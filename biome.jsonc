{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/.cloudflare",
      "!**/drizzle",
      "!**/.agents",
      "!**/.claude",
      "!DESIGN.md"
    ]
  },
  "formatter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space"
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentScriptAndStyle": true,
      "whitespaceSensitivity": "strict"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "preset": "recommended",
      "source": {
        "preset": "recommended",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": true }]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Input"] }
        }
      },
      "nursery": {
        "noArrayMethodsOnArguments": "error",
        "noAsyncPromiseFinally": "error",
        "noConstantComparisons": "error",
        "noDisabledAttribute": "error",
        "noDuplicateTypeConstituents": "error",
        "noErasingOperation": "error",
        "noExcessiveSelectorComplexity": "error",
        "noInvalidFetchOptions": "error",
        "noNegatedArrayPredicate": "error",
        "noNewArray": "error",
        "noNumberArgumentOutOfRange": "error",
        "noRedundantTypeConstituents": "error",
        "noScssNullComparison": "error",
        "noSharedBranchCode": "error",
        "noSubtractionComparison": "error",
        "noSvelteAsyncStore": "error",
        "noSvelteIgnoredUnsubscribe": "error",
        "noUninvokedArrayCallback": "error",
        "noUnresolvedDefaultImport": "error",
        "noUselessFallbackInSpread": "error",
        "noUselessParameterPropertyAssignment": "error",
        "noUselessQualifier": "error",
        "noUselessSpread": "error",
        "noVueExposeAfterAwait": "error",
        "useCatchErrorName": "error",
        "useConsistentFontWeightNotation": "error",
        "useConsistentTupleLabels": "error",
        "useGlobalRegexInMatchAll": "error",
        "useGlobalRegexInReplaceAll": "error",
        "useNextScriptForGoogleAnalytics": "error",
        "useValidCharacterComparison": "error"
      }
    },
    "domains": {
      "project": "recommended",
      "types": "recommended"
    }
  }
}
