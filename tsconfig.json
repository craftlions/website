{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "types": ["./.cloudflare/types/index.d.ts", "node"],
    "allowImportingTsExtensions": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".cloudflare/output", ".cloudflare/state", ".wrangler"],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ]
}
