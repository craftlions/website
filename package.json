{
  "name": "website",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "biome": "biome",
    "build": "astro build",
    "check": "tsc --noEmit --runExternalCode",
    "deploy": "astro build && cf deploy --prebuilt",
    "dev": "astro dev",
    "preview": "astro build && astro preview",
    "types": "cf workers types --include-runtime",
    "design:lint": "node scripts/design-lint.js",
    "a11y": "playwright test tests/a11y.spec.ts",
    "design:test": "playwright test tests/design",
    "e2e": "playwright test tests/e2e",
    "unit": "node --test tests/unit tests/design-lint",
    "cf-check": "cf workers types --include-runtime && git diff --exit-code -- .cloudflare/types"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "15.0.0-beta.5",
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/sitemap": "3.7.5",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@axe-core/playwright": "4.14.0",
    "@better-auth/drizzle-adapter": "1.7.25",
    "@better-auth/infra": "0.4.30",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.9",
    "@drizzle-team/minipg": "0.4.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "astro": "7.4.12",
    "auth": "1.7.25",
    "better-auth": "1.7.25",
    "browserslist": "4.29.5",
    "cf": "1.0.0-beta.32",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-orm": "1.0.0-rc.5",
    "lightningcss": "1.33.0",
    "nanoid": "6.0.2",
    "typescript": "7.1.0-beta",
    "update-browserslist-db": "1.3.4",
    "vite": "8.3.8"
  },
  "overrides": {
    "@cloudflare/runtime-types": "0.1.28",
    "zod": "4.6.7"
  }
}
