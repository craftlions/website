---
import type { HTMLAttributes } from "astro/types";
import { formatPercent } from "../lib/format.ts";

interface Props extends Omit<HTMLAttributes<"progress">, "value" | "max"> {
	percent: number;
	pace?: number | undefined;
}

const { percent, pace, class: className, ...attrs } = Astro.props;
---

<span class:list={["progress", className]}>
	<progress
		{...attrs}
		aria-valuetext={formatPercent(percent)}
		max="100"
		value={Math.min(Number(percent.toFixed(1)), 100)}
		class="forced-line"
		data-variant={percent > 100 ? "danger" : undefined}
	>
		{`${formatPercent(percent)} used`}
	</progress>
	{pace !== undefined && (
		<span aria-hidden="true">
			<span class="forced-ink" style={`--pace: ${pace + 1}`} />
		</span>
	)}
</span>

<style>
	@layer components {
		.progress {
			position: relative;
			display: grid;

			& > progress {
				--progress-fill: var(--fg);
				inline-size: 100%;
				block-size: 0.5rem;
				appearance: none;
				border: var(--rule) var(--line-control);
				background-color: transparent;

				&[data-variant="danger"] {
					--progress-fill: var(--fill-danger);
				}
				&::-webkit-progress-bar {
					background-color: transparent;
				}
				&::-webkit-progress-value {
					background-color: var(--progress-fill);
				}
				&::-moz-progress-bar {
					background-color: var(--progress-fill);
				}

				@media (forced-colors: active) {
					&::-webkit-progress-value {
						forced-color-adjust: none;
						background-color: CanvasText;
						border-color: CanvasText;
					}
					&::-moz-progress-bar {
						forced-color-adjust: none;
						background-color: CanvasText;
						border-color: CanvasText;
					}
				}
			}

			& > span {
				position: absolute;
				inset-block: calc(-1 * var(--space-3xs));
				inset-inline-start: 0;
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				inline-size: 100%;
				pointer-events: none;
			}

			& > span > span {
				grid-column-start: var(--pace);
				justify-self: start;
				inline-size: 0.1875rem;
				block-size: 100%;
				border: 0 solid var(--canvas);
				border-inline-width: var(--hairline);
				background-color: var(--fg);
			}
		}
	}
</style>
