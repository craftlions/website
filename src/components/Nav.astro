---
import LogoWithTextVertical from "../assets/logoWithTextVertical.svg";
import NavSessionLinks from "./NavSessionLinks.astro";

interface Props {
	deferSessionLinks?: boolean;
	organizationSlug?: string | undefined;
	variant?: "app" | "marketing";
}

const {
	deferSessionLinks = false,
	organizationSlug,
	variant = "app",
} = Astro.props;
---

<nav
	aria-label="Primary"
	class="grid w-full grid-cols-1 gap-4 py-4 justify-items-center sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center"
>
	<a
		href="/"
		aria-label="craftlions home"
		class="grid justify-self-center sm:justify-self-start"
	>
		<LogoWithTextVertical
			class:list={[
				"[view-transition-name:nav-logo]",
				variant === "marketing" ? "h-24" : "h-9",
			]}
		/>
	</a>
	<ul
		class="-m-1 grid max-w-full grid-flow-col auto-cols-max items-center gap-6 overflow-x-auto p-1 justify-self-center text-sm sm:justify-self-end"
	>
		{deferSessionLinks ? (
			<NavSessionLinks
				{organizationSlug}
				pathname={Astro.url.pathname}
				server:defer
			>
				<li slot="fallback">
					<span class="inline-grid w-max border border-dashed border-line px-3 py-1 text-sm text-fg-muted">
						Loading...
					</span>
				</li>
			</NavSessionLinks>
		) : (
			<NavSessionLinks {organizationSlug} pathname={Astro.url.pathname} />
		)}
	</ul>
</nav>
