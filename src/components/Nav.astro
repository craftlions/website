---
import LogoWithTextVertical from "../assets/logoWithTextVertical.svg";
import NavSessionLinks from "./NavSessionLinks.astro";

interface Props {
	deferSessionLinks?: boolean;
	organizationSlug?: string | undefined;
	variant?: "app" | "marketing";
}

const {
	deferSessionLinks = false,
	organizationSlug,
	variant = "app",
} = Astro.props;
---

<nav
	aria-label="Primary"
	class="nav cluster"
	data-space="s"
	data-justify="between"
	data-variant={variant === "marketing" ? "marketing" : undefined}
>
	<a href="/" aria-label="craftlions home"> <LogoWithTextVertical /> </a>
	<ul
		class="cluster text-sm"
		style="--cluster-space: var(--space-xs) var(--space-m)"
	>
		{deferSessionLinks ? (
			<NavSessionLinks
				{organizationSlug}
				pathname={Astro.url.pathname}
				server:defer
			>
				<li slot="fallback">
					<span class="nav-placeholder text-label text-fg-muted">Loading…</span>
				</li>
			</NavSessionLinks>
		) : (
			<NavSessionLinks {organizationSlug} pathname={Astro.url.pathname} />
		)}
	</ul>
</nav>

<style>
	@layer components {
		.nav {
			padding-block: var(--space-s);

			& > a {
				display: grid;
			}
			& > a > :global(svg) {
				view-transition-name: nav-logo;
				block-size: 2.25rem;
			}
			&[data-variant="marketing"] > a > :global(svg) {
				block-size: 6rem;
			}

			& .nav-placeholder {
				display: inline-grid;
				inline-size: max-content;
				padding: var(--space-3xs) var(--space-xs);
				border: var(--rule) var(--line);
			}
		}
	}
</style>
