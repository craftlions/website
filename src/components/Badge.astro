---
interface Props {
	type: "info" | "success" | "error" | "gray";
}

const { type } = Astro.props;
---

<span
	class="inline-grid w-max place-items-center whitespace-nowrap border border-dashed bg-transparent px-2.5 py-1 text-xs/none font-semibold capitalize"
	class:list={[
		{
			"border-line-success text-fg-success": type === "success",
			"border-line-danger text-fg-danger": type === "error",
			"border-line-info text-fg-info": type === "info",
			"border-line-strong text-fg-muted": type === "gray",
		},
	]}
>
	<slot />
</span>
