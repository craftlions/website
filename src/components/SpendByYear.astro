---
interface SpendRow {
	year: number;
	projectId: string | null;
	projectName: string;
	total: number;
}

interface Props {
	rows: SpendRow[];
}

const { rows } = Astro.props;

const UNASSIGNED = "Unassigned";
const UNTITLED_PROJECT = "Untitled project";
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const projectNameCollator = new Intl.Collator("de-DE", {
	numeric: true,
	sensitivity: "base",
});
const currentYear = new Date().getUTCFullYear();

// Stable, muted ink colors; unassigned spend stays neutral.
const segmentMarks = [
	"text-indigo-600/60 dark:text-indigo-300/60",
	"text-teal-700/60 dark:text-teal-300/60",
	"text-amber-700/60 dark:text-amber-300/60",
	"text-rose-700/55 dark:text-rose-300/60",
	"text-violet-700/55 dark:text-violet-300/60",
	"text-emerald-700/60 dark:text-emerald-300/60",
];

const validRows = rows.filter(
	(row) =>
		Number.isSafeInteger(row.year) &&
		row.year >= 1 &&
		row.year <= 9999 &&
		Number.isFinite(row.total),
);
const projectsByKey = new Map<string, { id: string; name: string }>();
const totalsByYear = new Map<number, Map<string, number>>();
for (const row of validRows) {
	const key = row.projectId ?? "unassigned";
	if (!projectsByKey.has(key)) {
		projectsByKey.set(key, {
			id: key,
			name:
				key === "unassigned"
					? UNASSIGNED
					: row.projectName.trim() || UNTITLED_PROJECT,
		});
	}

	if (!totalsByYear.has(row.year)) {
		totalsByYear.set(row.year, new Map());
	}
	const totalsForYear = totalsByYear.get(row.year);
	if (totalsForYear) {
		totalsForYear.set(key, (totalsForYear.get(key) ?? 0) + row.total);
	}
}
const projectKeys = [...projectsByKey.values()]
	.sort((a, b) => {
		if (a.id === "unassigned") return 1;
		if (b.id === "unassigned") return -1;
		return (
			projectNameCollator.compare(a.name, b.name) || a.id.localeCompare(b.id)
		);
	})
	.map((project, index) => ({
		...project,
		mark:
			project.id === "unassigned"
				? "text-neutral-500/55 dark:text-neutral-400/55"
				: (segmentMarks[index % segmentMarks.length] ?? segmentMarks[0]),
	}));

const dataYears = [...totalsByYear.keys()].sort((a, b) => a - b);
const firstYear = Math.min(currentYear, dataYears[0] ?? currentYear);
const lastYear = Math.max(currentYear, dataYears.at(-1) ?? currentYear);
const years =
	lastYear - firstYear <= 50
		? Array.from(
				{ length: lastYear - firstYear + 1 },
				(_, index) => firstYear + index,
			)
		: [...new Set([...dataYears, currentYear])].sort((a, b) => a - b);
const hasCondensedYears = lastYear - firstYear > 50;
const bars = years.map((year) => {
	const totalsForYear = totalsByYear.get(year);
	const segments = projectKeys.flatMap((project) =>
		totalsForYear?.has(project.id)
			? [{ ...project, total: totalsForYear.get(project.id) ?? 0 }]
			: [],
	);
	return {
		year,
		total: segments.reduce((sum, segment) => sum + segment.total, 0),
		segments,
	};
});
const maxTotal = Math.max(...bars.map((bar) => bar.total), 1);
const hasNegativeSpend = bars.some((bar) =>
	bar.segments.some((segment) => segment.total < 0),
);
---

<section aria-labelledby="spend-heading" class="grid content-start gap-3">
	<h2
		id="spend-heading"
		class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
	>
		Spend by year
	</h2>

	{rows.length === 0 ? (
		<p
			class="border border-dashed border-neutral-300 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400"
		>
			No invoices yet.
		</p>
	) : validRows.length === 0 ? (
		<p
			class="border border-dashed border-red-300 p-4 text-sm text-red-700 dark:border-red-800 dark:text-red-300"
		>
			Invoice spend could not be summarized. Please reload the page and try
			again.
		</p>
	) : (
		<>
			{validRows.length < rows.length && (
				<p
					class="border border-dashed border-red-300 p-4 text-sm text-red-700 dark:border-red-800 dark:text-red-300"
				>
					Some invoice amounts could not be included. Please reload the page; if
					the problem persists, contact craftlions.
				</p>
			)}

			{hasNegativeSpend ? (
				<p
					class="border border-dashed border-neutral-300 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400"
				>
					The chart cannot represent negative invoice adjustments. Open exact
					amounts below for the complete breakdown.
				</p>
			) : (
				<div
					class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700"
				>
				<div class="grid gap-1 overflow-x-auto">
					<div
						class="grid w-full min-w-max gap-2"
						style={`grid-template-columns: repeat(${bars.length}, minmax(8rem, 1fr))`}
					>
						{bars.map((bar) => {
							const reversed = bar.segments
								.filter((segment) => segment.total > 0)
								.reverse();
							return (
								<div class="grid min-w-0">
									<div
										class="grid h-36 items-end border-b border-dashed border-neutral-300 dark:border-neutral-700"
									>
										<div
											class="grid gap-px"
											style={`height: ${(bar.total / maxTotal) * 100}%; grid-template-rows: ${reversed.map((segment) => `${segment.total / bar.total}fr`).join(" ")}`}
											aria-hidden="true"
										>
											{reversed.map((segment) => (
												<div
													class:list={[
														"bg-[repeating-linear-gradient(135deg,transparent_0_3px,currentColor_3px_4px)]",
														segment.mark,
													]}
												/>
											))}
										</div>
									</div>
									<div class="grid gap-0.5 pt-1 text-center">
										<span
										class:list={[
											"whitespace-nowrap text-sm font-medium tabular-nums",
											bar.year === currentYear &&
												"underline decoration-dashed decoration-neutral-400 underline-offset-4 dark:decoration-neutral-600",
										]}
										>
											{currencyFormatter.format(bar.total)}
										</span>
										<span
											class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
										>
											{bar.year}
											{bar.year === currentYear && (
												<span class="sr-only"> (current year)</span>
											)}
										</span>
									</div>
								</div>
							);
						})}
					</div>
				</div>

				<ul
					aria-label="Spend by project"
					class="grid gap-x-4 gap-y-2 text-sm sm:grid-cols-2 md:grid-cols-3"
				>
					{projectKeys.map((project) => (
						<li
							class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-2"
						>
							<span
								aria-hidden="true"
								class:list={[
									"size-3 border border-dashed border-current bg-[repeating-linear-gradient(135deg,transparent_0_3px,currentColor_3px_4px)]",
									project.mark,
								]}
							/>
							<span class="min-w-0 wrap-break-word" dir="auto"
								>{project.name}</span
							>
						</li>
					))}
				</ul>
				{hasCondensedYears && (
					<p class="text-xs text-neutral-500 dark:text-neutral-400">
						Long gaps between invoice years are condensed.
					</p>
				)}
				</div>
			)}

			<details
				class="border border-dashed border-neutral-300 dark:border-neutral-700"
			>
				<summary
					class="cursor-pointer px-4 py-3 text-sm font-medium text-neutral-700 marker:text-neutral-500 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-700 dark:text-neutral-300 dark:marker:text-neutral-400 dark:hover:bg-neutral-900 dark:focus-visible:outline-neutral-300"
				>
					Exact amounts
				</summary>
				<div
					class="overflow-x-auto border-t border-dashed border-neutral-300 dark:border-neutral-700"
				>
					<table class="w-full min-w-xl text-sm">
						<caption class="sr-only">
							Exact invoiced spend by year and project
						</caption>
						<thead>
						<tr
							class="border-b border-dashed border-neutral-300 text-neutral-500 dark:border-neutral-700 dark:text-neutral-400"
						>
							<th
								scope="col"
								class="px-4 py-3 text-left text-xs font-semibold uppercase"
							>
								Year
							</th>
							{projectKeys.map((project) => (
								<th
									scope="col"
									class="max-w-64 px-4 py-3 text-right text-xs font-semibold uppercase wrap-break-word"
									dir="auto"
								>
									{project.name}
								</th>
							))}
							<th
								scope="col"
								class="px-4 py-3 text-right text-xs font-semibold uppercase"
							>
								Total
							</th>
						</tr>
						</thead>
						<tbody
						class="divide-y divide-dashed divide-neutral-300 dark:divide-neutral-700"
					>
						{bars.map((bar) => (
							<tr>
								<th
									scope="row"
									class="px-4 py-3 text-left font-medium"
								>
									{bar.year}
									{bar.year === currentYear && (
										<span class="sr-only"> (current year)</span>
									)}
								</th>
								{projectKeys.map((project) => {
									const total = totalsByYear.get(bar.year)?.get(project.id);
									return (
										<td
											class="whitespace-nowrap px-4 py-3 text-right tabular-nums text-neutral-700 dark:text-neutral-300"
										>
											{total !== undefined
												? currencyFormatter.format(total)
												: "—"}
										</td>
									);
								})}
								<td
									class:list={[
										"whitespace-nowrap px-4 py-3 text-right font-medium tabular-nums",
										bar.year === currentYear &&
											"underline decoration-dashed decoration-neutral-400 underline-offset-4 dark:decoration-neutral-600",
									]}
								>
									{currencyFormatter.format(bar.total)}
								</td>
							</tr>
						))}
						</tbody>
					</table>
				</div>
			</details>
		</>
	)}
</section>
