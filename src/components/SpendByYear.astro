---
import type { SpendByYearRow } from "../lib/budget-consumption.ts";

interface Props {
	rows: SpendByYearRow[];
}

const { rows } = Astro.props;

const UNASSIGNED = "Unassigned";
const UNTITLED_PROJECT = "Untitled project";
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const projectNameCollator = new Intl.Collator("de-DE", {
	numeric: true,
	sensitivity: "base",
});
const currentYear = new Date().getUTCFullYear();

// Distinct ink colors keep projects easy to separate at a glance.
const segmentMarks = [
	"text-chart-1",
	"text-chart-2",
	"text-chart-3",
	"text-chart-4",
	"text-chart-5",
	"text-chart-6",
];

const validRows = rows.filter(
	(row) =>
		Number.isSafeInteger(row.year) &&
		row.year >= 1 &&
		row.year <= 9999 &&
		Number.isFinite(row.total),
);
const projectsByKey = new Map<string, { id: string; name: string }>();
const totalsByYear = new Map<number, Map<string, number>>();
for (const row of validRows) {
	const key = row.projectId ?? "unassigned";
	if (!projectsByKey.has(key)) {
		projectsByKey.set(key, {
			id: key,
			name:
				key === "unassigned"
					? UNASSIGNED
					: row.projectName.trim() || UNTITLED_PROJECT,
		});
	}

	if (!totalsByYear.has(row.year)) {
		totalsByYear.set(row.year, new Map());
	}
	const totalsForYear = totalsByYear.get(row.year);
	if (totalsForYear) {
		totalsForYear.set(key, (totalsForYear.get(key) ?? 0) + row.total);
	}
}
const projectKeys = [...projectsByKey.values()]
	.sort((a, b) => {
		if (a.id === "unassigned") return 1;
		if (b.id === "unassigned") return -1;
		return (
			projectNameCollator.compare(a.name, b.name) || a.id.localeCompare(b.id)
		);
	})
	.map((project, index) => ({
		...project,
		mark:
			project.id === "unassigned"
				? "text-chart-unassigned"
				: (segmentMarks[index % segmentMarks.length] ?? segmentMarks[0]),
		total: [...totalsByYear.values()].reduce(
			(sum, totalsForYear) => sum + (totalsForYear.get(project.id) ?? 0),
			0,
		),
	}));

const dataYears = [...totalsByYear.keys()].sort((a, b) => a - b);
const firstYear = Math.min(currentYear, dataYears[0] ?? currentYear);
const lastYear = Math.max(currentYear, dataYears.at(-1) ?? currentYear);
const years =
	lastYear - firstYear <= 50
		? Array.from(
				{ length: lastYear - firstYear + 1 },
				(_, index) => firstYear + index,
			)
		: [...new Set([...dataYears, currentYear])].sort((a, b) => a - b);
const hasCondensedYears = lastYear - firstYear > 50;
const period =
	firstYear === lastYear ? `${firstYear}` : `${firstYear}–${lastYear}`;
const bars = years.map((year) => {
	const totalsForYear = totalsByYear.get(year);
	const segments = projectKeys.flatMap((project) =>
		totalsForYear?.has(project.id)
			? [{ ...project, total: totalsForYear.get(project.id) ?? 0 }]
			: [],
	);
	return {
		year,
		total: segments.reduce((sum, segment) => sum + segment.total, 0),
		segments,
	};
});
const maxTotal = Math.max(...bars.map((bar) => bar.total), 1);
const hasNegativeSpend = bars.some((bar) =>
	bar.segments.some((segment) => segment.total < 0),
);
---

<section aria-labelledby="spend-heading" class="grid content-start gap-3">
	<h2 id="spend-heading" class="label-caps"> Spend by year </h2>

	{rows.length === 0 ? (
		<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
			No invoices yet.
		</p>
	) : validRows.length === 0 ? (
		<p class="border border-dashed border-line-danger p-4 text-sm text-fg-danger">
			Invoice spend could not be summarized. Please reload the page and try
			again.
		</p>
	) : (
		<>
			{validRows.length < rows.length && (
				<p class="border border-dashed border-line-danger p-4 text-sm text-fg-danger">
					Some invoice amounts could not be included. Please reload the page; if
					the problem persists, contact craftlions.
				</p>
			)}

			{hasNegativeSpend ? (
				<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
					The chart cannot represent negative invoice adjustments. See the
					invoice list for the complete breakdown.
				</p>
			) : (
				<div
					class="grid grid-cols-1 gap-3 border border-dashed border-line p-4"
					data-spend-chart
				>
					<section
						class="grid gap-1 overflow-x-auto"
						dir="rtl"
						tabindex="0"
						aria-labelledby="spend-heading"
					>
						<div
							class="grid w-full min-w-max gap-2"
							dir="ltr"
							style={`grid-template-columns: repeat(${bars.length}, minmax(6.5rem, 1fr))`}
						>
							{bars.map((bar) => {
								const reversed = bar.segments
									.filter((segment) => segment.total > 0)
									.reverse();
								return (
									<div class="grid min-w-0">
										<div class="grid h-36 items-end border-b border-dashed border-line">
											<div
												class="grid gap-px"
												style={`height: ${(bar.total / maxTotal) * 100}%; grid-template-rows: ${reversed.map((segment) => `${segment.total / bar.total}fr`).join(" ")}`}
												aria-hidden="true"
											>
												{reversed.map((segment) => (
													<div
														class:list={[
															"bg-[repeating-linear-gradient(135deg,transparent_0_3px,currentColor_3px_4px)] transition-[filter,opacity] duration-150 forced-line",
															segment.mark,
														]}
														data-project={segment.id}
														data-name={segment.name}
														data-amount={currencyFormatter.format(
															segment.total,
														)}
														data-year={bar.year}
													/>
												))}
											</div>
										</div>
										<div class="grid gap-0.5 pt-1 text-center">
											<span
												class:list={[
													"whitespace-nowrap text-sm tabular-nums",
													bar.year === currentYear &&
														"justify-self-center border-b border-dashed border-line-strong",
												]}
											>
												{currencyFormatter.format(bar.total)}
											</span>
											<span class="label-caps">
												{bar.year}
												{bar.year === currentYear && (
													<span class="sr-only"> (current year)</span>
												)}
											</span>
										</div>
									</div>
								);
							})}
						</div>
					</section>

					<p class="text-sm" data-spend-status>
						<span class="block h-5 truncate" dir="auto">
							All projects
						</span>
						<span class="block h-5 truncate tabular-nums text-fg-muted">
							{`${currencyFormatter.format(bars.reduce((sum, bar) => sum + bar.total, 0))} · ${period}`}
						</span>
					</p>

					<ul
						aria-label="Spend by project"
						class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,9rem),1fr))] gap-x-4 gap-y-2 text-sm"
					>
						{projectKeys.map((project) => (
							<li
								class="grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start items-center gap-x-2 px-1 py-0.5 transition-colors duration-150"
								data-project={project.id}
								data-name={project.name}
								data-amount={currencyFormatter.format(project.total)}
								data-year={period}
							>
								<span
									aria-hidden="true"
									class:list={[
										"size-3 border border-dashed border-current bg-[repeating-linear-gradient(135deg,transparent_0_3px,currentColor_3px_4px)] forced-line",
										project.mark,
									]}
								/>
								<span class="min-w-0 wrap-break-word" dir="auto">
									{project.name}
								</span>
								<span class="col-start-2 min-w-0 text-xs tabular-nums text-fg-muted wrap-break-word">
									{currencyFormatter.format(project.total)}
								</span>
							</li>
						))}
					</ul>
					{hasCondensedYears && (
						<p class="text-xs text-fg-muted">
							Long gaps between invoice years are condensed.
						</p>
					)}
				</div>
			)}
		</>
	)}
</section>

<script>
	for (const chart of document.querySelectorAll("[data-spend-chart]")) {
		const items = chart.querySelectorAll<HTMLElement>("[data-project]");
		// The status line has a fixed height of two truncated lines, so changing
		// its text never moves the bars or the legend. It is not a live region:
		// it changes on every pointer move, and the legend already lists each
		// project's total.
		const [name, figure] = chart.querySelectorAll<HTMLElement>(
			"[data-spend-status] > span",
		);
		const defaults = [name?.textContent, figure?.textContent];

		// Only colour, opacity, filter and text change here; no class affects
		// an element's box.
		const setActive = (active: HTMLElement | null) => {
			for (const item of items) {
				const match = item.dataset.project === active?.dataset.project;
				const dimmed = active !== null && !match;
				if (item instanceof HTMLLIElement) {
					item.classList.toggle("text-fg-muted", dimmed);
					item.classList.toggle("bg-panel", match);
				} else {
					item.classList.toggle("opacity-30", dimmed);
					item.classList.toggle("brightness-125", match);
				}
			}
			if (!name || !figure) return;
			name.textContent = active?.dataset.name ?? defaults[0] ?? "";
			figure.textContent = active
				? `${active.dataset.amount} · ${active.dataset.year}`
				: (defaults[1] ?? "");
		};

		for (const item of items) {
			item.addEventListener("mouseenter", () => setActive(item));
			item.addEventListener("mouseleave", () => setActive(null));
		}
	}
</script>
