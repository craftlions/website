---
import { clientCostPartLabel } from "../lib/client-worklist.ts";
import {
	formatDate,
	formatDays,
	formatMoney,
	sumByCurrency,
} from "../lib/format.ts";
import { buildPhaseComponents } from "../lib/phase-billing";
import { daysOverdue, invoiceStatus } from "../lib/status.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import CostSplit from "./CostSplit.astro";
import DisclosureButton from "./DisclosureButton.astro";

interface Invoice {
	id: string;
	component: string | null;
	number: string;
	paymentPage: string;
	invoicedAt: Date;
	status: string;
	paidAt: Date | null;
	dueAt: Date | null;
	total: number;
	currency: string;
	phase: {
		publicId: string;
		title: string;
		cost: number;
		upfrontAmount: number | null;
		deliveryAmount: number | null;
		acceptanceAmount: number | null;
		currency: string;
		state:
			| "submitted"
			| "planned"
			| "approved"
			| "in_progress"
			| "delivered"
			| "accepted"
			| "cancelled";
		deliveryState: "url" | "none" | "not_recorded";
		deliveryUrl: string | null;
		project: {
			publicId: string;
			name: string;
		} | null;
		invoices: { component: string; stripe: { status: string } | null }[];
	} | null;
}

interface Props {
	invoices: Invoice[];
	slug: string;
}

const { invoices, slug } = Astro.props;
const now = new Date();
const rows = invoices.map((invoice) => ({
	...invoice,
	status:
		invoice.status === "open" && invoice.dueAt && invoice.dueAt < now
			? "overdue"
			: invoice.status,
	components: invoice.phase
		? buildPhaseComponents({
				upfrontAmount: invoice.phase.upfrontAmount,
				deliveryAmount: invoice.phase.deliveryAmount,
				acceptanceAmount: invoice.phase.acceptanceAmount,
				state: invoice.phase.state,
				invoices: invoice.phase.invoices,
			})
		: [],
}));
const totalWhere = (statuses: string[]) =>
	sumByCurrency(
		rows
			.filter((row) => statuses.includes(row.status))
			.map((row) => ({ amount: row.total, currency: row.currency })),
		rows[0]?.currency,
	);
const hasOverdue = rows.some((row) => row.status === "overdue");
// Open first, since it answers what is owed, and always while there are
// invoices; then paid, then void and uncollectible ones, each in the order
// given (newest first).
const groups = [
	{
		key: "open",
		label: "Open",
		statuses: ["open", "overdue"],
		empty: "Nothing to pay: every invoice is paid.",
	},
	{ key: "paid", label: "Paid", statuses: ["paid"], empty: null },
	{
		key: "not-charged",
		label: "Not charged",
		statuses: ["void", "uncollectible"],
		empty: null,
	},
]
	.map((group) => ({
		...group,
		items: rows.filter((row) => group.statuses.includes(row.status)),
	}))
	.filter((group) => group.empty || group.items.length > 0);

// Invoiced totals grouped by cost part show all three types at a glance;
// unattached invoices carry no component and stay a separate bucket.
const totalsByPart = new Map<string, number>();
let unassignedTotal = 0;
let unassignedCurrency = rows[0]?.currency ?? "EUR";
for (const row of rows) {
	if (
		row.component === "upfront" ||
		row.component === "delivery" ||
		row.component === "acceptance"
	) {
		totalsByPart.set(
			row.component,
			(totalsByPart.get(row.component) ?? 0) + row.total,
		);
	} else {
		unassignedTotal += row.total;
		unassignedCurrency = row.currency;
	}
}
const partSummaryCurrency = rows[0]?.currency ?? "EUR";
const partSummaryItems = [...totalsByPart]
	.filter(([, amount]) => amount !== 0)
	.map(([component, amount]) => ({
		component: component as "upfront" | "delivery" | "acceptance",
		amount,
		status: "invoiced" as const,
	}));
const partSummaryTotal = partSummaryItems.reduce(
	(sum, item) => sum + item.amount,
	0,
);
---

<div class="stack" data-space="xs">
	{rows.length > 0 && (
		<div class="stack" data-space="xs">
			<dl class="cluster text-sm" data-space="metrics" data-align="baseline">
				<div>
					<dt class="label-caps">Outstanding</dt>
					<dd class="tabular-nums">{totalWhere(["open", "overdue"])}</dd>
				</div>
				<div>
					<dt class="label-caps">Overdue</dt>
					<dd class:list={["tabular-nums", hasOverdue && "text-fg-danger"]}>
						{totalWhere(["overdue"])}
					</dd>
				</div>
				<div>
					<dt class="label-caps">Paid</dt>
					<dd class="tabular-nums">{totalWhere(["paid"])}</dd>
				</div>
			</dl>
			{partSummaryItems.length > 0 && (
				<div class="box stack" data-padding="xs" data-space="2xs">
					<p class="label-caps">Invoiced by cost part</p>
					<div class="invoice-table-parts">
						<CostSplit
							items={partSummaryItems}
							currency={partSummaryCurrency}
							total={partSummaryTotal}
							showStatus={false}
							caption={
								unassignedTotal > 0
									? `Plus ${formatMoney(unassignedTotal, unassignedCurrency)} unassigned`
									: null
							}
						/>
					</div>
				</div>
			)}
		</div>
	)}
	{rows.length > 0 ? (
		<div class="lines" data-actions="below">
			{groups.map((group) => (
				<>
					<h3>
						<span id={`invoices-${group.key}`} class="text-label">
							{group.label}{" "}
							<span class="text-fg-muted">· {group.items.length}</span>
						</span>
						{group.items.length > 0 && group.key !== "not-charged" && (
							<span class="line-figure text-sm text-fg-muted">
								<span class="sr-only">total </span>
								{totalWhere(group.statuses)}
							</span>
						)}
					</h3>
					{group.items.length > 0 ? (
						<ul aria-labelledby={`invoices-${group.key}`}>
							{group.items.map((invoice) => (
								<li id={`invoice-${invoice.id}`} class="target">
									<div class="line-text">
										{invoice.phase?.project ? (
											<h4>
												<a
													href={`/dash/org/${slug}/project/${invoice.phase.project.publicId}#phase-${invoice.phase.publicId}`}
													class="link"
												>
													{invoice.phase.project.name} · {invoice.phase.title}
												</a>
											</h4>
										) : (
											<h4 class="text-fg-muted">Unassigned invoice</h4>
										)}
										<p class="cluster text-sm text-fg-muted">
											{invoice.status === "overdue" ? (
												<Badge type="error">Overdue</Badge>
											) : invoice.status === "open" ? (
												<Badge type="info">Open</Badge>
											) : invoice.status === "paid" ? (
												<Badge type="success">Paid</Badge>
											) : (
												<Badge type="gray">
													{invoiceStatus(invoice).label}
												</Badge>
											)}
											<span>
												Invoice {invoice.number}
												{invoice.component &&
													clientCostPartLabel[invoice.component] &&
													` · ${clientCostPartLabel[invoice.component]}`}
												{invoice.phase?.deliveryState === "url" &&
												invoice.phase.deliveryUrl ? (
													<>
														{" · "}
														<a
															href={invoice.phase.deliveryUrl}
															target="_blank"
															rel="noopener noreferrer"
															aria-label={`Open delivery of ${invoice.phase.title} (opens in a new tab)`}
															class="link"
														>
															open delivery
														</a>
													</>
												) : invoice.phase?.deliveryState === "none" ? (
													" · no delivery"
												) : (
													invoice.phase?.deliveryState === "not_recorded" &&
													" · delivery not recorded"
												)}
											</span>
										</p>
									</div>
									<p class="line-figure">
										<span>{formatMoney(invoice.total, invoice.currency)}</span>
										<span
											class:list={[
												"text-sm",
												invoice.status === "overdue"
													? "text-fg-danger"
													: "text-fg-muted",
											]}
										>
											{invoice.status === "overdue"
												? `${formatDays(daysOverdue({ ...invoice, status: "open" }, now))} overdue`
												: invoice.status === "open"
													? invoice.dueAt
														? `due ${formatDate(invoice.dueAt)}`
														: "no due date"
													: invoice.status === "paid" && invoice.paidAt
														? `paid ${formatDate(invoice.paidAt)}`
														: `invoiced ${formatDate(invoice.invoicedAt)}`}
										</span>
									</p>
									<div class="line-actions cluster">
										{invoice.phase && invoice.components.length > 0 && (
											<DisclosureButton
												controls={`invoice-${invoice.id}-details`}
												variant="quiet"
												aria-label={`Details: invoice ${invoice.number}`}
											>
												Details
											</DisclosureButton>
										)}
										{invoice.status === "open" ||
										invoice.status === "overdue" ? (
											<Button
												href={invoice.paymentPage}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Pay invoice ${invoice.number} (opens in a new tab)`}
											>
												Pay
											</Button>
										) : (
											<Button
												href={invoice.paymentPage}
												target="_blank"
												rel="noopener noreferrer"
												variant="quiet"
												aria-label={`${invoice.status === "paid" ? "Receipt for" : "View"} invoice ${invoice.number} (opens in a new tab)`}
											>
												{invoice.status === "paid" ? "Receipt" : "View"}
											</Button>
										)}
									</div>
									{invoice.phase && invoice.components.length > 0 && (
										<div
											id={`invoice-${invoice.id}-details`}
											class="line-details"
											hidden
										>
											<div class="invoice-table-split">
												<CostSplit
													items={invoice.components}
													currency={invoice.phase.currency}
													total={invoice.phase.cost}
													highlight={
														invoice.component === "upfront" ||
														invoice.component === "delivery" ||
														invoice.component === "acceptance"
															? invoice.component
															: null
													}
												/>
											</div>
										</div>
									)}
								</li>
							))}
						</ul>
					) : (
						<p class="text-sm text-fg-muted">{group.empty}</p>
					)}
				</>
			))}
		</div>
	) : (
		<p class="box text-sm text-fg-muted">No invoices yet.</p>
	)}
</div>
