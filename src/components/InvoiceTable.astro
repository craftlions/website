---
import { clientCostPartLabel } from "../lib/client-worklist.ts";
import { formatDate, formatMoney, sumByCurrency } from "../lib/format.ts";
import { buildPhaseComponents } from "../lib/phase-billing";
import { invoiceStatus } from "../lib/status.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import CostSplit from "./CostSplit.astro";

interface Invoice {
	id: string;
	component: string | null;
	number: string;
	paymentPage: string;
	invoicedAt: Date;
	status: string;
	paidAt: Date | null;
	dueAt: Date | null;
	total: number;
	currency: string;
	phase: {
		publicId: string;
		title: string;
		cost: number;
		upfrontAmount: number | null;
		deliveryAmount: number | null;
		acceptanceAmount: number | null;
		currency: string;
		state:
			| "submitted"
			| "planned"
			| "approved"
			| "in_progress"
			| "delivered"
			| "accepted"
			| "cancelled";
		deliveryState: "url" | "none" | "not_recorded";
		deliveryUrl: string | null;
		project: {
			publicId: string;
			name: string;
		} | null;
		invoices: { component: string; stripe: { status: string } | null }[];
	} | null;
}

interface Props {
	invoices: Invoice[];
	slug: string;
}

const { invoices, slug } = Astro.props;
const now = new Date();
const rows = invoices.map((invoice) => ({
	...invoice,
	status:
		invoice.status === "open" && invoice.dueAt && invoice.dueAt < now
			? "overdue"
			: invoice.status,
	components: invoice.phase
		? buildPhaseComponents({
				upfrontAmount: invoice.phase.upfrontAmount,
				deliveryAmount: invoice.phase.deliveryAmount,
				acceptanceAmount: invoice.phase.acceptanceAmount,
				state: invoice.phase.state,
				invoices: invoice.phase.invoices,
			})
		: [],
}));
const totalWhere = (statuses: string[]) =>
	sumByCurrency(
		rows
			.filter((row) => statuses.includes(row.status))
			.map((row) => ({ amount: row.total, currency: row.currency })),
		rows[0]?.currency,
	);
const hasOverdue = rows.some((row) => row.status === "overdue");
const showFilter =
	rows.some((row) => row.status === "open" || row.status === "overdue") &&
	rows.some((row) => row.status === "paid");

// Invoiced totals grouped by cost part show all three types at a glance;
// unattached invoices carry no component and stay a separate bucket.
const totalsByPart = new Map<string, number>();
let unassignedTotal = 0;
let unassignedCurrency = rows[0]?.currency ?? "EUR";
for (const row of rows) {
	if (
		row.component === "upfront" ||
		row.component === "delivery" ||
		row.component === "acceptance"
	) {
		totalsByPart.set(
			row.component,
			(totalsByPart.get(row.component) ?? 0) + row.total,
		);
	} else {
		unassignedTotal += row.total;
		unassignedCurrency = row.currency;
	}
}
const partSummaryCurrency = rows[0]?.currency ?? "EUR";
const partSummaryItems = [...totalsByPart]
	.filter(([, amount]) => amount !== 0)
	.map(([component, amount]) => ({
		component: component as "upfront" | "delivery" | "acceptance",
		amount,
		status: "invoiced" as const,
	}));
const partSummaryTotal = partSummaryItems.reduce(
	(sum, item) => sum + item.amount,
	0,
);
---

<invoice-table class="stack" data-space="xs">
	{rows.length > 0 && (
		<div class="stack" data-space="xs">
			<dl class="invoice-table-metrics text-sm">
				<div class="stack" data-space="3xs">
					<dt class="label-caps">Outstanding</dt>
					<dd class="tabular-nums">{totalWhere(["open", "overdue"])}</dd>
				</div>
				<div class="stack" data-space="3xs">
					<dt class="label-caps">Overdue</dt>
					<dd class:list={["tabular-nums", hasOverdue && "text-fg-danger"]}>
						{totalWhere(["overdue"])}
					</dd>
				</div>
				<div class="stack" data-space="3xs">
					<dt class="label-caps">Paid</dt>
					<dd class="tabular-nums">{totalWhere(["paid"])}</dd>
				</div>
			</dl>
			{partSummaryItems.length > 0 && (
				<div class="box invoice-table-parts" data-padding="xs">
					<p class="label-caps">Invoiced by cost part</p>
					<div>
						<CostSplit
							items={partSummaryItems}
							currency={partSummaryCurrency}
							total={partSummaryTotal}
							variant="compact"
							showStatus={false}
							caption={
								unassignedTotal > 0
									? `Plus ${formatMoney(unassignedTotal, unassignedCurrency)} unassigned`
									: null
							}
						/>
					</div>
				</div>
			)}
		</div>
	)}
	{showFilter && (
		<nav aria-label="Filter invoices" class="invoice-table-filter">
			<Button type="button" data-invoice-filter="all" aria-pressed="true">
				All
			</Button>
			<Button type="button" data-invoice-filter="open" aria-pressed="false">
				Open
			</Button>
			<Button type="button" data-invoice-filter="paid" aria-pressed="false">
				Paid
			</Button>
		</nav>
	)}
	{rows.length > 0 ? (
		<ul class="stack" data-space="xs">
			{rows.map((invoice) => (
				<li
					id={`invoice-${invoice.id}`}
					class="box target invoice-table-item"
					data-invoice-item
					data-category={
						invoice.status === "paid"
							? "paid"
							: invoice.status === "open" || invoice.status === "overdue"
								? "open"
								: "other"
					}
				>
					<div class="invoice-table-columns">
						<div class="stack" data-space="2xs">
							<div class="stack" data-space="3xs">
								<p class="label-caps leading-none">Invoice {invoice.number}</p>
								<div class="invoice-table-amount">
									<p class="text-title tabular-nums leading-none">
										{formatMoney(invoice.total, invoice.currency)}
									</p>
									{invoice.component &&
									clientCostPartLabel[invoice.component] ? (
										<Badge type="info">
											{clientCostPartLabel[invoice.component]}
										</Badge>
									) : (
										<Badge type="gray">Unassigned</Badge>
									)}
								</div>
								{invoice.phase && invoice.components.length > 0 && (
									<div class="invoice-table-split">
										<CostSplit
											items={invoice.components}
											currency={invoice.phase.currency}
											total={invoice.phase.cost}
											variant="compact"
											highlight={
												invoice.component === "upfront" ||
												invoice.component === "delivery" ||
												invoice.component === "acceptance"
													? invoice.component
													: null
											}
										/>
									</div>
								)}
							</div>
							<dl class="invoice-table-facts text-sm">
								<div>
									<dt class="label-caps leading-none">Due</dt>
									<dd
										class:list={[
											invoice.status === "overdue" && "text-fg-danger",
										]}
									>
										{invoice.dueAt ? formatDate(invoice.dueAt) : "—"}
									</dd>
								</div>
								<div>
									<dt class="label-caps leading-none">Status</dt>
									<dd>
										<div class="invoice-table-status">
											{invoice.status === "overdue" ? (
												<Badge type="error">Overdue</Badge>
											) : invoice.status === "open" ? (
												<Badge type="info">Open</Badge>
											) : invoice.status === "paid" ? (
												<Badge type="success">Paid</Badge>
											) : invoice.status ? (
												<Badge type="gray">
													{invoiceStatus(invoice).label}
												</Badge>
											) : (
												<span class="text-fg-muted">—</span>
											)}
											{invoice.status === "paid" && invoice.paidAt && (
												<span class="text-xs text-fg-muted">
													{formatDate(invoice.paidAt)}
												</span>
											)}
										</div>
									</dd>
								</div>
								<div>
									<dt class="label-caps leading-none">Work</dt>
									<dd>
										{invoice.phase?.project ? (
											<a
												href={`/dash/org/${slug}/project/${invoice.phase.project.publicId}#phase-${invoice.phase.publicId}`}
												class="link"
											>
												{invoice.phase.project.name} · {invoice.phase.title}
											</a>
										) : (
											<span class="text-fg-muted">Unassigned</span>
										)}
									</dd>
								</div>
								<div>
									<dt class="label-caps leading-none">Delivery</dt>
									<dd>
										{invoice.phase?.deliveryState === "url" &&
										invoice.phase.deliveryUrl ? (
											<a
												href={invoice.phase.deliveryUrl}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Open Delivery for ${invoice.phase.project ? invoice.phase.title : "the invoice"}`}
												class="link"
											>
												Open
											</a>
										) : invoice.phase?.deliveryState === "none" ? (
											<span class="text-fg-muted">No delivery</span>
										) : invoice.phase?.deliveryState === "not_recorded" ? (
											<span class="text-fg-muted">Not recorded</span>
										) : (
											<span class="text-fg-muted">Unavailable</span>
										)}
									</dd>
								</div>
							</dl>
						</div>
						<div class="invoice-table-action">
							<Button
								href={invoice.paymentPage}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${invoice.status === "open" || invoice.status === "overdue" ? "Pay" : "Details"} invoice ${invoice.number}`}
							>
								{invoice.status === "open" || invoice.status === "overdue"
									? "Pay"
									: "Details"}
							</Button>
						</div>
					</div>
				</li>
			))}
		</ul>
	) : (
		<p class="box text-sm text-fg-muted">No invoices yet.</p>
	)}
</invoice-table>

<script>
	class InvoiceTable extends HTMLElement {
		filter = "all";

		connectedCallback() {
			if (this.dataset.initialized === "true") {
				this.renderList();
				return;
			}

			this.dataset.initialized = "true";
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.addEventListener("click", () => {
					this.filter = button.dataset.invoiceFilter ?? "all";
					this.renderList();
				});
			}
			this.renderList();
		}

		renderList() {
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.setAttribute(
					"aria-pressed",
					String((button.dataset.invoiceFilter ?? "all") === this.filter),
				);
			}

			for (const row of this.querySelectorAll<HTMLElement>(
				"[data-invoice-item]",
			)) {
				row.hidden =
					this.filter !== "all" && row.dataset.category !== this.filter;
			}
		}
	}

	customElements.define("invoice-table", InvoiceTable);
</script>
