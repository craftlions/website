---
import { buildPhaseComponents } from "../lib/phase-billing";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import CostSplit from "./CostSplit.astro";

interface Invoice {
	component: string | null;
	invoiceNumber: string;
	stripePaymentPage: string;
	invoicedAt: Date;
	stripeStatus: string | null;
	stripePaidAt: Date | null;
	stripeDueAt: Date | null;
	total: number;
	currency: string;
	phase: {
		publicId: string;
		title: string;
		cost: number;
		upfrontAmount: number | null;
		deliveryAmount: number | null;
		acceptanceAmount: number | null;
		currency: string;
		state:
			| "submitted"
			| "planned"
			| "approved"
			| "in_progress"
			| "delivered"
			| "accepted"
			| "cancelled";
		deliveryState: "url" | "none" | "not_recorded";
		deliveryUrl: string | null;
		project: {
			publicId: string;
			name: string;
		} | null;
		invoices: { component: string | null; stripeStatus: string | null }[];
	} | null;
}

interface Props {
	invoices: Invoice[];
	slug: string;
}

const { invoices, slug } = Astro.props;
const now = new Date();
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });
const formatAmount = (total: number, currency: string) =>
	new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(total);
const rows = invoices.map((invoice) => ({
	...invoice,
	status:
		invoice.stripeStatus === "open" &&
		invoice.stripeDueAt &&
		invoice.stripeDueAt < now
			? "overdue"
			: invoice.stripeStatus,
	components: invoice.phase
		? buildPhaseComponents({
				upfrontAmount: invoice.phase.upfrontAmount,
				deliveryAmount: invoice.phase.deliveryAmount,
				acceptanceAmount: invoice.phase.acceptanceAmount,
				state: invoice.phase.state,
				invoices: invoice.phase.invoices,
			})
		: [],
}));
const totalWhere = (statuses: string[]) => {
	const sums = new Map<string, number>();
	for (const row of rows) {
		if (!statuses.includes(row.status ?? "")) continue;
		sums.set(row.currency, (sums.get(row.currency) ?? 0) + row.total);
	}
	if (sums.size === 0) return formatAmount(0, rows[0]?.currency ?? "EUR");
	return [...sums]
		.map(([currency, total]) => formatAmount(total, currency))
		.join(" + ");
};
const hasOverdue = rows.some((row) => row.status === "overdue");
const showFilter =
	rows.some((row) => row.status === "open" || row.status === "overdue") &&
	rows.some((row) => row.status === "paid");

// Invoiced totals grouped by cost part show all three types at a glance;
// unattached invoices carry no component and stay a separate bucket.
const totalsByPart = new Map<string, number>();
let unassignedTotal = 0;
let unassignedCurrency = rows[0]?.currency ?? "EUR";
for (const row of rows) {
	if (
		row.component === "upfront" ||
		row.component === "delivery" ||
		row.component === "acceptance"
	) {
		totalsByPart.set(
			row.component,
			(totalsByPart.get(row.component) ?? 0) + row.total,
		);
	} else {
		unassignedTotal += row.total;
		unassignedCurrency = row.currency;
	}
}
const partSummaryCurrency = rows[0]?.currency ?? "EUR";
const partSummaryItems = [...totalsByPart]
	.filter(([, amount]) => amount !== 0)
	.map(([component, amount]) => ({
		component: component as "upfront" | "delivery" | "acceptance",
		amount,
		status: "invoiced" as const,
	}));
const partSummaryTotal = partSummaryItems.reduce(
	(sum, item) => sum + item.amount,
	0,
);
const componentLabel: Record<string, string> = {
	upfront: "Upfront part",
	delivery: "Delivery part",
	acceptance: "Acceptance part",
};
---

<invoice-table class="grid gap-3">
	{rows.length > 0 && (
		<div class="grid gap-3">
			<dl class="grid grid-flow-col justify-start gap-8 text-sm">
				<div class="grid gap-1">
					<dt class="eyebrow">Outstanding</dt>
					<dd class="tabular-nums">{totalWhere(["open", "overdue"])}</dd>
				</div>
				<div class="grid gap-1">
					<dt class="eyebrow">Overdue</dt>
					<dd class:list={["tabular-nums", hasOverdue && "text-fg-danger"]}>
						{totalWhere(["overdue"])}
					</dd>
				</div>
				<div class="grid gap-1">
					<dt class="eyebrow">Paid</dt>
					<dd class="tabular-nums">{totalWhere(["paid"])}</dd>
				</div>
			</dl>
			{partSummaryItems.length > 0 && (
				<div class="grid gap-2 border border-dashed border-line p-3">
					<p class="eyebrow">Invoiced by cost part</p>
					<div class="max-w-md">
						<CostSplit
							items={partSummaryItems}
							currency={partSummaryCurrency}
							total={partSummaryTotal}
							variant="compact"
							showStatus={false}
							caption={
								unassignedTotal > 0
									? `Plus ${formatAmount(unassignedTotal, unassignedCurrency)} unassigned`
									: null
							}
						/>
					</div>
				</div>
			)}
		</div>
	)}
	{showFilter && (
		<nav
			aria-label="Filter invoices"
			class="grid grid-flow-col justify-start gap-2"
		>
			<Button
				type="button"
				class="aria-pressed:border-line-active aria-pressed:bg-panel"
				data-invoice-filter="all"
				aria-pressed="true"
			>
				All
			</Button>
			<Button
				type="button"
				class="aria-pressed:border-line-active aria-pressed:bg-panel"
				data-invoice-filter="open"
				aria-pressed="false"
			>
				Open
			</Button>
			<Button
				type="button"
				class="aria-pressed:border-line-active aria-pressed:bg-panel"
				data-invoice-filter="paid"
				aria-pressed="false"
			>
				Paid
			</Button>
		</nav>
	)}
	{rows.length > 0 ? (
		<ul class="grid gap-3">
			{rows.map((invoice) => (
				<li
					class="grid gap-2 border border-dashed border-line p-4"
					data-invoice-item
					data-category={
						invoice.status === "paid"
							? "paid"
							: invoice.status === "open" || invoice.status === "overdue"
								? "open"
								: "other"
					}
				>
					<div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
						<div class="grid gap-2">
							<div class="grid gap-1">
								<p class="eyebrow leading-none">
									Invoice {invoice.invoiceNumber}
								</p>
								<div class="grid grid-flow-col items-center justify-start gap-2">
									<p class="text-title tabular-nums leading-none">
										{formatAmount(invoice.total, invoice.currency)}
									</p>
									{invoice.component && componentLabel[invoice.component] ? (
										<Badge type="info">
											{componentLabel[invoice.component]}
										</Badge>
									) : (
										<Badge type="gray">Unassigned</Badge>
									)}
								</div>
								{invoice.phase && invoice.components.length > 0 && (
									<div class="mt-1 max-w-sm">
										<CostSplit
											items={invoice.components}
											currency={invoice.phase.currency}
											total={invoice.phase.cost}
											variant="compact"
											highlight={
												invoice.component === "upfront" ||
												invoice.component === "delivery" ||
												invoice.component === "acceptance"
													? invoice.component
													: null
											}
										/>
									</div>
								)}
							</div>
							<dl class="grid gap-x-6 gap-y-3 text-sm leading-snug sm:grid-cols-[minmax(0,1fr)_auto]">
								<div class="grid gap-1">
									<dt class="eyebrow leading-none">Due</dt>
									<dd
										class:list={[
											invoice.status === "overdue" && "text-fg-danger",
										]}
									>
										{invoice.stripeDueAt
											? dateFormatter.format(invoice.stripeDueAt)
											: "—"}
									</dd>
								</div>
								<div class="grid gap-1">
									<dt class="eyebrow leading-none">Status</dt>
									<dd>
										<div class="grid grid-flow-col items-center justify-start gap-2 whitespace-nowrap">
											{invoice.status === "overdue" ? (
												<Badge type="error">Overdue</Badge>
											) : invoice.status === "open" ? (
												<Badge type="info">Open</Badge>
											) : invoice.status === "paid" ? (
												<Badge type="success">Paid</Badge>
											) : invoice.status ? (
												<Badge type="gray">{invoice.status}</Badge>
											) : (
												<span class="text-fg-muted">—</span>
											)}
											{invoice.status === "paid" && invoice.stripePaidAt && (
												<span class="text-xs text-fg-muted">
													{dateFormatter.format(invoice.stripePaidAt)}
												</span>
											)}
										</div>
									</dd>
								</div>
								<div class="grid gap-1">
									<dt class="eyebrow leading-none">Work</dt>
									<dd>
										{invoice.phase?.project ? (
											<a
												href={`/dash/org/${slug}/project/${invoice.phase.project.publicId}#phase-${invoice.phase.publicId}`}
												class="font-medium underline decoration-dashed underline-offset-4"
											>
												{invoice.phase.project.name} · {invoice.phase.title}
											</a>
										) : (
											<span class="text-fg-muted">Unassigned</span>
										)}
									</dd>
								</div>
								<div class="grid gap-1">
									<dt class="eyebrow leading-none">Delivery</dt>
									<dd>
										{invoice.phase?.deliveryState === "url" &&
										invoice.phase.deliveryUrl ? (
											<a
												href={invoice.phase.deliveryUrl}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Open Delivery for ${invoice.phase.project ? invoice.phase.title : "the invoice"}`}
												class="underline decoration-dashed underline-offset-4"
											>
												Open
											</a>
										) : invoice.phase?.deliveryState === "none" ? (
											<span class="text-fg-muted">No delivery</span>
										) : invoice.phase?.deliveryState === "not_recorded" ? (
											<span class="text-fg-muted">Not recorded</span>
										) : (
											<span class="text-fg-muted">Unavailable</span>
										)}
									</dd>
								</div>
							</dl>
						</div>
						<div class="grid justify-start sm:justify-self-end">
							<Button
								href={invoice.stripePaymentPage}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`${invoice.status === "open" || invoice.status === "overdue" ? "Pay" : "Details"} invoice ${invoice.invoiceNumber}`}
							>
								{invoice.status === "open" || invoice.status === "overdue"
									? "Pay"
									: "Details"}
							</Button>
						</div>
					</div>
				</li>
			))}
		</ul>
	) : (
		<p class="border border-dashed border-line bg-transparent p-4 text-sm text-fg-muted">
			No invoices yet.
		</p>
	)}
</invoice-table>

<script>
	class InvoiceTable extends HTMLElement {
		filter = "all";

		connectedCallback() {
			if (this.dataset.initialized === "true") {
				this.renderList();
				return;
			}

			this.dataset.initialized = "true";
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.addEventListener("click", () => {
					this.filter = button.dataset.invoiceFilter ?? "all";
					this.renderList();
				});
			}
			this.renderList();
		}

		renderList() {
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.setAttribute(
					"aria-pressed",
					String((button.dataset.invoiceFilter ?? "all") === this.filter),
				);
			}

			for (const row of this.querySelectorAll<HTMLElement>(
				"[data-invoice-item]",
			)) {
				row.hidden =
					this.filter !== "all" && row.dataset.category !== this.filter;
			}
		}
	}

	customElements.define("invoice-table", InvoiceTable);
</script>
