---
import Button from "./Button.astro";

// Shows and hides the typed text of the password inputs whose ids `controls`
// lists, separated by spaces. The label stays the same and aria-pressed carries
// the state, so a screen reader never hears "Hide password, pressed".
interface Props {
	controls: string;
}

const { controls } = Astro.props;
---

<password-toggle class="contents">
	<Button variant="quiet" aria-pressed="false" aria-controls={controls}>
		<slot>Show password</slot>
	</Button>
</password-toggle>

<script>
	class PasswordToggle extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const button = this.querySelector("button");

			if (!button) return;

			const show = (shown: boolean) => {
				button.setAttribute("aria-pressed", String(shown));
				for (const id of button.getAttribute("aria-controls")?.split(" ") ??
					[]) {
					const input = document.getElementById(id);
					if (input instanceof HTMLInputElement) {
						input.type = shown ? "text" : "password";
					}
				}
			};

			button.addEventListener("click", () =>
				show(button.getAttribute("aria-pressed") !== "true"),
			);
			// Submitted as text, the password could land in the browser's form history.
			button.form?.addEventListener("submit", () => show(false));
		}
	}

	if (!customElements.get("password-toggle")) {
		customElements.define("password-toggle", PasswordToggle);
	}
</script>
