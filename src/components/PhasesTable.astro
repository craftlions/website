---
import type { phaseSelectType } from "../lib/schema";
import { actions } from "astro:actions";
import Badge from "./Badge.astro";
import Button from "./Button.astro";

interface Phase {
	publicId: phaseSelectType["publicId"];
	title: phaseSelectType["title"];
	dueAt: phaseSelectType["dueAt"];
	cost: phaseSelectType["cost"];
	currency: phaseSelectType["currency"];
	state: phaseSelectType["state"];
	version: phaseSelectType["version"];
	externalUrl: phaseSelectType["externalUrl"];
	deliveryState: phaseSelectType["deliveryState"];
	deliveryUrl: phaseSelectType["deliveryUrl"];
}

interface Props {
	phases: Phase[];
	canApprovePhases?: boolean;
}

const { canApprovePhases = false, phases } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });

const phaseStateToBadgeType = (phaseState: phaseSelectType["state"]) => {
	switch (phaseState) {
		case "submitted":
		case "planned":
		case "approved":
		case "in_progress":
		case "invoiced":
			return "info";
		case "paid":
			return "success";
		case "cancelled":
			return "error";
		default:
			return "info";
	}
};
---

<div class="grid gap-3">
	{phases.length > 0 ? (
			<div class="overflow-x-auto border border-dashed border-neutral-300 bg-transparent dark:border-neutral-700">
				<table class="w-full min-w-2xl border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-dashed border-neutral-300 text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								Title
							</th>
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								Due Date
							</th>
							<th
								scope="col"
								class="px-4 py-3 text-right text-xs font-semibold uppercase"
							>
								Cost
							</th>
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								State
							</th>
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								Epic
							</th>
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								Delivery
							</th>
							<th scope="col" class="px-4 py-3 text-xs font-semibold uppercase">
								Actions
							</th>
						</tr>
					</thead>
					<tbody>
						{phases.map((phase) => (
							<tr id={`phase-${phase.publicId}`} class="border-b border-dashed border-neutral-300 last:border-b-0 scroll-mt-20 hover:bg-neutral-100/70 dark:border-neutral-700 dark:hover:bg-neutral-900/70">
								<td class="px-4 py-4 font-medium text-neutral-900 dark:text-neutral-100">
									{phase.title}
								</td>
								<td class="whitespace-nowrap px-4 py-4 text-neutral-700 dark:text-neutral-300">
									{phase.dueAt
										? dateFormatter.format(phase.dueAt)
										: "Not scheduled"}
								</td>
								<td class="whitespace-nowrap px-4 py-4 text-right tabular-nums text-neutral-700 dark:text-neutral-300">
									{new Intl.NumberFormat("de-DE", {
										style: "currency",
										currency: phase.currency,
									}).format(phase.cost)}
								</td>
								<td class="px-4 py-4">
									<Badge type={phaseStateToBadgeType(phase.state)}>
										{phase.state.replaceAll("_", " ")}
									</Badge>
								</td>
							<td class="px-4 py-4">
								{phase.externalUrl && (
									<Button
										href={phase.externalUrl}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Open Epic for ${phase.title}`}
									>
										Epic
									</Button>
								)}
							</td>
							<td class="px-4 py-4">
								{phase.deliveryState === "url" && phase.deliveryUrl ? (
									<Button
										href={phase.deliveryUrl}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Open Delivery for ${phase.title}`}
									>
										Open
									</Button>
								) : phase.deliveryState === "none" ? (
									<span class="text-neutral-600 dark:text-neutral-400">No delivery</span>
								) : (
									<span class="text-neutral-500 dark:text-neutral-400">Not recorded</span>
								)}
							</td>
							<td class="px-4 py-4">
								{canApprovePhases && phase.state === "planned" && (
									<div class="grid grid-flow-col justify-start gap-2">
										<form method="POST" action={actions.approvePhase} data-disable-on-submit>
											<input
												type="hidden"
												name="phaseId"
												value={phase.publicId}
											/>
											<input type="hidden" name="expectedVersion" value={phase.version} />
											<Button type="submit">Approve</Button>
										</form>
										<form method="POST" action={actions.declinePhase} data-disable-on-submit>
											<input
												type="hidden"
												name="phaseId"
												value={phase.publicId}
											/>
											<input type="hidden" name="expectedVersion" value={phase.version} />
											<Button type="submit">Decline</Button>
										</form>
									</div>
								)}
							</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p class="border border-dashed border-neutral-300 bg-transparent p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">
				No phases have been added yet.
			</p>
	)}
</div>

<script>
	// Exact phase evidence target: a client phase link points at the stable
	// `phase-<publicId>` fragment on this project page. Bring the exact row into
	// view and mark it targeted with a background tint plus a non-color outline
	// cue, persisting in light and dark mode without motion. The tint survives
	// hover because the neutral hover fill is swapped off the targeted row. Runs
	// on landing and on every fragment change, clearing the previous target.
	const highlightClasses = [
		"outline-2",
		"outline-dashed",
		"outline-sky-500/70",
		"bg-sky-100/60",
		"hover:bg-sky-100/60",
		"dark:outline-sky-400/70",
		"dark:bg-sky-950/50",
		"dark:hover:bg-sky-950/50",
	];
	const neutralHoverClasses = [
		"hover:bg-neutral-100/70",
		"dark:hover:bg-neutral-900/70",
	];
	let currentTarget: HTMLTableRowElement | null = null;

	const applyPhaseTarget = () => {
		if (currentTarget instanceof HTMLTableRowElement) {
			currentTarget.classList.remove(...highlightClasses);
			currentTarget.classList.add(...neutralHoverClasses);
			currentTarget = null;
		}

		const phaseFragment = location.hash.slice(1);
		if (!phaseFragment) return;

		const target = document.getElementById(phaseFragment);
		if (target instanceof HTMLTableRowElement) {
			target.classList.remove(...neutralHoverClasses);
			target.classList.add(...highlightClasses);
			currentTarget = target;
		}
	};

	applyPhaseTarget();
	window.addEventListener("hashchange", applyPhaseTarget);
</script>

<script>
	document.addEventListener("submit", (event) => {
		if (
			!(event.target instanceof HTMLFormElement) ||
			!event.target.checkValidity()
		) {
			return;
		}

		for (const button of event.target.querySelectorAll<HTMLButtonElement>(
			'button[type="submit"]',
		)) {
			button.disabled = true;
		}
	});
</script>
