---
import Button from "./Button.astro";
import LogoutButton from "./LogoutButton.astro";

interface Props {
	organizationSlug?: string | undefined;
	pathname: string;
}

const { organizationSlug, pathname } = Astro.props;
const dashboard = organizationSlug ? `/dash/org/${organizationSlug}` : "/dash";
const current = (href: string, section = href) =>
	pathname === href
		? "page"
		: pathname.startsWith(`${section}/`)
			? "true"
			: undefined;

const session =
	Astro.locals.session === undefined
		? await Astro.locals.auth.api.getSession({
				headers: Astro.request.headers,
			})
		: Astro.locals.session;
---

{session ? (
	<>
		<li>
			<ul class="cluster">
				<li>
					<Button href={dashboard} aria-current={current(dashboard, "/dash")}>
						Dashboard
					</Button>
				</li>
				{session.user.role === "admin" && (
					<li>
						<Button href="/admin" aria-current={current("/admin")}>
							Admin
						</Button>
					</li>
				)}
			</ul>
		</li>
		{Astro.locals.session && (
			<li>
				{/* fallback: CommandPalette's script opens the palette where invoker commands are missing. */}
				<Button
					command="show-modal"
					commandfor="command-palette"
					aria-haspopup="dialog"
					aria-controls="command-palette"
					aria-keyshortcuts="Control+K Meta+K"
					data-command-palette-open
				>
					Search
				</Button>
			</li>
		)}
		<li>
			<ul class="cluster" data-space="xs">
				<li>
					<Button
						href="/settings/profile"
						variant="quiet"
						aria-current={current("/settings/profile", "/settings")}
					>
						Account
					</Button>
				</li>
				{!session.session.impersonatedBy && (
					<li>
						<LogoutButton />
					</li>
				)}
			</ul>
		</li>
	</>
) : (
	<li>
		<Button href="/login" aria-current={current("/login")}>
			Login
		</Button>
	</li>
)}
