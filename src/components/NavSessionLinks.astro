---
import Button from "./Button.astro";
import LogoutButton from "./LogoutButton.astro";

interface Props {
	organizationSlug?: string | undefined;
	// Passed in because a deferred island sees its own URL, not the page's.
	pathname: string;
}

const { pathname } = Astro.props;
const current = (path: string) =>
	pathname === path || pathname.startsWith(`${path}/`) ? "page" : undefined;

const session =
	Astro.locals.session === undefined
		? await Astro.locals.auth.api.getSession({
				headers: Astro.request.headers,
			})
		: Astro.locals.session;
---

<li>
	<ul class="grid grid-flow-col auto-cols-max items-center gap-2">
		{session ? (
			<>
				<li>
					<Button href="/dash" aria-current={current("/dash")}>
						Dashboard
					</Button>
				</li>
				<li>
					<Button
						href="/settings/profile"
						aria-current={current("/settings/profile")}
					>
						Profile
					</Button>
				</li>
				<li>
					<Button href="/settings/api" aria-current={current("/settings/api")}>
						API Keys
					</Button>
				</li>
				{session.user.role === "admin" && (
					<li>
						<Button href="/admin" aria-current={current("/admin")}>
							Admin
						</Button>
					</li>
				)}
				{!session.session.impersonatedBy && (
					<li>
						<LogoutButton />
					</li>
				)}
			</>
		) : (
			<li>
				<Button href="/login" aria-current={current("/login")}>
					Login
				</Button>
			</li>
		)}
	</ul>
</li>
