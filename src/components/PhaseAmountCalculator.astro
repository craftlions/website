---
interface Props {
	cost: number;
	upfrontAmount?: number | null;
	deliveryAmount?: number | null;
	acceptanceAmount?: number | null;
}

const {
	cost,
	upfrontAmount = null,
	deliveryAmount = null,
	acceptanceAmount = null,
} = Astro.props;
const amounts = [upfrontAmount, deliveryAmount, acceptanceAmount];
const labels = ["Upfront", "Delivery", "Acceptance"];
const formatAmount = (amount: number | null) =>
	amount === null ? "" : amount.toFixed(4).replace(/\.?0+$/, "") || "0";
const percentageFor = (amount: number | null, index: number) => {
	if (cost === 0) {
		return amount !== null &&
			amounts.findIndex((value) => value !== null) === index
			? "100"
			: "0";
	}

	return amount === null
		? "0"
		: ((amount / cost) * 100).toFixed(4).replace(/\.?0+$/, "");
};
---

<fieldset class="grid gap-2" data-phase-amount-fields>
	<legend
		class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
		>Cost split</legend
	>
	<div
		class="grid grid-cols-[minmax(0,1fr)_7rem_minmax(0,1fr)] items-center gap-x-3 gap-y-2 text-sm"
	>
		{labels.map((label, index) => (
			<>
				<label class="contents">
					<span class="font-medium">{label}</span>
					<span class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-1 border border-dashed border-neutral-300 px-3 py-2 transition-colors focus-within:border-neutral-600 dark:border-neutral-700 dark:focus-within:border-neutral-300">
						<input
							class="min-w-0 bg-transparent tabular-nums outline-none"
							data-phase-amount-percent
							min="0"
							max="100"
							step="0.0001"
							type="number"
							value={percentageFor(amounts[index] ?? null, index)}
							inputmode="decimal"
						/>
						<span class="text-neutral-500 dark:text-neutral-400">%</span>
					</span>
				</label>
				<input
					class="min-w-0 bg-transparent text-right tabular-nums text-neutral-600 outline-none dark:text-neutral-400"
					data-phase-amount-value
					name={`${label.toLowerCase()}Amount`}
					readonly
					tabindex="-1"
					value={formatAmount(amounts[index] ?? null)}
					aria-readonly="true"
					aria-label={`${label} amount`}
				/>
			</>
		))}
		<span
			class="border-t border-dashed border-neutral-300 pt-2 text-xs font-medium uppercase text-neutral-500 dark:border-neutral-700 dark:text-neutral-400"
			>Total</span
		>
		<p
			class="col-span-2 border-t border-dashed border-neutral-300 pt-2 text-right text-xs tabular-nums text-neutral-600 dark:border-neutral-700 dark:text-neutral-400"
			data-phase-amount-total
			role="status"
		></p>
	</div>
	<p
		class="text-sm text-red-700 dark:text-red-300"
		data-phase-amount-error
		role="alert"
		hidden
	></p>
</fieldset>
