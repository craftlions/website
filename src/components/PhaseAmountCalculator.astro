---
// Cost split editor for a phase form. Upfront and Delivery are entered as
// percentages; Acceptance is always the remainder, so editing one part never
// changes another part the admin typed. The enclosing form supplies the cost
// (a `cost` field, else the `cost` prop) and the currency (a `currency` field,
// else the `currency` prop), and receives the three amounts as hidden fields.
interface Props {
	cost: number;
	currency: string;
	upfrontAmount?: number | null;
	deliveryAmount?: number | null;
	acceptanceAmount?: number | null;
	class?: string | undefined;
}

const {
	cost,
	currency,
	upfrontAmount = null,
	deliveryAmount = null,
	acceptanceAmount = null,
	class: className,
} = Astro.props;
const id = `split-${crypto.randomUUID()}`;
const formatAmount = (amount: number | null) =>
	amount === null ? "" : amount.toFixed(4).replace(/\.?0+$/, "") || "0";
// A zero-cost phase has no ratio; its first stored part then carries 100%.
const firstStoredPart = [
	upfrontAmount,
	deliveryAmount,
	acceptanceAmount,
].findIndex((amount) => amount !== null);
// Shares in ten-thousandths of a percent, rounded cumulatively: Delivery
// shows the rounded Upfront+Delivery share minus the rounded Upfront share,
// so the two shown shares never add up to more than 100% (rounding each on
// its own can turn 66.6667 + 133.3333 of 200 into 33.3334% + 66.6667%).
const [upfrontShare = 0, upfrontDeliveryShare = 0] = [
	upfrontAmount ?? 0,
	(upfrontAmount ?? 0) + (deliveryAmount ?? 0),
].map((amount, index) =>
	cost === 0
		? firstStoredPart !== -1 && firstStoredPart <= index
			? 1_000_000
			: 0
		: Math.round((amount / cost) * 1_000_000),
);
const parts = [
	{ key: "upfront", label: "Upfront", when: "billed on approval" },
	{ key: "delivery", label: "Delivery", when: "billed on delivery" },
] as const;
const percentages = [
	upfrontShare / 10_000,
	(upfrontDeliveryShare - upfrontShare) / 10_000,
];
---

<phase-amount-calculator
	class:list={["grid gap-3", className]}
	data-cost={cost}
	data-currency={currency}
>
	<fieldset class="grid gap-3" aria-describedby={`${id}-rule`}>
		<legend class="label-caps">Cost split</legend>
		<p id={`${id}-rule`} class="max-w-prose text-sm text-fg-muted">
			Set the shares billed upfront and on delivery; Acceptance always takes the
			remainder, so the default of 0% and 0% bills the whole cost on acceptance.
		</p>
		{parts.map((part, index) => (
			<div class="grid grid-cols-[minmax(0,1fr)_7rem] items-center gap-x-3 gap-y-0.5">
				<label for={`${id}-${part.key}`} class="text-sm wrap-break-word">
					<span class="text-label">{part.label}</span>{" "}
					<span class="text-fg-muted">{part.when}</span>
				</label>
				<span class="row-span-2 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-1 border border-dashed border-line-control px-3 py-2 text-sm transition-colors focus-within:border-line-active">
					<input
						id={`${id}-${part.key}`}
						class="min-w-0 bg-transparent tabular-nums"
						data-split-percent
						min="0"
						max="100"
						step="any"
						type="number"
						inputmode="decimal"
						value={percentages[index]}
					/>
					<span class="text-fg-muted">%</span>
				</span>
				<output
					for={`${id}-${part.key}`}
					class="text-xs tabular-nums text-fg-muted wrap-break-word"
					data-split-amount-output
				></output>
			</div>
		))}
		<div
			class="grid grid-cols-[minmax(0,1fr)_7rem] items-center gap-x-3 gap-y-0.5"
		>
			<p class="text-sm wrap-break-word">
				<span class="text-label">Acceptance</span>{" "}
				<span class="text-fg-muted">billed on acceptance · remainder</span>
			</p>
			<output
				class="row-span-2 border border-dashed border-line-control px-3 py-2 text-sm tabular-nums text-fg-muted"
				aria-label="Acceptance share, calculated"
				data-split-remainder
			></output>
			<output
				class="text-xs tabular-nums text-fg-muted wrap-break-word"
				data-split-amount-output
			></output>
		</div>
		<div class="grid">
			<p
				class="border-t border-dashed border-line pt-2 text-sm tabular-nums text-fg-muted wrap-break-word"
				data-split-total
				role="status"
			></p>
			<p
				class="text-sm text-fg-danger not-empty:mt-3"
				data-split-error
				role="alert"
			></p>
		</div>
	</fieldset>
	<input
		type="hidden"
		name="upfrontAmount"
		value={formatAmount(upfrontAmount)}
		data-split-amount
	>
	<input
		type="hidden"
		name="deliveryAmount"
		value={formatAmount(deliveryAmount)}
		data-split-amount
	>
	<input
		type="hidden"
		name="acceptanceAmount"
		value={formatAmount(acceptanceAmount)}
		data-split-amount
	>
</phase-amount-calculator>

<script>
	import { formatMoney, formatShare } from "../lib/format.ts";

	// Amounts are kept in ten-thousandths, the precision the server stores, so
	// the three parts always add up to the cost exactly. The currency is an
	// ISO code from the phase or the add-phase form's currency select.
	const units = (value: number) => Math.round(value * 10_000);
	const formatAmount = (amountUnits: number) =>
		(amountUnits / 10_000).toFixed(4).replace(/\.?0+$/, "") || "0";

	class PhaseAmountCalculator extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const form = this.closest("form");
			const percentInputs = [
				...this.querySelectorAll<HTMLInputElement>("[data-split-percent]"),
			];
			const amountInputs = [
				...this.querySelectorAll<HTMLInputElement>("[data-split-amount]"),
			];
			const amountOutputs = [
				...this.querySelectorAll<HTMLOutputElement>(
					"[data-split-amount-output]",
				),
			];
			const remainder = this.querySelector("[data-split-remainder]");
			const total = this.querySelector("[data-split-total]");
			const error = this.querySelector<HTMLElement>("[data-split-error]");
			const costField = form?.elements.namedItem("cost");
			const currencyField = form?.elements.namedItem("currency");

			if (!form || !remainder || !total || !error) return;

			// Until the admin edits a share or the cost, the parts are the amounts
			// the server rendered (a stored or submitted split, which adds up to the
			// cost), so an untouched form posts them unchanged. The shown shares are
			// rounded, and recomputing from them could move a part by a unit.
			let edited = false;

			const sync = () => {
				const cost =
					costField instanceof HTMLInputElement
						? Number(costField.value)
						: Number(this.dataset.cost);
				const costUnits = Number.isFinite(cost) && cost > 0 ? units(cost) : 0;
				const currency =
					currencyField instanceof HTMLSelectElement ||
					currencyField instanceof HTMLInputElement
						? currencyField.value.toUpperCase()
						: (this.dataset.currency ?? "EUR");
				const entered = percentInputs.map((input) =>
					input.value === "" ? 0 : Number(input.value),
				);
				const enteredSum = entered.reduce((sum, value) => sum + value, 0);
				const partInvalid = entered.some(
					(value) => !Number.isFinite(value) || value < 0 || value > 100,
				);
				const valid =
					!edited || (!partInvalid && units(enteredSum) <= units(100));
				const percentages = [
					...entered,
					Math.max(0, units(100 - enteredSum) / 10_000),
				];

				// Each part rounds to the stored precision; the last part with a
				// share takes what is left so the parts sum to the cost.
				const lastPart = percentages.findLastIndex((value) => value > 0);
				let assigned = 0;
				const partUnits = edited
					? percentages.map((percentage, index) => {
							if (percentage <= 0) return null;
							const amount =
								index === lastPart
									? costUnits - assigned
									: Math.round((costUnits * percentage) / 100);
							assigned += amount;
							return amount;
						})
					: amountInputs.map((input) =>
							input.value === "" ? null : units(Number(input.value)),
						);

				if (edited) {
					for (const [index, input] of amountInputs.entries()) {
						const amount = partUnits[index];
						input.value = valid && amount != null ? formatAmount(amount) : "";
					}
				}
				for (const [index, output] of amountOutputs.entries()) {
					const amount = partUnits[index];
					output.value = !valid
						? "—"
						: amount == null
							? "Not billed"
							: formatMoney(amount / 10_000, currency);
				}
				for (const input of percentInputs) {
					input.setAttribute("aria-invalid", String(!valid));
				}

				remainder.textContent = valid ? formatShare(percentages[2] ?? 0) : "—";
				total.textContent = valid
					? `Total 100% · ${formatMoney(costUnits / 10_000, currency)}`
					: `Upfront and Delivery: ${formatShare(enteredSum)}`;
				error.textContent = valid
					? ""
					: partInvalid
						? "Each share must be between 0% and 100%."
						: "Upfront and Delivery together cannot exceed 100%.";

				for (const button of form.querySelectorAll<HTMLButtonElement>(
					'button[type="submit"]',
				)) {
					button.disabled = !valid;
				}
			};

			form.addEventListener("input", (event) => {
				if (
					event.target === costField ||
					percentInputs.some((input) => input === event.target)
				) {
					edited = true;
				}
				sync();
			});
			sync();
		}
	}

	if (!customElements.get("phase-amount-calculator")) {
		customElements.define("phase-amount-calculator", PhaseAmountCalculator);
	}
</script>
