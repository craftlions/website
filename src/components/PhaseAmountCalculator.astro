---
interface Props {
	cost: number;
	upfrontAmount?: number | null;
	deliveryAmount?: number | null;
	acceptanceAmount?: number | null;
}

const {
	cost,
	upfrontAmount = null,
	deliveryAmount = null,
	acceptanceAmount = null,
} = Astro.props;
const amounts = [upfrontAmount, deliveryAmount, acceptanceAmount];
const labels = ["Upfront", "Delivery", "Acceptance"];
const formatAmount = (amount: number | null) =>
	amount === null ? "" : amount.toFixed(4).replace(/\.?0+$/, "") || "0";
const percentageFor = (amount: number | null, index: number) => {
	if (cost === 0) {
		return amount !== null &&
			amounts.findIndex((value) => value !== null) === index
			? "100"
			: "0";
	}

	return amount === null
		? "0"
		: ((amount / cost) * 100).toFixed(4).replace(/\.?0+$/, "");
};
---

<fieldset class="grid gap-3" data-phase-amount-fields>
	<legend class="text-sm font-semibold">Cost split</legend>
	<p class="text-sm text-neutral-600 dark:text-neutral-400">
		Set percentages totalling 100%. The amounts are calculated from the phase
		cost and stored.
	</p>
	<div class="grid gap-3 sm:grid-cols-3">
		{labels.map((label, index) => (
			<div class="grid gap-2">
				<label class="grid gap-1 text-sm">
					<span class="font-medium">{label} %</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						data-phase-amount-percent
						min="0"
						max="100"
						step="0.0001"
						type="number"
						value={percentageFor(amounts[index] ?? null, index)}
						inputmode="decimal"
					/>
				</label>
				<label class="grid gap-1 text-sm">
					<span class="font-medium">{label} amount</span>
					<input
						class="border border-dashed border-neutral-300 bg-neutral-100 px-3 py-2 text-sm tabular-nums outline-none dark:border-neutral-700 dark:bg-neutral-900"
						data-phase-amount-value
						name={`${label.toLowerCase()}Amount`}
						readonly
						value={formatAmount(amounts[index] ?? null)}
						aria-readonly="true"
					/>
				</label>
			</div>
		))}
	</div>
	<p
		class="text-sm tabular-nums text-neutral-600 dark:text-neutral-400"
		data-phase-amount-total
		role="status"
	></p>
	<p
		class="text-sm text-red-700 dark:text-red-300"
		data-phase-amount-error
		role="alert"
		hidden
	></p>
</fieldset>
