---
import InvoiceTable from "./InvoiceTable.astro";

interface Props {
	id: string;
	slug: string;
}

const { id, slug } = Astro.props;

const invoices = await Astro.locals.db.query.invoices.findMany({
	columns: {
		invoiceNumber: true,
		stripePaymentPage: true,
		stripeStatus: true,
		stripePaidAt: true,
		stripeDueAt: true,
		total: true,
		currency: true,
		invoicedAt: true,
	},
	// S-003 R2: an attached invoice derives its project, phase, and Delivery
	// from its one phase — nothing is copied onto the invoice row.
	with: {
		phase: {
			columns: {
				publicId: true,
				title: true,
				deliveryState: true,
				deliveryUrl: true,
			},
			with: {
				project: {
					columns: {
						publicId: true,
						name: true,
					},
				},
			},
		},
	},
	where: {
		phase: { projectId: id },
	},
	orderBy: { invoicedAt: "desc" },
});
---

<InvoiceTable invoices={invoices} slug={slug} />
