---
import LogoWithTextVertical from "../assets/logoWithTextVertical.svg";

interface Props {
	wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer
	class:list={[
		"mx-auto grid w-full gap-5 border-t border-dashed border-neutral-300 px-3 py-6 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-start lg:grid-cols-[auto_minmax(0,1fr)_auto]",
		wide ? "max-w-6xl" : "max-w-3xl",
	]}
>
	<a href="/" aria-label="craftlions home" class="grid justify-self-start">
		<LogoWithTextVertical class="w-16 text-neutral-900 dark:text-neutral-100" />
	</a>
	<div class="grid max-w-prose gap-2">
		<p>
			Small, focused technical work for teams that value clarity,
			maintainability, and durable software decisions.
		</p>
		<p class="text-xs text-neutral-500 dark:text-neutral-400">
			Craftlions helps teams ship technical work with less noise and clearer
			handoffs.
		</p>
	</div>
	<nav
		aria-label="Footer"
		class="grid justify-self-start lg:justify-self-end lg:self-start"
	>
		<ul class="grid gap-1">
			<li><a href="mailto:alexander@craftlions.com">Contact</a></li>
			<li><a href="https://github.com/craftlions">GitHub</a></li>
			<li>
				<a href="https://www.linkedin.com/company/craftlions">LinkedIn</a>
			</li>
			<li><a href="/changelog">Changelog</a></li>
			<li><a href="/imprint">Imprint</a></li>
		</ul>
	</nav>
	<p
		class="border-t border-dashed border-neutral-300 pt-4 text-xs text-neutral-500 dark:border-neutral-700 dark:text-neutral-400 sm:col-span-2 lg:col-span-3"
	>
		&copy; 2026 Craftlions. All rights reserved.
	</p>
</footer>
