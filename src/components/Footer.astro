---
import LogoWithTextVertical from "../assets/logoWithTextVertical.svg";
import { email, summary, tagline } from "../lib/company.ts";

interface Props {
	wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer
	class="center stack footer text-sm text-fg-muted"
	data-width={wide ? "wide" : undefined}
>
	<div class="switcher" style="--switcher-threshold: 36rem">
		<a href="/" aria-label="craftlions home">
			<LogoWithTextVertical class="text-fg" />
		</a>
		<div class="stack" data-space="2xs">
			<p class="measure">{tagline}</p>
			<p class="measure text-xs text-fg-muted">{summary}</p>
		</div>
		<nav aria-label="Footer">
			<ul class="stack" data-space="3xs">
				<li
					><a href={`mailto:${email}`} class="link hover-text-fg"
						>Contact</a
					></li
				>
				<li>
					<a href="https://github.com/craftlions" class="link hover-text-fg"
						>GitHub</a
					>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/company/craftlions"
						class="link hover-text-fg"
						>LinkedIn</a
					>
				</li>
				<li><a href="/changelog/" class="link hover-text-fg">Changelog</a></li>
				<li><a href="/imprint/" class="link hover-text-fg">Imprint</a></li>
			</ul>
		</nav>
	</div>
	<p class="text-xs text-fg-muted">
		&copy; 2026 craftlions. All rights reserved.
	</p>
</footer>
