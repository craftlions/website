---
import LogoWithTextVertical from "../assets/logoWithTextVertical.svg";

interface Props {
	wide?: boolean;
}

const { wide = false } = Astro.props;
---

<footer
	class="footer text-sm text-fg-muted"
	data-width={wide ? "wide" : undefined}
>
	<a href="/" aria-label="craftlions home">
		<LogoWithTextVertical class="text-fg" />
	</a>
	<div class="stack" data-space="2xs">
		<p>
			Small, focused technical work for teams that value clarity,
			maintainability, and durable software decisions.
		</p>
		<p class="text-xs text-fg-muted">
			craftlions helps teams ship technical work with less noise and clearer
			handoffs.
		</p>
	</div>
	<nav aria-label="Footer">
		<ul class="stack" data-space="3xs">
			<li
				><a href="mailto:alexander@craftlions.com" class="link">Contact</a></li
			>
			<li><a href="https://github.com/craftlions" class="link">GitHub</a></li>
			<li>
				<a href="https://www.linkedin.com/company/craftlions" class="link"
					>LinkedIn</a
				>
			</li>
			<li><a href="/changelog/" class="link">Changelog</a></li>
			<li><a href="/imprint/" class="link">Imprint</a></li>
		</ul>
	</nav>
	<p class="text-xs text-fg-muted">
		&copy; 2026 craftlions. All rights reserved.
	</p>
</footer>
