---
import Button from "./Button.astro";
import Input from "./Input.astro";

// The command palette: Ctrl+K (Cmd+K on a Mac) or the nav's Search button
// opens a modal combobox over /api/search. Results are links; nothing is
// executed from here. Shell renders it only for a signed-in session, and
// /brand/specimen for the tests.
const idleStatus =
	"Type to search. Filters: open, paid, overdue, 2025, >1000 EUR.";
---

<command-palette data-idle-status={idleStatus}>
	{/* A click on the backdrop closes it, as Esc does; the script's fallback
	   does it where closedby is missing. */}
	<dialog
		id="command-palette"
		aria-label="Search"
		closedby="any"
		class="box text-fg"
	>
		<search>
			<Input
				type="text"
				role="combobox"
				aria-label="Search"
				aria-expanded="false"
				aria-controls="command-palette-results"
				aria-autocomplete="list"
				aria-describedby="command-palette-status"
				autocomplete="off"
				spellcheck="false"
				enterkeyhint="go"
				maxlength={200}
				placeholder={Astro.locals.session?.user.role === "admin"
					? "Clients, projects, phases, invoices…"
					: "Projects, phases, invoices…"}
				autofocus
			/>
			<Button
				variant="quiet"
				command="close"
				commandfor="command-palette"
				data-command-palette-close
			>
				Close
			</Button>
		</search>
		<p id="command-palette-status" role="status" class="text-sm text-fg-muted">
			{idleStatus}
		</p>
		<div
			id="command-palette-results"
			role="listbox"
			aria-label="Results"
			class="stack"
			data-space="xs"
		></div>
	</dialog>
</command-palette>

<script>
	import type { SearchResponse } from "../lib/search-query.ts";

	// Ctrl+K stays the line-kill key in macOS text fields.
	const isMac = /Mac|iPhone|iPad/.test(navigator.platform);

	class CommandPalette extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const dialog = this.querySelector("dialog");
			const input = this.querySelector<HTMLInputElement>("[role=combobox]");
			const status = this.querySelector<HTMLElement>("[role=status]");
			const listbox = this.querySelector<HTMLElement>("[role=listbox]");

			if (!dialog || !input || !status || !listbox) return;

			const idleStatus = this.dataset.idleStatus ?? "";
			let opener: HTMLElement | null = null;
			let controller: AbortController | undefined;
			let debounce: ReturnType<typeof setTimeout> | undefined;
			let busy: ReturnType<typeof setTimeout> | undefined;
			let retry: ReturnType<typeof setTimeout> | undefined;
			// The query the list shows and the one in flight. While they differ
			// from the field, Enter waits for the field's results (`onResults`).
			let shown: string | undefined;
			let requested: string | undefined;
			let onResults: ((first: HTMLAnchorElement) => void) | undefined;

			const options = () => [
				...listbox.querySelectorAll<HTMLAnchorElement>("[role=option]"),
			];
			const active = () =>
				listbox.querySelector<HTMLAnchorElement>("[aria-selected=true]");

			const activate = (
				option: HTMLAnchorElement | undefined,
				scroll = true,
			) => {
				for (const other of options()) {
					other.setAttribute("aria-selected", String(other === option));
				}
				if (option) {
					input.setAttribute("aria-activedescendant", option.id);
					if (scroll) option.scrollIntoView({ block: "nearest" });
				} else {
					input.removeAttribute("aria-activedescendant");
				}
			};

			const option = (
				id: number,
				label: string,
				sublabel: string,
				href: string,
			) => {
				const link = document.createElement("a");
				link.id = `command-palette-option-${id}`;
				link.href = href;
				link.tabIndex = -1;
				link.setAttribute("role", "option");
				link.setAttribute("aria-selected", "false");
				// Hovering a result must not load its page: some page loads change
				// state, such as the active organization.
				link.setAttribute("data-astro-prefetch", "false");
				link.className = "text-sm";
				const primary = document.createElement("span");
				primary.className = "text-fg wrap-break-word";
				primary.textContent = label;
				const secondary = document.createElement("span");
				secondary.className =
					"text-xs text-fg-muted tabular-nums wrap-break-word";
				secondary.textContent = sublabel;
				link.replaceChildren(...(sublabel ? [primary, secondary] : [primary]));
				return link;
			};

			// Labels hold client data, so options are built as text, never as HTML.
			const render = (groups: SearchResponse["groups"]) => {
				let id = 0;
				listbox.replaceChildren(
					...groups.map((group) => {
						const element = document.createElement("div");
						element.setAttribute("role", "group");
						element.setAttribute(
							"aria-labelledby",
							`command-palette-group-${group.id}`,
						);
						const heading = document.createElement("p");
						heading.id = `command-palette-group-${group.id}`;
						heading.setAttribute("role", "presentation");
						heading.className = "label-caps";
						heading.textContent = group.label;
						element.replaceChildren(
							heading,
							...group.items.map((item) =>
								option(id++, item.label, item.sublabel, item.href),
							),
						);
						return element;
					}),
				);
				input.setAttribute("aria-expanded", String(id > 0));
				activate(options()[0]);
			};

			const settle = () => {
				clearTimeout(busy);
				listbox.removeAttribute("aria-busy");
			};

			const search = async (query: string, retried = false) => {
				controller?.abort();
				clearTimeout(retry);
				controller = new AbortController();
				const { signal } = controller;
				requested = query;
				clearTimeout(busy);
				busy = setTimeout(() => {
					status.textContent = "Searching…";
					listbox.setAttribute("aria-busy", "true");
				}, 300);

				try {
					const response = await fetch(
						`/api/search?q=${encodeURIComponent(query)}`,
						{ signal, headers: { Accept: "application/json" } },
					);
					settle();

					if (response.status === 401) {
						listbox.replaceChildren(
							option(
								0,
								"Sign in",
								"",
								`/login?returnTo=${encodeURIComponent(location.pathname)}`,
							),
						);
						input.setAttribute("aria-expanded", "true");
						activate(options()[0]);
						status.textContent = "Your session ended. Sign in again.";
						landed(query);
						return;
					}

					if (response.status === 429) {
						onResults = undefined;
						status.textContent = "Too many searches. Wait a few seconds.";
						if (!retried) {
							const seconds = Number(response.headers.get("Retry-After")) || 10;
							retry = setTimeout(() => {
								if (dialog.open && input.value.trim() === query) {
									search(query, true);
								}
							}, seconds * 1000);
						}
						return;
					}

					if (!response.ok)
						throw new Error(`Search answered ${response.status}`);

					const data: SearchResponse = await response.json();
					// A slower answer to an earlier query must not replace a newer one.
					if (data.query !== input.value.trim()) return;

					render(data.groups);
					const shown = data.groups.reduce((sum, g) => sum + g.items.length, 0);
					const total = data.groups.reduce((sum, g) => sum + g.total, 0);
					const count = `${shown < total ? `${shown} of ${total}` : shown} ${total === 1 ? "result" : "results"}.`;
					status.textContent =
						data.query === ""
							? idleStatus
							: shown === 0
								? `No results for “${data.query}”.`
								: data.filters.length > 0
									? `${data.filters.join(" · ")} — ${count}`
									: count;
					landed(data.query);
				} catch {
					if (signal.aborted) return;
					settle();
					onResults = undefined;
					status.textContent = "Search failed. Keep typing to try again.";
				} finally {
					if (controller?.signal === signal) requested = undefined;
				}
			};

			// The list now shows `query`; an Enter that waited for it is answered.
			const landed = (query: string) => {
				shown = query;
				const first = options()[0];
				const then = onResults;
				onResults = undefined;
				if (then && first) then(first);
			};

			// Opening lists the first results and remembers where focus returns.
			const open = (from: Element | null) => {
				opener = from instanceof HTMLElement ? from : null;
				search("");
			};

			// The trigger's invoker command opens the dialog and names the trigger.
			dialog.addEventListener("command", (event) => {
				if (event instanceof CommandEvent && event.command === "show-modal") {
					open(event.source);
				}
			});

			dialog.addEventListener("close", () => {
				// The event is queued: a quick reopen may already have searched.
				if (dialog.open) return;
				controller?.abort();
				clearTimeout(debounce);
				clearTimeout(retry);
				settle();
				input.value = "";
				shown = undefined;
				onResults = undefined;
				listbox.replaceChildren();
				input.setAttribute("aria-expanded", "false");
				input.removeAttribute("aria-activedescendant");
				status.textContent = idleStatus;
				// Safari does not focus a clicked button, so focus would not return.
				if (opener?.isConnected) opener.focus();
			});

			// The old results stay visible, but none of them is chosen any more.
			input.addEventListener("input", () => {
				activate(undefined);
				onResults = undefined;
				clearTimeout(debounce);
				debounce = setTimeout(() => search(input.value.trim()), 150);
			});

			// Closing first empties the list, so the link is followed by hand.
			const follow = (link: HTMLAnchorElement) => {
				const href = link.href;
				dialog.close();
				location.assign(href);
			};

			input.addEventListener("keydown", (event) => {
				if (event.isComposing) return;
				const all = options();
				const current = active();
				const index = current ? all.indexOf(current) : -1;

				if (event.key === "ArrowDown" || event.key === "ArrowUp") {
					if (all.length === 0) return;
					event.preventDefault();
					const step = event.key === "ArrowDown" ? 1 : -1;
					activate(all[(index + step + all.length) % all.length]);
				} else if (event.key === "PageDown" || event.key === "PageUp") {
					const groups = [...listbox.querySelectorAll("[role=group]")];
					if (groups.length === 0) return;
					event.preventDefault();
					const group = current?.closest("[role=group]");
					const at = group ? groups.indexOf(group) : -1;
					const step = event.key === "PageDown" ? 1 : -1;
					const target = groups[(at + step + groups.length) % groups.length];
					activate(
						target?.querySelector<HTMLAnchorElement>("[role=option]") ??
							undefined,
					);
				} else if (event.key === "Enter") {
					const newTab = isMac ? event.metaKey : event.ctrlKey;
					const go = (link: HTMLAnchorElement) => {
						if (newTab) {
							window.open(link.href, "_blank", "noopener");
						} else {
							follow(link);
						}
					};
					const query = input.value.trim();
					if (shown === query) {
						if (!current) return;
						event.preventDefault();
						go(current);
						return;
					}
					// The list is older than the field: take the first result of
					// the field's own search, starting it now unless it is in flight.
					event.preventDefault();
					onResults = go;
					if (requested !== query) {
						clearTimeout(debounce);
						search(query);
					}
				}
			});

			listbox.addEventListener("pointermove", (event) => {
				const link =
					event.target instanceof Element
						? event.target.closest<HTMLAnchorElement>("[role=option]")
						: null;
				if (link && link !== active()) activate(link, false);
			});

			listbox.addEventListener("click", (event) => {
				const link =
					event.target instanceof Element
						? event.target.closest<HTMLAnchorElement>("[role=option]")
						: null;
				// A modified click opens a tab or window and keeps the palette open.
				if (
					!link ||
					event.button !== 0 ||
					event.ctrlKey ||
					event.metaKey ||
					event.shiftKey ||
					event.altKey
				) {
					return;
				}
				event.preventDefault();
				follow(link);
			});

			// fallback: browsers without closedby close it on the backdrop here.
			// Its events land on the dialog, outside its box. The press must be
			// there too: a text selection dragged out of the field onto the
			// backdrop also ends in a click on the dialog.
			if (!("closedBy" in HTMLDialogElement.prototype)) {
				const outside = (event: PointerEvent) => {
					const box = dialog.getBoundingClientRect();
					return (
						event.clientX < box.left ||
						event.clientX > box.right ||
						event.clientY < box.top ||
						event.clientY > box.bottom
					);
				};
				let pressedOutside = false;
				dialog.addEventListener("pointerdown", (event) => {
					pressedOutside = outside(event);
				});
				dialog.addEventListener("pointerup", (event) => {
					if (pressedOutside && outside(event)) dialog.close();
				});
			}

			// fallback: browsers without invoker commands open and close it here.
			if (!("commandForElement" in HTMLButtonElement.prototype)) {
				document.addEventListener("click", (event) => {
					if (!(event.target instanceof Element)) return;
					const trigger = event.target.closest("[data-command-palette-open]");
					if (trigger) {
						open(trigger);
						dialog.showModal();
					} else if (event.target.closest("[data-command-palette-close]")) {
						dialog.close();
					}
				});
			}

			// Invoker commands answer only a button, so the shortcut stays here.
			document.addEventListener("keydown", (event) => {
				if (
					event.isComposing ||
					event.altKey ||
					event.shiftKey ||
					event.key.toLowerCase() !== "k" ||
					!(isMac ? event.metaKey : event.ctrlKey)
				) {
					return;
				}
				// Another open dialog, such as a confirmation, keeps the keyboard.
				if (!dialog.open && document.querySelector("dialog[open]")) return;
				event.preventDefault();
				if (dialog.open) {
					dialog.close();
				} else {
					open(document.activeElement);
					dialog.showModal();
				}
			});
		}
	}

	if (!customElements.get("command-palette")) {
		customElements.define("command-palette", CommandPalette);
	}
</script>

<style>
	@layer components {
		/* The search field, its status line
		   and the results, which scroll inside the modal. */
		command-palette {
			/* The base dialog, at the wide dialog width. */
			& dialog {
				max-inline-size: min(var(--dialog-wide), 100% - 2rem);
				max-block-size: min(36rem, 100dvh - 4rem);
				grid-template-rows: auto auto minmax(0, 1fr);
				gap: var(--space-xs);
			}

			& search {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				align-items: center;
				gap: var(--space-2xs);
			}
			/* The combobox is an Input, a component of its own. */
			& :global([role="combobox"]) {
				inline-size: 100%;
			}

			& [role="listbox"] {
				min-block-size: 0;
				overflow-y: auto;
				overscroll-behavior: contain;
			}
			/* Groups and options are built by the script, so these rules select
			   them by role, outside the component's scope. */
			& :global([role="group"]) {
				display: grid;

				& > :global([role="presentation"]) {
					padding: var(--space-3xs) var(--space-xs);
				}
			}
			& :global([role="option"]) {
				display: grid;
				gap: var(--space-3xs);
				padding: var(--space-2xs) var(--space-xs);

				&[aria-selected="true"] {
					outline-width: 1px;
					outline-style: dashed;
					outline-offset: -1px;
					background-color: var(--panel);
				}
			}
		}
	}
</style>
