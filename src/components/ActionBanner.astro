---
import type { BannerMessage } from "../lib/action-feedback.ts";
import { isInputError, type SafeResult } from "astro:actions";

interface Props {
	// Each entry pairs an action's result with the message shown when it
	// succeeded: `[result, "Text"]`, `[result, { text, link }]`, or
	// `successMessage(result, (data) => …)` to build it from the returned data.
	results?:
		| (readonly [
				result: SafeResult<Record<string, unknown>, unknown> | undefined,
				success: BannerMessage,
		  ])[]
		| undefined;
	fieldLabels?: Record<string, string> | undefined;
}

const { results = [], fieldLabels = {} } = Astro.props;
const error = results.find(([result]) => result?.error)?.[0]?.error;
const message = results.find(([result]) => result && !result.error)?.[1];

if (error?.code === "INTERNAL_SERVER_ERROR") {
	console.error(error);
}
---

{isInputError(error) ? (
	<div
		role="alert"
		class="grid gap-2 border border-dashed border-line-danger p-3 text-sm text-fg-danger"
	>
		<p>Check these fields and try again.</p>
		<ul class="grid list-disc gap-1 pl-5">
			{error.issues.map((issue) => (
				<li>
					{[fieldLabels[String(issue.path[0] ?? "")], issue.message]
						.filter(Boolean)
						.join(": ")}
				</li>
			))}
		</ul>
	</div>
) : error ? (
	<p
		role="alert"
		class="border border-dashed border-line-danger p-3 text-sm text-fg-danger"
	>
		{error.code === "INTERNAL_SERVER_ERROR" || !error.message
			? "The action failed because of a server error. Try again."
			: error.message}
	</p>
) : (
	message && (
		<p
			role="status"
			class="border border-dashed border-line-success p-3 text-sm text-fg-success wrap-break-word"
		>
			{typeof message === "string" ? (
				message
			) : (
				<>
					{message.text}
					{message.link && (
						<>
							{" "}
							<a href={message.link.href} class="link">
								{message.link.label}
							</a>
						</>
					)}
				</>
			)}
		</p>
	)
)}
