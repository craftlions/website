---
import { actions } from "astro:actions";
import { fileFacts, fileKind } from "../lib/files.ts";
import ConfirmAction from "./ConfirmAction.astro";

type Props = {
	files: {
		id: string;
		publicId: string;
		filename: string;
		contentType: string;
		size: number;
	}[];
	deleteFrom?: { organizationId: string; organizationName: string };
} & ({ base: string; preview?: never } | { base?: never; preview: true });

const { files, base, deleteFrom, preview } = Astro.props;
---

<ul class="file-cards auto-grid">
	{files.map((file) => (
		<li class="file-card box stack" data-space="2xs" id={file.publicId}>
			<p class="label-caps text-fg-muted">
				{fileKind(file.filename, file.contentType)}
			</p>
			<a
				class="link text-label wrap-anywhere"
				href={preview ? `#${file.publicId}` : `${base}/${file.publicId}`}
			>
				{file.filename}
			</a>
			<p class="text-xs text-fg-muted">{fileFacts(file)}</p>
			{deleteFrom && (
				<form
					{...(preview
						? { method: "dialog" }
						: { method: "POST", action: actions.deleteFile })}
				>
					<input
						type="hidden"
						name="organizationId"
						value={deleteFrom.organizationId}
					/>
					<input type="hidden" name="filePublicId" value={file.publicId} />
					<ConfirmAction
						id={`delete-file-${file.publicId}`}
						trigger="Delete"
						triggerLabel={`Delete ${file.filename}`}
						triggerVariant="quiet"
						title={`Delete ${file.filename}?`}
						confirm="Delete file"
						cancel="Keep file"
					>
						{`${deleteFrom.organizationName} can no longer open ${file.filename}, and links to it stop working. This cannot be undone.`}
					</ConfirmAction>
				</form>
			)}
		</li>
	))}
</ul>

<style>
	@layer components {
		.file-cards {
			--grid-min: 13rem;
		}

		.file-card {
			grid-template-rows: auto 1fr auto;
			align-content: start;

			&:has(form) {
				grid-template-rows: auto 1fr auto auto;
			}
		}
	}
</style>
