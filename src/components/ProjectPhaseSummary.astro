---
import { type PhaseState, phaseStateSummary } from "../lib/status.ts";

interface Props {
	phases: ReadonlyArray<{ state: PhaseState }>;
	class?: string | undefined;
}

const { phases, class: className } = Astro.props;
const counted = phases.filter((phase) => phase.state !== "cancelled");
const yourMove = phaseStateSummary(phases, "info");
const waitingOnClient = phaseStateSummary(phases, "gray");
---

<dl
	class:list={["cluster text-sm", className]}
	data-space="metrics"
	data-align="baseline"
>
	<div>
		<dt class="label-caps">Phases</dt>
		<dd class="tabular-nums wrap-break-word">
			{counted.length > 0
				? `${counted.filter((phase) => phase.state === "accepted").length} of ${counted.length} accepted`
				: phases.length > 0
					? `${phases.length} cancelled`
					: "None yet"}
		</dd>
	</div>
	{yourMove && (
		<div>
			<dt class="label-caps">Your move</dt>
			<dd class="wrap-break-word text-fg-info">{yourMove}</dd>
		</div>
	)}
	{waitingOnClient && (
		<div>
			<dt class="label-caps">Waiting on client</dt>
			<dd class="wrap-break-word">{waitingOnClient}</dd>
		</div>
	)}
</dl>
