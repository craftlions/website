---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
	href?: string;
	rel?: string;
	target?: string;
	variant?: "default" | "danger" | "quiet" | "hint";
}

const {
	type = "button",
	class: className,
	href,
	variant = "default",
	...attrs
} = Astro.props;

const buttonClass = [
	"cursor-pointer transition-colors disabled:cursor-not-allowed disabled:opacity-50",
	{
		default:
			"inline-grid w-max grid-flow-col items-center justify-center gap-2 border border-dashed border-line bg-transparent px-3 py-1 text-label text-fg not-disabled:hover:border-line-active not-disabled:hover:bg-panel aria-pressed:border-line-active aria-pressed:bg-panel aria-[current=page]:border-line-active aria-[current=page]:bg-panel aria-[current=true]:border-line-active aria-[current=true]:bg-panel",
		danger:
			"inline-grid w-max grid-flow-col items-center justify-center gap-2 border border-dashed border-line-danger bg-transparent px-3 py-1 text-label text-fg-danger not-disabled:hover:border-fill-danger not-disabled:hover:bg-panel",
		quiet:
			"w-max text-sm text-fg-muted link not-disabled:hover:text-fg aria-pressed:text-fg aria-pressed:decoration-solid aria-[current=page]:text-fg aria-[current=page]:decoration-solid aria-[current=true]:text-fg aria-[current=true]:decoration-solid",
		hint: "grid size-6 place-items-center border border-dashed border-line-control text-xs leading-none text-fg-muted not-disabled:hover:border-line-active not-disabled:hover:text-fg focus-visible:border-line-active focus-visible:text-fg",
	}[variant],
	className,
];
---

{href ? (
	<a href={href} class:list={buttonClass} {...attrs}>
		<slot />
	</a>
) : (
	<button class:list={buttonClass} type={type} {...attrs}>
		<slot />
	</button>
)}
