---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
	href?: string;
	rel?: string;
	target?: string;
	variant?: "default" | "danger" | "quiet" | "hint";
}

const {
	type = "button",
	class: className,
	href,
	variant = "default",
	...attrs
} = Astro.props;

const buttonClass = [
	"button",
	{
		default: "text-label",
		danger: "text-label",
		quiet: "text-sm link",
		hint: "text-xs leading-none",
	}[variant],
	className,
];
---

{href ? (
	<a href={href} class:list={buttonClass} data-variant={variant} {...attrs}>
		<slot />
	</a>
) : (
	<button
		class:list={buttonClass}
		data-variant={variant}
		type={type}
		{...attrs}
	>
		<slot />
	</button>
)}
