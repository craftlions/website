---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
	href?: string;
	rel?: string;
	target?: string;
	variant?: "default" | "danger" | "quiet" | "hint";
}

const {
	type = "button",
	class: className,
	href,
	variant = "default",
	...attrs
} = Astro.props;

const buttonClass = [
	"button",
	{
		default: "text-label",
		danger: "text-label",
		quiet: "text-sm link",
		hint: "text-xs leading-none",
	}[variant],
	className,
];
---

{href ? (
	<a href={href} class:list={buttonClass} data-variant={variant} {...attrs}>
		<slot />
	</a>
) : (
	<button
		class:list={buttonClass}
		data-variant={variant}
		type={type}
		{...attrs}
	>
		<slot />
	</button>
)}

<style>
	@layer components {
		.button {
			cursor: pointer;
			transition-property:
				color, background-color, border-color, outline-color,
				text-decoration-color, fill, stroke;
			transition-duration: var(--duration);
			transition-timing-function: var(--ease);

			&:disabled {
				cursor: not-allowed;
				opacity: 0.5;
			}
		}

		.button:is([data-variant="default"], [data-variant="danger"]) {
			display: inline-grid;
			inline-size: max-content;
			grid-auto-flow: column;
			align-items: center;
			justify-content: center;
			gap: var(--space-2xs);
			padding: var(--space-3xs) var(--space-xs);
			border: var(--rule) var(--line);
			background-color: transparent;
			color: var(--fg);
		}

		.button[data-variant="default"] {
			@media (hover: hover) {
				&:not(:disabled):hover {
					border-color: var(--line-active);
					background-color: var(--panel);
				}
			}

			&:is(
					[aria-pressed="true"],
					[aria-current="page"],
					[aria-current="true"]
				) {
				border-color: var(--line-active);
				background-color: var(--panel);
			}
		}

		.button[data-variant="danger"] {
			border-color: var(--line-danger);
			color: var(--fg-danger);

			@media (hover: hover) {
				&:not(:disabled):hover {
					border-color: var(--fill-danger);
					background-color: var(--panel);
				}
			}
		}

		.button[data-variant="quiet"] {
			inline-size: max-content;
			color: var(--fg-muted);

			@media (hover: hover) {
				&:not(:disabled):hover {
					color: var(--fg);
				}
			}

			&:is(
					[aria-pressed="true"],
					[aria-current="page"],
					[aria-current="true"]
				) {
				color: var(--fg);
				text-decoration-style: solid;
			}
		}

		.button[data-variant="hint"] {
			display: grid;
			inline-size: 1.5rem;
			block-size: 1.5rem;
			place-items: center;
			border: var(--rule) var(--line-control);
			color: var(--fg-muted);

			@media (hover: hover) {
				&:not(:disabled):hover {
					border-color: var(--line-active);
					color: var(--fg);
				}
			}

			&:focus-visible {
				border-color: var(--line-active);
				color: var(--fg);
			}
		}
	}
</style>
