---
import type { WorklistItem } from "../lib/admin-worklist.ts";
import { actions } from "astro:actions";
import { formatMoney } from "../lib/format.ts";
import {
	componentBillingStatus,
	type InvoiceComponent,
} from "../lib/phase-billing.ts";
import {
	costPartLabel,
	type PhaseState,
	phaseTransitionsFrom,
	recordDeliveryLabel,
} from "../lib/status.ts";
import { submittedValues } from "../lib/submitted-values.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import DeliveryForm from "./DeliveryForm.astro";
import DisclosureButton from "./DisclosureButton.astro";
import PhaseTransitionForm from "./PhaseTransitionForm.astro";

type WorklistProject = {
	publicId: string;
	name: string;
	phases: ReadonlyArray<{
		id: string;
		publicId: string;
		title: string;
		state: PhaseState;
		version: number;
		cost: number;
		currency: string;
		upfrontAmount: number | null;
		invoices: ReadonlyArray<{
			id: string;
			component: InvoiceComponent;
			stripe: {
				id: string;
				number: string;
				status: string;
				currency: string;
				total: number;
				dueAt: Date | null;
				invoicedAt: Date | null;
			} | null;
		}>;
	}>;
};

interface Props {
	// From `deriveWorklist`; items that carry their organization show the
	// client's name, for the cross-client list on /admin.
	items: ReadonlyArray<
		WorklistItem<WorklistProject> & {
			organization?: { id: string; name: string };
		}
	>;
	// Shows at most this many items, the admin's moves first.
	limit?: number | undefined;
	// The full worklist, linked below a limited list.
	allHref?: string | undefined;
	// Prefix for element ids; unique per page.
	id?: string;
}

const { items, limit, allHref, id = "worklist" } = Astro.props;

// A failed delivery reopens the delivery form of the phase it was submitted
// for, since the page reloads.
const deliveryResult = Astro.getActionResult(actions.recordDelivery);
const failedDeliveryPhaseId = submittedValues(
	Astro.locals,
	deliveryResult,
)?.get("phaseId");
const ordered = [
	...items.filter((item) => item.actor === "admin"),
	...items.filter((item) => item.actor === "client"),
];
const visible = ordered.slice(0, limit ?? ordered.length);
const groups = [
	{
		id: `${id}-your-move`,
		label: "Your move",
		total: items.filter((item) => item.actor === "admin").length,
		items: visible.filter((item) => item.actor === "admin"),
		empty: "Nothing for you to do: every open item waits on the client.",
	},
	{
		id: `${id}-waiting`,
		label: "Waiting on client",
		total: items.filter((item) => item.actor === "client").length,
		items: visible.filter((item) => item.actor === "client"),
		empty: "Nothing waits on the client.",
	},
];
---

{items.length > 0 ? (
	<div class="grid border border-dashed border-line lg:grid-cols-[auto_minmax(0,1fr)_auto_auto_auto] lg:gap-x-6">
		<div
			aria-hidden="true"
			class="hidden border-b border-dashed border-line px-4 py-3 label-caps lg:col-span-5 lg:grid lg:grid-cols-subgrid"
		>
			<span>Status</span>
			<span>Item</span>
			<span class="text-right">Amount</span>
			<span>Waiting</span>
			<span class="text-right">Action</span>
		</div>
		{groups
			.filter((group) => group.total === 0 || group.items.length > 0)
			.map((group) => (
				<section
					aria-labelledby={group.id}
					class="grid min-w-0 border-b border-dashed border-line last:border-b-0 lg:col-span-5 lg:grid-cols-subgrid"
				>
					<h3
						id={group.id}
						class="border-b border-dashed border-line px-4 py-2 text-label lg:col-span-5"
					>
						{group.label}{" "}
						<span class="tabular-nums text-fg-muted">· {group.total}</span>
					</h3>
					{group.items.length > 0 ? (
						<ul class="grid min-w-0 lg:col-span-5 lg:grid-cols-subgrid">
							{group.items.map((item) => (
								<li class="grid min-w-0 gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 lg:col-span-5 lg:grid-cols-subgrid lg:items-center">
									<Badge type={item.badge}>{item.label}</Badge>
									<div class="grid min-w-0 gap-1">
										<h4 class="grid gap-1 wrap-break-word">
											{item.organization && (
												<span class="text-sm text-fg-muted">
													{item.organization.name}
												</span>
											)}
											<a href={item.href} class="link">
												{item.project.name} · {item.phase.title}
											</a>
										</h4>
										{item.invoice ? (
											<p class="text-sm text-fg-muted wrap-break-word">
												{costPartLabel[item.invoice.component]} invoice{" "}
												{item.invoice.stripe.number}
											</p>
										) : (
											(item.phase.state === "approved" ||
												item.phase.state === "in_progress" ||
												item.phase.state === "delivered") &&
											Boolean(item.phase.upfrontAmount) &&
											componentBillingStatus({
												component: "upfront",
												state: item.phase.state,
												invoice:
													item.phase.invoices.find(
														(invoice) => invoice.component === "upfront",
													) ?? null,
											}) !== "paid" && (
												<p class="text-sm text-fg-danger">Upfront unpaid</p>
											)
										)}
									</div>
									<p class="tabular-nums lg:text-right">
										<span class="text-sm text-fg-muted lg:sr-only">
											Amount{" "}
										</span>
										{item.invoice
											? formatMoney(
													item.invoice.stripe.total,
													item.invoice.stripe.currency,
												)
											: formatMoney(item.phase.cost, item.phase.currency)}
									</p>
									<p
										class:list={[
											"text-sm tabular-nums",
											item.status === "overdue"
												? "text-fg-danger"
												: "text-fg-muted",
										]}
									>
										{item.status !== "overdue" && (
											<span class="lg:sr-only">Waiting </span>
										)}
										{item.age}
									</p>
									<div class="grid justify-items-start gap-2 lg:justify-items-end">
										{item.invoice ? (
											<Button
												href={`https://dashboard.stripe.com/invoices/${item.invoice.stripe.id}`}
												target="_blank"
												rel="noreferrer"
												aria-label={`Open in Stripe: invoice ${item.invoice.stripe.number} (opens in a new tab)`}
											>
												Open in Stripe
											</Button>
										) : item.phase.state === "in_progress" ? (
											<DisclosureButton
												controls={`${id}-${item.key}-delivery`}
												open={item.phase.id === failedDeliveryPhaseId}
												aria-label={`${recordDeliveryLabel}: ${item.phase.title}`}
											>
												{recordDeliveryLabel}
											</DisclosureButton>
										) : (
											phaseTransitionsFrom(item.phase.state).map(
												(nextState) => (
													<PhaseTransitionForm phase={item.phase} {nextState} />
												),
											)
										)}
									</div>
									{item.phase.state === "in_progress" && !item.invoice && (
										<div
											id={`${id}-${item.key}-delivery`}
											class="grid min-w-0 lg:col-span-5"
											hidden={item.phase.id !== failedDeliveryPhaseId}
										>
											<DeliveryForm
												mode="record"
												phase={item.phase}
												result={deliveryResult}
											/>
										</div>
									)}
								</li>
							))}
						</ul>
					) : (
						<p class="p-4 text-sm text-fg-muted lg:col-span-5">{group.empty}</p>
					)}
				</section>
			))}
	</div>
) : (
	<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
		The worklist is empty: no phase waits on you or the client, and no invoice
		is open.
	</p>
)}
{limit !== undefined && allHref && items.length > limit && (
	<Button href={allHref} variant="quiet">
		Show all {items.length} items
	</Button>
)}
