---
import type { ComponentProps } from "astro/types";
import { isInputError, type SafeResult } from "astro:actions";
import { submittedValues } from "../lib/submitted-values.ts";
import Input from "./Input.astro";

interface Props extends Omit<ComponentProps<typeof Input>, "class"> {
	label: string;
	hint?: string | undefined;
	error?: string | string[] | undefined;
	result?: SafeResult<Record<string, unknown>, unknown> | undefined;
	class?: string | undefined;
}

const {
	label,
	hint,
	error,
	result,
	class: className,
	id = `field-${crypto.randomUUID()}`,
	danger,
	...attrs
} = Astro.props;

// After `result` failed, the field shows what was submitted under its name:
// the text, the selected options, or whether a checkbox or radio was checked.
// An explicit `value` (or `checked`) wins; hidden, file and password fields
// are never restored.
const submitted =
	attrs.name && !["hidden", "file", "password"].includes(String(attrs.type))
		? submittedValues(Astro.locals, result)
		: undefined;
const restored =
	submitted && attrs.name
		? attrs.type === "checkbox" || attrs.type === "radio"
			? {
					checked:
						attrs.checked ??
						submitted.getAll(attrs.name).includes(String(attrs.value ?? "on")),
				}
			: {
					value:
						attrs.value ??
						(attrs.as === "select"
							? submitted.getAll(attrs.name)
							: (submitted.get(attrs.name) ?? undefined)),
				}
		: {};

// An explicit error wins; otherwise the action's input error for this field's name.
const errors = [
	error ??
		(isInputError(result?.error) && attrs.name
			? result.error.fields[attrs.name]
			: undefined),
]
	.flat()
	.filter(Boolean);
---

<div class:list={["stack", className]} data-space="2xs">
	<label for={id} class="text-label text-fg-muted">{label}</label>
	<Input
		{...attrs}
		{...restored}
		{id}
		danger={danger || errors.length > 0}
		aria-invalid={errors.length > 0 ? "true" : undefined}
		aria-describedby={[
			attrs["aria-describedby"],
			hint && `${id}-hint`,
			errors.length > 0 && `${id}-error`,
		]
			.filter(Boolean)
			.join(" ") || undefined}
	>
		<slot />
	</Input>
	{hint && (
		<p id={`${id}-hint`} class="text-sm text-fg-muted">
			{hint}
		</p>
	)}
	{errors.length > 0 && (
		<p id={`${id}-error`} class="text-sm text-fg-danger">
			{errors.join(" ")}
		</p>
	)}
</div>
