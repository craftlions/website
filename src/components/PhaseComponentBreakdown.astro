---
import type { PhaseComponentItem } from "../lib/phase-billing";
import CostSplit from "./CostSplit.astro";

interface Props {
	items: PhaseComponentItem[];
	currency: string;
	total?: number | null;
	variant?: "full" | "compact";
}

const { items, currency, total = null, variant = "full" } = Astro.props;
---

<CostSplit
	items={items}
	currency={currency}
	total={total ?? items.reduce((sum, item) => sum + item.amount, 0)}
	variant={variant}
/>
