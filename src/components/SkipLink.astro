---
import Button from "./Button.astro";
---

{/* The first tab stop of every page: past the header to the main landmark,
   which takes focus (tabindex="-1") in every browser. */}
<Button href="#main" class="skip-link bg-canvas">Skip to content</Button>

<style>
	@layer components {
		/* A Button out of the flow, so the .cover
		   body keeps its gaps. It sits in the page's corner, over the header, while
		   it has focus, and waits above the top edge otherwise. */
		.skip-link {
			position: absolute;
			inset-block-start: var(--space-xs);
			inset-inline-start: var(--space-xs);
			z-index: 60;

			&:not(:focus) {
				translate: 0 calc(-100% - var(--space-xs));
			}
		}
	}
</style>
