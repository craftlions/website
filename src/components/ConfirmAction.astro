---
import Button from "./Button.astro";
import Field from "./Field.astro";

interface Props {
	id: string;
	trigger: string;
	triggerLabel?: string | undefined;
	triggerVariant?: "default" | "danger" | "quiet";
	title: string;
	confirm: string;
	// Danger for destructive or irreversible actions; default for deliberate
	// steps that need a second look but destroy nothing.
	confirmVariant?: "default" | "danger";
	cancel?: string;
	form?: string | undefined;
	name?: string | undefined;
	value?: string | undefined;
	typeToConfirm?:
		| { value: string; name?: string | undefined; label?: string | undefined }
		| undefined;
}

const {
	id,
	trigger,
	triggerLabel,
	triggerVariant = "default",
	title,
	confirm,
	confirmVariant = "danger",
	cancel = "Cancel",
	form,
	name,
	value,
	typeToConfirm,
} = Astro.props;
---

<confirm-action class="grid justify-items-start">
	<Button
		command="show-modal"
		commandfor={id}
		variant={triggerVariant}
		aria-label={triggerLabel}
		aria-haspopup="dialog"
		data-confirm-trigger
	>
		{trigger}
	</Button>
	<dialog
		{id}
		aria-labelledby={`${id}-title`}
		aria-describedby={`${id}-consequence`}
		class="m-auto w-full max-w-[min(28rem,calc(100%-2rem))] grid-cols-[minmax(0,1fr)] gap-4 border border-dashed border-line bg-canvas p-4 text-fg wrap-anywhere open:grid backdrop:bg-canvas/80"
		data-confirm-dialog
	>
		<h2 id={`${id}-title`} class="text-title">{title}</h2>
		<p id={`${id}-consequence`} class="text-sm text-fg-muted">
			<slot />
		</p>
		{typeToConfirm && (
			<Field
				label={typeToConfirm.label ?? `Type ${typeToConfirm.value} to confirm`}
				name={typeToConfirm.name ?? "confirmation"}
				{form}
				required
				danger
				autocomplete="off"
				spellcheck="false"
				pattern={typeToConfirm.value.replace(/[\\^$.*+?()[\]{}|/]/g, "\\$&")}
				title={`Type ${typeToConfirm.value} exactly`}
			/>
		)}
		<div
			class="grid grid-cols-[minmax(0,auto)_minmax(0,auto)] justify-end gap-2"
		>
			<Button
				command="close"
				commandfor={id}
				class="max-w-full"
				data-confirm-cancel
			>
				{cancel}
			</Button>
			<Button
				type="submit"
				variant={confirmVariant}
				class="max-w-full"
				{form}
				{name}
				{value}
				data-confirm-submit
			>
				{confirm}
			</Button>
		</div>
	</dialog>
</confirm-action>

<script>
	class ConfirmAction extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const dialog = this.querySelector("dialog");
			const trigger = this.querySelector<HTMLButtonElement>(
				"[data-confirm-trigger]",
			);
			const submit = this.querySelector<HTMLButtonElement>(
				"[data-confirm-submit]",
			);

			if (!dialog || !trigger || !submit) return;

			// The open dialog makes the rest of the form inert, so the browser could
			// not point at an invalid field behind it: report the first invalid field
			// instead of opening. Fields inside confirmation dialogs are skipped,
			// since they are filled in once their dialog is open. Cancelling the
			// click also cancels the trigger's invoker command.
			trigger.addEventListener("click", (event) => {
				if (event.defaultPrevented) return;

				for (const element of submit.form?.elements ?? []) {
					if (
						(element instanceof HTMLButtonElement ||
							element instanceof HTMLInputElement ||
							element instanceof HTMLSelectElement ||
							element instanceof HTMLTextAreaElement) &&
						!element.closest("[data-confirm-dialog]") &&
						!element.checkValidity()
					) {
						event.preventDefault();
						element.reportValidity();
						return;
					}
				}

				// Browsers without invoker commands open the dialog here.
				if (!("command" in HTMLButtonElement.prototype)) {
					dialog.showModal();
				}
			});

			if (!("command" in HTMLButtonElement.prototype)) {
				this.querySelector("[data-confirm-cancel]")?.addEventListener(
					"click",
					() => dialog.close(),
				);
			}

			// Safari does not focus a clicked button, so focus would not return to it.
			dialog.addEventListener("close", () => trigger.focus());

			// Enter in another field of the form must not confirm past the dialog.
			submit.form?.addEventListener("submit", (event) => {
				if (event.submitter === submit && !dialog.open) {
					event.preventDefault();
					dialog.showModal();
				}
			});
		}
	}

	if (!customElements.get("confirm-action")) {
		customElements.define("confirm-action", ConfirmAction);
	}
</script>
