---
import Button from "./Button.astro";
import Field from "./Field.astro";

interface Props {
	id: string;
	trigger: string;
	triggerLabel?: string | undefined;
	triggerVariant?: "default" | "danger" | "quiet";
	title: string;
	confirm: string;
	confirmVariant?: "default" | "danger";
	cancel?: string;
	typeToConfirm?: string | undefined;
}

const {
	id,
	trigger,
	triggerLabel,
	triggerVariant = "default",
	title,
	confirm,
	confirmVariant = "danger",
	cancel = "Cancel",
	typeToConfirm,
} = Astro.props;
---

<confirm-action>
	<Button
		command="show-modal"
		commandfor={id}
		variant={triggerVariant}
		aria-label={triggerLabel}
		aria-haspopup="dialog"
		data-confirm-trigger
	>
		{trigger}
	</Button>
	<dialog
		{id}
		aria-labelledby={`${id}-title`}
		aria-describedby={`${id}-consequence`}
		class="box text-fg wrap-anywhere"
		data-confirm-dialog
	>
		<h2 id={`${id}-title`} class="text-title">{title}</h2>
		<p id={`${id}-consequence`} class="text-sm text-fg-muted">
			<slot />
		</p>
		{typeToConfirm && (
			<Field
				label={`Type ${typeToConfirm} to confirm`}
				name="confirmation"
				required
				danger
				autocomplete="off"
				spellcheck="false"
				pattern={typeToConfirm.replace(/[\\^$.*+?()[\]{}|/]/g, "\\$&")}
				title={`Type ${typeToConfirm} exactly`}
			/>
		)}
		<div class="cluster" data-justify="end">
			<Button command="close" commandfor={id} autofocus data-confirm-cancel>
				{cancel}
			</Button>
			<Button type="submit" variant={confirmVariant} data-confirm-submit>
				{confirm}
			</Button>
		</div>
	</dialog>
</confirm-action>

<script>
	class ConfirmAction extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const dialog = this.querySelector("dialog");
			const trigger = this.querySelector<HTMLButtonElement>(
				"[data-confirm-trigger]",
			);
			const submit = this.querySelector<HTMLButtonElement>(
				"[data-confirm-submit]",
			);

			if (!dialog || !trigger || !submit) return;

			trigger.addEventListener("click", (event) => {
				if (event.defaultPrevented) return;

				for (const element of submit.form?.elements ?? []) {
					if (
						(element instanceof HTMLButtonElement ||
							element instanceof HTMLInputElement ||
							element instanceof HTMLSelectElement ||
							element instanceof HTMLTextAreaElement) &&
						!element.closest("[data-confirm-dialog]") &&
						!element.checkValidity()
					) {
						event.preventDefault();
						element.reportValidity();
						return;
					}
				}

				// fallback: browsers without invoker commands open the dialog here.
				if (!("commandForElement" in HTMLButtonElement.prototype)) {
					dialog.showModal();
				}
			});

			// fallback: and close it here.
			if (!("commandForElement" in HTMLButtonElement.prototype)) {
				this.querySelector("[data-confirm-cancel]")?.addEventListener(
					"click",
					() => dialog.close(),
				);
			}

			dialog.addEventListener("close", () => trigger.focus());

			submit.form?.addEventListener("submit", (event) => {
				if (event.submitter === submit && !dialog.open) {
					event.preventDefault();
					dialog.showModal();
				}
			});
		}
	}

	if (!customElements.get("confirm-action")) {
		customElements.define("confirm-action", ConfirmAction);
	}
</script>

<style>
	@layer components {
		confirm-action {
			display: grid;
			justify-items: start;

			& dialog {
				grid-template-columns: repeat(1, minmax(0, 1fr));
				gap: var(--space-s);
			}
		}
	}
</style>
