---
import type { ComponentProps } from "astro/types";
import Button from "./Button.astro";

interface Props
	extends Omit<ComponentProps<typeof Button>, "as" | "href" | "type"> {
	controls: string;
	open?: boolean | undefined;
}

const { controls, open = false, class: className, ...attrs } = Astro.props;
---

<Button
	{...attrs}
	class:list={["disclosure", className]}
	aria-expanded={open ? "true" : "false"}
	aria-controls={controls}
	data-disclosure-toggle
>
	<slot />
	<svg aria-hidden="true" viewBox="0 0 12 12">
		<path
			d="M2.5 4.5 6 8l3.5-3.5"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
		/>
	</svg>
</Button>

<script>
	const fields =
		"input:not([type=hidden]):not([disabled]), select:not([disabled]), textarea:not([disabled])";

	const setOpen = (panel: HTMLElement, open: boolean) => {
		for (const toggle of document.querySelectorAll(
			`[data-disclosure-toggle][aria-controls="${CSS.escape(panel.id)}"]`,
		)) {
			toggle.setAttribute("aria-expanded", String(open));
		}
		panel.hidden = !open;
	};

	const openFromHash = () => {
		const panel = document.getElementById(location.hash.slice(1));
		if (
			!panel ||
			!document.querySelector(
				`[data-disclosure-toggle][aria-controls="${CSS.escape(panel.id)}"]`,
			)
		)
			return;
		setOpen(panel, true);
		panel.querySelector<HTMLElement>(fields)?.focus();
	};

	document.addEventListener("click", (event) => {
		if (!(event.target instanceof Element)) return;

		const toggle = event.target.closest<HTMLElement>(
			"[data-disclosure-toggle]",
		);
		if (toggle) {
			const panel = document.getElementById(
				toggle.getAttribute("aria-controls") ?? "",
			);
			if (!panel) return;
			const open = toggle.getAttribute("aria-expanded") !== "true";
			setOpen(panel, open);
			if (open) panel.querySelector<HTMLElement>(fields)?.focus();
			return;
		}

		const cancel = event.target.closest("[data-disclosure-cancel]");
		for (
			let panel = cancel?.parentElement?.closest<HTMLElement>("[id]");
			panel;
			panel = panel.parentElement?.closest<HTMLElement>("[id]")
		) {
			const owner = document.querySelector<HTMLElement>(
				`[data-disclosure-toggle][aria-controls="${CSS.escape(panel.id)}"]`,
			);
			if (!owner) continue;
			for (const form of panel instanceof HTMLFormElement
				? [panel]
				: panel.querySelectorAll("form")) {
				form.reset();
				form.dispatchEvent(new Event("input"));
			}
			setOpen(panel, false);
			owner.focus();
			return;
		}
	});

	openFromHash();
	window.addEventListener("hashchange", openFromHash);
</script>
