---
import Badge from "./Badge.astro";

interface Props {
	date: string;
	datetime: string;
	title: string;
	kind: "New" | "Improved" | "Fixed";
	summary: string;
	points?: string[];
	first?: boolean;
	last?: boolean;
}

const {
	date,
	datetime,
	title,
	kind,
	summary,
	points = [],
	first = false,
	last = false,
} = Astro.props;

const badgeType = {
	New: "info",
	Improved: "gray",
	Fixed: "success",
} as const;

const slug = `${datetime}-${title
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, "-")
	.replace(/^-|-$/g, "")}`;
---

<li class="changelog-entry">
	<div class="rail" aria-hidden="true">
		{!(first && last) && (
			<span
				class="rail-line"
				data-first={first || undefined}
				data-last={last || undefined}
			></span>
		)}
		<span class="rail-dot"></span>
	</div>
	<article id={slug} class="stack box" data-last={last || undefined}>
		<header class="stack" data-space="2xs">
			<div class="cluster" data-justify="between">
				<a href={`#${slug}`} class="link text-fg-muted hover-text-fg">
					<time datetime={datetime} class="text-label">
						{date}
					</time>
				</a>
				<Badge type={badgeType[kind]}>{kind}</Badge>
			</div>
			<h2 class="text-title">{title}</h2>
		</header>
		<p class="text-fg-muted">{summary}</p>
		{points.length > 0 && (
			<ul class="stack text-sm text-fg-muted" data-space="2xs">
				{points.map((point) => (
					<li class="point">
						<span class="bullet bg-line-strong" aria-hidden="true"></span>
						<span>{point}</span>
					</li>
				))}
			</ul>
		)}
	</article>
</li>

<style>
	@layer components {
		/* One entry of the changelog timeline: a rail with a dot beside a dashed
		   plane. The rail's line runs unbroken from the first entry's dot to the last
		   one's, each dot a --space-m below its entry's top. Two fixed tracks that
		   never wrap: a grid, not a with-sidebar. */
		.changelog-entry {
			display: grid;
			grid-template-columns: 1rem minmax(0, 1fr);
			column-gap: var(--space-s);

			& .rail {
				position: relative;
				display: grid;
				justify-items: center;
			}
			& .rail-line {
				position: absolute;
				inset-block: 0;
				inset-inline-start: 50%; /* constant: centred on the rail */
				translate: -50%;
				border: 0 dashed var(--line);
				border-inline-start-width: var(--hairline);

				&[data-first] {
					inset-block-start: var(--space-m);
				}
				&[data-last] {
					inset-block-end: auto;
					block-size: var(--space-m);
				}
			}
			& .rail-dot {
				position: relative;
				z-index: 10;
				inline-size: 0.5rem;
				block-size: 0.5rem;
				margin-block-start: var(--space-m);
				border: var(--hairline) solid var(--line-active);
				background-color: var(--canvas);
			}

			& > article {
				scroll-margin-block-start: var(--space-m);

				&:not([data-last]) {
					margin-block-end: var(--space-m);
				}
			}
			& .point {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr);
				align-items: start;
				gap: var(--space-2xs);
			}
			& .bullet {
				inline-size: 0.25rem;
				block-size: 0.25rem;
				margin-block-start: var(--space-2xs);
			}
		}
	}
</style>
