---
import type { PhaseState } from "../lib/status.ts";
import {
	type ClientWorklistItem,
	clientCostPartLabel,
} from "../lib/client-worklist.ts";
import { formatMoney } from "../lib/format.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import ClientPhaseActions from "./ClientPhaseActions.astro";

type WorklistProject = {
	publicId: string;
	name: string;
	phases: ReadonlyArray<{
		publicId: string;
		title: string;
		state: PhaseState;
		dueAt: Date | null;
		version: number;
		cost: number;
		currency: string;
		upfrontAmount: number | null;
		deliveryAmount: number | null;
		acceptanceAmount: number | null;
	}>;
};

type WorklistInvoice = {
	id: string;
	number: string;
	status: string;
	total: number;
	currency: string;
	dueAt: Date | null;
	paymentPage: string;
	component: string | null;
	phase: {
		publicId: string;
		title: string;
		project: { publicId: string; name: string } | null;
	} | null;
};

interface Props {
	// From `deriveClientWorklist`.
	items: ReadonlyArray<ClientWorklistItem<WorklistProject, WorklistInvoice>>;
	// Whether this member may approve, decline and accept phases.
	canDecide: boolean;
	// Prefix for element ids; unique per page.
	id?: string;
}

const { items, canDecide, id = "worklist" } = Astro.props;

// The client's own group always shows, since "nothing to do" answers their
// first question; craftlions' group shows only when it holds work.
const groups = [
	{
		id: `${id}-your-move`,
		label: "Your move",
		items: items.filter((item) => item.actor === "client"),
		empty:
			"Nothing to do: no phase waits for your decision and no invoice is open.",
	},
	{
		id: `${id}-waiting`,
		label: "Waiting on craftlions",
		items: items.filter((item) => item.actor === "craftlions"),
		empty: null,
	},
].filter((group) => group.empty || group.items.length > 0);
---

{items.length > 0 ? (
	<div class="client-worklist">
		<div aria-hidden="true" class="client-worklist-head label-caps">
			<span>Status</span>
			<span>Item</span>
			<span>Amount</span>
			<span>Due</span>
			<span>Action</span>
		</div>
		{groups.map((group) => (
			<section aria-labelledby={group.id} class="client-worklist-group">
				<h3 id={group.id} class="text-label">
					{group.label}{" "}
					<span class="tabular-nums text-fg-muted">· {group.items.length}</span>
				</h3>
				{group.items.length > 0 ? (
					<ul>
						{group.items.map((item) => (
							<li>
								<Badge type={item.badge}>{item.label}</Badge>
								<div class="client-worklist-subject">
									<h4 class="wrap-anywhere">
										{item.kind === "phase" ? (
											<a href={item.href} class="link">
												{item.project.name} · {item.phase.title}
											</a>
										) : item.href && item.invoice.phase?.project ? (
											<a href={item.href} class="link">
												{item.invoice.phase.project.name} ·{" "}
												{item.invoice.phase.title}
											</a>
										) : (
											`Invoice ${item.invoice.number}`
										)}
									</h4>
									{item.kind === "invoice" && item.href && (
										<p class="text-sm text-fg-muted wrap-anywhere">
											Invoice {item.invoice.number}
											{item.invoice.component &&
												clientCostPartLabel[item.invoice.component] &&
												` · ${clientCostPartLabel[item.invoice.component]}`}
										</p>
									)}
								</div>
								<p class="client-worklist-amount text-sm tabular-nums">
									<span class="text-fg-muted">Amount </span>
									{formatMoney(item.amount, item.currency)}
								</p>
								<p
									class:list={[
										"text-sm tabular-nums",
										item.overdue ? "text-fg-danger" : "text-fg-muted",
									]}
								>
									{item.due}
								</p>
								{item.kind === "invoice" ? (
									<div class="client-worklist-action">
										<Button
											href={item.invoice.paymentPage}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Pay invoice ${item.invoice.number} (opens in a new tab)`}
										>
											Pay invoice
										</Button>
									</div>
								) : item.actor === "client" && canDecide ? (
									<div class="client-worklist-action">
										<ClientPhaseActions
											phase={item.phase}
											name={`${item.project.name} · ${item.phase.title}`}
											{id}
											canApprove
											canAccept
										/>
									</div>
								) : (
									item.actor === "client" && (
										<p class="client-worklist-note text-sm text-fg-muted">
											An owner or admin decides
										</p>
									)
								)}
							</li>
						))}
					</ul>
				) : (
					<p class="client-worklist-empty text-sm text-fg-muted">
						{group.empty}
					</p>
				)}
			</section>
		))}
	</div>
) : (
	<p class="box text-sm text-fg-muted">
		Nothing needs your attention right now. Phases to approve or accept and
		invoices to pay will show up here, along with the work craftlions is doing
		for you.
	</p>
)}
