---
import type { phaseSelectType } from "../lib/schema.ts";
import type { PhaseState } from "../lib/status.ts";
import {
	type ClientWorklistItem,
	clientCostPartLabel,
} from "../lib/client-worklist.ts";
import { formatMoney, sumByCurrency } from "../lib/format.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import ClientPhaseActions from "./ClientPhaseActions.astro";

type WorklistProject = {
	publicId: string;
	name: string;
	phases: ReadonlyArray<{
		publicId: string;
		title: string;
		state: PhaseState;
		dueAt: Date | null;
		version: number;
		cost: number;
		currency: string;
		upfrontAmount: number | null;
		deliveryAmount: number | null;
		acceptanceAmount: number | null;
		externalUrl: phaseSelectType["externalUrl"];
		deliveryState: phaseSelectType["deliveryState"];
		deliveryUrl: phaseSelectType["deliveryUrl"];
	}>;
};

type WorklistInvoice = {
	id: string;
	number: string;
	status: string;
	total: number;
	currency: string;
	dueAt: Date | null;
	paymentPage: string;
	component: string | null;
	phase: {
		publicId: string;
		title: string;
		project: { publicId: string; name: string } | null;
	} | null;
};

interface Props {
	items: ReadonlyArray<ClientWorklistItem<WorklistProject, WorklistInvoice>>;
	canDecide: boolean;
	id?: string;
}

const { items, canDecide, id = "worklist" } = Astro.props;

const groups = [
	{
		key: "your-move",
		label: "Your move",
		items: items.filter((item) => item.actor === "client"),
		empty:
			"Nothing to do: no phase waits for your decision and no invoice is open.",
	},
	{
		key: "craftlions",
		label: "Waiting on craftlions",
		items: items.filter((item) => item.actor === "craftlions"),
		empty: null,
	},
].filter((group) => group.empty || group.items.length > 0);
---

{items.length > 0 ? (
	<div class="lines">
		{groups.map((group) => (
			<>
				<h3>
					<span id={`${id}-${group.key}`} class="text-label">
						{group.label}{" "}
						<span class="text-fg-muted">· {group.items.length}</span>
					</span>
					{group.items.length > 0 && (
						<span class="line-figure text-sm text-fg-muted">
							<span class="sr-only">total </span>
							{sumByCurrency(group.items)}
						</span>
					)}
				</h3>
				{group.items.length > 0 ? (
					<ul aria-labelledby={`${id}-${group.key}`}>
						{group.items.map((item) => (
							<li>
								<div class="line-text">
									<h4>
										{item.kind === "phase" ? (
											<a href={item.href} class="link">
												{item.project.name} · {item.phase.title}
											</a>
										) : item.href && item.invoice.phase?.project ? (
											<a href={item.href} class="link">
												{item.invoice.phase.project.name} ·{" "}
												{item.invoice.phase.title}
											</a>
										) : (
											`Invoice ${item.invoice.number}`
										)}
									</h4>
									<p class="cluster text-sm text-fg-muted">
										<Badge type={item.badge}>{item.label}</Badge>
										{item.kind === "phase" &&
											(item.phase.externalUrl ? (
												<a
													href={item.phase.externalUrl}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Epic: ${item.project.name} · ${item.phase.title} (opens in a new tab)`}
													class="link hover-text-fg"
												>
													Epic
												</a>
											) : (
												<span class="text-fg-warning">Epic missing</span>
											))}
										{item.kind === "phase" &&
											(item.phase.deliveryState === "url" &&
											item.phase.deliveryUrl ? (
												<a
													href={item.phase.deliveryUrl}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Delivery: ${item.project.name} · ${item.phase.title} (opens in a new tab)`}
													class="link hover-text-fg"
												>
													Delivery
												</a>
											) : item.phase.deliveryState === "none" ? (
												<span>No delivery PR/MR</span>
											) : (
												(item.phase.state === "delivered" ||
													item.phase.state === "accepted") && (
													<span class="text-fg-warning">Delivery missing</span>
												)
											))}
										{item.kind === "invoice" && item.href && (
											<span>
												Invoice {item.invoice.number}
												{item.invoice.component &&
													clientCostPartLabel[item.invoice.component] &&
													` · ${clientCostPartLabel[item.invoice.component]}`}
											</span>
										)}
									</p>
								</div>
								<p class="line-figure">
									<span>{formatMoney(item.amount, item.currency)}</span>
									<span
										class:list={[
											"text-sm",
											item.overdue ? "text-fg-danger" : "text-fg-muted",
										]}
									>
										{item.due}
									</span>
								</p>
								{item.kind === "invoice" ? (
									<div class="line-actions cluster">
										<Button
											href={item.invoice.paymentPage}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Pay invoice ${item.invoice.number} (opens in a new tab)`}
										>
											Pay invoice
										</Button>
									</div>
								) : item.actor === "client" && canDecide ? (
									<div class="line-actions cluster">
										<ClientPhaseActions
											phase={item.phase}
											name={`${item.project.name} · ${item.phase.title}`}
											{id}
											canApprove
											canAccept
										/>
									</div>
								) : (
									item.actor === "client" && (
										<div class="line-actions cluster">
											<p class="text-sm text-fg-muted">
												An owner or admin decides
											</p>
										</div>
									)
								)}
							</li>
						))}
					</ul>
				) : (
					<p class="text-sm text-fg-muted">{group.empty}</p>
				)}
			</>
		))}
	</div>
) : (
	<p class="box text-sm text-fg-muted">
		Nothing needs your attention right now. Phases to approve or accept and
		invoices to pay will show up here, along with the work craftlions is doing
		for you.
	</p>
)}
