---
import type { HTMLAttributes } from "astro/types";
import { selectOptions } from "../lib/submitted-values.ts";

interface Props extends HTMLAttributes<"input"> {
	as?: "input" | "select";
	danger?: boolean;
}

const { as = "input", class: className, danger, value, ...attrs } = Astro.props;

const inputClass = ["input text-sm", className];

// A select has no value attribute: a given `value` (one or, for `multiple`,
// several) selects the slot's options whose `value` attribute matches instead.
// Give every option an explicit `value`: an option without one submits its
// text, which is never matched, so after a failed submit (Field restores the
// value) the select falls back to the page's default.
const options =
	as === "select" && value != null
		? selectOptions(
				await Astro.slots.render("default"),
				[value].flat().map(String),
			)
		: undefined;
---

{as === "select" ? (
	<select
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{...attrs}
	>
		{options === undefined ? <slot /> : <Fragment set:html={options} />}
	</select>
) : (
	<input
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{value}
		{...attrs}
	/>
)}
