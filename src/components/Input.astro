---
import type { HTMLAttributes } from "astro/types";
import { selectOptions } from "../lib/submitted-values.ts";

interface Props extends HTMLAttributes<"input"> {
	as?: "input" | "select";
	danger?: boolean;
}

const { as = "input", class: className, danger, value, ...attrs } = Astro.props;

const inputClass = ["input text-sm", className];

// A select has no value attribute: a given `value` (one or, for `multiple`,
// several) selects the slot's options whose `value` attribute matches instead.
// Give every option an explicit `value`: an option without one submits its
// text, which is never matched, so after a failed submit (Field restores the
// value) the select falls back to the page's default.
const options =
	as === "select" && value != null
		? selectOptions(
				await Astro.slots.render("default"),
				[value].flat().map(String),
			)
		: undefined;
---

{as === "select" ? (
	<select
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{...attrs}
	>
		{options === undefined ? <slot /> : <Fragment set:html={options} />}
	</select>
) : (
	<input
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{value}
		{...attrs}
	/>
)}

<style>
	@layer components {
		/* A text input or select on a dashed line that
		   darkens on focus. A danger line marks a destructive confirmation
		   (data-variant="danger") or an invalid value (aria-invalid, which Field
		   sets for a server error and, through its script, while :user-invalid
		   matches). */
		.input {
			padding: var(--space-2xs) var(--space-xs);
			border: var(--rule) var(--line-control);
			background-color: transparent;
			transition-property:
				color, background-color, border-color, outline-color,
				text-decoration-color, fill, stroke;
			transition-duration: var(--duration);
			transition-timing-function: var(--ease);

			&::placeholder {
				color: var(--fg-muted);
			}

			/* A read-only value is shown, not edited: muted like a calculated
			   output, and still focusable and selectable. */
			&:is(input)[readonly] {
				color: var(--fg-muted);
			}

			&:is([data-variant="danger"], [aria-invalid="true"]) {
				border-color: var(--line-danger);
			}

			&:focus {
				border-color: var(--line-active);
			}

			&:disabled {
				cursor: not-allowed;
				opacity: 0.5;
			}
		}
	}
</style>
