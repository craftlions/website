---
import type { HTMLAttributes } from "astro/types";
import { selectOptions } from "../lib/submitted-values.ts";

interface Props extends HTMLAttributes<"input"> {
	as?: "input" | "select";
	danger?: boolean;
}

const { as = "input", class: className, danger, value, ...attrs } = Astro.props;

const inputClass = ["input text-sm", className];

const options =
	as === "select" && value != null
		? selectOptions(
				await Astro.slots.render("default"),
				[value].flat().map(String),
			)
		: undefined;
---

{as === "select" ? (
	<select
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{...attrs}
	>
		{options === undefined ? <slot /> : <Fragment set:html={options} />}
	</select>
) : (
	<input
		class:list={inputClass}
		data-variant={danger ? "danger" : undefined}
		{value}
		{...attrs}
	/>
)}

<style>
	@layer components {
		.input {
			padding: var(--space-2xs) var(--space-xs);
			border: var(--rule) var(--line-control);
			background-color: transparent;
			transition-property:
				color, background-color, border-color, outline-color,
				text-decoration-color, fill, stroke;
			transition-duration: var(--duration);
			transition-timing-function: var(--ease);

			&::placeholder {
				color: var(--fg-muted);
			}

			&:is(input)[readonly] {
				color: var(--fg-muted);
			}

			&:is([data-variant="danger"], [aria-invalid="true"]) {
				border-color: var(--line-danger);
			}

			&:focus {
				border-color: var(--line-active);
			}

			&:disabled {
				cursor: not-allowed;
				opacity: 0.5;
			}
		}
	}
</style>
