---
import type { phaseSelectType } from "../lib/schema";
import { clientPhaseLabel } from "../lib/client-worklist.ts";
import { formatDate, formatMoney, sumByCurrency } from "../lib/format.ts";
import { buildPhaseComponents } from "../lib/phase-billing";
import { invoiceStatus } from "../lib/status.ts";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import ClientPhaseActions from "./ClientPhaseActions.astro";

interface Phase {
	publicId: phaseSelectType["publicId"];
	title: phaseSelectType["title"];
	dueAt: phaseSelectType["dueAt"];
	cost: phaseSelectType["cost"];
	upfrontAmount: phaseSelectType["upfrontAmount"];
	deliveryAmount: phaseSelectType["deliveryAmount"];
	acceptanceAmount: phaseSelectType["acceptanceAmount"];
	currency: phaseSelectType["currency"];
	state: phaseSelectType["state"];
	version: phaseSelectType["version"];
	externalUrl: phaseSelectType["externalUrl"];
	deliveryState: phaseSelectType["deliveryState"];
	deliveryUrl: phaseSelectType["deliveryUrl"];
	invoices: {
		component: string;
		stripe: {
			number: string;
			paymentPage: string;
			status: string;
			paidAt: Date | null;
			dueAt: Date | null;
			total: number;
			currency: string;
		} | null;
	}[];
}

interface Props {
	phases: Phase[];
	canApprovePhases?: boolean;
	canAcceptPhases?: boolean;
}

const {
	canAcceptPhases = false,
	canApprovePhases = false,
	phases,
} = Astro.props;
const now = new Date();
const percentFormatter = new Intl.NumberFormat("de-DE", {
	style: "percent",
	maximumFractionDigits: 1,
});
const billedOn = {
	upfront: "billed on approval",
	delivery: "billed on delivery",
	acceptance: "billed on acceptance",
};

const phaseStateToBadgeType = (phaseState: phaseSelectType["state"]) => {
	switch (phaseState) {
		case "accepted":
			return "success";
		case "cancelled":
			return "error";
		default:
			return "info";
	}
};

// Each cost part has at most one invoice (invoices_phase_component_uidx), so
// a phase's invoices fold into its payment schedule part by part.
const rows = phases.map((phase) => {
	const parts = buildPhaseComponents(phase).map((part) => {
		const invoice = phase.invoices.find(
			(invoice) => invoice.component === part.component,
		);
		return {
			...part,
			invoice: invoice?.stripe && {
				...invoice.stripe,
				status:
					invoice.stripe.status === "open" &&
					invoice.stripe.dueAt &&
					invoice.stripe.dueAt < now
						? "overdue"
						: invoice.stripe.status,
			},
		};
	});
	return {
		...phase,
		parts,
		paidAmount: parts
			.filter((part) => part.status === "paid")
			.reduce((sum, part) => sum + part.amount, 0),
		overdueCount: parts.filter((part) => part.invoice?.status === "overdue")
			.length,
		openCount: parts.filter((part) => part.invoice?.status === "open").length,
	};
});

const invoicesWhere = (statuses: string[]) =>
	rows.flatMap((row) =>
		row.parts.flatMap((part) =>
			part.invoice && statuses.includes(part.invoice.status ?? "")
				? [{ amount: part.invoice.total, currency: part.invoice.currency }]
				: [],
		),
	);
const hasOverdue = rows.some((row) => row.overdueCount > 0);
---

<phase-overview class="stack" data-space="xs">
	{rows.length > 0 ? (
		<>
			<div class="with-sidebar" data-side="end" data-align="center">
				<dl class="cluster text-sm" data-space="metrics" data-align="baseline">
					<div>
						<dt class="label-caps">Est. Cost</dt>
						<dd class="tabular-nums">
							{sumByCurrency(
								rows
									.filter((row) => row.state !== "cancelled")
									.map((row) => ({ amount: row.cost, currency: row.currency })),
								phases[0]?.currency,
							)}
						</dd>
					</div>
					<div>
						<dt class="label-caps">Paid</dt>
						<dd class="tabular-nums">
							{sumByCurrency(invoicesWhere(["paid"]), phases[0]?.currency)}
						</dd>
					</div>
					<div>
						<dt class="label-caps">Outstanding</dt>
						<dd class="tabular-nums">
							{sumByCurrency(
								invoicesWhere(["open", "overdue"]),
								phases[0]?.currency,
							)}
						</dd>
					</div>
					<div>
						<dt class="label-caps">Overdue</dt>
						<dd class:list={["tabular-nums", hasOverdue && "text-fg-danger"]}>
							{sumByCurrency(invoicesWhere(["overdue"]), phases[0]?.currency)}
						</dd>
					</div>
				</dl>
				<nav aria-label="Phase view" class="cluster">
					<Button type="button" data-phase-view="compact" aria-pressed="true">
						Compact
					</Button>
					<Button type="button" data-phase-view="detailed" aria-pressed="false">
						Detailed
					</Button>
				</nav>
			</div>

			<ol class="lines" aria-label="Phases">
				{rows.map((phase) => (
					<li id={`phase-${phase.publicId}`} class="target" data-phase>
						<div class="line-text">
							<h3 data-state={phase.state}>{phase.title}</h3>
							<p class="cluster text-sm text-fg-muted">
								<Badge type={phaseStateToBadgeType(phase.state)}>
									{clientPhaseLabel[phase.state]}
								</Badge>
								<span>
									{phase.dueAt
										? `due ${formatDate(phase.dueAt)}`
										: "not scheduled"}
								</span>
							</p>
						</div>
						<div class="line-figure">
							<span>{formatMoney(phase.cost, phase.currency)}</span>
							{phase.parts.length > 0 && (
								<ol aria-label="Payment progress" class="phase-payments">
									{phase.parts.map((part) => {
										const state =
											part.invoice?.status === "overdue"
												? "overdue"
												: part.status === "paid"
													? "paid"
													: part.invoice
														? "invoiced"
														: "uninvoiced";
										const label = `${part.component} ${part.invoice?.status ?? part.status.replaceAll("_", " ")}`;
										return (
											<li
												data-state={state}
												class:list={[state === "paid" && "forced-ink"]}
											>
												<span class="sr-only">{label}</span>
											</li>
										);
									})}
								</ol>
							)}
							<span
								class:list={[
									"text-sm",
									phase.overdueCount > 0 ? "text-fg-danger" : "text-fg-muted",
								]}
							>
								{phase.overdueCount > 0
									? `${phase.overdueCount} invoice${phase.overdueCount === 1 ? "" : "s"} overdue`
									: phase.openCount > 0
										? `${phase.openCount} invoice${phase.openCount === 1 ? "" : "s"} to pay`
										: phase.parts.length === 0
											? "nothing to bill"
											: phase.parts.every((part) => part.status === "paid")
												? "fully paid"
												: phase.paidAmount > 0
													? `${formatMoney(phase.paidAmount, phase.currency)} paid`
													: "not invoiced yet"}
							</span>
						</div>
						<div class="line-actions cluster">
							<ClientPhaseActions
								{phase}
								id="phase"
								canApprove={canApprovePhases}
								canAccept={canAcceptPhases}
							/>
							<Button
								type="button"
								variant="quiet"
								class="disclosure"
								aria-label={`Details: ${phase.title}`}
								aria-expanded="false"
								aria-controls={`phase-${phase.publicId}-details`}
								data-phase-toggle
							>
								Details
								<svg aria-hidden="true" viewBox="0 0 12 12">
									<path
										d="M2.5 4.5 6 8l3.5-3.5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
									/>
								</svg>
							</Button>
						</div>

						<div
							id={`phase-${phase.publicId}-details`}
							class="line-details stack"
							hidden
						>
							<dl
								class="cluster text-sm"
								data-space="metrics"
								data-align="baseline"
							>
								<div>
									<dt class="label-caps">Epic</dt>
									<dd>
										{phase.externalUrl ? (
											<a
												href={phase.externalUrl}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Open Epic for ${phase.title}`}
												class="link"
											>
												Open
											</a>
										) : (
											<span class="text-fg-muted">None</span>
										)}
									</dd>
								</div>
								<div>
									<dt class="label-caps">Delivery</dt>
									<dd>
										{phase.deliveryState === "url" && phase.deliveryUrl ? (
											<a
												href={phase.deliveryUrl}
												target="_blank"
												rel="noopener noreferrer"
												aria-label={`Open Delivery for ${phase.title}`}
												class="link"
											>
												Open
											</a>
										) : phase.deliveryState === "none" ? (
											<span class="text-fg-muted">No delivery</span>
										) : (
											<span class="text-fg-muted">Not recorded</span>
										)}
									</dd>
								</div>
							</dl>

							<div class="stack" data-space="2xs">
								<h4 id={`phase-${phase.publicId}-schedule`} class="label-caps">
									Payment Schedule
								</h4>
								{phase.parts.length > 0 ? (
									<ol
										class="lines"
										data-actions="below"
										aria-labelledby={`phase-${phase.publicId}-schedule`}
									>
										{phase.parts.map((part) => (
											<li>
												<div class="line-text text-sm">
													<p class="capitalize">
														{part.component}
														{phase.cost > 0 &&
															` · ${percentFormatter.format(part.amount / phase.cost)}`}
													</p>
													<p class="cluster text-fg-muted">
														{part.invoice?.status === "overdue" ? (
															<Badge type="error">Overdue</Badge>
														) : part.invoice?.status === "open" ? (
															<Badge type="info">Open</Badge>
														) : part.invoice?.status === "paid" ? (
															<Badge type="success">Paid</Badge>
														) : part.invoice?.status ? (
															<Badge type="gray">
																{invoiceStatus(part.invoice).label}
															</Badge>
														) : part.invoice ? (
															<Badge type="info">Invoiced</Badge>
														) : part.status === "due" ? (
															<Badge type="gray">Invoice pending</Badge>
														) : (
															<Badge type="gray">Not due</Badge>
														)}
														<span>
															{part.invoice
																? `Invoice ${part.invoice.number} for ${formatMoney(part.invoice.total, part.invoice.currency)}`
																: part.status === "invoiced"
																	? "Invoice unavailable"
																	: "No invoice yet"}
														</span>
														<span>{billedOn[part.component]}</span>
													</p>
												</div>
												<p class="line-figure text-sm">
													<span>
														{formatMoney(part.amount, phase.currency)}
													</span>
													{part.invoice?.status === "paid" &&
													part.invoice.paidAt ? (
														<span class="text-fg-muted">
															paid {formatDate(part.invoice.paidAt)}
														</span>
													) : (
														part.invoice?.dueAt &&
														(part.invoice.status === "open" ||
															part.invoice.status === "overdue") && (
															<span
																class={
																	part.invoice.status === "overdue"
																		? "text-fg-danger"
																		: "text-fg-muted"
																}
															>
																due {formatDate(part.invoice.dueAt)}
															</span>
														)
													)}
												</p>
												{part.invoice && (
													<div class="line-actions cluster">
														<Button
															href={part.invoice.paymentPage}
															target="_blank"
															rel="noopener noreferrer"
															aria-label={`${part.invoice.status === "open" || part.invoice.status === "overdue" ? "Pay" : "View"} invoice ${part.invoice.number}`}
														>
															{part.invoice.status === "open" ||
															part.invoice.status === "overdue"
																? "Pay"
																: "View"}
														</Button>
													</div>
												)}
											</li>
										))}
									</ol>
								) : (
									<p class="text-sm text-fg-muted">
										No chargeable parts ·{" "}
										{formatMoney(phase.cost, phase.currency)}
									</p>
								)}
							</div>
						</div>
					</li>
				))}
			</ol>
		</>
	) : (
		<p class="box text-sm text-fg-muted">No phases have been added yet.</p>
	)}
</phase-overview>

<script>
	// Compact shows one line per phase; Detailed opens every payment schedule.
	// Single phases still toggle on their own, and the chosen view is a
	// per-viewer convenience that survives reloads when storage is available.
	const viewStorageKey = "phase-overview-view";

	// Exact phase evidence target: worklist and invoice links point at the
	// stable `phase-<publicId>` fragment. The targeted phase opens its details
	// and is marked with a background tint plus a non-color outline cue,
	// without motion. Runs on landing and on every fragment change.
	class PhaseOverview extends HTMLElement {
		currentTarget: HTMLElement | null = null;

		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-phase-view]",
			)) {
				button.addEventListener("click", () => {
					const view = button.dataset.phaseView ?? "compact";
					try {
						localStorage.setItem(viewStorageKey, view);
					} catch {}
					this.setView(view);
				});
			}

			for (const toggle of this.querySelectorAll<HTMLButtonElement>(
				"[data-phase-toggle]",
			)) {
				toggle.addEventListener("click", () => {
					this.setExpanded(
						toggle,
						toggle.getAttribute("aria-expanded") !== "true",
					);
				});
			}

			let view = "compact";
			try {
				view = localStorage.getItem(viewStorageKey) ?? "compact";
			} catch {}
			this.setView(view);

			this.applyTarget();
			window.addEventListener("hashchange", () => this.applyTarget());

			// Find in page or a text fragment is about to reveal a closed panel,
			// so its toggle opens with it.
			this.addEventListener("beforematch", (event) => {
				if (!(event.target instanceof HTMLElement)) return;
				const toggle = this.querySelector<HTMLButtonElement>(
					`[data-phase-toggle][aria-controls="${event.target.id}"]`,
				);
				if (toggle) this.setExpanded(toggle, true);
			});
		}

		setExpanded(toggle: HTMLButtonElement, expanded: boolean) {
			toggle.setAttribute("aria-expanded", String(expanded));
			const panel = document.getElementById(
				toggle.getAttribute("aria-controls") ?? "",
			);
			// enhancement: a closed panel stays findable, so find in page and text
			// fragments open it; without beforematch (Safari) it is plainly hidden.
			if (panel) {
				panel.hidden = expanded
					? false
					: "onbeforematch" in HTMLElement.prototype
						? "until-found"
						: true;
			}
		}

		setView(view: string) {
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-phase-view]",
			)) {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.phaseView === view),
				);
			}
			for (const toggle of this.querySelectorAll<HTMLButtonElement>(
				"[data-phase-toggle]",
			)) {
				this.setExpanded(toggle, view === "detailed");
			}
			if (this.currentTarget) this.openTarget(this.currentTarget);
		}

		openTarget(target: HTMLElement) {
			const toggle = target.querySelector<HTMLButtonElement>(
				"[data-phase-toggle]",
			);
			if (toggle) this.setExpanded(toggle, true);
		}

		applyTarget() {
			this.currentTarget?.removeAttribute("data-highlight");
			this.currentTarget = null;

			const target = document.getElementById(location.hash.slice(1));
			if (!(target instanceof HTMLElement) || !this.contains(target)) return;
			if (!target.matches("[data-phase]")) return;

			target.setAttribute("data-highlight", "");
			this.currentTarget = target;
			this.openTarget(target);
		}
	}

	customElements.define("phase-overview", PhaseOverview);
</script>
