---
import type { ComponentProps, HTMLAttributes } from "astro/types";
import type { phaseSelectType } from "../lib/schema.ts";
import { actions } from "astro:actions";
import Button from "./Button.astro";
import Field from "./Field.astro";

interface Props extends HTMLAttributes<"form"> {
	// "record" moves an in-progress phase to delivered (recordDelivery);
	// "edit" corrects the delivery of a delivered or accepted phase
	// (updatePhaseDelivery).
	mode: "record" | "edit";
	phase: {
		id: string;
		title: string;
		version: number;
		deliveryState?: phaseSelectType["deliveryState"];
		deliveryUrl?: string | null;
	};
	// The mode's action result, so each field shows its own input error.
	result?: ComponentProps<typeof Field>["result"];
}

const { mode, phase, result, class: className, ...attrs } = Astro.props;
const submitLabel = mode === "record" ? "Record delivery" : "Update delivery";
---

<delivery-form class="grid">
	<form
		method="POST"
		action={mode === "record"
			? actions.recordDelivery
			: actions.updatePhaseDelivery}
		class:list={[
			"grid grid-cols-[minmax(0,1fr)] gap-4 border border-dashed border-line p-4 md:grid-cols-[auto_minmax(0,1fr)]",
			className,
		]}
		{...attrs}
	>
		<input type="hidden" name="phaseId" value={phase.id}>
		<input type="hidden" name="expectedVersion" value={phase.version}>
		<Field
			label="Delivery"
			as="select"
			name="deliveryChoice"
			required
			{result}
			data-delivery-choice
		>
			<option value="url" selected={phase.deliveryState !== "none"}>
				Delivery link
			</option>
			<option value="none" selected={phase.deliveryState === "none"}>
				No delivery PR/MR
			</option>
		</Field>
		<Field
			label="Delivery URL"
			name="deliveryUrl"
			type="url"
			inputmode="url"
			autocomplete="off"
			value={phase.deliveryUrl ?? ""}
			placeholder="https://github.com/…"
			hint="HTTPS link to the pull or merge request that delivers the phase."
			{result}
			data-delivery-url
		/>
		<Button
			type="submit"
			aria-label={`${submitLabel}: ${phase.title}`}
			class="md:col-span-2"
		>
			{submitLabel}
		</Button>
	</form>
</delivery-form>

<script>
	// The URL field shows, and is required, only for a delivery link.
	class DeliveryForm extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const select = this.querySelector("[data-delivery-choice]");
			const input = this.querySelector("[data-delivery-url]");
			// Field's wrapper holds the URL's label, input, hint and error.
			const field = input?.parentElement;

			if (
				!(select instanceof HTMLSelectElement) ||
				!(input instanceof HTMLInputElement) ||
				!field
			) {
				return;
			}

			const syncDeliveryUrl = () => {
				const show = select.value === "url";
				field.hidden = !show;
				input.required = show;

				if (!show) {
					input.value = "";
				}
			};

			syncDeliveryUrl();
			select.addEventListener("change", syncDeliveryUrl);
		}
	}

	if (!customElements.get("delivery-form")) {
		customElements.define("delivery-form", DeliveryForm);
	}
</script>
