---
import type { HTMLAttributes } from "astro/types";
import type { phaseSelectType } from "../lib/schema.ts";
import { actions } from "astro:actions";
import Button from "./Button.astro";
import Input from "./Input.astro";

interface Props extends HTMLAttributes<"form"> {
	// "record" moves an in-progress phase to delivered (recordDelivery);
	// "edit" corrects the delivery of a delivered or accepted phase
	// (updatePhaseDelivery).
	mode: "record" | "edit";
	phase: {
		id: string;
		title: string;
		version: number;
		deliveryState?: phaseSelectType["deliveryState"];
		deliveryUrl?: string | null;
	};
}

const { mode, phase, class: className, ...attrs } = Astro.props;
const submitLabel = mode === "record" ? "Record delivery" : "Update delivery";
---

<delivery-form class="grid">
	<form
		method="POST"
		action={mode === "record"
			? actions.recordDelivery
			: actions.updatePhaseDelivery}
		class:list={[
			"grid gap-3 border border-dashed border-line p-4 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-end",
			className,
		]}
		{...attrs}
	>
		<input type="hidden" name="phaseId" value={phase.id}>
		<input type="hidden" name="expectedVersion" value={phase.version}>
		<label class="grid gap-1">
			<span class="text-label text-fg-muted">Delivery</span>
			<Input as="select" name="deliveryChoice" data-delivery-choice required>
				<option value="url" selected={phase.deliveryState !== "none"}>
					Delivery link
				</option>
				<option value="none" selected={phase.deliveryState === "none"}>
					No delivery PR/MR
				</option>
			</Input>
		</label>
		<label class="grid gap-1" data-delivery-url-field>
			<span class="text-label text-fg-muted">Delivery URL</span>
			<Input
				name="deliveryUrl"
				type="url"
				inputmode="url"
				autocomplete="off"
				value={phase.deliveryUrl ?? ""}
				placeholder="https://github.com/…"
			/>
		</label>
		<Button type="submit" aria-label={`${submitLabel}: ${phase.title}`}>
			{submitLabel}
		</Button>
	</form>
</delivery-form>

<script>
	// The URL field shows, and is required, only for a delivery link.
	class DeliveryForm extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const select = this.querySelector("[data-delivery-choice]");
			const field = this.querySelector<HTMLElement>(
				"[data-delivery-url-field]",
			);
			const input = field?.querySelector<HTMLInputElement>(
				'input[name="deliveryUrl"]',
			);

			if (!(select instanceof HTMLSelectElement) || !field || !input) return;

			const syncDeliveryUrl = () => {
				const show = select.value === "url";
				field.hidden = !show;
				input.required = show;

				if (!show) {
					input.value = "";
				}
			};

			syncDeliveryUrl();
			select.addEventListener("change", syncDeliveryUrl);
		}
	}

	if (!customElements.get("delivery-form")) {
		customElements.define("delivery-form", DeliveryForm);
	}
</script>
