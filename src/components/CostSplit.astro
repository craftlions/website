---
import type {
	ComponentBillingStatus,
	InvoiceComponent,
	PhaseComponentItem,
} from "../lib/phase-billing";
import Badge from "./Badge.astro";

interface Props {
	items: PhaseComponentItem[];
	currency: string;
	total: number;
	variant?: "full" | "compact";
	showStatus?: boolean;
	highlight?: InvoiceComponent | null;
	caption?: string | null;
}

const {
	items,
	currency,
	total,
	variant = "full",
	showStatus = true,
	highlight = null,
	caption = null,
} = Astro.props;

const formatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency,
});
const percentFormatter = new Intl.NumberFormat("de-DE", {
	style: "percent",
	maximumFractionDigits: 1,
});

const dueHint: Record<InvoiceComponent, string> = {
	upfront: "on approval",
	delivery: "on delivery",
	acceptance: "on acceptance",
};

const statusBadgeType: Record<
	ComponentBillingStatus,
	"info" | "success" | "error" | "gray"
> = {
	not_due: "gray",
	due: "info",
	invoiced: "info",
	paid: "success",
};

const statusLabel: Record<ComponentBillingStatus, string> = {
	not_due: "Not due",
	due: "Due",
	invoiced: "Invoiced",
	paid: "Paid",
};

const share = (amount: number) =>
	total > 0 ? percentFormatter.format(amount / total) : "—";
const accessibleSummary =
	items.length === 0
		? `Total ${formatter.format(total)}, no chargeable parts.`
		: `Total ${formatter.format(total)} in ${items.length} part${items.length === 1 ? "" : "s"}: ${items
				.map(
					(item) =>
						`${item.component} ${formatter.format(item.amount)} (${share(item.amount)}) ${dueHint[item.component]}${showStatus ? `, ${item.status.replaceAll("_", " ")}` : ""}`,
				)
				.join("; ")}.`;
---

{items.length === 0 ? (
	<p class="text-xs text-fg-muted">
		No chargeable parts · {formatter.format(total)}
	</p>
) : variant === "compact" ? (
	<figure class="cost-split" data-variant="compact">
		<figcaption class="sr-only">{accessibleSummary}</figcaption>
		<ul class="stack" data-space="3xs" aria-label="Cost split">
			{items.map((item) => (
				<li
					class="text-xs"
					data-dimmed={(highlight && item.component !== highlight) || undefined}
					title={`${dueHint[item.component]}${showStatus ? ` · ${item.status.replaceAll("_", " ")}` : ""}`}
				>
					<span class="cost-split-part truncate text-fg-muted">
						{item.component}
						<span> · {dueHint[item.component]}</span>
					</span>
					<span class="cost-split-amount tabular-nums text-fg">
						{formatter.format(item.amount)}
						<span class="text-fg-muted"> · {share(item.amount)}</span>
					</span>
				</li>
			))}
		</ul>
		{caption && <p class="text-xs text-fg-muted">{caption}</p>}
		{items.length === 1 && !caption && (
			<p class="text-xs text-fg-muted">
				Single payment {dueHint[items[0]?.component ?? "acceptance"]}
			</p>
		)}
	</figure>
) : (
	<figure class="cost-split" data-variant="full">
		<figcaption class="sr-only">{accessibleSummary}</figcaption>
		<ul class="stack" data-space="3xs" aria-label="Cost split">
			{items.map((item) => (
				<li
					data-dimmed={(highlight && item.component !== highlight) || undefined}
				>
					<span class="stack" data-space="3xs">
						<span class="cost-split-name text-xs">
							<span class="cost-split-part">{item.component}</span>
							<span class="truncate text-fg-muted">
								{dueHint[item.component]}
							</span>
						</span>
						<span class="text-xs tabular-nums text-fg">
							{formatter.format(item.amount)}
							<span class="text-fg-muted"> · {share(item.amount)}</span>
						</span>
					</span>
					{showStatus ? (
						<Badge type={statusBadgeType[item.status]}>
							{statusLabel[item.status]}
						</Badge>
					) : highlight === item.component ? (
						<Badge type="info">This invoice</Badge>
					) : null}
				</li>
			))}
		</ul>
		{caption ? (
			<p class="text-xs text-fg-muted">{caption}</p>
		) : items.length === 1 ? (
			<p class="text-xs text-fg-muted">
				Single payment {dueHint[items[0]?.component ?? "acceptance"]} ·{" "}
				{formatter.format(total)} total
			</p>
		) : (
			<p class="text-xs tabular-nums text-fg-muted">
				{formatter.format(total)} total in {items.length} parts
			</p>
		)}
	</figure>
)}
