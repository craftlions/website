---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h1">;

const { class: className, ...attrs } = Astro.props;
---

{/* biome-ignore lint/a11y/useHeadingContent: the slot supplies the heading text */}
<h1
	class:list={["page-heading text-display wrap-break-word", className]}
	{...attrs}
>
	<slot />
</h1>

<style>
	@layer components {
		/* The page title behind a dashed rule at
		   its start. */
		.page-heading {
			padding-inline-start: var(--space-xs);
			border: 0 dashed var(--line-strong);
			border-inline-start-width: var(--hairline);
		}
	}
</style>
