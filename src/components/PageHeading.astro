---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h1">;

const { class: className, ...attrs } = Astro.props;
---

{/* biome-ignore lint/a11y/useHeadingContent: the slot supplies the heading text */}
<h1
	class:list={["page-heading text-display wrap-break-word", className]}
	{...attrs}
>
	<slot />
</h1>
