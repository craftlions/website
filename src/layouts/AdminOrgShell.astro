---
import type { ComponentProps } from "astro/types";
import Button from "../components/Button.astro";
import AdminShell from "./AdminShell.astro";

interface Props
	extends Omit<ComponentProps<typeof AdminShell>, "title" | "breadcrumbs"> {
	organization: {
		id: string;
		name: string;
	};
	activePage:
		| "overview"
		| "worklist"
		| "projects"
		| "invoices"
		| "members"
		| "settings";
	breadcrumbs?: ComponentProps<typeof AdminShell>["breadcrumbs"];
	title?: string | undefined;
	/** @deprecated Pass `results` with a message per action, or `success`. */
	showSuccess?: boolean;
}

const {
	organization,
	activePage,
	breadcrumbs = [],
	title,
	showSuccess = false,
	results,
	fieldLabels,
	success,
} = Astro.props;
const pages = [
	{
		id: "overview",
		label: "Overview",
		href: `/admin/org/${organization.id}`,
	},
	{
		id: "worklist",
		label: "Worklist",
		href: `/admin/org/${organization.id}/worklist`,
	},
	{
		id: "projects",
		label: "Projects",
		href: `/admin/org/${organization.id}/projects`,
	},
	{
		id: "invoices",
		label: "Invoices",
		href: `/admin/org/${organization.id}/invoices`,
	},
	{
		id: "members",
		label: "Members",
		href: `/admin/org/${organization.id}/members`,
	},
	{
		id: "settings",
		label: "Settings",
		href: `/admin/org/${organization.id}/settings`,
	},
] as const;
const activeTab = pages.find((page) => page.id === activePage) ?? pages[0];
---

<AdminShell
	title={`${title ?? breadcrumbs.at(-1)?.label ?? activeTab.label} · ${organization.name}`}
	breadcrumbs={[
		{ label: "Admin", href: "/admin" },
		{ label: organization.name, href: pages[0].href },
		...(activePage === "overview" ? [] : [activeTab]),
		...breadcrumbs,
	]}
	{results}
	{fieldLabels}
	success={success ?? (showSuccess ? "Saved." : undefined)}
>
	<header
		slot="header"
		class="grid gap-4 border-b border-dashed border-line pb-6"
	>
		<div class="grid gap-1">
			<p class="text-label uppercase text-fg-muted">Client</p>
			<h1
				class="border-l border-dashed border-line-strong pl-3 text-display wrap-break-word"
			>
				{organization.name}
			</h1>
		</div>
		<nav aria-label="Client sections">
			<ul
				class="-m-1 grid grid-flow-col auto-cols-max gap-2 overflow-x-auto p-1"
			>
				{pages.map((page) => (
					<li>
						<Button
							href={page.href}
							aria-current={activePage === page.id ? "page" : undefined}
						>
							{page.label}
						</Button>
					</li>
				))}
			</ul>
		</nav>
	</header>
	<slot />
</AdminShell>
