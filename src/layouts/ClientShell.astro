---
import type { ComponentProps } from "astro/types";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Shell from "./Shell.astro";

interface Props {
	title: string;
	breadcrumbs?: ComponentProps<typeof Breadcrumbs>["items"];
	organization?: { name: string; slug: string } | undefined;
	wide?: boolean;
}

const { title, breadcrumbs = [], organization, wide = false } = Astro.props;
const session = Astro.locals.session;
// Members of several organizations switch between them on /dash.
const memberships =
	organization && session
		? await Astro.locals.db.query.member.findMany({
				columns: { id: true },
				where: { userId: session.user.id },
				limit: 2,
			})
		: [];
const trail = organization
	? [
			...(memberships.length > 1
				? [{ label: "Organizations", href: "/dash" }]
				: []),
			{ label: organization.name, href: `/dash/org/${organization.slug}` },
			...breadcrumbs,
		]
	: breadcrumbs;
---

<Shell bodyClass="min-h-dvh grid gap-region p-gutter text-pretty">
	<Fragment slot="head"> <title>{title} · craftlions</title> </Fragment>
	<Fragment slot="body">
		<header
			class:list={[
				"mx-auto grid w-full gap-6",
				wide ? "max-w-6xl" : "max-w-3xl",
			]}
		>
			<Nav organizationSlug={organization?.slug} />
		</header>
		<main
			class:list={[
				"mx-auto grid min-h-0 w-full content-start gap-6 pl-3",
				wide ? "max-w-6xl" : "max-w-3xl",
			]}
		>
			{trail.length > 1 && <Breadcrumbs items={trail} />}
			<slot name="header" />
			<slot />
		</main>
		<Footer {wide} />
	</Fragment>
</Shell>

<script>
	document.addEventListener("submit", (event) => {
		if (
			event.defaultPrevented ||
			!(event.target instanceof HTMLFormElement) ||
			!event.target.checkValidity()
		) {
			return;
		}

		// Disabling waits a task, because the form leaves a disabled submitter's
		// name and value out of the data it sends.
		const { elements } = event.target;
		window.setTimeout(() => {
			for (const element of elements) {
				if (element instanceof HTMLButtonElement && element.type === "submit") {
					element.disabled = true;
				}
			}
		});
	});
</script>
