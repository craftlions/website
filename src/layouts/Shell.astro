---
import "../styles/global.css";
import Button from "../components/Button.astro";
import CommandPalette from "../components/CommandPalette.astro";
import SkipLink from "../components/SkipLink.astro";
import { isPrivatePath } from "../lib/indexing.ts";

const lang = Astro.currentLocale;

interface Props {
	bodyClass?: string;
}

const { bodyClass } = Astro.props;
const session = Astro.locals.session;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang={lang ?? "en"}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="color-scheme" content="light dark">
		<meta name="text-scale" content="scale">
		<meta name="generator" content={Astro.generator}>
		<style is:inline>
			@layer reset, tokens, base, layout, components, page, utilities;
		</style>

		{/* enhancement: the cross-fade between pages waits for the new page's
		   main landmark to be parsed (Chrome 124, Safari 18.2); Firefox ignores
		   it and fades as before. */}
		<link rel="expect" href="#main" blocking="render">

		<slot name="head" />
		{isPrivatePath(Astro.url.pathname) && (
			<meta name="robots" content="noindex">
		)}
		<link rel="canonical" href={canonical}>
		<meta property="og:url" content={canonical}>
		<meta property="og:site_name" content="craftlions">
		<meta name="twitter:card" content="summary">
		<link rel="sitemap" href="/sitemap-index.xml">
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
	</head>
	{bodyClass ? (
		<body class={bodyClass}>
			<SkipLink />
			{session?.session.impersonatedBy && (
				<aside aria-label="Impersonation" class="impersonation">
					<p class="text-label wrap-break-word">
						Viewing as {session.user.name}
					</p>
					<stop-impersonating>
						<Button aria-describedby="stop-impersonating-error">Stop</Button>
						<p
							id="stop-impersonating-error"
							role="alert"
							class="text-sm text-fg-danger"
						/>
					</stop-impersonating>
				</aside>
			)}
			<slot name="body" />
			{session && <CommandPalette />}
		</body>
	) : (
		<slot name="body" />
	)}
</html>

<script>
	import { authClient } from "../lib/auth-client.ts";

	class StopImpersonating extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const button = this.querySelector("button");
			const message = this.querySelector<HTMLElement>("[role=alert]");

			if (!button || !message) return;

			button.addEventListener("click", async () => {
				button.disabled = true;
				message.textContent = "";

				try {
					const { error } = await authClient.admin.stopImpersonating();

					if (error) {
						throw error;
					}

					window.location.replace("/admin");
				} catch {
					button.disabled = false;
					message.textContent =
						"Could not return to the admin view. Try again.";
					button.focus();
				}
			});
		}
	}

	if (!customElements.get("stop-impersonating")) {
		customElements.define("stop-impersonating", StopImpersonating);
	}
</script>
