---
import "../styles/global.css";
import Button from "../components/Button.astro";

const lang = Astro.currentLocale;

interface Props {
	bodyClass?: string;
}

const { bodyClass } = Astro.props;
const session = Astro.locals.session;
// Without the query string, so tracking and form parameters share one URL.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<html lang={lang ?? "en"}>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator}>

		<slot name="head" />
		<link rel="canonical" href={canonical}>
		<meta property="og:url" content={canonical}>
		<meta property="og:site_name" content="craftlions">
		<meta name="twitter:card" content="summary">
		<link rel="sitemap" href="/sitemap-index.xml">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
	</head>
	{bodyClass ? (
		<body
			class:list={[
				bodyClass,
				session?.session.impersonatedBy
					? "grid-rows-[auto_auto_1fr_auto]"
					: "grid-rows-[auto_1fr_auto]",
			]}
		>
			{session?.session.impersonatedBy && (
				<aside
					aria-label="Impersonation"
					class="sticky top-0 z-50 grid w-full grid-cols-[minmax(0,1fr)_auto] items-center gap-3 border-b border-dashed border-line-strong bg-panel p-3"
				>
					<p class="text-label wrap-break-word">
						Viewing as {session.user.name}
					</p>
					<stop-impersonating class="contents">
						<Button aria-describedby="stop-impersonating-error">Stop</Button>
						<p
							id="stop-impersonating-error"
							role="alert"
							class="col-span-2 text-sm text-fg-danger"
							hidden
						/>
					</stop-impersonating>
				</aside>
			)}
			<slot name="body" />
		</body>
	) : (
		<slot name="body" />
	)}
</html>

<script>
	import { authClient } from "../lib/auth-client.ts";

	class StopImpersonating extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const button = this.querySelector("button");
			const message = this.querySelector<HTMLElement>("[role=alert]");

			if (!button || !message) return;

			button.addEventListener("click", async () => {
				button.disabled = true;
				message.hidden = true;
				message.textContent = "";

				try {
					const { error } = await authClient.admin.stopImpersonating();

					if (error) {
						throw error;
					}

					window.location.replace("/admin");
				} catch {
					button.disabled = false;
					message.textContent =
						"Could not return to the admin view. Try again.";
					message.hidden = false;
					button.focus();
				}
			});
		}
	}

	if (!customElements.get("stop-impersonating")) {
		customElements.define("stop-impersonating", StopImpersonating);
	}
</script>
