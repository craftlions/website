---
export const prerender = true;

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import Shell from "../layouts/Shell.astro";
import { email, legalName } from "../lib/company.ts";
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Impressum</title> </Fragment>
	<Fragment slot="body">
		<body class="cover public">
			<header class="stack center" data-space="m">
				<Nav deferSessionLinks />
			</header>

			<main class="stack center imprint" data-space="m">
				<div class="stack">
					<PageHeading> Impressum </PageHeading>
					<p class="measure text-sm text-fg-muted">
						Diese Seite enthält die gesetzlich vorgeschriebenen Angaben zur
						Betreiberin der Website und die wichtigsten Kontaktinformationen.
					</p>
					<div class="stack box" data-space="2xs">
						<p class="text-label">Fragen zur Website?</p>
						<p class="text-sm text-fg-muted">
							Schreiben Sie mir direkt an&nbsp;
							<a href={`mailto:${email}`} class="text-fg-info link">
								{email}
							</a>
						</p>
					</div>
				</div>
				<section class="stack">
					<article class="stack box">
						<div class="stack" data-space="3xs">
							<h2 class="text-title">Angaben gemäß § 5 DDG</h2>
							<p class="text-sm text-fg-muted">{legalName}</p>
						</div>
						<dl class="stack text-sm text-fg-muted" data-space="xs">
							<div class="stack" data-space="3xs">
								<dt class="text-label text-fg"> Postanschrift </dt>
								<dd>
									<address>
										Amandus-Voigt-Str. 8<br>
										23617 Stockelsdorf
									</address>
								</dd>
							</div>
							<div class="stack" data-space="3xs">
								<dt class="text-label text-fg"> Kontakt </dt>
								<dd class="stack" data-space="3xs">
									<span>Telefon: auf Anfrage</span>
									<a href={`mailto:${email}`} class="text-fg-info link">
										{email}
									</a>
								</dd>
							</div>
							<div class="stack" data-space="3xs">
								<dt class="text-label text-fg"> Vertreten durch </dt>
								<dd>Geschäftsführer: Alexander Niebuhr</dd>
							</div>
						</dl>
					</article>
					<article class="stack box" data-space="xs">
						<h2 class="text-title">
							Verantwortlich für journalistisch-redaktionelle Inhalte
						</h2>
						<p class="text-sm text-fg-muted">
							Alexander Niebuhr, Amandus-Voigt-Str. 8, 23617 Stockelsdorf
						</p>
					</article>
					<article class="stack box" data-space="xs">
						<h2 class="text-title">Information gemäß § 36 VSBG</h2>
						<p class="text-sm text-fg-muted">
							Gemäß § 36 VSBG (Verbraucherstreitbeilegungsgesetz – Gesetz über
							die alternative Streitbeilegung in Verbrauchersachen) erklärt der
							Betreiber dieser Website:
						</p>
						<p class="text-sm text-fg-muted">
							Wir sind bereit, an Streitbeilegungsverfahren bei der folgenden
							Verbraucherschlichtungsstelle teilzunehmen.
						</p>
						<address class="stack text-sm text-fg-muted" data-space="3xs">
							<span>
								Universalschlichtungsstelle des Bundes<br>
								Zentrum für Schlichtung e. V.<br>
								Straßburger Str. 8<br>
								77694 Kehl
							</span>
							<a
								href="https://www.universalschlichtungsstelle.de"
								class="text-fg-info link wrap-anywhere"
							>
								https://www.universalschlichtungsstelle.de
							</a>
						</address>
					</article>
				</section>
			</main>
			<Footer />
		</body>
	</Fragment>
</Shell>
