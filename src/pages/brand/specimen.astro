---
export const prerender = true;

import { ActionError } from "astro:actions";
import designMd from "../../../DESIGN.md?raw";
import { range, tokens as scale } from "../../../scripts/fluid-scale.js";
import ActionBanner from "../../components/ActionBanner.astro";
import Badge from "../../components/Badge.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/Button.astro";
import Checkbox from "../../components/Checkbox.astro";
import ConfirmAction from "../../components/ConfirmAction.astro";
import DisclosureButton from "../../components/DisclosureButton.astro";
import Field from "../../components/Field.astro";
import PageHeading from "../../components/PageHeading.astro";
import Progress from "../../components/Progress.astro";
import Shell from "../../layouts/Shell.astro";
import {
	contrastChecks,
	parseContrast,
	parseTokens,
} from "../../lib/contrast.ts";
import tokensCss from "../../styles/tokens.css?raw";

const tokens = parseTokens(tokensCss);
const requirements = parseContrast(designMd);

const schemes = (["light", "dark"] as const).map((scheme) => {
	const swatches = contrastChecks(tokens, requirements, scheme);
	return {
		scheme,
		style: `color-scheme: ${scheme}; ${swatches.map(({ name, value }) => `--${name}: ${value}`).join("; ")}`,
		swatches,
	};
});

const feedback = [
	{ data: undefined, error: undefined },
	{
		data: undefined,
		error: new ActionError({
			code: "CONFLICT",
			message: "This phase changed in the meantime. Reload and try again.",
		}),
	},
	{
		data: undefined,
		error: ActionError.fromJson({
			type: "AstroActionInputError",
			issues: [
				{ code: "custom", path: ["email"], message: "Invalid email address" },
				{ code: "custom", path: [], message: "Pick a delivery date" },
			],
		}),
	},
	// Without a message the banner shows its generic server-error text, as it
	// does for INTERNAL_SERVER_ERROR, but nothing is logged.
	{ data: undefined, error: new ActionError({ code: "BAD_GATEWAY" }) },
];

const typeRoles = [
	["text-display", "Display"],
	["text-headline", "Headline"],
	["text-title", "Title"],
	["text-label", "Label"],
	["text-caption", "Caption"],
	["text-sm", "Small body"],
	["text-xs", "Extra small body"],
	["label-caps", "Label caps"],
];

// Each step shows its range from scripts/fluid-scale.js, which the design tests
// measure each probe against.
const typeSteps = [
	["text-display", "Display", "step-3"],
	["text-headline", "Headline", "step-2"],
	["text-title", "Title", "step-1"],
	[undefined, "Body", "step-0"],
	["text-sm", "Small body", "step--1"],
	["text-xs", "Extra small body", "step--2"],
] as const;

// Each layout primitive renders in a narrow and a wide frame, so the design
// tests and a reader see what it does with the room it gets.
const frames = [
	["narrow", "20rem"],
	["wide", "60rem"],
] as const;
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Specimen</title> </Fragment>
	<Fragment slot="body">
		<body class="specimen">
			<header class="center stack" data-width="wide" data-space="2xs">
				<PageHeading> Specimen </PageHeading>
				<p class="intro text-sm text-fg-muted">
					Every token and primitive in both color schemes; hover and tab through
					the controls to see their states.
				</p>
			</header>
			<main class="center stack sections" data-width="wide">
				<section
					aria-labelledby="scale"
					class="box stack panel full-row"
					data-space="l"
				>
					<header class="stack" data-space="2xs">
						<h2 id="scale" class="text-headline">Scale</h2>
						<p class="text-sm text-fg-muted">
							Fluid steps grow with the window from 320px to 1280px and hold
							outside it; resize to watch them.
						</p>
					</header>

					<section class="stack" data-space="xs">
						<h3 class="text-title">Type</h3>
						<ul class="stack" data-space="xs">
							{typeSteps.map(([role, label, name]) => {
								const token = scale.find((step) => step.name === name);
								return (
									token && (
										<li class="stack" data-space="3xs">
											<p class={role} data-probe={name}>
												{label}
											</p>
											<p class="text-xs tabular-nums text-fg-muted">
												<code>--{name}</code> · {range(token)}
											</p>
										</li>
									)
								);
							})}
						</ul>
					</section>

					<section class="stack" data-space="xs">
						<h3 class="text-title">Space</h3>
						<ul class="stack" data-space="xs">
							{scale
								.filter(({ name }) => name.startsWith("space-"))
								.map((token) => (
									<li class="stack" data-space="3xs">
										<span
											aria-hidden="true"
											class="probe bg-ink forced-ink"
											style={`width: var(--${token.name})`}
											data-probe={token.name}
										/>
										<p class="text-xs tabular-nums text-fg-muted">
											<code>--{token.name}</code> · {range(token)}
										</p>
									</li>
								))}
						</ul>
					</section>
				</section>
				{schemes.map(({ scheme, style, swatches }) => (
					<section
						aria-labelledby={`scheme-${scheme}`}
						class="box stack panel bg-canvas text-fg"
						data-space="l"
						style={style}
					>
						<h2 id={`scheme-${scheme}`} class="scheme-name text-headline">
							{scheme}
						</h2>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Tokens</h3>
							<ul class="tokens stack text-sm" data-space="2xs">
								{swatches.map(({ name, value, minimum, checks }) => (
									<li class="token-row">
										<span class="swatch" style={`background-color: ${value}`} />
										<code class="truncate">--{name}</code>
										<span class="token-ratios text-xs tabular-nums">
											{checks.map(({ surface, ratio }) => (
												<span
													class:list={[
														minimum && ratio < minimum
															? "text-caption text-fg-danger"
															: "text-fg-muted",
													]}
												>
													{surface} {ratio.toFixed(2)}
												</span>
											))}
										</span>
									</li>
								))}
							</ul>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Type</h3>
							{typeRoles.map(([role, label]) => (
								<p class={role}>{label}</p>
							))}
							<p class="text-fg-muted">Body, muted</p>
							<p class="text-fg-danger">Danger</p>
							<p class="text-fg-success">Success</p>
							<p class="text-fg-info">Info</p>
							<p class="text-fg-warning">Warning</p>
						</section>

						<section class="button-demos">
							<h3 class="text-title">Buttons</h3>
							<div class="buttons">
								<Button>Default</Button>
								<Button aria-pressed="true">Pressed</Button>
								<Button href="/brand/specimen" aria-current="page">
									Current
								</Button>
								<Button variant="danger">Danger</Button>
								<Button disabled>Disabled</Button>
								<Button href="/brand/specimen">Link</Button>
							</div>
							<div class="button-row">
								<Button variant="quiet">Quiet</Button>
								<Button variant="quiet" disabled>
									Quiet disabled
								</Button>
								<Button variant="hint" aria-label="Hint">
									i
								</Button>
							</div>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Disclosure</h3>
							<div class="section-head">
								<p class="label-caps">Members</p>
								<DisclosureButton controls={`disclosure-${scheme}`}>
									Add member
								</DisclosureButton>
							</div>
							<form
								id={`disclosure-${scheme}`}
								method="dialog"
								aria-label="Add member"
								hidden
								class="box stack panel"
							>
								<Field label="Email" type="email" />
								<div class="pair">
									<Button type="submit">Add member</Button>
									<Button variant="quiet" data-disclosure-cancel>
										Cancel
									</Button>
								</div>
							</form>
							<DisclosureButton
								controls={`disclosure-row-${scheme}`}
								variant="quiet"
							>
								More
							</DisclosureButton>
							<p
								id={`disclosure-row-${scheme}`}
								hidden
								class="divided border-line text-sm text-fg-muted"
							>
								A row's corrections and quiet destructive actions.
							</p>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Breadcrumbs</h3>
							<Breadcrumbs
								label={`Breadcrumb, ${scheme}`}
								items={[
									{ label: "Admin", href: "/brand/specimen" },
									{ label: "Acme", href: "/brand/specimen" },
									{ label: "Projects", href: "/brand/specimen" },
									{ label: "Website relaunch" },
								]}
							/>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Inputs</h3>
							<Field label="Text" placeholder="Placeholder" />
							<Field
								label="With hint"
								hint="Shown to the client on every invoice."
							/>
							<Field
								label="With error"
								name="email"
								type="email"
								value="not-an-email"
								error="Enter a valid email address."
							/>
							<Field label="Danger" danger value="Type to confirm" />
							<Field label="Select" as="select">
								<option>First option</option>
								<option>Second option</option>
							</Field>
							<Field
								label="Read-only"
								readonly
								value="cus_N1x2y3"
								hint="Locked: shown, not edited."
							/>
							<Field label="Disabled" disabled value="Disabled" />
							<Checkbox>Unchecked</Checkbox>
							<Checkbox checked>Checked</Checkbox>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Badges</h3>
							<div class="badges stack" data-space="2xs">
								<Badge type="info">Ready to start</Badge>
								<Badge type="success">Accepted</Badge>
								<Badge type="error">Overdue</Badge>
								<Badge type="gray">Awaiting approval</Badge>
							</div>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Progress</h3>
							<Progress percent={40} aria-label="Within budget" />
							<Progress
								percent={40}
								pace={6}
								aria-label="Within budget, with pace marker"
							/>
							<Progress percent={120} aria-label="Over budget" />
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Confirmation</h3>
							<form method="dialog">
								<ConfirmAction
									id={`confirm-${scheme}`}
									trigger="Remove"
									triggerLabel="Remove Jane Doe"
									title="Remove Jane Doe from Acme?"
									confirm="Remove member"
									cancel="Keep member"
								>
									Jane loses access to the Acme dashboard. Her account stays.
								</ConfirmAction>
							</form>
							<form method="dialog">
								<ConfirmAction
									id={`confirm-approve-${scheme}`}
									trigger="Approve for client"
									title="Approve Discovery for the client?"
									confirm="Approve for client"
									confirmVariant="default"
									cancel="Go back"
								>
									You approve this phase on the client's behalf. Its upfront
									payment becomes due.
								</ConfirmAction>
							</form>
							<form method="dialog">
								<ConfirmAction
									id={`confirm-typed-${scheme}`}
									trigger="Delete client"
									triggerVariant="danger"
									title="Delete Acme?"
									confirm="Delete client"
									cancel="Keep client"
									typeToConfirm="Acme"
								>
									The client and its settings are deleted for good.
								</ConfirmAction>
							</form>
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Action feedback</h3>
							{feedback.map((result) => (
								<ActionBanner
									results={[[result, "Phase sent to client."]]}
									fieldLabels={{ email: "Email" }}
								/>
							))}
						</section>

						<section class="stack" data-space="xs">
							<h3 class="text-title">Surfaces</h3>
							<p class="box text-sm">Dashed plane</p>
							<p class="box bg-panel text-sm">Panel fill</p>
							<p class="box bg-info-subtle text-sm">Info highlight</p>
							<p class="box border-line-danger text-sm text-fg-danger">
								Danger outline
							</p>
							<a href="/brand/specimen" class="fit text-sm text-fg-info link">
								Text link
							</a>
						</section>
					</section>
				))}
				<section
					aria-labelledby="layout"
					class="box stack full-row"
					data-space="l"
				>
					<header class="stack" data-space="2xs">
						<h2 id="layout" class="text-headline">Layout</h2>
						<p class="text-sm text-fg-muted">
							The layout primitives in src/styles/layout.css, each in a 20rem
							and a 60rem frame, or as wide as the screen allows. Their content
							decides when they wrap or switch.
						</p>
					</header>

					<section
						aria-labelledby="layout-stack"
						class="stack"
						data-space="xs"
						data-fixture="stack"
					>
						<h3 id="layout-stack" class="text-title">Stack</h3>
						<p class="text-sm text-fg-muted">
							The space between siblings comes from the parent; each nested
							stack keeps its own.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="stack" data-space="l">
										<article class="stack" data-space="2xs">
											<h4 class="text-title">Website relaunch</h4>
											<p class="text-sm text-fg-muted">Phase 2 of 4 · Design</p>
											<p class="text-sm">
												Templates, navigation and a content migration plan for
												the new site.
											</p>
										</article>
										<article class="stack">
											<h4 class="text-title">Billing API</h4>
											<p class="text-sm text-fg-muted">Done · Paid in full</p>
										</article>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-box"
						class="stack"
						data-space="xs"
						data-fixture="box"
					>
						<h3 id="layout-box" class="text-title">Box</h3>
						<p class="text-sm text-fg-muted">
							The dashed plane: padding inside a dashed line.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="stack" data-space="xs">
										<p class="box text-sm text-fg-muted">
											No invoices yet. The first one appears here once a phase
											is accepted.
										</p>
										<p class="box text-sm" data-space="xs">
											Dense cell: 4,000 € due 2026-12-01
										</p>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-center"
						class="stack"
						data-space="xs"
						data-fixture="center"
					>
						<h3 id="layout-center" class="text-title">Center</h3>
						<p class="text-sm text-fg-muted">
							A column capped at its width token and centred, here the 32rem
							column of the sign-in forms.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="center" data-width="narrow">
										<p class="box text-sm">
											Sign in with the email address your invitation went to.
										</p>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-cluster"
						class="stack"
						data-space="xs"
						data-fixture="cluster"
					>
						<h3 id="layout-cluster" class="text-title">Cluster</h3>
						<p class="text-sm text-fg-muted">
							Peers at their own width that wrap like words, with the same gap
							between rows.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="cluster">
										<Button>Send to client</Button>
										<Button>Edit</Button>
										<Button>Record payment</Button>
										<Button variant="danger">Delete phase</Button>
										<Badge type="info">Sent</Badge>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-heading-row"
						class="stack"
						data-space="xs"
						data-fixture="heading-row"
					>
						<h3 id="layout-heading-row" class="text-title">
							Sidebar: heading and action
						</h3>
						<p class="text-sm text-fg-muted">
							The action keeps its own width beside the heading; when the
							heading would get less than half the row, the action moves below
							it.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="with-sidebar" data-side="end" data-align="center">
										<h4 class="label-caps">
											Projects in Example client organisation
										</h4>
										<Button>Create project</Button>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-sidebar"
						class="stack"
						data-space="xs"
						data-fixture="sidebar"
					>
						<h3 id="layout-sidebar" class="text-title">Sidebar: dashboard</h3>
						<p class="text-sm text-fg-muted">
							Projects and a 20rem Budget side by side while Projects keeps at
							least 60% of the row; stacked otherwise.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div
										class="with-sidebar"
										data-side="end"
										style="--sidebar-width: 20rem; --content-min: 60%"
									>
										<div class="stack" data-space="xs">
											<h4 class="label-caps">Projects</h4>
											<ul class="stack" data-space="2xs">
												<li class="box text-sm">Website relaunch · Design</li>
												<li class="box text-sm">Billing API · Done</li>
											</ul>
										</div>
										<div class="stack" data-space="xs">
											<h4 class="label-caps">Budget</h4>
											<p class="box text-sm tabular-nums">
												8,200 € of 12,400 € used
											</p>
										</div>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-switcher"
						class="stack"
						data-space="xs"
						data-fixture="switcher"
					>
						<h3 id="layout-switcher" class="text-title">Switcher</h3>
						<p class="text-sm text-fg-muted">
							All in one row above the threshold, all stacked below it, never in
							between: an invoice and its cost split at 40rem, the split taking
							1.5 shares of the room, and three metrics at 30rem.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="stack">
										<div class="switcher" style="--switcher-threshold: 40rem">
											<div class="box stack" data-space="2xs">
												<p class="text-title">INV-0042</p>
												<p class="text-sm text-fg-muted tabular-nums">
													Issued 2026-11-02 · due 2026-12-01
												</p>
											</div>
											<div
												class="box stack"
												data-space="2xs"
												style="flex-grow: 1.5"
											>
												<p class="label-caps">Cost split</p>
												<p class="text-sm tabular-nums">
													Website relaunch 8,000 € · Billing API 4,400 €
												</p>
											</div>
										</div>
										<dl class="switcher" style="--switcher-threshold: 30rem">
											<div class="box stack" data-space="3xs">
												<dt class="label-caps">Used</dt>
												<dd class="tabular-nums">8,200 €</dd>
											</div>
											<div class="box stack" data-space="3xs">
												<dt class="label-caps">Left</dt>
												<dd class="tabular-nums">4,200 €</dd>
											</div>
											<div class="box stack" data-space="3xs">
												<dt class="label-caps">Budget</dt>
												<dd class="tabular-nums">12,400 €</dd>
											</div>
										</dl>
									</div>
								</div>
							</figure>
						))}
					</section>

					<section
						aria-labelledby="layout-cover"
						class="stack"
						data-space="xs"
						data-fixture="cover"
					>
						<h3 id="layout-cover" class="text-title">Cover</h3>
						<p class="text-sm text-fg-muted">
							The page shell at a 12rem minimum height: the main part grows, so
							the first part sits at the top and the last at the bottom, with or
							without the impersonation bar.
						</p>
						{frames.map(([frame, width]) => (
							<figure class="stack" data-space="3xs">
								<figcaption class="label-caps">{width}</figcaption>
								<div class="frame box" data-frame={frame}>
									<div class="stack">
										<div
											class="cover box"
											style="--cover-min: 12rem; --cover-pad: var(--space-xs); --cover-space: var(--space-xs)"
										>
											<p class="text-sm">craftlions · Dashboard</p>
											<p class="box text-sm text-fg-muted" data-cover="grow">
												Main
											</p>
											<p class="text-sm text-fg-muted">© 2026 craftlions</p>
										</div>
										<div
											class="cover box"
											style="--cover-min: 12rem; --cover-pad: var(--space-xs); --cover-space: var(--space-xs)"
										>
											<p class="box text-label bg-panel">
