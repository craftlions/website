	@layer page {
		.specimen {
			display: grid;
			gap: var(--space-m-l);
			padding: var(--space-s-m);
		}
		.intro {
			padding-inline-start: var(--space-xs);
		}
		.panel {
			grid-template-columns: minmax(0, 1fr);
			min-inline-size: 0;
		}
		.probe {
			display: block;
			block-size: 0.5rem;
		}
		.swatch {
			inline-size: 1.5rem;
			block-size: 1.5rem;
			border: var(--rule) var(--line);
		}
		/* A token's swatch and name; its contrast ratios sit beside it, or
		   below it once the name would get less than 11rem, the longest name. */
		.token-name {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			align-items: center;
			column-gap: var(--space-2xs);
		}
		.button-row {
			display: grid;
			grid-auto-flow: column;
			align-items: center;
			justify-content: start;
			gap: var(--space-s);
		}
		.pair {
			display: grid;
			grid-template-columns: auto auto;
			align-items: center;
			justify-content: start;
			gap: var(--space-xs);
		}
		.divided {
			border-block-start-width: var(--hairline);
			border-style: dashed;
			padding-block-start: var(--space-s);
		}
		.badges {
			justify-items: start;
		}
		.fit {
			inline-size: max-content;
		}
		.frame {
			inline-size: min(100%, 20rem);
		}
		.frame[data-frame="wide"] {
			inline-size: min(100%, 60rem);
		}
		.frame[data-frame="rows-narrow"] {
			inline-size: min(100%, 30rem);
		}
		.frame[data-frame="rows-wide"] {
			inline-size: min(100%, 64rem);
		}
	}
</style>
