---
export const prerender = false;

import Button from "../../components/Button.astro";
import SettingsShell from "../../layouts/SettingsShell.astro";

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}
---

<SettingsShell activePage="api">
	<api-key-create class="grid gap-4">
		<section aria-labelledby="api-keys-title" class="grid gap-3">
			<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
				<h2 id="api-keys-title" class="label-caps">API keys</h2>
				<Button aria-describedby="api-key-error" data-api-key-create>
					Create API key
				</Button>
			</div>
			<p class="text-sm text-fg-muted">
				A key belongs to your account. It is shown once, right after you create
				it.
			</p>
			<p
				id="api-key-error"
				role="alert"
				class="text-sm text-fg-danger"
				data-api-key-error
			></p>
		</section>
		<section
			aria-labelledby="new-api-key-title"
			aria-describedby="new-api-key-note"
			tabindex="-1"
			hidden
			class="grid gap-3"
			data-api-key-result
		>
			<h3 id="new-api-key-title" class="text-label">New API key</h3>
			<p id="new-api-key-note" class="text-sm text-fg-muted">
				Copy it now. It will not be shown again.
			</p>
			<p
				class="border border-dashed border-line-control p-3 text-sm wrap-anywhere select-all"
				translate="no"
				data-api-key-value
			></p>
			<div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3">
				<Button data-api-key-copy>Copy</Button>
				<p role="status" class="text-sm" data-api-key-copied></p>
			</div>
		</section>
	</api-key-create>
</SettingsShell>

<script>
	import { authClient } from "../../lib/auth-client.ts";

	class ApiKeyCreate extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const create = this.querySelector<HTMLButtonElement>(
				"[data-api-key-create]",
			);
			const error = this.querySelector<HTMLElement>("[data-api-key-error]");
			const result = this.querySelector<HTMLElement>("[data-api-key-result]");
			const value = this.querySelector<HTMLElement>("[data-api-key-value]");
			const copy = this.querySelector<HTMLButtonElement>("[data-api-key-copy]");
			const copied = this.querySelector<HTMLElement>("[data-api-key-copied]");

			if (!create || !error || !result || !value || !copy || !copied) return;

			create.addEventListener("click", async () => {
				create.disabled = true;
				error.textContent = "";
				let failed: Response | undefined;

				try {
					const { data, error: createError } = await authClient.apiKey.create({
						prefix: "sk_",
						fetchOptions: {
							onError: ({ response }) => {
								failed = response;
							},
						},
					});

					if (createError) throw createError;

					// The key lives only in this text node: never in an attribute, the
					// console, storage or the URL, so a reload cannot bring it back.
					value.textContent = data.key;
					copied.textContent = "";
					result.hidden = false;
					create.disabled = false;
					result.focus();
				} catch {
					create.disabled = false;
					const retryAfter = failed?.headers.get("X-Retry-After");
					// The live region is always rendered, so changing its text announces it.
					error.textContent =
						failed?.status !== 429
							? "Could not create an API key. Try again."
							: retryAfter
								? `Too many requests. Try again in ${retryAfter} seconds.`
								: "Too many requests. Try again in a minute.";
					create.focus();
				}
			});

			copy.addEventListener("click", async () => {
				copied.textContent = "";

				try {
					await navigator.clipboard.writeText(value.textContent ?? "");
					copied.className = "text-sm text-fg-success";
					copied.textContent = "Copied.";
				} catch {
					// Without clipboard access, select the key so the shortcut copies it.
					getSelection()?.selectAllChildren(value);
					copied.className = "text-sm text-fg";
					copied.textContent = "Key selected. Press Ctrl+C or ⌘C to copy it.";
				}
			});

			// The back-forward cache would otherwise restore the page with the key shown.
			window.addEventListener("pagehide", () => {
				value.textContent = "";
				copied.textContent = "";
				result.hidden = true;
			});
		}
	}

	if (!customElements.get("api-key-create")) {
		customElements.define("api-key-create", ApiKeyCreate);
	}
</script>
