---
export const prerender = false;

import Button from "../../components/Button.astro";
import SettingsShell from "../../layouts/SettingsShell.astro";

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}
---

<SettingsShell activePage="api">
	<Button id="create-api-key" type="button"> Create new API Key </Button>
</SettingsShell>

<script>
	import { authClient } from "../../lib/auth-client.ts";

	const button = document.getElementById("create-api-key");

	button?.addEventListener("click", async () => {
		const { data, error } = await authClient.apiKey.create({
			prefix: "sk_",
			metadata: {
				// isAdmin: true
			},
		});
		if (error) {
			console.error("Error creating API key:", error);
			return;
		}
		console.log("API key created successfully:", data);
	});
</script>
