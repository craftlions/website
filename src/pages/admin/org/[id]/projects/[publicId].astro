---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../../components/Badge.astro";
import Button from "../../../../../components/Button.astro";
import ConfirmAction from "../../../../../components/ConfirmAction.astro";
import DeliveryForm from "../../../../../components/DeliveryForm.astro";
import DisclosureButton from "../../../../../components/DisclosureButton.astro";
import Field from "../../../../../components/Field.astro";
import PhaseAmountCalculator from "../../../../../components/PhaseAmountCalculator.astro";
import PhaseTransitionForm from "../../../../../components/PhaseTransitionForm.astro";
import ProjectTransitionForm from "../../../../../components/ProjectTransitionForm.astro";
import AdminOrgShell from "../../../../../layouts/AdminOrgShell.astro";
import {
	deliveryRecordedMessage,
	phaseTransitionMessage,
	projectTransitionMessage,
	successMessage,
} from "../../../../../lib/action-feedback.ts";
import { getAdminOrganizationCore } from "../../../../../lib/admin-org.ts";
import {
	formatCurrency,
	formatDate,
	formatMoney,
	formatPercent,
} from "../../../../../lib/format.ts";
import { buildPhaseComponents } from "../../../../../lib/phase-billing.ts";
import {
	costPartLabel,
	phaseStatus,
	phaseTransitionsFrom,
	projectStatus,
	recordDeliveryLabel,
} from "../../../../../lib/status.ts";
import { submittedValues } from "../../../../../lib/submitted-values.ts";

const { id, publicId } = Astro.params;

if (!id || !publicId) {
	return Astro.redirect("/admin");
}

const [organization, project] = await Promise.all([
	getAdminOrganizationCore(Astro.locals.db, id),
	Astro.locals.db.query.projects.findFirst({
		columns: {
			id: true,
			publicId: true,
			name: true,
			state: true,
			version: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					publicId: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					deliveryAmount: true,
					acceptanceAmount: true,
					currency: true,
					state: true,
					version: true,
					dueAt: true,
					externalUrl: true,
					deliveryState: true,
					deliveryUrl: true,
				},
				with: {
					invoices: {
						columns: {
							component: true,
						},
						with: {
							stripe: { columns: { status: true } },
						},
					},
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
			publicId,
		},
	}),
]);

if (!organization) {
	return Astro.redirect("/admin");
}

if (!project) {
	return Astro.redirect(`/admin/org/${organization.id}/projects`);
}

// Accepted and cancelled phases are settled. The server completes a project
// only once every phase is settled (transitionProject in admin-mutations.ts).
const settledStates = ["accepted", "cancelled"];
const openPhaseCount = project.phases.filter(
	(phase) => !settledStates.includes(phase.state),
).length;

const createResult = Astro.getActionResult(actions.createPhase);
const projectResult = Astro.getActionResult(actions.createProject);
const canAddPhase = project.state === "draft" || project.state === "active";
// The add-phase form starts open after a failed add and right after the
// project was created, since adding phases is the next step.
const isAddPhaseOpen =
	Boolean(createResult?.error) || (projectResult && !projectResult.error);
// New phases default to the currency the project already bills in.
const defaultCurrency = project.phases.at(-1)?.currency ?? "EUR";

// Cost parts as a failed form submitted them; an empty part is not billed.
const submittedSplit = (values: URLSearchParams) => ({
	upfrontAmount: values.get("upfrontAmount")
		? Number(values.get("upfrontAmount"))
		: null,
	deliveryAmount: values.get("deliveryAmount")
		? Number(values.get("deliveryAmount"))
		: null,
	acceptanceAmount: values.get("acceptanceAmount")
		? Number(values.get("acceptanceAmount"))
		: null,
});
const createInput = submittedValues(Astro.locals, createResult);
const amountsInput = submittedValues(
	Astro.locals,
	Astro.getActionResult(actions.updatePhaseAmounts),
);

// The phase row the last phase action came from: its data names the phase
// on success, its submitted `phaseId` on failure. Only that row is marked.
const phaseResult = [
	Astro.getActionResult(actions.transitionPhase),
	Astro.getActionResult(actions.recordDelivery),
	Astro.getActionResult(actions.updatePhaseDelivery),
	Astro.getActionResult(actions.updatePhaseAmounts),
].find(Boolean);
const phaseInput = submittedValues(Astro.locals, phaseResult);
const actedPhase = project.phases.find(
	(phase) =>
		phase.id === (phaseResult?.data?.phaseId ?? phaseInput?.get("phaseId")),
);
// After a failure the row's More panel renders open when the failed form
// lives there: every form but the row's transition buttons, of which only
// "Cancel phase" sits in the panel.
const reopenedPhase =
	phaseInput && [null, "cancelled"].includes(phaseInput.get("nextState"))
		? actedPhase
		: undefined;

// Open phases first, settled ones after; each group keeps creation order.
const phases = project.phases
	.map((phase) => ({
		...phase,
		components: buildPhaseComponents(phase),
		settled: settledStates.includes(phase.state),
	}))
	.toSorted((a, b) => Number(a.settled) - Number(b.settled));
---

<AdminOrgShell
	{organization}
	activePage="projects"
	breadcrumbs={[{ label: project.name }]}
	results={[
		successMessage(
			Astro.getActionResult(actions.transitionProject),
			(transition) => projectTransitionMessage[transition.event],
		),
		[projectResult, "Project created. Add its phases, then activate it."],
		[createResult, "Phase added. Send it to the client when it is ready."],
		successMessage(
			Astro.getActionResult(actions.transitionPhase),
			(phase) => phaseTransitionMessage[phase.state],
		),
		[Astro.getActionResult(actions.recordDelivery), deliveryRecordedMessage],
		[Astro.getActionResult(actions.updatePhaseDelivery), "Delivery updated."],
		[Astro.getActionResult(actions.updatePhaseAmounts), "Cost split saved."],
	]}
	fieldLabels={{
		title: "Title",
		cost: "Cost",
		currency: "Currency",
		dueAt: "Due date",
		upfrontAmount: "Upfront",
		deliveryAmount: "Delivery",
		acceptanceAmount: "Acceptance",
		deliveryChoice: "Delivery",
		deliveryUrl: "Delivery URL",
	}}
>
	<header class="stack" data-space="xs">
		<div class="cluster" data-space="xs">
			<h2 id="project-heading" class="text-headline wrap-break-word">
				{project.name}
			</h2>
			<Badge type={projectStatus[project.state].badge}
				>{projectStatus[project.state].label}</Badge
			>
		</div>
		{project.state === "draft" && (
			<ProjectTransitionForm {project} nextState="active" />
		)}
		{project.state === "active" &&
			(openPhaseCount === 0 ? (
				<ProjectTransitionForm {project} nextState="completed" />
			) : (
				<div class="with-sidebar" data-align="center">
					<ProjectTransitionForm
						{project}
						nextState="completed"
						button={{ disabled: true, "aria-describedby": "complete-blocked" }}
					/>
					<p id="complete-blocked" class="text-sm text-fg-muted">
						{openPhaseCount === 1
							? "1 phase is still open. Accept or cancel it to complete the project."
							: `${openPhaseCount} phases are still open. Accept or cancel them to complete the project.`}
					</p>
				</div>
			))}
		{project.state === "completed" && (
			<div class="cluster" data-space="s">
				<ProjectTransitionForm {project} nextState="active" />
				<form method="POST" action={actions.transitionProject}>
					<input type="hidden" name="projectId" value={project.id}>
					<input type="hidden" name="nextState" value="archived">
					<input type="hidden" name="expectedVersion" value={project.version}>
					<ConfirmAction
						id="archive-project"
						trigger="Archive"
						triggerLabel={`Archive: ${project.name}`}
						triggerVariant="quiet"
						title={`Archive ${project.name}?`}
						confirm="Archive"
						cancel="Keep project"
					>
						Archiving is final: the project cannot be reopened and no phases can
						be added to it. Its phases and invoices stay as they are.
					</ConfirmAction>
				</form>
			</div>
		)}
	</header>

	<section aria-labelledby="phases-heading">
		<div class="with-sidebar" data-side="end" data-align="center">
			<h3 id="phases-heading" class="label-caps"> Phases </h3>
			{canAddPhase && (
				<DisclosureButton controls="add-phase" open={isAddPhaseOpen}>
					Add phase
				</DisclosureButton>
			)}
		</div>
		<p class="measure text-sm text-fg-muted">
			Open phases come first. Each row offers its next step; corrections and
			cancelling sit under More.
			{!canAddPhase && " Phases can only be added to draft or active projects."}
		</p>
		{canAddPhase && (
			<form
				id="add-phase"
				method="POST"
				action={actions.createPhase}
				class="box stack"
				aria-label="Add phase"
				hidden={!isAddPhaseOpen}
			>
				<input type="hidden" name="projectId" value={project.id}>
				<Field
					label="Title"
					name="title"
					required
					maxlength="180"
					hint="Shown to the client in their project view."
					result={createResult}
				/>
				<div class="switcher" style="--switcher-threshold: 40rem">
					<Field
						as="select"
						label="Currency"
						name="currency"
						required
						hint="Every invoice of the phase bills in this currency."
						result={createResult}
					>
						{[
							...new Set([
								...Intl.supportedValuesOf("currency"),
								...project.phases.map((phase) => phase.currency),
							]),
						]
							.toSorted()
							.map((code) => (
								<option value={code} selected={code === defaultCurrency}>
									{formatCurrency(code)}
								</option>
							))}
					</Field>
					<Field
						label="Cost"
						name="cost"
						type="number"
						min="0"
						step="0.0001"
						inputmode="decimal"
						required
						hint="Total for the phase in the currency chosen, e.g. 4800.50."
						result={createResult}
					/>
					<Field
						label="Due date"
						name="dueAt"
						type="date"
						hint="Optional target date shown to the client."
						result={createResult}
					/>
				</div>
				<PhaseAmountCalculator
					cost={Number(createInput?.get("cost")) || 0}
					currency={createInput?.get("currency") ?? defaultCurrency}
					{...(createInput
						? submittedSplit(createInput)
						: { acceptanceAmount: 0 })}
					class="phase-form-split"
				/>
				<div class="cluster" data-space="xs">
					<Button type="submit">Add phase</Button>
					<Button variant="quiet" data-disclosure-cancel>
						Cancel
					</Button>
				</div>
			</form>
		)}
		{phases.length > 0 ? (
			<admin-phase-list
				class="rows admin-phases"
				data-at="60"
				style="--rows-columns: minmax(0, 1fr) auto auto auto auto"
				data-acted={actedPhase && `phase-${actedPhase.publicId}`}
			>
				<ul>
					<li aria-hidden="true" class="admin-phases-head label-caps" data-head>
						<span>Phase</span>
						<span>State</span>
						<span>Amount</span>
						<span>Next step</span>
					</li>
					{phases.map((phase) => (
						<li id={`phase-${phase.publicId}`} class="phase-row" data-phase>
							<div class="stack phase-info" data-space="3xs">
								<h4
									class:list={[
										"wrap-break-word",
										phase.settled ? "text-fg-muted" : undefined,
									]}
									data-cancelled={phase.state === "cancelled" || undefined}
								>
									{phase.title}
								</h4>
								<p class="text-sm text-fg-muted">
									{phase.dueAt
										? `Due ${formatDate(phase.dueAt)}`
										: "No due date"}
								</p>
								{phase.externalUrl && (
									<a
										class="text-sm link"
										href={phase.externalUrl}
										rel="noopener noreferrer"
										target="_blank"
										aria-label={`Epic: ${phase.title} (opens in a new tab)`}
									>
										Epic
									</a>
								)}
								{phase.deliveryState === "url" && phase.deliveryUrl ? (
									<a
										class="text-sm link"
										href={phase.deliveryUrl}
										rel="noopener noreferrer"
										target="_blank"
										aria-label={`Delivery: ${phase.title} (opens in a new tab)`}
									>
										Delivery
									</a>
								) : (
									phase.deliveryState === "none" && (
										<p class="text-sm text-fg-muted">
											Delivered without a PR/MR
										</p>
									)
								)}
							</div>
							<Badge type={phaseStatus[phase.state].badge}>
								{phaseStatus[phase.state].label}
							</Badge>
							<div class="stack phase-amount" data-space="3xs">
								<p
									class:list={[
										"tabular-nums wrap-break-word",
										phase.settled ? "text-fg-muted" : undefined,
									]}
								>
									{formatMoney(phase.cost, phase.currency)}
								</p>
								{phase.components.length > 0 ? (
									<ul
										class="stack text-xs tabular-nums text-fg-muted wrap-break-word"
										data-space="3xs"
										aria-label={`Cost split of ${phase.title}`}
									>
										{phase.components.map((part) => (
											<li>
												{costPartLabel[part.component]}
												{phase.cost > 0 &&
													` ${formatPercent((part.amount / phase.cost) * 100)}`}
												{" · "}
												{formatMoney(part.amount, phase.currency)}
											</li>
										))}
									</ul>
								) : (
									<p class="text-xs text-fg-muted">Nothing to bill</p>
								)}
							</div>
							{phaseTransitionsFrom(phase.state)
								.filter((nextState) => nextState !== "cancelled")
								.map((nextState) => (
									<PhaseTransitionForm {phase} {nextState} class="phase-step" />
								))}
							{phase.state === "in_progress" && (
								<DisclosureButton
									controls={`phase-${phase.publicId}-more`}
									open={phase.id === reopenedPhase?.id}
									class="phase-step"
									aria-label={`${recordDeliveryLabel}: ${phase.title}`}
								>
									{recordDeliveryLabel}
								</DisclosureButton>
							)}
							{["submitted", "planned", "delivered", "accepted"].includes(
								phase.state,
							) && (
								<DisclosureButton
									controls={`phase-${phase.publicId}-more`}
									open={phase.id === reopenedPhase?.id}
									variant="quiet"
									class="phase-more"
									aria-label={`More: ${phase.title}`}
								>
									More
								</DisclosureButton>
							)}
							{!["approved", "cancelled"].includes(phase.state) && (
								<div
									id={`phase-${phase.publicId}-more`}
									class="stack phase-panel"
									hidden={phase.id !== reopenedPhase?.id}
								>
									{phase.state === "in_progress" && (
										<DeliveryForm
											mode="record"
											{phase}
											result={Astro.getActionResult(actions.recordDelivery)}
										/>
									)}
									{(phase.state === "delivered" ||
										phase.state === "accepted") && (
										<DeliveryForm
											mode="edit"
											{phase}
											result={Astro.getActionResult(
												actions.updatePhaseDelivery,
											)}
										/>
									)}
									{(phase.state === "submitted" ||
										phase.state === "planned") && (
										<>
											<form
												method="POST"
												action={actions.updatePhaseAmounts}
												class="box stack phase-split-form"
												data-space="xs"
											>
												<input type="hidden" name="phaseId" value={phase.id}>
												<input
													type="hidden"
													name="expectedVersion"
													value={phase.version}
												>
												<PhaseAmountCalculator
													cost={phase.cost}
													currency={phase.currency}
													upfrontAmount={phase.upfrontAmount}
													deliveryAmount={phase.deliveryAmount}
													acceptanceAmount={phase.acceptanceAmount}
													{...(amountsInput?.get("phaseId") === phase.id
														? submittedSplit(amountsInput)
														: {})}
												/>
												<Button
													type="submit"
													aria-label={`Save cost split: ${phase.title}`}
												>
													Save cost split
												</Button>
											</form>
											<PhaseTransitionForm {phase} nextState="cancelled" />
										</>
									)}
								</div>
							)}
						</li>
					))}
				</ul>
			</admin-phase-list>
		) : (
			<p class="box text-sm text-fg-muted">
				No phases yet. Add the first phase, then send it to the client.
			</p>
		)}
	</section>
</AdminOrgShell>

<script>
	// Deep links (`#phase-<publicId>`, from the worklist and invoices) and the
	// row the last action came from (`data-acted`, set by the server) are
	// marked with `data-highlight`, which src/styles/base.css draws as a
	// background tint plus a non-color outline cue, without motion. A
	// deep-linked row also opens its More panel, the way its DisclosureButton
	// does; the server already rendered the acted row's panel open when its
	// failed form lives there.

	class AdminPhaseList extends HTMLElement {
		currentTarget: HTMLElement | null = null;

		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const row = document.getElementById(this.dataset.acted ?? "");
			if (row && this.contains(row)) {
				this.mark(row);
			} else {
				this.applyHash();
			}
			window.addEventListener("hashchange", () => this.applyHash());
		}

		mark(row: HTMLElement) {
			this.currentTarget?.removeAttribute("data-highlight");
			row.setAttribute("data-highlight", "");
			this.currentTarget = row;
		}

		applyHash() {
			const target = document.getElementById(location.hash.slice(1));
			if (
				target instanceof HTMLElement &&
				this.contains(target) &&
				target.matches("[data-phase]")
			) {
				this.mark(target);
				const panel = document.getElementById(`${target.id}-more`);
				if (!panel) return;
				for (const toggle of this.querySelectorAll(
					`[aria-controls="${CSS.escape(panel.id)}"]`,
				)) {
					toggle.setAttribute("aria-expanded", "true");
				}
				panel.hidden = false;
			} else {
				this.currentTarget?.removeAttribute("data-highlight");
				this.currentTarget = null;
			}
		}
	}

	if (!customElements.get("admin-phase-list")) {
		customElements.define("admin-phase-list", AdminPhaseList);
	}
</script>
