---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	componentBillingStatus,
	invoiceComponents,
	isInvoiceComponentDue,
} from "../../../../lib/phase-billing.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const organization = await getAdminOrganizationCore(Astro.locals.db, id);

if (!organization) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.importStripeInvoices),
	Astro.getActionResult(actions.attachInvoiceToPhase),
	Astro.getActionResult(actions.recordInvoice),
	Astro.getActionResult(actions.updatePhaseDelivery),
	Astro.getActionResult(actions.refreshStripeInvoice),
	Astro.getActionResult(actions.transitionPhase),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const [organizationData, projects, unattachedInvoices] = await Promise.all([
	Astro.locals.db.query.organizationMetadata.findFirst({
		columns: {
			stripeCustomerId: true,
		},
		where: {
			organizationId: id,
		},
	}),
	Astro.locals.db.query.projects.findMany({
		columns: {
			id: true,
			publicId: true,
			name: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					deliveryAmount: true,
					acceptanceAmount: true,
					currency: true,
					state: true,
					version: true,
					deliveryState: true,
					deliveryUrl: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
							component: true,
							invoiceNumber: true,
							stripePaymentPage: true,
							total: true,
							stripeStatus: true,
							stripePaidAt: true,
							stripeDueAt: true,
							fetchedAt: true,
						},
					},
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
	Astro.locals.db.query.invoices.findMany({
		columns: {
			id: true,
			invoiceNumber: true,
			stripePaymentPage: true,
			currency: true,
			total: true,
			stripeStatus: true,
			stripeDueAt: true,
			stripePaidAt: true,
		},
		where: {
			organizationId: id,
			phaseId: {
				isNull: true,
			},
		},
		orderBy: {
			id: "desc",
		},
	}),
]);
const allPhases = projects.flatMap((project) =>
	project.phases.map((phase) => ({ ...phase, project })),
);
const componentTargets = allPhases.flatMap((phase) =>
	invoiceComponents.flatMap((component) => {
		const amount = phase[`${component}Amount`];
		if (amount === null || amount === 0) return [];
		const invoice = phase.invoices.find((row) => row.component === component);
		return [{ ...phase, component, amount, invoice }];
	}),
);
const attachableTargets = componentTargets.filter(
	(target) =>
		!target.invoice && isInvoiceComponentDue(target.component, target.state),
);
const recordableTargets = attachableTargets;
const deliveryPhaseIds = new Set<string>();
const recordedTargets = componentTargets
	.filter((target) => target.invoice)
	.toSorted((a, b) => (b.invoice?.id ?? "").localeCompare(a.invoice?.id ?? ""))
	.map((target) => {
		const showDelivery = !deliveryPhaseIds.has(target.id);
		deliveryPhaseIds.add(target.id);
		return { ...target, showDelivery };
	});
const targetValue = (target: (typeof componentTargets)[number]) =>
	`${target.id}:${target.component}:${target.version}`;
const suggestedTarget = (invoice: (typeof unattachedInvoices)[number]) =>
	attachableTargets
		.filter((target) => target.currency === invoice.currency)
		.toSorted(
			(a, b) =>
				Math.abs(a.amount - invoice.total) - Math.abs(b.amount - invoice.total),
		)[0];
const suggestedTargetValue = (invoice: (typeof unattachedInvoices)[number]) => {
	const target = suggestedTarget(invoice);
	return target ? targetValue(target) : "";
};
const formatCurrency = (amount: number, currency: string) =>
	new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(
		amount,
	);
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });
const inputClass =
	"border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300";
const quietButtonClass =
	"w-max cursor-pointer text-sm text-neutral-500 underline decoration-dashed underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100";
const summaryClass =
	"w-max cursor-pointer list-none text-sm text-neutral-500 underline decoration-dashed underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100";
const sectionLabelClass =
	"text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400";
const stripeLine = (invoice: {
	stripeStatus: string | null;
	stripeDueAt: Date | null;
	stripePaidAt: Date | null;
	fetchedAt?: Date | null;
}) =>
	[
		`Stripe ${invoice.stripeStatus ?? "not fetched"}`,
		invoice.stripeDueAt && `due ${dateFormatter.format(invoice.stripeDueAt)}`,
		invoice.stripePaidAt &&
			`paid ${dateFormatter.format(invoice.stripePaidAt)}`,
		invoice.fetchedAt && `fetched ${dateFormatter.format(invoice.fetchedAt)}`,
	]
		.filter(Boolean)
		.join(" · ");
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	showSuccess={actionSucceeded}
>
	{actionError && <p class="border border-dashed border-red-300 p-3 text-sm text-red-700 dark:border-red-700 dark:text-red-300">{actionError.message}</p>}
	<section class="grid gap-6" aria-labelledby="invoices-heading">
		<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
			<h2 id="invoices-heading" class={sectionLabelClass}>Invoices</h2>
			{organizationData?.stripeCustomerId ? (
				<form method="POST" action={actions.importStripeInvoices}>
					<input type="hidden" name="organizationId" value={organization.id} />
					<Button type="submit">Fetch from Stripe</Button>
				</form>
			) : (
				<Button href={`/admin/org/${organization.id}/settings`}>Link Stripe customer</Button>
			)}
		</div>

		{unattachedInvoices.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Unattached from Stripe</h3>
				<ul class="grid border border-dashed border-neutral-300 dark:border-neutral-700">
					{unattachedInvoices.map((invoice) => (
						<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1.5fr)] md:items-center">
							<div class="grid gap-1">
								<a class="w-max font-medium underline decoration-dashed underline-offset-4" href={invoice.stripePaymentPage}>{invoice.invoiceNumber}</a>
								<p class="text-xs text-neutral-500 dark:text-neutral-400">{stripeLine(invoice)}</p>
							</div>
							<p class="font-medium tabular-nums md:text-right">{formatCurrency(invoice.total, invoice.currency)}</p>
							{attachableTargets.some((target) => target.currency === invoice.currency) ? (
								<form method="POST" action={actions.attachInvoiceToPhase} class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
									<input type="hidden" name="invoiceId" value={invoice.id} />
									<select name="target" aria-label="Phase component" required class={inputClass}>
										{attachableTargets.filter((target) => target.currency === invoice.currency).map((target) => (
											<option value={targetValue(target)} selected={targetValue(target) === suggestedTargetValue(invoice)}>{target.project.name} · {target.title} · {target.component} · {formatCurrency(target.amount, target.currency)}{targetValue(target) === suggestedTargetValue(invoice) ? " (suggested)" : ""}</option>
										))}
									</select>
									<Button type="submit">Attach</Button>
								</form>
							) : (
								<p class="text-sm text-neutral-500 dark:text-neutral-400">No matching phase</p>
							)}
						</li>
					))}
				</ul>
			</div>
		)}

		{recordableTargets.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Due, not invoiced</h3>
				<ul class="grid border border-dashed border-neutral-300 dark:border-neutral-700">
					{recordableTargets.map((target) => (
						<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_auto] md:items-center">
							<div class="grid gap-1">
								<p class="font-medium"><a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}>{target.project.name}</a> · {target.title}</p>
								<p class="text-xs capitalize text-neutral-500 dark:text-neutral-400">{target.component}</p>
							</div>
							<p class="font-medium tabular-nums md:text-right">{formatCurrency(target.amount, target.currency)}</p>
							<Badge type="info">due</Badge>
							<details class="grid gap-3 md:col-span-3">
								<summary class={summaryClass}>Record invoice</summary>
								<form method="POST" action={actions.recordInvoice} class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.5fr)_8rem] md:items-start">
									<input type="hidden" name="phaseId" value={target.id} />
									<input type="hidden" name="component" value={target.component} />
									<input type="hidden" name="expectedVersion" value={target.version} />
									<label class="grid gap-1 text-sm"><span class="font-medium">Invoice number</span><input class={inputClass} name="invoiceNumber" required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Stripe id</span><input class={inputClass} name="stripeId" required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Payment URL</span><input class={inputClass} name="stripePaymentPage" type="url" required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Total</span><input class={inputClass} name="total" type="number" min="0" step="0.0001" value={target.amount} data-component-amount={target.amount} required /><span class="text-xs text-amber-700 dark:text-amber-300" data-amount-warning hidden>Differs from the component amount of {formatCurrency(target.amount, target.currency)}.</span></label>
									<Button type="submit" class="md:col-span-full">Record</Button>
								</form>
							</details>
						</li>
					))}
				</ul>
			</div>
		)}

		<div class="grid gap-3">
			<h3 class={sectionLabelClass}>Recorded</h3>
			<ul
				class="grid border border-dashed border-neutral-300 dark:border-neutral-700"
			>
				{recordedTargets.length > 0 ? recordedTargets.map((target) => target.invoice && (
					<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_auto_auto] md:items-start">
						<div class="grid gap-1">
							<a class="w-max font-medium underline decoration-dashed underline-offset-4" href={target.invoice.stripePaymentPage}>{target.invoice.invoiceNumber}</a>
							<p class="text-sm"><a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}>{target.project.name}</a> · {target.title} · {target.component}</p>
							<p class="text-xs text-neutral-500 dark:text-neutral-400">{stripeLine(target.invoice)}</p>
							{target.showDelivery && (
								target.deliveryState === "url" && target.deliveryUrl ? (
									<a class="w-max text-xs underline decoration-dashed underline-offset-4" href={target.deliveryUrl} rel="noreferrer" target="_blank">Delivery</a>
								) : (
									<p class="text-xs text-neutral-500 dark:text-neutral-400">{target.deliveryState === "none" ? "Delivered without PR/MR" : "Delivery not recorded"}</p>
								)
							)}
						</div>
						<Badge type={target.invoice.stripeStatus === "paid" ? "success" : "info"}>{componentBillingStatus({ component: target.component, state: target.state, invoice: target.invoice })}</Badge>
						<div class="grid gap-1 md:text-right">
							<p class="font-medium tabular-nums">{formatCurrency(target.invoice.total, target.currency)}</p>
							{target.invoice.total !== target.amount && <p class="text-xs text-amber-700 dark:text-amber-300">Expected {formatCurrency(target.amount, target.currency)}</p>}
						</div>
						<form method="POST" action={actions.refreshStripeInvoice} class="md:justify-self-end">
							<input type="hidden" name="invoiceId" value={target.invoice.id} />
							<button type="submit" class={quietButtonClass}>Refresh</button>
						</form>
						{target.showDelivery && (target.state === "delivered" || target.state === "accepted") && (
							<details class="grid gap-3 md:col-span-4">
								<summary class={summaryClass}>Edit delivery</summary>
								<form method="POST" action={actions.updatePhaseDelivery} class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-end">
									<input type="hidden" name="phaseId" value={target.id} />
									<input type="hidden" name="expectedVersion" value={target.version} />
									<label class="grid gap-1 text-sm"><span class="font-medium">Delivery</span><select name="deliveryChoice" data-delivery-choice required class={inputClass}><option value="url" selected={target.deliveryState !== "none"}>Delivery link</option><option value="none" selected={target.deliveryState === "none"}>No delivery PR/MR</option></select></label>
									<label data-delivery-url-field class="grid gap-1 text-sm"><span class="font-medium">Delivery URL</span><input class={inputClass} name="deliveryUrl" type="url" inputmode="url" autocomplete="off" value={target.deliveryUrl ?? ""} placeholder="https://github.com/…" /></label>
									<Button type="submit">Update delivery</Button>
								</form>
							</details>
						)}
					</li>
				)) : (
					<li class="p-4 text-sm text-neutral-600 dark:text-neutral-400">No invoices recorded.</li>
				)}
			</ul>
		</div>
	</section>
</AdminOrgShell>

<script>
	for (const input of document.querySelectorAll("[data-component-amount]")) {
		if (!(input instanceof HTMLInputElement)) continue;
		const warning = input.parentElement?.querySelector("[data-amount-warning]");
		if (!(warning instanceof HTMLElement)) continue;
		const syncWarning = () => {
			warning.hidden =
				Number(input.value) === Number(input.dataset.componentAmount);
		};
		syncWarning();
		input.addEventListener("input", syncWarning);
	}

	for (const select of document.querySelectorAll("[data-delivery-choice]")) {
		if (!(select instanceof HTMLSelectElement)) {
			continue;
		}

		const field = select
			.closest("form")
			?.querySelector<HTMLLabelElement>("[data-delivery-url-field]");
		const input = field?.querySelector<HTMLInputElement>(
			'input[name="deliveryUrl"]',
		);

		if (
			!(field instanceof HTMLElement) ||
			!(input instanceof HTMLInputElement)
		) {
			continue;
		}

		const syncDeliveryUrl = () => {
			const show = select.value === "url";
			field.hidden = !show;
			input.required = show;

			if (!show) {
				input.value = "";
			}
		};

		syncDeliveryUrl();
		select.addEventListener("change", syncDeliveryUrl);
	}
</script>
