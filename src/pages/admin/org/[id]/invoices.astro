---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import ConfirmAction from "../../../../components/ConfirmAction.astro";
import Field from "../../../../components/Field.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	formatDate,
	formatDays,
	formatMoney,
	sumByCurrency,
} from "../../../../lib/format.ts";
import {
	costPartsToInvoice,
	invoiceComponents,
} from "../../../../lib/phase-billing.ts";
import {
	costPartLabel,
	daysOverdue,
	invoiceStatus,
	isInvoiceOverdue,
	phaseStatus,
} from "../../../../lib/status.ts";
import {
	organizationStripeInvoices,
	stripeInvoiceFields,
} from "../../../../lib/stripe.ts";
import { submittedValues } from "../../../../lib/submitted-values.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const attachResult = Astro.getActionResult(actions.attachInvoiceToPhase);
// After a failed attach, only that invoice's row shows the error and keeps
// the part that was picked.
const attachInput = submittedValues(Astro.locals, attachResult);

const [organization, organizationData, projects, unattachedInvoices] =
	await Promise.all([
		getAdminOrganizationCore(Astro.locals.db, id),
		Astro.locals.db.query.organizationMetadata.findFirst({
			columns: {
				stripeCustomerId: true,
			},
			where: {
				organizationId: id,
			},
		}),
		Astro.locals.db.query.projects.findMany({
			columns: {
				id: true,
				publicId: true,
				name: true,
			},
			with: {
				phases: {
					columns: {
						id: true,
						publicId: true,
						title: true,
						upfrontAmount: true,
						deliveryAmount: true,
						acceptanceAmount: true,
						currency: true,
						state: true,
						version: true,
					},
					with: {
						invoices: {
							columns: {
								component: true,
							},
							with: {
								stripe: stripeInvoiceFields,
							},
						},
					},
					orderBy: {
						id: "asc",
					},
				},
			},
			where: {
				organizationId: id,
			},
			orderBy: {
				name: "asc",
			},
		}),
		Astro.locals.db.query.stripeInvoices.findMany({
			...stripeInvoiceFields,
			where: {
				...organizationStripeInvoices(id),
				NOT: { link: true },
			},
			orderBy: {
				invoicedAt: "desc",
			},
		}),
	]);

if (!organization) {
	return Astro.redirect("/admin");
}

const now = new Date();
// Stripe dashboard paths: /customers/{cus_…} and /invoices/{in_…}.
const stripeDashboard = "https://dashboard.stripe.com";
const phaseHref = (
	project: { publicId: string },
	phase: { publicId: string },
) =>
	`/admin/org/${organization.id}/projects/${project.publicId}#phase-${phase.publicId}`;

// One entry per priced cost part, in project and phase order.
const parts = projects.flatMap((project) =>
	project.phases.flatMap((phase) =>
		invoiceComponents.flatMap((component) => {
			const amount = phase[`${component}Amount`];
			if (amount === null || amount === 0) return [];
			return [
				{
					project,
					phase,
					component,
					amount,
					link: phase.invoices.find((row) => row.component === component),
				},
			];
		}),
	),
);
const unbilledParts = parts.filter(
	(part) => !part.link && part.phase.state !== "cancelled",
);
const dueParts = projects.flatMap((project) =>
	project.phases.flatMap((phase) =>
		costPartsToInvoice(phase).map((part) => ({ ...part, project, phase })),
	),
);
const recorded = parts
	.flatMap((part) =>
		part.link?.stripe ? [{ ...part, invoice: part.link.stripe }] : [],
	)
	.toSorted((a, b) => {
		// Overdue first (longest overdue on top), then open by due date, then
		// everything else newest first.
		const rank = (invoice: typeof a.invoice) =>
			isInvoiceOverdue(invoice, now) ? 0 : invoice.status === "open" ? 1 : 2;
		return (
			rank(a.invoice) - rank(b.invoice) ||
			(rank(a.invoice) < 2
				? (a.invoice.dueAt?.getTime() ?? Number.MAX_SAFE_INTEGER) -
					(b.invoice.dueAt?.getTime() ?? Number.MAX_SAFE_INTEGER)
				: b.invoice.invoicedAt.getTime() - a.invoice.invoicedAt.getTime())
		);
	});
// Open (overdue included) above paid; void and uncollectible ones, if any,
// last and without a total, since they are not owed. Each group keeps the
// order above.
const invoiceGroups = [
	{ id: "open", label: "Open", empty: "Nothing is open." },
	{ id: "paid", label: "Paid", empty: "Nothing is paid yet." },
	{ id: "other", label: "Void or uncollectible", empty: undefined },
]
	.map((group) => ({
		...group,
		rows: recorded.filter(
			(row) =>
				group.id ===
				(["open", "paid"].includes(row.invoice.status)
					? row.invoice.status
					: "other"),
		),
	}))
	.filter((group) => group.empty || group.rows.length > 0);
const unavailableCount = parts.filter(
	(part) => part.link && !part.link.stripe,
).length;
const liveInvoices = [
	...recorded.map((row) => row.invoice),
	...unattachedInvoices,
];
const defaultCurrency =
	parts[0]?.phase.currency ?? unattachedInvoices[0]?.currency ?? "EUR";

// Paid date, days overdue, due date or issue date: the one fact that matters
// for the invoice's current status, worded to stand alone ("paid 10.01.2026").
const statusDetail = (invoice: {
	status: string;
	dueAt: Date | null;
	paidAt: Date | null;
	invoicedAt: Date;
}) =>
	invoice.status === "paid" && invoice.paidAt
		? `paid ${formatDate(invoice.paidAt)}`
		: isInvoiceOverdue(invoice, now)
			? `${formatDays(daysOverdue(invoice, now))} overdue`
			: invoice.dueAt
				? `due ${formatDate(invoice.dueAt)}`
				: `issued ${formatDate(invoice.invoicedAt)}`;

// Why an unattached invoice has no due cost part in its currency.
const attachBlocker = (invoice: { currency: string }) => {
	const pending = unbilledParts.filter(
		(part) => part.phase.currency === invoice.currency,
	);
	if (pending.length > 0) {
		return `No ${invoice.currency} cost part is due yet. Next up: ${pending
			.slice(0, 2)
			.map(
				(part) =>
					`${part.project.name} · ${part.phase.title} · ${costPartLabel[part.component]} (${phaseStatus[part.phase.state].label})`,
			)
			.join("; ")}.`;
	}
	if (unbilledParts.length > 0) {
		return `This invoice is in ${invoice.currency}; the open cost parts are in ${[
			...new Set(unbilledParts.map((part) => part.phase.currency)),
		].join(", ")}.`;
	}
	return parts.length > 0
		? "Every cost part already has an invoice."
		: "There are no priced phases to attach it to.";
};
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	results={[[attachResult, "Invoice attached to its cost part."]]}
	fieldLabels={{ stripeId: "Stripe invoice", target: "Attach to" }}
>
	<section aria-labelledby="summary-heading">
		<h2 id="summary-heading" class="label-caps"> Summary </h2>
		<dl class="cluster" data-space="metrics" data-align="start">
			<div>
				<dt class="label-caps">Outstanding</dt>
				<dd class="text-title tabular-nums wrap-break-word">
					{sumByCurrency(
						liveInvoices
							.filter((invoice) => invoice.status === "open")
							.map((invoice) => ({
								amount: invoice.total,
								currency: invoice.currency,
							})),
						defaultCurrency,
					)}
				</dd>
			</div>
			<div>
				<dt class="label-caps">Overdue</dt>
				<dd
					class:list={[
						"text-title tabular-nums wrap-break-word",
						liveInvoices.some((invoice) => isInvoiceOverdue(invoice, now))
							? "text-fg-danger"
							: null,
					]}
				>
					{sumByCurrency(
						liveInvoices
							.filter((invoice) => isInvoiceOverdue(invoice, now))
							.map((invoice) => ({
								amount: invoice.total,
								currency: invoice.currency,
							})),
						defaultCurrency,
					)}
				</dd>
			</div>
			<div>
				<dt class="label-caps">To invoice</dt>
				<dd class="text-title tabular-nums wrap-break-word">
					{sumByCurrency(
						dueParts.map((part) => ({
							amount: part.amount,
							currency: part.phase.currency,
						})),
						defaultCurrency,
					)}
				</dd>
			</div>
		</dl>
		<nav aria-label="On this page">
			<ul class="cluster">
				<li>
					<Button href="#to-invoice" variant="quiet">
						To invoice ({dueParts.length})
					</Button>
				</li>
				<li>
					<Button href="#to-attach" variant="quiet">
						To attach ({unattachedInvoices.length})
					</Button>
				</li>
				<li>
					<Button href="#invoices" variant="quiet">
						Invoices ({recorded.length})
					</Button>
				</li>
			</ul>
		</nav>
	</section>

	<section
		id="to-invoice"
		aria-labelledby="to-invoice-heading"
		class="stack invoices-section"
		data-space="xs"
	>
		<h2 id="to-invoice-heading" class="label-caps">
			To invoice ({dueParts.length})
		</h2>
		<p class="measure text-sm text-fg-muted">
			Cost parts that are due and have no invoice yet. Create the invoice in
			Stripe, then attach it under To attach.
		</p>
		{!organizationData?.stripeCustomerId && (
			<div class="box stack text-sm" data-space="xs">
				<p>
					No Stripe customer linked.{" "}
					<span class="text-fg-muted">
						Add the client's Stripe customer ID in settings to open the client
						in Stripe from here.
					</span>
				</p>
				<Button href={`/admin/org/${organization.id}/settings#billing-heading`}>
					Link Stripe customer
				</Button>
			</div>
		)}
		{dueParts.length > 0 ? (
			<ul
				class="lines"
				data-actions="narrow"
				aria-labelledby="to-invoice-heading"
			>
				{dueParts.map((part) => (
					<li>
						<div class="line-text">
							<h3>
								<a class="link" href={phaseHref(part.project, part.phase)}>
									{part.project.name} · {part.phase.title}
								</a>
							</h3>
							<p class="cluster text-sm text-fg-muted">
								<Badge type={phaseStatus[part.phase.state].badge}>
									{phaseStatus[part.phase.state].label}
								</Badge>
								<span>{costPartLabel[part.component]} part</span>
							</p>
						</div>
						<p class="line-figure">
							<span>{formatMoney(part.amount, part.phase.currency)}</span>
						</p>
						{organizationData?.stripeCustomerId && (
							<div class="line-actions cluster">
								<Button
									href={`${stripeDashboard}/customers/${organizationData.stripeCustomerId}`}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`Create in Stripe: ${part.project.name} · ${part.phase.title} · ${costPartLabel[part.component]} (opens in a new tab)`}
								>
									Create in Stripe
								</Button>
							</div>
						)}
					</li>
				))}
			</ul>
		) : (
			<p class="box text-sm text-fg-muted">
				Nothing to invoice. Cost parts appear here once their phase makes them
				due.
			</p>
		)}
	</section>

	<section
		id="to-attach"
		aria-labelledby="to-attach-heading"
		class="stack invoices-section"
		data-space="xs"
	>
		<h2 id="to-attach-heading" class="label-caps">
			To attach ({unattachedInvoices.length})
		</h2>
		<p class="measure text-sm text-fg-muted">
			Stripe invoices for this client that are not linked to a cost part yet.
		</p>
		{unattachedInvoices.length > 0 ? (
			<ul class="invoice-list">
				{unattachedInvoices.map((invoice) => {
					const status = invoiceStatus(invoice, now);
					const options = dueParts.filter(
						(part) => part.phase.currency === invoice.currency,
					);
					const suggested = options.toSorted(
						(a, b) =>
							Math.abs(a.amount - invoice.total) -
							Math.abs(b.amount - invoice.total),
					)[0];
					// After a failed attach of this invoice, the part that was picked,
					// matched by phase and cost part only: the phase version in the
					// submitted value is stale when the phase changed meanwhile.
					const [pickedPhaseId, pickedComponent] =
						attachInput?.get("stripeId") === invoice.id
							? (attachInput.get("target") ?? "").split(":")
							: [];
					const picked = options.find(
						(part) =>
							part.phase.id === pickedPhaseId &&
							part.component === pickedComponent,
					);
					return (
						<li
							id={`invoice-${invoice.id}`}
							class="switcher target attach-row"
							style="--switcher-threshold: 40rem"
						>
							<div class="stack" data-space="3xs">
								<p class="label-caps">
									Invoice{" "}
									<a
										class="text-fg link"
										href={`${stripeDashboard}/invoices/${invoice.id}`}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Open invoice ${invoice.number} in Stripe (opens in a new tab)`}
									>
										{invoice.number}
									</a>
								</p>
								<p class="text-title tabular-nums">
									{formatMoney(invoice.total, invoice.currency)}
								</p>
								<Badge type={status.badge}>{status.label}</Badge>
								<p
									class:list={[
										"text-sm",
										status.overdue ? "text-fg-danger" : "text-fg-muted",
									]}
								>
									{statusDetail(invoice)}
								</p>
							</div>
							{suggested ? (
								<form
									method="POST"
									action={actions.attachInvoiceToPhase}
									class="stack"
									data-space="2xs"
									style="flex-grow: 1.5"
								>
									<input type="hidden" name="stripeId" value={invoice.id} />
									<Field
										as="select"
										name="target"
										label="Attach to"
										hint="The closest amount is preselected. Attaching cannot be undone from the dashboard."
										required
										result={
											attachInput?.get("stripeId") === invoice.id
												? attachResult
												: undefined
										}
										class="attach-field"
									>
										{projects.map((project) => {
											const group = options.filter(
												(part) => part.project.id === project.id,
											);
											return (
												group.length > 0 && (
													<optgroup label={project.name}>
														{group.map((part) => (
															<option
																value={`${part.phase.id}:${part.component}:${part.phase.version}`}
																selected={part === (picked ?? suggested)}
															>
																{part.phase.title} ·{" "}
																{costPartLabel[part.component]} ·{" "}
																{formatMoney(part.amount, part.phase.currency)}
																{part === suggested ? " (suggested)" : ""}
															</option>
														))}
													</optgroup>
												)
											);
										})}
									</Field>
									<ConfirmAction
										id={`confirm-attach-${invoice.id}`}
										trigger="Attach"
										triggerLabel={`Attach: invoice ${invoice.number}`}
										title={`Attach invoice ${invoice.number}?`}
										confirm="Attach"
										confirmVariant="default"
										cancel="Go back"
									>
										The invoice is linked to the cost part you picked for good:
										it cannot be detached or moved to another part from the
										dashboard, and the part counts as invoiced from now on.
									</ConfirmAction>
								</form>
							) : (
								<p
									class="text-sm text-fg-muted wrap-break-word"
									style="flex-grow: 1.5"
								>
									<span class="text-fg">Cannot attach yet.</span>{" "}
									{attachBlocker(invoice)}
								</p>
							)}
						</li>
					);
				})}
			</ul>
		) : (
			<p class="box text-sm text-fg-muted">
				Every Stripe invoice for this client is attached.
			</p>
		)}
	</section>

	<section
		id="invoices"
		aria-labelledby="invoices-heading"
		class="stack invoices-section"
		data-space="xs"
	>
		<h2 id="invoices-heading" class="label-caps">
			Invoices ({recorded.length})
		</h2>
		<p class="measure text-sm text-fg-muted">
			Invoices attached to a cost part: open ones, overdue first, then paid
			ones.
		</p>
		{unavailableCount > 0 && (
			<p class="text-sm text-fg-warning">
				{unavailableCount === 1
					? "1 attached invoice is not available from Stripe right now."
					: `${unavailableCount} attached invoices are not available from Stripe right now.`}
			</p>
		)}
		{recorded.length > 0 ? (
			<div class="lines" data-actions="below">
				{invoiceGroups.map((group) => (
					<>
						<h3>
							<span id={`invoices-${group.id}`} class="text-label">
								{group.label}{" "}
								<span class="text-fg-muted">· {group.rows.length}</span>
							</span>
							{group.id !== "other" && group.rows.length > 0 && (
								<span class="line-figure text-sm text-fg-muted">
									<span class="sr-only">total </span>
									{sumByCurrency(
										group.rows.map((row) => ({
											amount: row.invoice.total,
											currency: row.invoice.currency,
										})),
									)}
								</span>
							)}
						</h3>
						{group.rows.length > 0 ? (
							<ul aria-labelledby={`invoices-${group.id}`}>
								{group.rows.map((row) => {
									const status = invoiceStatus(row.invoice, now);
									return (
										<li id={`invoice-${row.invoice.id}`} class="target">
											<div class="line-text">
												<h4>
													<a
														class="link"
														href={phaseHref(row.project, row.phase)}
													>
														{row.project.name} · {row.phase.title}
													</a>
												</h4>
												<p class="cluster text-sm text-fg-muted">
													<Badge type={status.badge}>{status.label}</Badge>
													<span>
														Invoice {row.invoice.number} ·{" "}
														{costPartLabel[row.component]}
													</span>
													{row.invoice.total !== row.amount && (
														<span class="text-fg-warning">
															{`differs from the cost part (${formatMoney(row.amount, row.phase.currency)})`}
														</span>
													)}
													{!row.invoice.paymentPage && (
														<span>no payment page</span>
													)}
												</p>
											</div>
											<p class="line-figure">
												<span>
													{formatMoney(row.invoice.total, row.invoice.currency)}
												</span>
												<span
													class:list={[
														"text-sm",
														status.overdue ? "text-fg-danger" : "text-fg-muted",
													]}
												>
													{statusDetail(row.invoice)}
												</span>
											</p>
											<div class="line-actions cluster">
												<Button
													href={`${stripeDashboard}/invoices/${row.invoice.id}`}
													variant="quiet"
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Open in Stripe: invoice ${row.invoice.number} (opens in a new tab)`}
												>
													Open in Stripe
												</Button>
												{row.invoice.paymentPage && (
													<Button
														href={row.invoice.paymentPage}
														variant="quiet"
														target="_blank"
														rel="noopener noreferrer"
														aria-label={`Payment page: invoice ${row.invoice.number} (opens in a new tab)`}
													>
														Payment page
													</Button>
												)}
											</div>
										</li>
									);
								})}
							</ul>
						) : (
							<p class="text-sm text-fg-muted">{group.empty}</p>
						)}
					</>
				))}
			</div>
		) : (
			<div class="box stack text-sm" data-space="xs">
				<p class="text-fg-muted">
					{parts.length === 0
						? "No priced phases yet. Add a priced phase to a project to start billing."
						: "No invoices attached yet. Attach a Stripe invoice under To attach and it appears here."}
				</p>
				{parts.length === 0 && (
					<Button href={`/admin/org/${organization.id}/projects`}>
						Go to projects
					</Button>
				)}
			</div>
		)}
	</section>
</AdminOrgShell>
