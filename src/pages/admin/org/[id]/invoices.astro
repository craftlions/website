---
export const prerender = false;

import { actions } from "astro:actions";
import Button from "../../../../components/Button.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	componentBillingStatus,
	invoiceComponents,
	isInvoiceComponentDue,
} from "../../../../lib/phase-billing.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const organization = await getAdminOrganizationCore(Astro.locals.db, id);

if (!organization) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.importStripeInvoices),
	Astro.getActionResult(actions.attachInvoiceToPhase),
	Astro.getActionResult(actions.recordInvoice),
	Astro.getActionResult(actions.updatePhaseDelivery),
	Astro.getActionResult(actions.refreshStripeInvoice),
	Astro.getActionResult(actions.transitionPhase),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const [organizationData, projects, unattachedInvoices] = await Promise.all([
	Astro.locals.db.query.organizationMetadata.findFirst({
		columns: {
			stripeCustomerId: true,
		},
		where: {
			organizationId: id,
		},
	}),
	Astro.locals.db.query.projects.findMany({
		columns: {
			id: true,
			name: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					deliveryAmount: true,
					acceptanceAmount: true,
					currency: true,
					state: true,
					version: true,
					deliveryState: true,
					deliveryUrl: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
							component: true,
							invoiceNumber: true,
							stripePaymentPage: true,
							total: true,
							stripeStatus: true,
							stripePaidAt: true,
							stripeDueAt: true,
							fetchedAt: true,
						},
					},
					events: { columns: { event: true } },
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
	Astro.locals.db.query.invoices.findMany({
		columns: {
			id: true,
			invoiceNumber: true,
			stripePaymentPage: true,
			currency: true,
			total: true,
			stripeStatus: true,
			stripePaidAt: true,
		},
		where: {
			organizationId: id,
			phaseId: {
				isNull: true,
			},
		},
		orderBy: {
			id: "desc",
		},
	}),
]);
const allPhases = projects.flatMap((project) =>
	project.phases.map((phase) => ({ ...phase, project })),
);
const componentTargets = allPhases.flatMap((phase) =>
	invoiceComponents.flatMap((component) => {
		const amount = phase[`${component}Amount`];
		if (amount === null) return [];
		const invoice = phase.invoices.find((row) => row.component === component);
		const events = phase.events.map(({ event }) => event);
		return [{ ...phase, component, amount, invoice, events }];
	}),
);
const attachableTargets = componentTargets.filter(
	(target) =>
		!target.invoice && isInvoiceComponentDue(target.component, target.events),
);
const recordableTargets = attachableTargets;
const recordedTargets = componentTargets
	.filter((target) => target.invoice)
	.toSorted((a, b) => (b.invoice?.id ?? "").localeCompare(a.invoice?.id ?? ""));
const targetValue = (target: (typeof componentTargets)[number]) =>
	`${target.id}:${target.component}`;
const suggestedTarget = (invoice: (typeof unattachedInvoices)[number]) =>
	attachableTargets
		.filter((target) => target.currency === invoice.currency)
		.toSorted(
			(a, b) =>
				Math.abs(a.amount - invoice.total) - Math.abs(b.amount - invoice.total),
		)[0];
const suggestedTargetValue = (invoice: (typeof unattachedInvoices)[number]) => {
	const target = suggestedTarget(invoice);
	return target ? targetValue(target) : "";
};
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	showSuccess={actionSucceeded}
>
	{actionError && <p class="border border-dashed border-red-300 p-3 text-sm text-red-700 dark:border-red-700 dark:text-red-300">{actionError.message}</p>}
	<section class="grid gap-6" aria-labelledby="invoices-heading">
		<div class="grid gap-3">
			<h2
				id="invoices-heading"
				class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>Invoices</h2
			>
			{organizationData?.stripeCustomerId ? (
				<form method="POST" action={actions.importStripeInvoices} class="grid justify-start">
					<input type="hidden" name="organizationId" value={organization.id} />
					<Button type="submit">Fetch from Stripe</Button>
				</form>
			) : (
				<p class="border border-dashed border-neutral-300 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">Link a Stripe customer in settings to fetch invoices.</p>
			)}
		</div>
		{unattachedInvoices.length > 0 && (
			<div class="overflow-x-auto border border-dashed border-neutral-300 dark:border-neutral-700">
				<table class="w-full min-w-4xl border-collapse text-left text-sm">
					<thead>
						<tr class="border-b border-dashed border-neutral-300 text-xs uppercase text-neutral-500 dark:border-neutral-700 dark:text-neutral-400">
							<th class="px-4 py-3" scope="col">Unattached invoice</th>
							<th class="px-4 py-3" scope="col">Stripe</th>
							<th class="px-4 py-3 text-right" scope="col">Total</th>
							<th class="px-4 py-3" scope="col">Phase</th>
						</tr>
					</thead>
					<tbody>
						{unattachedInvoices.map((invoice) => (
							<tr class="border-b border-dashed border-neutral-300 last:border-b-0 dark:border-neutral-700">
								<td class="px-4 py-3"><a class="underline decoration-dashed underline-offset-4" href={invoice.stripePaymentPage}>{invoice.invoiceNumber}</a></td>
								<td class="px-4 py-3">{invoice.stripeStatus ?? "Not fetched"}{invoice.stripePaidAt ? ` · paid ${dateFormatter.format(invoice.stripePaidAt)}` : ""}</td>
								<td class="px-4 py-3 text-right tabular-nums">{new Intl.NumberFormat("de-DE", { style: "currency", currency: invoice.currency }).format(invoice.total)}</td>
								<td class="px-4 py-3">
									{attachableTargets.some((target) => target.currency === invoice.currency) ? (
										<form method="POST" action={actions.attachInvoiceToPhase} class="grid gap-2" data-attach-invoice>
											<input type="hidden" name="invoiceId" value={invoice.id} />
											<input type="hidden" name="phaseId" value={suggestedTarget(invoice)?.id ?? ""} />
											<input type="hidden" name="component" value={suggestedTarget(invoice)?.component ?? ""} />
											<input type="hidden" name="expectedVersion" value={suggestedTarget(invoice)?.version ?? ""} />
											<div class="grid grid-cols-[1fr_auto] items-center gap-2">
												<select name="target" required class="max-w-96 border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300">
													{attachableTargets.filter((target) => target.currency === invoice.currency).map((target) => (
														<option value={targetValue(target)} data-phase-id={target.id} data-component={target.component} data-version={target.version} selected={targetValue(target) === suggestedTargetValue(invoice)}>{target.project.name} · {target.title} · {target.component} · {currencyFormatter.format(target.amount)}{targetValue(target) === suggestedTargetValue(invoice) ? " (suggested)" : ""}</option>
													))}
												</select>
												<Button type="submit">Attach</Button>
											</div>
										</form>
									) : (
										<span class="text-neutral-500 dark:text-neutral-400">No matching phase</span>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)}
		{recordableTargets.length > 0 && (
			<div class="grid gap-3">
				<h3 class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400">Record an invoice</h3>
				<div class="grid border border-dashed border-neutral-300 dark:border-neutral-700">
					{recordableTargets.map((target) => (
						<form method="POST" action={actions.recordInvoice} class="grid gap-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.5fr)_8rem_max-content] md:items-end">
							<input type="hidden" name="phaseId" value={target.id} />
							<input type="hidden" name="component" value={target.component} />
							<input type="hidden" name="expectedVersion" value={target.version} />
							<p class="text-sm font-medium md:col-span-5">{target.project.name} · {target.title} · {target.component}</p>
							<label class="grid gap-1 text-sm"><span class="font-medium">Invoice number</span><input class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300" name="invoiceNumber" required /></label>
							<label class="grid gap-1 text-sm"><span class="font-medium">Stripe id</span><input class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300" name="stripeId" required /></label>
							<label class="grid gap-1 text-sm"><span class="font-medium">Payment URL</span><input class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300" name="stripePaymentPage" type="url" required /></label>
							<label class="grid gap-1 text-sm"><span class="font-medium">Total</span><input class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300" name="total" type="number" min="0" step="0.0001" value={target.amount} data-component-amount={target.amount} required /><span class="text-xs text-amber-700 dark:text-amber-300" data-amount-warning hidden>Total differs from the gross component amount of {currencyFormatter.format(target.amount)}. Recording remains available.</span></label>
							<Button type="submit">Record</Button>
						</form>
					))}
				</div>
			</div>
		)}
		<div
			class="overflow-x-auto border border-dashed border-neutral-300 dark:border-neutral-700"
		>
			<table class="w-full min-w-4xl border-collapse text-left text-sm">
				<thead>
					<tr
						class="border-b border-dashed border-neutral-300 text-xs uppercase text-neutral-500 dark:border-neutral-700 dark:text-neutral-400"
					>
						<th class="px-4 py-3" scope="col">Invoice</th>
						<th class="px-4 py-3" scope="col">Phase</th>
						<th class="px-4 py-3" scope="col">Stripe</th>
						<th class="px-4 py-3 text-right" scope="col">Total</th>
						<th class="px-4 py-3" scope="col">Delivery</th>
						<th class="px-4 py-3" scope="col">Action</th>
					</tr>
				</thead>
				<tbody>
					{recordedTargets.length > 0 ? recordedTargets.map((target) => (
						<tr class="border-b border-dashed border-neutral-300 last:border-b-0 dark:border-neutral-700">
							<td class="px-4 py-3">
								{target.invoice ? (
									<a class="underline decoration-dashed underline-offset-4" href={target.invoice.stripePaymentPage}>{target.invoice.invoiceNumber}</a>
								) : (
									<span class="text-neutral-500 dark:text-neutral-400">—</span>
								)}
							</td>
							<td class="px-4 py-3">{target.project.name} · {target.title} · {target.component}</td>
							<td class="px-4 py-3">
								{target.invoice ? (
									<>{componentBillingStatus({ component: target.component, events: target.events, invoice: target.invoice })} · Stripe {target.invoice.stripeStatus ?? "not fetched"}{target.invoice.stripeDueAt ? ` · due ${dateFormatter.format(target.invoice.stripeDueAt)}` : ""}{target.invoice.stripePaidAt ? ` · paid ${dateFormatter.format(target.invoice.stripePaidAt)}` : ""}{target.invoice.fetchedAt ? ` · ${dateFormatter.format(target.invoice.fetchedAt)}` : ""}</>
								) : (
									<span class="text-neutral-500 dark:text-neutral-400">No invoice</span>
								)}
							</td>
							<td class="px-4 py-3 text-right tabular-nums">{target.invoice ? <>{currencyFormatter.format(target.invoice.total)}{target.invoice.total !== target.amount && <span class="block text-xs text-amber-700 dark:text-amber-300">Expected {currencyFormatter.format(target.amount)}</span>}</> : "—"}</td>
							<td class="px-4 py-3">
								<div class="grid gap-2">
									<span class="text-xs uppercase text-neutral-500 dark:text-neutral-400">{target.deliveryState === "url" ? target.deliveryUrl : target.deliveryState === "none" ? "No delivery" : "Not recorded"}</span>
									{(target.state === "delivered" || target.state === "accepted") && (
										<form method="POST" action={actions.updatePhaseDelivery} class="grid gap-2">
										<input type="hidden" name="phaseId" value={target.id} />
										<input type="hidden" name="expectedVersion" value={target.version} />
										<select name="deliveryChoice" aria-label="Delivery" data-delivery-choice required class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"><option value="url" selected={target.deliveryState === "url" || target.deliveryState === "not_recorded"}>Delivery link</option><option value="none" selected={target.deliveryState === "none"}>No delivery PR/MR</option></select>
										<label data-delivery-url-field class="grid gap-1 text-sm"><span class="font-medium">Delivery URL</span><input class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300" name="deliveryUrl" type="url" inputmode="url" autocomplete="off" value={target.deliveryUrl ?? ""} placeholder="https://github.com/…" /></label>
										<Button type="submit">Update Delivery</Button>
									</form>
									)}
								</div>
							</td>
							<td class="px-4 py-3">
								<div class="grid grid-flow-col justify-start gap-2">
									{target.invoice && <form method="POST" action={actions.refreshStripeInvoice}><input type="hidden" name="invoiceId" value={target.invoice.id} /><Button type="submit">Refresh now</Button></form>}
								</div>
							</td>
						</tr>
					)) : (
						<tr>
							<td class="px-4 py-3 text-neutral-600 dark:text-neutral-400" colspan="6">No invoices recorded.</td>
						</tr>
					)}
				</tbody>
			</table>
		</div>
	</section>
</AdminOrgShell>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>(
		"[data-attach-invoice]",
	)) {
		const select = form.querySelector('select[name="target"]');
		const phaseId = form.querySelector('input[name="phaseId"]');
		const component = form.querySelector('input[name="component"]');
		const expectedVersion = form.querySelector('input[name="expectedVersion"]');

		if (
			!(select instanceof HTMLSelectElement) ||
			!(phaseId instanceof HTMLInputElement) ||
			!(component instanceof HTMLInputElement) ||
			!(expectedVersion instanceof HTMLInputElement)
		) {
			continue;
		}

		const syncExpectedVersion = () => {
			const option = select.selectedOptions[0];

			if (option) {
				phaseId.value = option.dataset.phaseId ?? "";
				component.value = option.dataset.component ?? "";
				expectedVersion.value = option.dataset.version ?? "";
			}
		};

		syncExpectedVersion();
		select.addEventListener("change", syncExpectedVersion);
	}

	for (const input of document.querySelectorAll("[data-component-amount]")) {
		if (!(input instanceof HTMLInputElement)) continue;
		const warning = input.parentElement?.querySelector("[data-amount-warning]");
		if (!(warning instanceof HTMLElement)) continue;
		const syncWarning = () => {
			warning.hidden =
				Number(input.value) === Number(input.dataset.componentAmount);
		};
		syncWarning();
		input.addEventListener("input", syncWarning);
	}

	for (const select of document.querySelectorAll("[data-delivery-choice]")) {
		if (!(select instanceof HTMLSelectElement)) {
			continue;
		}

		const field = select
			.closest("form")
			?.querySelector<HTMLLabelElement>("[data-delivery-url-field]");
		const input = field?.querySelector<HTMLInputElement>(
			'input[name="deliveryUrl"]',
		);

		if (
			!(field instanceof HTMLElement) ||
			!(input instanceof HTMLInputElement)
		) {
			continue;
		}

		const syncDeliveryUrl = () => {
			const show = select.value === "url";
			field.hidden = !show;
			input.required = show;

			if (!show) {
				input.value = "";
			}
		};

		syncDeliveryUrl();
		select.addEventListener("change", syncDeliveryUrl);
	}
</script>
