---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	invoiceComponents,
	isInvoiceComponentDue,
} from "../../../../lib/phase-billing.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const organization = await getAdminOrganizationCore(Astro.locals.db, id);

if (!organization) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.importStripeInvoices),
	Astro.getActionResult(actions.attachInvoiceToPhase),
	Astro.getActionResult(actions.recordInvoice),
	Astro.getActionResult(actions.updatePhaseDelivery),
	Astro.getActionResult(actions.refreshStripeInvoice),
	Astro.getActionResult(actions.transitionPhase),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const [organizationData, projects, unattachedInvoices] = await Promise.all([
	Astro.locals.db.query.organizationMetadata.findFirst({
		columns: {
			stripeCustomerId: true,
		},
		where: {
			organizationId: id,
		},
	}),
	Astro.locals.db.query.projects.findMany({
		columns: {
			id: true,
			publicId: true,
			name: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					deliveryAmount: true,
					acceptanceAmount: true,
					currency: true,
					state: true,
					version: true,
					deliveryState: true,
					deliveryUrl: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
							component: true,
							invoiceNumber: true,
							stripePaymentPage: true,
							currency: true,
							total: true,
							stripeStatus: true,
							stripePaidAt: true,
							stripeDueAt: true,
							fetchedAt: true,
						},
					},
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
	Astro.locals.db.query.invoices.findMany({
		columns: {
			id: true,
			invoiceNumber: true,
			stripePaymentPage: true,
			currency: true,
			total: true,
			stripeStatus: true,
			stripeDueAt: true,
			stripePaidAt: true,
			fetchedAt: true,
		},
		where: {
			organizationId: id,
			phaseId: {
				isNull: true,
			},
		},
		orderBy: {
			id: "desc",
		},
	}),
]);
const allPhases = projects.flatMap((project) =>
	project.phases.map((phase) => ({ ...phase, project })),
);
const componentTargets = allPhases.flatMap((phase) =>
	invoiceComponents.flatMap((component) => {
		const amount = phase[`${component}Amount`];
		if (amount === null || amount === 0) return [];
		const invoice = phase.invoices.find((row) => row.component === component);
		return [{ ...phase, component, amount, invoice }];
	}),
);
const unbilledTargets = componentTargets.filter((target) => !target.invoice);
const attachableTargets = unbilledTargets.filter((target) =>
	isInvoiceComponentDue(target.component, target.state),
);
const pendingTargets = unbilledTargets.filter(
	(target) => !isInvoiceComponentDue(target.component, target.state),
);
const recordableTargets = attachableTargets;
type ComponentTarget = (typeof componentTargets)[number];
type RecordedTarget = ComponentTarget & {
	invoice: NonNullable<ComponentTarget["invoice"]>;
};

const recordedTargets: RecordedTarget[] = componentTargets
	.filter((target): target is RecordedTarget => Boolean(target.invoice))
	.toSorted((a, b) => b.invoice.id.localeCompare(a.invoice.id));
const targetValue = (target: (typeof componentTargets)[number]) =>
	`${target.id}:${target.component}:${target.version}`;
const suggestedTarget = (invoice: (typeof unattachedInvoices)[number]) =>
	attachableTargets
		.filter((target) => target.currency === invoice.currency)
		.toSorted(
			(a, b) =>
				Math.abs(a.amount - invoice.total) - Math.abs(b.amount - invoice.total),
		)[0];
const suggestedTargetValue = (invoice: (typeof unattachedInvoices)[number]) => {
	const target = suggestedTarget(invoice);
	return target ? targetValue(target) : "";
};
const now = new Date();
const defaultCurrency =
	allPhases[0]?.currency ?? unattachedInvoices[0]?.currency ?? "EUR";
const formatCurrency = (amount: number, currency: string) =>
	new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(
		amount,
	);
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });

const sumByCurrency = (
	items: ReadonlyArray<{ amount: number; currency: string }>,
) => {
	const sums = new Map<string, number>();
	for (const item of items) {
		sums.set(item.currency, (sums.get(item.currency) ?? 0) + item.amount);
	}
	if (sums.size === 0) return formatCurrency(0, defaultCurrency);
	return [...sums]
		.map(([currency, total]) => formatCurrency(total, currency))
		.join(" + ");
};

const totalInvoiced = sumByCurrency(
	recordedTargets.map((t) => ({
		amount: t.invoice.total,
		currency: t.invoice.currency ?? t.currency,
	})),
);
const totalOutstanding = sumByCurrency(
	recordedTargets
		.filter((t) => t.invoice.stripeStatus === "open")
		.map((t) => ({
			amount: t.invoice.total,
			currency: t.invoice.currency ?? t.currency,
		})),
);
const overdueTargets = recordedTargets.filter(
	(t) =>
		t.invoice.stripeStatus === "open" &&
		t.invoice.stripeDueAt &&
		t.invoice.stripeDueAt < now,
);
const totalOverdue = sumByCurrency(
	overdueTargets.map((t) => ({
		amount: t.invoice.total,
		currency: t.invoice.currency ?? t.currency,
	})),
);
const overdueCount = overdueTargets.length;
const totalPaid = sumByCurrency(
	recordedTargets
		.filter((t) => t.invoice.stripeStatus === "paid")
		.map((t) => ({
			amount: t.invoice.total,
			currency: t.invoice.currency ?? t.currency,
		})),
);
const totalDueToBill = sumByCurrency(
	recordableTargets.map((t) => ({
		amount: t.amount,
		currency: t.currency,
	})),
);
const openCount = recordedTargets.filter(
	(t) => t.invoice.stripeStatus === "open",
).length;
const paidCount = recordedTargets.filter(
	(t) => t.invoice.stripeStatus === "paid",
).length;
const showRecordedFilter = openCount > 0 && paidCount > 0;

const latestFetch = [
	...unattachedInvoices.map((i) => i.fetchedAt),
	...recordedTargets.map((t) => t.invoice.fetchedAt),
]
	.filter((d): d is Date => d instanceof Date)
	.sort((a, b) => b.getTime() - a.getTime())[0];

const getInvoiceStatus = (invoice: {
	stripeStatus: string | null;
	stripeDueAt: Date | null;
}) => {
	if (invoice.stripeStatus === "paid") {
		return { label: "Paid", type: "success" as const, isOverdue: false };
	}
	if (invoice.stripeStatus === "open") {
		if (invoice.stripeDueAt && invoice.stripeDueAt < now) {
			return { label: "Overdue", type: "error" as const, isOverdue: true };
		}
		return { label: "Open", type: "info" as const, isOverdue: false };
	}
	if (
		invoice.stripeStatus === "void" ||
		invoice.stripeStatus === "uncollectible"
	) {
		return {
			label: invoice.stripeStatus,
			type: "error" as const,
			isOverdue: false,
		};
	}
	if (invoice.stripeStatus === "draft") {
		return { label: "Draft", type: "gray" as const, isOverdue: false };
	}
	return {
		label: invoice.stripeStatus ?? "Invoiced",
		type: "info" as const,
		isOverdue: false,
	};
};

const getAttachmentGuidance = (
	invoice: (typeof unattachedInvoices)[number],
) => {
	const matchingAttachable = attachableTargets.filter(
		(target) => target.currency === invoice.currency,
	);
	if (matchingAttachable.length > 0) {
		return { canAttach: true as const, targets: matchingAttachable };
	}

	const matchingPending = pendingTargets.filter(
		(target) => target.currency === invoice.currency,
	);
	if (matchingPending.length > 0) {
		const preview = matchingPending
			.slice(0, 2)
			.map(
				(t) =>
					`"${t.project.name} · ${t.title}" (${t.component}, state: ${t.state.replace("_", " ")})`,
			)
			.join(", ");
		const extra =
			matchingPending.length > 2
				? ` and ${matchingPending.length - 2} more`
				: "";
		return {
			canAttach: false as const,
			reason: `Components exist but are not due yet: ${preview}${extra}. Advance phase state to attach.`,
		};
	}

	const currencyMismatches = unbilledTargets.filter(
		(target) => target.currency !== invoice.currency,
	);
	if (currencyMismatches.length > 0) {
		const otherCurrencies = [
			...new Set(currencyMismatches.map((t) => t.currency)),
		].join(", ");
		return {
			canAttach: false as const,
			reason: `Currency mismatch: invoice is in ${invoice.currency}, but unbilled phases are in ${otherCurrencies}.`,
		};
	}

	return {
		canAttach: false as const,
		reason: "No unbilled phase components available for this organization.",
	};
};

const inputClass =
	"border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300";
const quietButtonClass =
	"w-max cursor-pointer text-sm text-neutral-500 underline decoration-dashed underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100";
const summaryClass =
	"w-max cursor-pointer list-none text-sm text-neutral-500 underline decoration-dashed underline-offset-4 transition-colors hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100";
const sectionLabelClass =
	"text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400";
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	showSuccess={actionSucceeded}
>
	{actionError && <p class="border border-dashed border-red-300 p-3 text-sm text-red-700 dark:border-red-700 dark:text-red-300">{actionError.message}</p>}
	<section class="grid gap-6" aria-labelledby="invoices-heading">
		<div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
			<div class="grid gap-1">
				<h2 id="invoices-heading" class={sectionLabelClass}>Invoices</h2>
				{organizationData?.stripeCustomerId ? (
					<p class="text-xs text-neutral-500 dark:text-neutral-400">
						<span>Customer </span>
						<a
							class="underline decoration-dashed underline-offset-4 hover:text-neutral-900 dark:hover:text-neutral-100"
							href={`https://dashboard.stripe.com/customers/${organizationData.stripeCustomerId}`}
							target="_blank"
							rel="noreferrer"
						>{organizationData.stripeCustomerId}</a>
						{latestFetch && <span> · Synced {dateFormatter.format(latestFetch)}</span>}
					</p>
				) : (
					<p class="text-xs text-neutral-500 dark:text-neutral-400">No Stripe customer linked</p>
				)}
			</div>
			{organizationData?.stripeCustomerId ? (
				<form method="POST" action={actions.importStripeInvoices}>
					<input type="hidden" name="organizationId" value={organization.id} />
					<Button type="submit">Fetch from Stripe</Button>
				</form>
			) : (
				<Button href={`/admin/org/${organization.id}/settings`}>Link Stripe customer</Button>
			)}
		</div>

		<dl
			class="grid grid-cols-2 gap-4 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 sm:grid-cols-3 lg:grid-cols-5"
			aria-label="Invoicing summary"
		>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Total Invoiced</dt
				>
				<dd class="text-lg font-semibold tabular-nums">{totalInvoiced}</dd>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Outstanding</dt
				>
				<dd class="text-lg font-semibold tabular-nums">{totalOutstanding}</dd>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Overdue</dt
				>
				<dd
					class:list={["text-lg font-semibold tabular-nums", overdueCount > 0 && "text-red-700 dark:text-red-300"]}
					>{totalOverdue}</dd
				>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Due to Bill</dt
				>
				<dd class="text-lg font-semibold tabular-nums">{totalDueToBill}</dd>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Paid</dt
				>
				<dd
					class="text-lg font-semibold tabular-nums text-emerald-700 dark:text-emerald-300"
					>{totalPaid}</dd
				>
			</div>
		</dl>

		{unattachedInvoices.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Unattached from Stripe</h3>
				<ul class="grid border border-dashed border-neutral-300 dark:border-neutral-700">
					{unattachedInvoices.map((invoice) => {
						const guidance = getAttachmentGuidance(invoice);
						return (
						<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1.5fr)] md:items-center">
							<div class="grid gap-1">
								<a class="w-max font-medium underline decoration-dashed underline-offset-4" href={invoice.stripePaymentPage}>{invoice.invoiceNumber}</a>
								<p class="text-xs text-neutral-500 dark:text-neutral-400">
									<span>Stripe {invoice.stripeStatus ?? "not fetched"}</span>
									{invoice.stripeDueAt && (
										<>
											<span> · </span>
											<span class:list={[invoice.stripeStatus === "open" && invoice.stripeDueAt < now && "font-semibold text-red-700 dark:text-red-300"]}>
												due {dateFormatter.format(invoice.stripeDueAt)}
												{invoice.stripeStatus === "open" && invoice.stripeDueAt < now && " (overdue)"}
											</span>
										</>
									)}
									{invoice.stripePaidAt && (
										<>
											<span> · </span>
											<span>paid {dateFormatter.format(invoice.stripePaidAt)}</span>
										</>
									)}
									{invoice.fetchedAt && (
										<>
											<span> · </span>
											<span>synced {dateFormatter.format(invoice.fetchedAt)}</span>
										</>
									)}
								</p>
							</div>
							<p class="font-medium tabular-nums md:text-right">{formatCurrency(invoice.total, invoice.currency)}</p>
							{guidance.canAttach ? (
								<form method="POST" action={actions.attachInvoiceToPhase} class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2">
									<input type="hidden" name="invoiceId" value={invoice.id} />
									<select name="target" aria-label="Phase component" required class={inputClass}>
										{guidance.targets.map((target) => (
											<option value={targetValue(target)} selected={targetValue(target) === suggestedTargetValue(invoice)}>{target.project.name} · {target.title} · {target.component} · {formatCurrency(target.amount, target.currency)}{targetValue(target) === suggestedTargetValue(invoice) ? " (suggested)" : ""}</option>
										))}
									</select>
									<Button type="submit">Attach</Button>
								</form>
							) : (
								<div class="grid gap-0.5 text-xs">
									<p class="font-medium text-amber-700 dark:text-amber-400">Cannot attach</p>
									<p class="text-neutral-600 dark:text-neutral-400">{guidance.reason}</p>
								</div>
							)}
						</li>
					);})}
				</ul>
			</div>
		)}

		{recordableTargets.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Due, not invoiced</h3>
				<ul class="grid border border-dashed border-neutral-300 dark:border-neutral-700">
					{recordableTargets.map((target) => (
						<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_auto] md:items-center">
							<div class="grid gap-1">
								<p class="font-medium"><a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}>{target.project.name}</a> · {target.title}</p>
								<p class="text-xs capitalize text-neutral-500 dark:text-neutral-400">{target.component}</p>
							</div>
							<p class="font-medium tabular-nums md:text-right">{formatCurrency(target.amount, target.currency)}</p>
							<Badge type="info">due</Badge>
							<details class="grid gap-3 md:col-span-3">
								<summary class={summaryClass}>Record invoice</summary>
								<form method="POST" action={actions.recordInvoice} class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 sm:grid-cols-2 lg:grid-cols-4 items-start">
									<input type="hidden" name="phaseId" value={target.id} />
									<input type="hidden" name="component" value={target.component} />
									<input type="hidden" name="expectedVersion" value={target.version} />
									<label class="grid gap-1 text-sm"><span class="font-medium">Invoice number</span><input class={inputClass} name="invoiceNumber" autocomplete="off" required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Stripe id</span><input class={inputClass} name="stripeId" autocomplete="off" placeholder="in_..." required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Payment URL</span><input class={inputClass} name="stripePaymentPage" type="url" placeholder="https://invoice.stripe.com/..." required /></label>
									<label class="grid gap-1 text-sm"><span class="font-medium">Total ({target.currency})</span><input class={inputClass} name="total" type="number" min="0" step="0.0001" value={target.amount} data-component-amount={target.amount} required /><span class="text-xs text-amber-700 dark:text-amber-300" data-amount-warning hidden>Differs from component amount ({formatCurrency(target.amount, target.currency)}).</span></label>
									<Button type="submit" class="sm:col-span-2 lg:col-span-4">Record</Button>
								</form>
							</details>
						</li>
					))}
				</ul>
			</div>
		)}

		<div class="grid gap-3">
			<div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
				<h3 class={sectionLabelClass}>Recorded</h3>
				{showRecordedFilter && (
					<nav aria-label="Filter recorded invoices" class="grid grid-flow-col justify-start gap-2" data-invoice-filter-nav>
						<Button type="button" class="aria-pressed:border-neutral-500 aria-pressed:bg-neutral-100 dark:aria-pressed:bg-neutral-900" data-invoice-filter="all" aria-pressed="true">All ({recordedTargets.length})</Button>
						<Button type="button" class="aria-pressed:border-neutral-500 aria-pressed:bg-neutral-100 dark:aria-pressed:bg-neutral-900" data-invoice-filter="open" aria-pressed="false">Open ({openCount})</Button>
						<Button type="button" class="aria-pressed:border-neutral-500 aria-pressed:bg-neutral-100 dark:aria-pressed:bg-neutral-900" data-invoice-filter="paid" aria-pressed="false">Paid ({paidCount})</Button>
					</nav>
				)}
			</div>
			<ul
				class="grid border border-dashed border-neutral-300 dark:border-neutral-700"
			>
				{recordedTargets.length > 0 ? recordedTargets.map((target) => {
					const status = getInvoiceStatus(target.invoice);
					const rowCategory = target.invoice.stripeStatus === "paid" ? "paid" : "open";
					return (
					<li
						class="grid gap-x-6 gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto_auto_auto] md:items-start"
						data-recorded-row
						data-row-category={rowCategory}
					>
						<div class="grid gap-1">
							<a class="w-max font-medium underline decoration-dashed underline-offset-4" href={target.invoice.stripePaymentPage}>{target.invoice.invoiceNumber}</a>
							<p class="text-sm"><a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}>{target.project.name}</a> · {target.title} · <span class="capitalize">{target.component}</span></p>
							<p class="text-xs text-neutral-500 dark:text-neutral-400">
								<span>Stripe {target.invoice.stripeStatus ?? "not fetched"}</span>
								{target.invoice.stripeDueAt && (
									<>
										<span> · </span>
										<span class:list={[status.isOverdue && "font-semibold text-red-700 dark:text-red-300"]}>
											due {dateFormatter.format(target.invoice.stripeDueAt)}
											{status.isOverdue && " (overdue)"}
										</span>
									</>
								)}
								{target.invoice.stripePaidAt && (
									<>
										<span> · </span>
										<span>paid {dateFormatter.format(target.invoice.stripePaidAt)}</span>
									</>
								)}
								{target.invoice.fetchedAt && (
									<>
										<span> · </span>
										<span>synced {dateFormatter.format(target.invoice.fetchedAt)}</span>
									</>
								)}
							</p>
							{target.component === "delivery" && (
								target.deliveryState === "url" && target.deliveryUrl ? (
									<a class="w-max text-xs underline decoration-dashed underline-offset-4" href={target.deliveryUrl} rel="noreferrer" target="_blank">Delivery PR/MR</a>
								) : (
									<p class="text-xs text-neutral-500 dark:text-neutral-400">{target.deliveryState === "none" ? "Delivered without PR/MR" : "Delivery not recorded"}</p>
								)
							)}
						</div>
						<Badge type={status.type}>{status.label}</Badge>
						<div class="grid gap-1 md:text-right">
							<p class="font-medium tabular-nums">{formatCurrency(target.invoice.total, target.currency)}</p>
							{target.invoice.total !== target.amount && <p class="text-xs text-amber-700 dark:text-amber-300">Expected {formatCurrency(target.amount, target.currency)}</p>}
						</div>
						<form method="POST" action={actions.refreshStripeInvoice} class="md:justify-self-end">
							<input type="hidden" name="invoiceId" value={target.invoice.id} />
							<button type="submit" class={quietButtonClass}>Refresh</button>
						</form>
						{target.component === "delivery" && (target.state === "delivered" || target.state === "accepted") && (
							<details class="grid gap-3 md:col-span-4">
								<summary class={summaryClass}>Edit delivery</summary>
								<form method="POST" action={actions.updatePhaseDelivery} class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-end">
									<input type="hidden" name="phaseId" value={target.id} />
									<input type="hidden" name="expectedVersion" value={target.version} />
									<label class="grid gap-1 text-sm"><span class="font-medium">Delivery</span><select name="deliveryChoice" data-delivery-choice required class={inputClass}><option value="url" selected={target.deliveryState !== "none"}>Delivery link</option><option value="none" selected={target.deliveryState === "none"}>No delivery PR/MR</option></select></label>
									<label data-delivery-url-field class="grid gap-1 text-sm"><span class="font-medium">Delivery URL</span><input class={inputClass} name="deliveryUrl" type="url" inputmode="url" autocomplete="off" value={target.deliveryUrl ?? ""} placeholder="https://github.com/…" /></label>
									<Button type="submit">Update delivery</Button>
								</form>
							</details>
						)}
					</li>
				);}) : (
					<li class="grid gap-2 p-6 text-sm text-neutral-600 dark:text-neutral-400">
						<p class="font-medium text-neutral-900 dark:text-neutral-100">No invoices recorded yet</p>
						<p class="text-xs">
							{allPhases.length === 0
								? "No project phases found. Create a project and add priced phases to begin billing."
								: "Invoices will appear here once imported from Stripe or recorded against due phase components."}
						</p>
						{allPhases.length === 0 && (
							<Button href={`/admin/org/${organization.id}/projects`} class="w-max mt-1">Go to projects</Button>
						)}
					</li>
				)}
			</ul>
		</div>
	</section>
</AdminOrgShell>

<script>
	for (const input of document.querySelectorAll("[data-component-amount]")) {
		if (!(input instanceof HTMLInputElement)) continue;
		const warning = input.parentElement?.querySelector("[data-amount-warning]");
		if (!(warning instanceof HTMLElement)) continue;
		const syncWarning = () => {
			warning.hidden =
				Number(input.value) === Number(input.dataset.componentAmount);
		};
		syncWarning();
		input.addEventListener("input", syncWarning);
	}

	for (const select of document.querySelectorAll("[data-delivery-choice]")) {
		if (!(select instanceof HTMLSelectElement)) {
			continue;
		}

		const field = select
			.closest("form")
			?.querySelector<HTMLLabelElement>("[data-delivery-url-field]");
		const input = field?.querySelector<HTMLInputElement>(
			'input[name="deliveryUrl"]',
		);

		if (
			!(field instanceof HTMLElement) ||
			!(input instanceof HTMLInputElement)
		) {
			continue;
		}

		const syncDeliveryUrl = () => {
			const show = select.value === "url";
			field.hidden = !show;
			input.required = show;

			if (!show) {
				input.value = "";
			}
		};

		syncDeliveryUrl();
		select.addEventListener("change", syncDeliveryUrl);
	}

	for (const nav of document.querySelectorAll("[data-invoice-filter-nav]")) {
		const buttons = nav.querySelectorAll<HTMLButtonElement>(
			"[data-invoice-filter]",
		);
		const rows = document.querySelectorAll<HTMLElement>("[data-recorded-row]");

		for (const button of buttons) {
			button.addEventListener("click", () => {
				const filter = button.dataset.invoiceFilter;
				for (const btn of buttons) {
					btn.setAttribute("aria-pressed", String(btn === button));
				}
				for (const row of rows) {
					if (filter === "all") {
						row.hidden = false;
					} else if (filter === "open") {
						row.hidden = row.dataset.rowCategory !== "open";
					} else if (filter === "paid") {
						row.hidden = row.dataset.rowCategory !== "paid";
					}
				}
			});
		}
	}
</script>
