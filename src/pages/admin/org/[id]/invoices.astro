---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import Field from "../../../../components/Field.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	formatDate,
	formatDays,
	formatMoney,
	sumByCurrency,
} from "../../../../lib/format.ts";
import {
	costPartsToInvoice,
	invoiceComponents,
} from "../../../../lib/phase-billing.ts";
import {
	costPartLabel,
	daysOverdue,
	invoiceStatus,
	isInvoiceOverdue,
	phaseStatus,
} from "../../../../lib/status.ts";
import {
	organizationStripeInvoices,
	stripeInvoiceFields,
} from "../../../../lib/stripe.ts";
import { submittedValues } from "../../../../lib/submitted-values.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const attachResult = Astro.getActionResult(actions.attachInvoiceToPhase);
// After a failed attach, only that invoice's row shows the error and keeps
// the part that was picked.
const attachInput = submittedValues(Astro.locals, attachResult);

const [organization, organizationData, projects, unattachedInvoices] =
	await Promise.all([
		getAdminOrganizationCore(Astro.locals.db, id),
		Astro.locals.db.query.organizationMetadata.findFirst({
			columns: {
				stripeCustomerId: true,
			},
			where: {
				organizationId: id,
			},
		}),
		Astro.locals.db.query.projects.findMany({
			columns: {
				id: true,
				publicId: true,
				name: true,
			},
			with: {
				phases: {
					columns: {
						id: true,
						publicId: true,
						title: true,
						upfrontAmount: true,
						deliveryAmount: true,
						acceptanceAmount: true,
						currency: true,
						state: true,
						version: true,
					},
					with: {
						invoices: {
							columns: {
								component: true,
							},
							with: {
								stripe: stripeInvoiceFields,
							},
						},
					},
					orderBy: {
						id: "asc",
					},
				},
			},
			where: {
				organizationId: id,
			},
			orderBy: {
				name: "asc",
			},
		}),
		Astro.locals.db.query.stripeInvoices.findMany({
			...stripeInvoiceFields,
			where: {
				...organizationStripeInvoices(id),
				NOT: { link: true },
			},
			orderBy: {
				invoicedAt: "desc",
			},
		}),
	]);

if (!organization) {
	return Astro.redirect("/admin");
}

const now = new Date();
// Stripe dashboard paths: /customers/{cus_…} and /invoices/{in_…}.
const stripeDashboard = "https://dashboard.stripe.com";
const phaseHref = (
	project: { publicId: string },
	phase: { publicId: string },
) =>
	`/admin/org/${organization.id}/projects/${project.publicId}#phase-${phase.publicId}`;

// One entry per priced cost part, in project and phase order.
const parts = projects.flatMap((project) =>
	project.phases.flatMap((phase) =>
		invoiceComponents.flatMap((component) => {
			const amount = phase[`${component}Amount`];
			if (amount === null || amount === 0) return [];
			return [
				{
					project,
					phase,
					component,
					amount,
					link: phase.invoices.find((row) => row.component === component),
				},
			];
		}),
	),
);
const unbilledParts = parts.filter(
	(part) => !part.link && part.phase.state !== "cancelled",
);
const dueParts = projects.flatMap((project) =>
	project.phases.flatMap((phase) =>
		costPartsToInvoice(phase).map((part) => ({ ...part, project, phase })),
	),
);
const recorded = parts
	.flatMap((part) =>
		part.link?.stripe ? [{ ...part, invoice: part.link.stripe }] : [],
	)
	.toSorted((a, b) => {
		// Overdue first (longest overdue on top), then open by due date, then
		// everything else newest first.
		const rank = (invoice: typeof a.invoice) =>
			isInvoiceOverdue(invoice, now) ? 0 : invoice.status === "open" ? 1 : 2;
		return (
			rank(a.invoice) - rank(b.invoice) ||
			(rank(a.invoice) < 2
				? (a.invoice.dueAt?.getTime() ?? Number.MAX_SAFE_INTEGER) -
					(b.invoice.dueAt?.getTime() ?? Number.MAX_SAFE_INTEGER)
				: b.invoice.invoicedAt.getTime() - a.invoice.invoicedAt.getTime())
		);
	});
const unavailableCount = parts.filter(
	(part) => part.link && !part.link.stripe,
).length;
const liveInvoices = [
	...recorded.map((row) => row.invoice),
	...unattachedInvoices,
];
const defaultCurrency =
	parts[0]?.phase.currency ?? unattachedInvoices[0]?.currency ?? "EUR";

// Paid date, days overdue, due date or issue date: the one fact that matters
// for the invoice's current status.
const statusDetail = (invoice: {
	status: string;
	dueAt: Date | null;
	paidAt: Date | null;
	invoicedAt: Date;
}) =>
	invoice.status === "paid" && invoice.paidAt
		? `Paid ${formatDate(invoice.paidAt)}`
		: isInvoiceOverdue(invoice, now)
			? `${formatDays(daysOverdue(invoice, now))} overdue`
			: invoice.dueAt
				? `Due ${formatDate(invoice.dueAt)}`
				: `Issued ${formatDate(invoice.invoicedAt)}`;

// Why an unattached invoice has no due cost part in its currency.
const attachBlocker = (invoice: { currency: string }) => {
	const pending = unbilledParts.filter(
		(part) => part.phase.currency === invoice.currency,
	);
	if (pending.length > 0) {
		return `No ${invoice.currency} cost part is due yet. Next up: ${pending
			.slice(0, 2)
			.map(
				(part) =>
					`${part.project.name} · ${part.phase.title} · ${costPartLabel[part.component]} (${phaseStatus[part.phase.state].label})`,
			)
			.join("; ")}.`;
	}
	if (unbilledParts.length > 0) {
		return `This invoice is in ${invoice.currency}; the open cost parts are in ${[
			...new Set(unbilledParts.map((part) => part.phase.currency)),
		].join(", ")}.`;
	}
	return parts.length > 0
		? "Every cost part already has an invoice."
		: "There are no priced phases to attach it to.";
};
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	results={[[attachResult, "Invoice attached to its cost part."]]}
	fieldLabels={{ stripeId: "Stripe invoice", target: "Attach to" }}
>
	<section aria-labelledby="summary-heading" class="grid gap-3">
		<h2 id="summary-heading" class="text-label uppercase text-fg-muted">
			Summary
		</h2>
		<dl
			class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-x-8 gap-y-3"
		>
			<div class="grid min-w-0 gap-1">
				<dt class="label-caps">Outstanding</dt>
				<dd class="text-title tabular-nums wrap-break-word">
					{sumByCurrency(
						liveInvoices
							.filter((invoice) => invoice.status === "open")
							.map((invoice) => ({
								amount: invoice.total,
								currency: invoice.currency,
							})),
						defaultCurrency,
					)}
				</dd>
			</div>
			<div class="grid min-w-0 gap-1">
				<dt class="label-caps">Overdue</dt>
				<dd
					class:list={[
						"text-title tabular-nums wrap-break-word",
						liveInvoices.some((invoice) => isInvoiceOverdue(invoice, now))
							? "text-fg-danger"
							: null,
					]}
				>
					{sumByCurrency(
						liveInvoices
							.filter((invoice) => isInvoiceOverdue(invoice, now))
							.map((invoice) => ({
								amount: invoice.total,
								currency: invoice.currency,
							})),
						defaultCurrency,
					)}
				</dd>
			</div>
			<div class="grid min-w-0 gap-1">
				<dt class="label-caps">To invoice</dt>
				<dd class="text-title tabular-nums wrap-break-word">
					{sumByCurrency(
						dueParts.map((part) => ({
							amount: part.amount,
							currency: part.phase.currency,
						})),
						defaultCurrency,
					)}
				</dd>
			</div>
		</dl>
		<nav aria-label="On this page">
			<ul
				class="grid grid-cols-[repeat(auto-fill,minmax(8.5rem,1fr))] gap-x-6 gap-y-2"
			>
				<li>
					<Button href="#to-invoice" variant="quiet">
						To invoice ({dueParts.length})
					</Button>
				</li>
				<li>
					<Button href="#to-attach" variant="quiet">
						To attach ({unattachedInvoices.length})
					</Button>
				</li>
				<li>
					<Button href="#invoices" variant="quiet">
						Invoices ({recorded.length})
					</Button>
				</li>
			</ul>
		</nav>
	</section>

	<section
		id="to-invoice"
		aria-labelledby="to-invoice-heading"
		class="grid scroll-mt-20 gap-3"
	>
		<h2 id="to-invoice-heading" class="text-label uppercase text-fg-muted">
			To invoice ({dueParts.length})
		</h2>
		<p class="max-w-prose text-sm text-fg-muted">
			Cost parts that are due and have no invoice yet. Create the invoice in
			Stripe, then attach it under To attach.
		</p>
		{!organizationData?.stripeCustomerId && (
			<div class="grid gap-3 border border-dashed border-line p-4 text-sm">
				<p>
					<span class="font-medium">No Stripe customer linked.</span>
					<span class="text-fg-muted">
						Add the client's Stripe customer ID in settings to open the client
						in Stripe from here.
					</span>
				</p>
				<Button href={`/admin/org/${organization.id}/settings`}>
					Open settings
				</Button>
			</div>
		)}
		{dueParts.length > 0 ? (
			<ul class="grid divide-y divide-dashed divide-line border border-dashed border-line">
				{dueParts.map((part) => (
					<li class="grid gap-x-6 gap-y-2 p-4 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-center">
						<div class="grid min-w-0 gap-1">
							<a
								class="w-fit max-w-full font-medium underline decoration-dashed underline-offset-4 wrap-break-word"
								href={phaseHref(part.project, part.phase)}
							>
								{part.project.name} · {part.phase.title}
							</a>
							<p class="text-sm text-fg-muted">
								{costPartLabel[part.component]} ·{" "}
								{phaseStatus[part.phase.state].label}
							</p>
						</div>
						<p class="font-medium tabular-nums sm:text-right">
							{formatMoney(part.amount, part.phase.currency)}
						</p>
						{organizationData?.stripeCustomerId && (
							<Button
								href={`${stripeDashboard}/customers/${organizationData.stripeCustomerId}`}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={`Create invoice in Stripe for ${part.project.name} · ${part.phase.title} · ${costPartLabel[part.component]} (opens in a new tab)`}
							>
								Create in Stripe
							</Button>
						)}
					</li>
				))}
			</ul>
		) : (
			<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
				Nothing to invoice. Cost parts appear here once their phase makes them
				due.
			</p>
		)}
	</section>

	<section
		id="to-attach"
		aria-labelledby="to-attach-heading"
		class="grid scroll-mt-20 gap-3"
	>
		<h2 id="to-attach-heading" class="text-label uppercase text-fg-muted">
			To attach ({unattachedInvoices.length})
		</h2>
		<p class="max-w-prose text-sm text-fg-muted">
			Stripe invoices for this client that are not linked to a cost part yet.
		</p>
		{unattachedInvoices.length > 0 ? (
			<ul class="grid divide-y divide-dashed divide-line border border-dashed border-line">
				{unattachedInvoices.map((invoice) => {
					const status = invoiceStatus(invoice, now);
					const options = dueParts.filter(
						(part) => part.phase.currency === invoice.currency,
					);
					const suggested = options.toSorted(
						(a, b) =>
							Math.abs(a.amount - invoice.total) -
							Math.abs(b.amount - invoice.total),
					)[0];
					return (
						<li class="grid gap-x-6 gap-y-3 p-4 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-start">
							<div class="grid min-w-0 justify-items-start gap-1">
								<p class="label-caps">
									Invoice{" "}
									<a
										class="text-fg underline decoration-dashed underline-offset-4"
										href={`${stripeDashboard}/invoices/${invoice.id}`}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`Open invoice ${invoice.number} in Stripe (opens in a new tab)`}
									>
										{invoice.number}
									</a>
								</p>
								<p class="text-title tabular-nums">
									{formatMoney(invoice.total, invoice.currency)}
								</p>
								<Badge type={status.badge}>{status.label}</Badge>
								<p
									class:list={[
										"text-sm",
										status.overdue ? "text-fg-danger" : "text-fg-muted",
									]}
								>
									{statusDetail(invoice)}
								</p>
							</div>
							{suggested ? (
								<form
									method="POST"
									action={actions.attachInvoiceToPhase}
									class="grid min-w-0 gap-2"
								>
									<input type="hidden" name="stripeId" value={invoice.id} />
									<Field
										as="select"
										name="target"
										label="Attach to"
										hint="The closest amount is preselected. Attaching cannot be undone from the dashboard."
										required
										result={
											attachInput?.get("stripeId") === invoice.id
												? attachResult
												: undefined
										}
										class="min-w-0 [&_select]:w-full [&_select]:min-w-0"
									>
										{projects.map((project) => {
											const group = options.filter(
												(part) => part.project.id === project.id,
											);
											return (
												group.length > 0 && (
													<optgroup label={project.name}>
														{group.map((part) => (
															<option
																value={`${part.phase.id}:${part.component}:${part.phase.version}`}
																selected={part === suggested}
															>
																{part.phase.title} ·{" "}
																{costPartLabel[part.component]} ·{" "}
																{formatMoney(part.amount, part.phase.currency)}
																{part === suggested ? " (suggested)" : ""}
															</option>
														))}
													</optgroup>
												)
											);
										})}
									</Field>
									<Button
										type="submit"
										aria-label={`Attach invoice ${invoice.number}`}
									>
										Attach
									</Button>
								</form>
							) : (
								<p class="min-w-0 text-sm text-fg-muted wrap-break-word">
									<span class="font-medium text-fg">Cannot attach yet.</span>{" "}
									{attachBlocker(invoice)}
								</p>
							)}
						</li>
					);
				})}
			</ul>
		) : (
			<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
				Every Stripe invoice for this client is attached.
			</p>
		)}
	</section>

	<section
		id="invoices"
		aria-labelledby="invoices-heading"
		class="grid scroll-mt-20 gap-3"
	>
		<h2 id="invoices-heading" class="text-label uppercase text-fg-muted">
			Invoices ({recorded.length})
		</h2>
		<p class="max-w-prose text-sm text-fg-muted">
			Invoices attached to a cost part, overdue first.
		</p>
		{unavailableCount > 0 && (
			<p class="text-sm text-fg-warning">
				{unavailableCount === 1
					? "1 attached invoice is not available from Stripe right now."
					: `${unavailableCount} attached invoices are not available from Stripe right now.`}
			</p>
		)}
		{recorded.length > 0 ? (
			<admin-invoice-list class="grid gap-3">
				<nav
					aria-label="Filter invoices"
					class="grid grid-flow-col justify-start gap-2"
				>
					<Button type="button" data-invoice-filter="all" aria-pressed="true">
						All
					</Button>
					<Button type="button" data-invoice-filter="open" aria-pressed="false">
						Open
					</Button>
					<Button type="button" data-invoice-filter="paid" aria-pressed="false">
						Paid
					</Button>
				</nav>
				<p role="status" class="text-sm text-fg-muted" data-invoice-count>
					{recorded.length} of {recorded.length}{" "}
					{recorded.length === 1 ? "invoice" : "invoices"} shown
				</p>
				<ul class="grid gap-3">
					{recorded.map((row) => {
						const status = invoiceStatus(row.invoice, now);
						return (
							<li
								class="grid gap-3 border border-dashed border-line p-4"
								data-invoice-item
								data-category={
									row.invoice.status === "open" || row.invoice.status === "paid"
										? row.invoice.status
										: "other"
								}
							>
								<div class="grid min-w-0 gap-1">
									<p class="label-caps">
										Invoice{" "}
										<a
											class="text-fg underline decoration-dashed underline-offset-4"
											href={`${stripeDashboard}/invoices/${row.invoice.id}`}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Open invoice ${row.invoice.number} in Stripe (opens in a new tab)`}
										>
											{row.invoice.number}
										</a>
									</p>
									<p class="text-title tabular-nums">
										{formatMoney(row.invoice.total, row.invoice.currency)}
									</p>
									{row.invoice.total !== row.amount && (
										<p class="text-sm text-fg-warning">
											{`Differs from the cost part (${formatMoney(row.amount, row.phase.currency)})`}
										</p>
									)}
								</div>
								<dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-[repeat(2,minmax(0,1fr))] lg:grid-cols-[repeat(4,minmax(0,1fr))]">
									<div class="grid min-w-0 content-start gap-1">
										<dt class="label-caps">Status</dt>
										<dd class="grid justify-items-start gap-1">
											<Badge type={status.badge}>{status.label}</Badge>
											<span
												class={
													status.overdue ? "text-fg-danger" : "text-fg-muted"
												}
											>
												{statusDetail(row.invoice)}
											</span>
										</dd>
									</div>
									<div class="grid min-w-0 content-start gap-1">
										<dt class="label-caps">Phase</dt>
										<dd class="wrap-break-word">
											<a
												class="font-medium underline decoration-dashed underline-offset-4"
												href={phaseHref(row.project, row.phase)}
											>
												{row.project.name} · {row.phase.title}
											</a>
										</dd>
									</div>
									<div class="grid min-w-0 content-start gap-1">
										<dt class="label-caps">Cost part</dt>
										<dd>{costPartLabel[row.component]}</dd>
									</div>
									<div class="grid min-w-0 content-start gap-1">
										<dt class="label-caps">Payment</dt>
										<dd>
											{row.invoice.paymentPage ? (
												<a
													class="underline decoration-dashed underline-offset-4"
													href={row.invoice.paymentPage}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Client's payment page for invoice ${row.invoice.number} (opens in a new tab)`}
												>
													Client's payment page
												</a>
											) : (
												<span class="text-fg-muted">No payment page</span>
											)}
										</dd>
									</div>
								</dl>
							</li>
						);
					})}
				</ul>
				<p
					class="border border-dashed border-line p-4 text-sm text-fg-muted"
					data-invoice-empty
					hidden
				>
					No invoices match this filter.
				</p>
			</admin-invoice-list>
		) : (
			<div class="grid gap-3 border border-dashed border-line p-4 text-sm">
				<p class="text-fg-muted">
					{parts.length === 0
						? "No priced phases yet. Add a priced phase to a project to start billing."
						: "No invoices attached yet. Attach a Stripe invoice under To attach and it appears here."}
				</p>
				{parts.length === 0 && (
					<Button href={`/admin/org/${organization.id}/projects`}>
						Go to projects
					</Button>
				)}
			</div>
		)}
	</section>
</AdminOrgShell>

<script>
	// "Open" shows open and overdue invoices (Stripe status "open"); void and
	// uncollectible ones only show under "All".
	class AdminInvoiceList extends HTMLElement {
		filter = "all";

		connectedCallback() {
			if (this.dataset.initialized === "true") {
				this.render();
				return;
			}

			this.dataset.initialized = "true";
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.addEventListener("click", () => {
					this.filter = button.dataset.invoiceFilter ?? "all";
					this.render();
				});
			}
		}

		render() {
			for (const button of this.querySelectorAll<HTMLButtonElement>(
				"[data-invoice-filter]",
			)) {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.invoiceFilter === this.filter),
				);
			}

			const rows = [
				...this.querySelectorAll<HTMLElement>("[data-invoice-item]"),
			];
			for (const row of rows) {
				row.hidden =
					this.filter !== "all" && row.dataset.category !== this.filter;
			}
			const visible = rows.filter((row) => !row.hidden).length;

			const count = this.querySelector("[data-invoice-count]");
			if (count) {
				count.textContent = `${visible} of ${rows.length} ${rows.length === 1 ? "invoice" : "invoices"} shown`;
			}
			const empty = this.querySelector<HTMLElement>("[data-invoice-empty]");
			if (empty) {
				empty.hidden = visible > 0;
			}
		}
	}

	customElements.define("admin-invoice-list", AdminInvoiceList);
</script>
