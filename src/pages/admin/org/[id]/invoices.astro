---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import CostSplit from "../../../../components/CostSplit.astro";
import Input from "../../../../components/Input.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	buildPhaseComponents,
	invoiceComponents,
	isInvoiceComponentDue,
} from "../../../../lib/phase-billing.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.importStripeInvoices),
	Astro.getActionResult(actions.attachInvoiceToPhase),
	Astro.getActionResult(actions.recordInvoice),
	Astro.getActionResult(actions.updatePhaseDelivery),
	Astro.getActionResult(actions.refreshStripeInvoice),
	Astro.getActionResult(actions.transitionPhase),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const [organization, organizationData, projects, unattachedInvoices] =
	await Promise.all([
		getAdminOrganizationCore(Astro.locals.db, id),
		Astro.locals.db.query.organizationMetadata.findFirst({
			columns: {
				stripeCustomerId: true,
			},
			where: {
				organizationId: id,
			},
		}),
		Astro.locals.db.query.projects.findMany({
			columns: {
				id: true,
				publicId: true,
				name: true,
			},
			with: {
				phases: {
					columns: {
						id: true,
						title: true,
						cost: true,
						upfrontAmount: true,
						deliveryAmount: true,
						acceptanceAmount: true,
						currency: true,
						state: true,
						version: true,
						deliveryState: true,
						deliveryUrl: true,
					},
					with: {
						invoices: {
							columns: {
								id: true,
								component: true,
								invoiceNumber: true,
								stripePaymentPage: true,
								currency: true,
								total: true,
								stripeStatus: true,
								stripePaidAt: true,
								stripeDueAt: true,
								fetchedAt: true,
							},
						},
					},
					orderBy: {
						id: "asc",
					},
				},
			},
			where: {
				organizationId: id,
			},
			orderBy: {
				name: "asc",
			},
		}),
		Astro.locals.db.query.invoices.findMany({
			columns: {
				id: true,
				invoiceNumber: true,
				stripePaymentPage: true,
				currency: true,
				total: true,
				stripeStatus: true,
				stripeDueAt: true,
				stripePaidAt: true,
				fetchedAt: true,
			},
			where: {
				organizationId: id,
				phaseId: {
					isNull: true,
				},
			},
			orderBy: {
				id: "desc",
			},
		}),
	]);

if (!organization) {
	return Astro.redirect("/admin");
}
const allPhases = projects.flatMap((project) =>
	project.phases.map((phase) => ({ ...phase, project })),
);
const componentTargets = allPhases.flatMap((phase) =>
	invoiceComponents.flatMap((component) => {
		const amount = phase[`${component}Amount`];
		if (amount === null || amount === 0) return [];
		const invoice = phase.invoices.find((row) => row.component === component);
		return [{ ...phase, component, amount, invoice }];
	}),
);
const unbilledTargets = componentTargets.filter((target) => !target.invoice);
const attachableTargets = unbilledTargets.filter((target) =>
	isInvoiceComponentDue(target.component, target.state),
);
const pendingTargets = unbilledTargets.filter(
	(target) => !isInvoiceComponentDue(target.component, target.state),
);
type ComponentTarget = (typeof componentTargets)[number];
type RecordedTarget = ComponentTarget & {
	invoice: NonNullable<ComponentTarget["invoice"]>;
};

const recordedTargets: RecordedTarget[] = componentTargets
	.filter((target): target is RecordedTarget => Boolean(target.invoice))
	.toSorted((a, b) => b.invoice.id.localeCompare(a.invoice.id));
const targetValue = (target: (typeof componentTargets)[number]) =>
	`${target.id}:${target.component}:${target.version}`;
const suggestedTargetValue = (invoice: (typeof unattachedInvoices)[number]) => {
	const target = attachableTargets
		.filter((target) => target.currency === invoice.currency)
		.toSorted(
			(a, b) =>
				Math.abs(a.amount - invoice.total) - Math.abs(b.amount - invoice.total),
		)[0];
	return target ? targetValue(target) : "";
};
const now = new Date();
const defaultCurrency =
	allPhases[0]?.currency ?? unattachedInvoices[0]?.currency ?? "EUR";
const formatCurrency = (amount: number, currency: string) =>
	new Intl.NumberFormat("de-DE", { style: "currency", currency }).format(
		amount,
	);
const dateFormatter = new Intl.DateTimeFormat("de-DE", { dateStyle: "medium" });

const sumByCurrency = (
	items: ReadonlyArray<{ amount: number; currency: string }>,
) => {
	const sums = new Map<string, number>();
	for (const item of items) {
		sums.set(item.currency, (sums.get(item.currency) ?? 0) + item.amount);
	}
	if (sums.size === 0) return formatCurrency(0, defaultCurrency);
	return [...sums]
		.map(([currency, total]) => formatCurrency(total, currency))
		.join(" + ");
};

const totalInvoiced = sumByCurrency(
	recordedTargets.map((t) => ({
		amount: t.invoice.total,
		currency: t.invoice.currency ?? t.currency,
	})),
);
const totalOutstanding = sumByCurrency(
	recordedTargets
		.filter((t) => t.invoice.stripeStatus === "open")
		.map((t) => ({
			amount: t.invoice.total,
			currency: t.invoice.currency ?? t.currency,
		})),
);
const overdueTargets = recordedTargets.filter(
	(t) =>
		t.invoice.stripeStatus === "open" &&
		t.invoice.stripeDueAt &&
		t.invoice.stripeDueAt < now,
);
const totalOverdue = sumByCurrency(
	overdueTargets.map((t) => ({
		amount: t.invoice.total,
		currency: t.invoice.currency ?? t.currency,
	})),
);
const totalPaid = sumByCurrency(
	recordedTargets
		.filter((t) => t.invoice.stripeStatus === "paid")
		.map((t) => ({
			amount: t.invoice.total,
			currency: t.invoice.currency ?? t.currency,
		})),
);
const totalDueToBill = sumByCurrency(attachableTargets);

// Invoiced and due-to-bill totals grouped by cost part and currency so all
// three types stay visible in the summary, not just the grand totals.
const groupByPartAndCurrency = (
	entries: ReadonlyArray<{
		component: string;
		amount: number;
		currency: string;
	}>,
) => {
	const byCurrency = new Map<
		string,
		{ upfront: number; delivery: number; acceptance: number }
	>();
	for (const entry of entries) {
		const bucket = byCurrency.get(entry.currency) ?? {
			upfront: 0,
			delivery: 0,
			acceptance: 0,
		};
		if (
			entry.component === "upfront" ||
			entry.component === "delivery" ||
			entry.component === "acceptance"
		) {
			bucket[entry.component] += entry.amount;
		}
		byCurrency.set(entry.currency, bucket);
	}
	return [...byCurrency].map(([currency, bucket]) => ({
		currency,
		total: bucket.upfront + bucket.delivery + bucket.acceptance,
		items: (
			[
				{ component: "upfront", amount: bucket.upfront },
				{ component: "delivery", amount: bucket.delivery },
				{ component: "acceptance", amount: bucket.acceptance },
			] as const
		)
			.filter((item) => item.amount !== 0)
			.map((item) => ({ ...item, status: "not_due" as const })),
	}));
};
const invoicedByPart = groupByPartAndCurrency(
	recordedTargets.map((target) => ({
		component: target.component,
		amount: target.invoice.total,
		currency: target.invoice.currency ?? target.currency,
	})),
);
const dueByPart = groupByPartAndCurrency(attachableTargets);
const componentLabel: Record<string, string> = {
	upfront: "Upfront part",
	delivery: "Delivery part",
	acceptance: "Acceptance part",
};
const phaseSplit = (target: (typeof componentTargets)[number]) =>
	buildPhaseComponents({
		upfrontAmount: target.upfrontAmount,
		deliveryAmount: target.deliveryAmount,
		acceptanceAmount: target.acceptanceAmount,
		state: target.state,
		invoices: target.invoices,
	});
const openCount = recordedTargets.filter(
	(t) => t.invoice.stripeStatus === "open",
).length;
const paidCount = recordedTargets.filter(
	(t) => t.invoice.stripeStatus === "paid",
).length;
const showRecordedFilter = openCount > 0 && paidCount > 0;

const latestFetch = [
	...unattachedInvoices.map((i) => i.fetchedAt),
	...recordedTargets.map((t) => t.invoice.fetchedAt),
]
	.filter((d): d is Date => d instanceof Date)
	.sort((a, b) => b.getTime() - a.getTime())[0];

const getInvoiceStatus = (invoice: {
	stripeStatus: string | null;
	stripeDueAt: Date | null;
}) => {
	if (invoice.stripeStatus === "paid") {
		return { label: "Paid", type: "success" as const, isOverdue: false };
	}
	if (invoice.stripeStatus === "open") {
		if (invoice.stripeDueAt && invoice.stripeDueAt < now) {
			return { label: "Overdue", type: "error" as const, isOverdue: true };
		}
		return { label: "Open", type: "info" as const, isOverdue: false };
	}
	if (
		invoice.stripeStatus === "void" ||
		invoice.stripeStatus === "uncollectible"
	) {
		return {
			label: invoice.stripeStatus,
			type: "error" as const,
			isOverdue: false,
		};
	}
	if (invoice.stripeStatus === "draft") {
		return { label: "Draft", type: "gray" as const, isOverdue: false };
	}
	return {
		label: invoice.stripeStatus ?? "Invoiced",
		type: "info" as const,
		isOverdue: false,
	};
};

const getAttachmentGuidance = (
	invoice: (typeof unattachedInvoices)[number],
) => {
	const matchingAttachable = attachableTargets.filter(
		(target) => target.currency === invoice.currency,
	);
	if (matchingAttachable.length > 0) {
		return { canAttach: true as const, targets: matchingAttachable };
	}

	const matchingPending = pendingTargets.filter(
		(target) => target.currency === invoice.currency,
	);
	if (matchingPending.length > 0) {
		const preview = matchingPending
			.slice(0, 2)
			.map(
				(t) =>
					`"${t.project.name} · ${t.title}" (${t.component}, state: ${t.state.replace("_", " ")})`,
			)
			.join(", ");
		const extra =
			matchingPending.length > 2
				? ` and ${matchingPending.length - 2} more`
				: "";
		return {
			canAttach: false as const,
			reason: `Components exist but are not due yet: ${preview}${extra}. Advance phase state to attach.`,
		};
	}

	const currencyMismatches = unbilledTargets.filter(
		(target) => target.currency !== invoice.currency,
	);
	if (currencyMismatches.length > 0) {
		const otherCurrencies = [
			...new Set(currencyMismatches.map((t) => t.currency)),
		].join(", ");
		return {
			canAttach: false as const,
			reason: `Currency mismatch: invoice is in ${invoice.currency}, but unbilled phases are in ${otherCurrencies}.`,
		};
	}

	return {
		canAttach: false as const,
		reason: "No unbilled phase components available for this organization.",
	};
};

const sectionLabelClass = "text-label uppercase text-fg-muted";
---

<AdminOrgShell
	{organization}
	activePage="invoices"
	showSuccess={actionSucceeded}
>
	{actionError && (
		<p class="border border-dashed border-line-danger p-3 text-sm text-fg-danger">
			{actionError.message}
		</p>
	)}
	<section class="grid gap-6" aria-labelledby="invoices-heading">
		<div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
			<div class="grid gap-1">
				<h2 id="invoices-heading" class={sectionLabelClass}>Invoices</h2>
				{organizationData?.stripeCustomerId ? (
					<p class="text-xs text-fg-muted">
						<span>Customer </span>
						<a
							class="underline decoration-dashed underline-offset-4 hover:text-fg"
							href={`https://dashboard.stripe.com/customers/${organizationData.stripeCustomerId}`}
							target="_blank"
							rel="noreferrer"
						>
							{organizationData.stripeCustomerId}
						</a>
						{latestFetch && (
							<span> · Synced {dateFormatter.format(latestFetch)}</span>
						)}
					</p>
				) : (
					<p class="text-xs text-fg-muted">No Stripe customer linked</p>
				)}
			</div>
			{organizationData?.stripeCustomerId ? (
				<form method="POST" action={actions.importStripeInvoices}>
					<input type="hidden" name="organizationId" value={organization.id} />
					<Button type="submit">Fetch from Stripe</Button>
				</form>
			) : (
				<Button href={`/admin/org/${organization.id}/settings`}>
					Link Stripe customer
				</Button>
			)}
		</div>

		<dl
			class="grid grid-cols-2 gap-4 border border-dashed border-line p-4 sm:grid-cols-3 lg:grid-cols-5"
			aria-label="Invoicing summary"
		>
			<div class="grid gap-1">
				<dt class="label-caps">Total Invoiced</dt>
				<dd class="text-title tabular-nums">{totalInvoiced}</dd>
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Outstanding</dt>
				<dd class="text-title tabular-nums">{totalOutstanding}</dd>
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Overdue</dt>
				<dd
					class:list={[
						"text-title tabular-nums",
						overdueTargets.length > 0 && "text-fg-danger",
					]}
					>{totalOverdue}</dd
				>
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Due to Bill</dt>
				<dd class="text-title tabular-nums">{totalDueToBill}</dd>
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Paid</dt>
				<dd class="text-title tabular-nums text-fg-success">{totalPaid}</dd>
			</div>
		</dl>

		{(invoicedByPart.length > 0 || dueByPart.length > 0) && (
			<div class="grid gap-3 border border-dashed border-line p-4 sm:grid-cols-2">
				{invoicedByPart.length > 0 && (
					<div class="grid content-start gap-2">
						<p class="label-caps">Invoiced by cost part</p>
						{invoicedByPart.map((split) => (
							<CostSplit
								items={split.items}
								currency={split.currency}
								total={split.total}
								variant="compact"
								showStatus={false}
							/>
						))}
					</div>
				)}
				{dueByPart.length > 0 && (
					<div class="grid content-start gap-2">
						<p class="label-caps">Due to bill by cost part</p>
						{dueByPart.map((split) => (
							<CostSplit
								items={split.items}
								currency={split.currency}
								total={split.total}
								variant="compact"
								showStatus={false}
							/>
						))}
					</div>
				)}
			</div>
		)}

		{unattachedInvoices.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Unattached from Stripe</h3>
				<ul class="grid border border-dashed border-line">
					{unattachedInvoices.map((invoice) => {
						const guidance = getAttachmentGuidance(invoice);
						const suggested = suggestedTargetValue(invoice);
						return (
							<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1.5fr)] md:items-center">
								<div class="grid gap-1">
									<a
										class="w-max font-medium underline decoration-dashed underline-offset-4"
										href={invoice.stripePaymentPage}
									>
										{invoice.invoiceNumber}
									</a>
									<p class="text-xs text-fg-muted">
										<span>Stripe {invoice.stripeStatus ?? "not fetched"}</span>
										{invoice.stripeDueAt && (
											<>
												<span> · </span>
												<span
													class:list={[
														invoice.stripeStatus === "open" &&
															invoice.stripeDueAt < now &&
															"font-semibold text-fg-danger",
													]}
												>
													due {dateFormatter.format(invoice.stripeDueAt)}
													{invoice.stripeStatus === "open" &&
														invoice.stripeDueAt < now &&
														" (overdue)"}
												</span>
											</>
										)}
										{invoice.stripePaidAt && (
											<>
												<span> · </span>
												<span>
													paid {dateFormatter.format(invoice.stripePaidAt)}
												</span>
											</>
										)}
										{invoice.fetchedAt && (
											<>
												<span> · </span>
												<span>
													synced {dateFormatter.format(invoice.fetchedAt)}
												</span>
											</>
										)}
									</p>
								</div>
								<p class="font-medium tabular-nums md:text-right">
									{formatCurrency(invoice.total, invoice.currency)}
								</p>
								{guidance.canAttach ? (
									<form
										method="POST"
										action={actions.attachInvoiceToPhase}
										class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2"
									>
										<input type="hidden" name="invoiceId" value={invoice.id} />
										<Input
											as="select"
											name="target"
											aria-label="Phase component"
											required
										>
											{guidance.targets.map((target) => (
												<option
													value={targetValue(target)}
													selected={targetValue(target) === suggested}
												>
													{target.project.name} · {target.title} ·{" "}
													{target.component} ·{" "}
													{formatCurrency(target.amount, target.currency)}
													{targetValue(target) === suggested
														? " (suggested)"
														: ""}
												</option>
											))}
										</Input>
										<Button type="submit">Attach</Button>
									</form>
								) : (
									<div class="grid gap-0.5 text-xs">
										<p class="font-medium text-fg-warning">Cannot attach</p>
										<p class="text-fg-muted">{guidance.reason}</p>
									</div>
								)}
							</li>
						);
					})}
				</ul>
			</div>
		)}

		{attachableTargets.length > 0 && (
			<div class="grid gap-3">
				<h3 class={sectionLabelClass}>Due, not invoiced</h3>
				<ul class="grid border border-dashed border-line">
					{attachableTargets.map((target) => (
						<li class="grid gap-x-6 gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 md:grid-cols-[minmax(0,1fr)_auto_auto] md:items-start">
							<div class="grid gap-2">
								<p class="font-medium">
									<a
										class="underline decoration-dashed underline-offset-4"
										href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}
									>
										{target.project.name}
									</a>{" "}
									· {target.title}
								</p>
								<div class="max-w-xs">
									<CostSplit
										items={phaseSplit(target)}
										currency={target.currency}
										total={target.cost}
										variant="compact"
										highlight={target.component}
									/>
								</div>
							</div>
							<div class="grid gap-1 md:justify-items-end md:text-right">
								<p class="font-medium tabular-nums">
									{formatCurrency(target.amount, target.currency)}
								</p>
								<Badge type="info">
									{componentLabel[target.component] ?? target.component}
								</Badge>
							</div>
							<Badge type="info">due</Badge>
							<details class="grid gap-3 md:col-span-3">
								<Button as="summary" variant="quiet">
									Record invoice
								</Button>
								<form
									method="POST"
									action={actions.recordInvoice}
									class="grid gap-3 border border-dashed border-line p-4 sm:grid-cols-2 lg:grid-cols-4 items-start"
								>
									<input type="hidden" name="phaseId" value={target.id} />
									<input
										type="hidden"
										name="component"
										value={target.component}
									/>
									<input
										type="hidden"
										name="expectedVersion"
										value={target.version}
									/>
									<label class="grid gap-1 text-sm">
										<span class="font-medium">Invoice number</span>
										<Input name="invoiceNumber" autocomplete="off" required />
									</label>
									<label class="grid gap-1 text-sm">
										<span class="font-medium">Stripe id</span>
										<Input
											name="stripeId"
											autocomplete="off"
											placeholder="in_..."
											required
										/>
									</label>
									<label class="grid gap-1 text-sm">
										<span class="font-medium">Payment URL</span>
										<Input
											name="stripePaymentPage"
											type="url"
											placeholder="https://invoice.stripe.com/..."
											required
										/>
									</label>
									<label class="grid gap-1 text-sm">
										<span class="font-medium">Total ({target.currency})</span>
										<Input
											name="total"
											type="number"
											min="0"
											step="0.0001"
											value={target.amount}
											data-component-amount={target.amount}
											required
										/>
										<span
											class="text-xs text-fg-warning"
											data-amount-warning
											hidden
										>
											Differs from component amount (
											{formatCurrency(target.amount, target.currency)}).
										</span>
									</label>
									<Button type="submit" class="sm:col-span-2 lg:col-span-4">
										Record
									</Button>
								</form>
							</details>
						</li>
					))}
				</ul>
			</div>
		)}

		<div class="grid gap-3">
			<div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
				<h3 class={sectionLabelClass}>Recorded</h3>
				{showRecordedFilter && (
					<nav
						aria-label="Filter recorded invoices"
						class="grid grid-flow-col justify-start gap-2"
						data-invoice-filter-nav
					>
						<Button type="button" data-invoice-filter="all" aria-pressed="true">
							All ({recordedTargets.length})
						</Button>
						<Button
							type="button"
							data-invoice-filter="open"
							aria-pressed="false"
						>
							Open ({openCount})
						</Button>
						<Button
							type="button"
							data-invoice-filter="paid"
							aria-pressed="false"
						>
							Paid ({paidCount})
						</Button>
					</nav>
				)}
			</div>
			<ul class="grid border border-dashed border-line">
				{recordedTargets.length > 0 ? (
					recordedTargets.map((target) => {
						const status = getInvoiceStatus(target.invoice);
						const rowCategory =
							target.invoice.stripeStatus === "paid" ? "paid" : "open";
						return (
							<li
								class="grid gap-x-6 gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 md:grid-cols-[minmax(0,1fr)_auto_auto_auto] md:items-start"
								data-recorded-row
								data-row-category={rowCategory}
							>
								<div class="grid gap-2">
									<div class="grid grid-flow-col items-center justify-start gap-2">
										<a
											class="w-max font-medium underline decoration-dashed underline-offset-4"
											href={target.invoice.stripePaymentPage}
										>
											{target.invoice.invoiceNumber}
										</a>
										<Badge type="info">
											{componentLabel[target.component] ?? target.component}
										</Badge>
									</div>
									<p class="text-sm">
										<a
											class="underline decoration-dashed underline-offset-4"
											href={`/admin/org/${organization.id}/projects/${target.project.publicId}`}
										>
											{target.project.name}
										</a>{" "}
										· {target.title}
									</p>
									<div class="max-w-xs">
										<CostSplit
											items={phaseSplit(target)}
											currency={target.currency}
											total={target.cost}
											variant="compact"
											highlight={target.component}
										/>
									</div>
									<p class="text-xs text-fg-muted">
										<span>
											Stripe {target.invoice.stripeStatus ?? "not fetched"}
										</span>
										{target.invoice.stripeDueAt && (
											<>
												<span> · </span>
												<span
													class:list={[
														status.isOverdue && "font-semibold text-fg-danger",
													]}
												>
													due {dateFormatter.format(target.invoice.stripeDueAt)}
													{status.isOverdue && " (overdue)"}
												</span>
											</>
										)}
										{target.invoice.stripePaidAt && (
											<>
												<span> · </span>
												<span>
													paid{" "}
													{dateFormatter.format(target.invoice.stripePaidAt)}
												</span>
											</>
										)}
										{target.invoice.fetchedAt && (
											<>
												<span> · </span>
												<span>
													synced{" "}
													{dateFormatter.format(target.invoice.fetchedAt)}
												</span>
											</>
										)}
									</p>
									{target.component === "delivery" &&
										(target.deliveryState === "url" && target.deliveryUrl ? (
											<a
												class="w-max text-xs underline decoration-dashed underline-offset-4"
												href={target.deliveryUrl}
												rel="noreferrer"
												target="_blank"
											>
												Delivery PR/MR
											</a>
										) : (
											<p class="text-xs text-fg-muted">
												{target.deliveryState === "none"
													? "Delivered without PR/MR"
													: "Delivery not recorded"}
											</p>
										))}
								</div>
								<Badge type={status.type}>{status.label}</Badge>
								<div class="grid gap-1 md:text-right">
									<p class="font-medium tabular-nums">
										{formatCurrency(target.invoice.total, target.currency)}
									</p>
									{target.invoice.total !== target.amount && (
										<p class="text-xs text-fg-warning">
											Expected {formatCurrency(target.amount, target.currency)}
										</p>
									)}
								</div>
								<form
									method="POST"
									action={actions.refreshStripeInvoice}
									class="md:justify-self-end"
								>
									<input
										type="hidden"
										name="invoiceId"
										value={target.invoice.id}
									/>
									<Button type="submit" variant="quiet">
										Refresh
									</Button>
								</form>
								{target.component === "delivery" &&
									(target.state === "delivered" ||
										target.state === "accepted") && (
										<details class="grid gap-3 md:col-span-4">
											<Button as="summary" variant="quiet">
												Edit delivery
											</Button>
											<form
												method="POST"
												action={actions.updatePhaseDelivery}
												class="grid gap-3 border border-dashed border-line p-4 md:grid-cols-[auto_minmax(0,1fr)_auto] md:items-end"
											>
												<input type="hidden" name="phaseId" value={target.id} />
												<input
													type="hidden"
													name="expectedVersion"
													value={target.version}
												/>
												<label class="grid gap-1 text-sm">
													<span class="font-medium">Delivery</span>
													<Input
														as="select"
														name="deliveryChoice"
														data-delivery-choice
														required
													>
														<option
															value="url"
															selected={target.deliveryState !== "none"}
														>
															Delivery link
														</option>
														<option
															value="none"
															selected={target.deliveryState === "none"}
														>
															No delivery PR/MR
														</option>
													</Input>
												</label>
												<label
													data-delivery-url-field
													class="grid gap-1 text-sm"
												>
													<span class="font-medium">Delivery URL</span>
													<Input
														name="deliveryUrl"
														type="url"
														inputmode="url"
														autocomplete="off"
														value={target.deliveryUrl ?? ""}
														placeholder="https://github.com/…"
													/>
												</label>
												<Button type="submit">Update delivery</Button>
											</form>
										</details>
									)}
							</li>
						);
					})
				) : (
					<li class="grid gap-2 p-6 text-sm text-fg-muted">
						<p class="font-medium text-fg">No invoices recorded yet</p>
						<p class="text-xs">
							{allPhases.length === 0
								? "No project phases found. Create a project and add priced phases to begin billing."
								: "Invoices will appear here once imported from Stripe or recorded against due phase components."}
						</p>
						{allPhases.length === 0 && (
							<Button
								href={`/admin/org/${organization.id}/projects`}
								class="w-max mt-1"
							>
								Go to projects
							</Button>
						)}
					</li>
				)}
			</ul>
		</div>
	</section>
</AdminOrgShell>

<script>
	for (const input of document.querySelectorAll("[data-component-amount]")) {
		if (!(input instanceof HTMLInputElement)) continue;
		const warning = input.parentElement?.querySelector("[data-amount-warning]");
		if (!(warning instanceof HTMLElement)) continue;
		const syncWarning = () => {
			warning.hidden =
				Number(input.value) === Number(input.dataset.componentAmount);
		};
		syncWarning();
		input.addEventListener("input", syncWarning);
	}

	for (const select of document.querySelectorAll("[data-delivery-choice]")) {
		if (!(select instanceof HTMLSelectElement)) {
			continue;
		}

		const field = select
			.closest("form")
			?.querySelector<HTMLLabelElement>("[data-delivery-url-field]");
		const input = field?.querySelector<HTMLInputElement>(
			'input[name="deliveryUrl"]',
		);

		if (
			!(field instanceof HTMLElement) ||
			!(input instanceof HTMLInputElement)
		) {
			continue;
		}

		const syncDeliveryUrl = () => {
			const show = select.value === "url";
			field.hidden = !show;
			input.required = show;

			if (!show) {
				input.value = "";
			}
		};

		syncDeliveryUrl();
		select.addEventListener("change", syncDeliveryUrl);
	}

	for (const nav of document.querySelectorAll("[data-invoice-filter-nav]")) {
		const buttons = nav.querySelectorAll<HTMLButtonElement>(
			"[data-invoice-filter]",
		);
		const rows = document.querySelectorAll<HTMLElement>("[data-recorded-row]");

		for (const button of buttons) {
			button.addEventListener("click", () => {
				const filter = button.dataset.invoiceFilter;
				for (const btn of buttons) {
					btn.setAttribute("aria-pressed", String(btn === button));
				}
				for (const row of rows) {
					if (filter === "all") {
						row.hidden = false;
					} else if (filter === "open") {
						row.hidden = row.dataset.rowCategory !== "open";
					} else if (filter === "paid") {
						row.hidden = row.dataset.rowCategory !== "paid";
					}
				}
			});
		}
	}
</script>
