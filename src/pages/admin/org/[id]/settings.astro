---
export const prerender = false;

import { actions } from "astro:actions";
import { and, count, eq, ne } from "drizzle-orm";
import Button from "../../../../components/Button.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { member, projects } from "../../../../lib/schema.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.updateOrganizationSettings),
	Astro.getActionResult(actions.hardDeleteOrganization),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const organization = await Astro.locals.db.query.organization.findFirst({
	columns: {
		id: true,
		name: true,
		slug: true,
		logo: true,
	},
	extras: {
		projectCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(projects)
				.where(eq(projects.organizationId, organization.id))
				.getSQL()
				.mapWith(Number),
		unarchivedProjectCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(projects)
				.where(
					and(
						eq(projects.organizationId, organization.id),
						ne(projects.state, "archived"),
					),
				)
				.getSQL()
				.mapWith(Number),
		memberCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(member)
				.where(eq(member.organizationId, organization.id))
				.getSQL()
				.mapWith(Number),
	},
	with: {
		data: {
			columns: {
				yearlyBudget: true,
				stripeCustomerId: true,
			},
		},
	},
	where: {
		id,
	},
});

if (!organization) {
	return Astro.redirect("/admin");
}
---

<AdminOrgShell
	{organization}
	activePage="settings"
	showSuccess={actionSucceeded}
>
	{actionError && <p class="border border-dashed border-red-300 p-3 text-sm text-red-700 dark:border-red-700 dark:text-red-300">{actionError.message}</p>}
	<section class="grid gap-6" aria-labelledby="settings-heading">
		<div class="grid gap-3">
			<h2
				id="settings-heading"
				class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>Settings</h2
			>
			<form
				method="POST"
				action={actions.updateOrganizationSettings}
				class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-2"
			>
				<input type="hidden" name="organizationId" value={organization.id}>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Name</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="name"
						value={organization.name}
						required
					></label
				>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Slug</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="slug"
						value={organization.slug}
						required
					></label
				>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Logo URL</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="logo"
						value={organization.logo ?? ""}
						type="url"
					></label
				>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Yearly budget</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="yearlyBudget"
						value={organization.data?.yearlyBudget ?? ""}
						type="number"
						min="1"
					></label
				>
				<label class="grid gap-1 text-sm md:col-span-2"
					><span class="font-medium">Stripe customer id</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="stripeCustomerId"
						value={organization.data?.stripeCustomerId ?? ""}
						placeholder="cus_…"
					></label
				>
				<div class="grid md:col-span-2"
					><Button type="submit">Save settings</Button></div
				>
			</form>
		</div>
		<section
			class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700"
		>
			<h3 class="font-semibold">Offboarding</h3>
			<p class="text-sm text-neutral-600 dark:text-neutral-400"
				>{organization.unarchivedProjectCount}
				projects not yet archived, {organization.memberCount} members remaining.</p
			>
			<div class="grid grid-flow-col justify-start gap-2">
				<Button href={`/admin/org/${organization.id}/projects`}
					>Projects</Button
				>
				<Button href={`/admin/org/${organization.id}/members`}>Members</Button>
			</div>
		</section>
		{organization.projectCount === 0 && (
			<form method="POST" action={actions.hardDeleteOrganization} class="grid gap-3 border border-dashed border-red-300 p-4 dark:border-red-700">
				<input type="hidden" name="organizationId" value={organization.id} />
				<label class="grid gap-1 text-sm"><span class="font-medium">Type {organization.name} to delete</span><input class="border border-dashed border-red-300 bg-transparent px-3 py-2 dark:border-red-700" name="confirmation" required /></label>
				<Button type="submit">Delete organization</Button>
			</form>
		)}
	</section>
</AdminOrgShell>
