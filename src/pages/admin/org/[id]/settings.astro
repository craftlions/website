---
export const prerender = false;

import { actions } from "astro:actions";
import { and, count, eq, ne } from "drizzle-orm";
import Button from "../../../../components/Button.astro";
import ConfirmAction from "../../../../components/ConfirmAction.astro";
import Field from "../../../../components/Field.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import {
	clientDeletedMessage,
	successMessage,
} from "../../../../lib/action-feedback.ts";
import { member, projects } from "../../../../lib/schema.ts";
import { submittedValues } from "../../../../lib/submitted-values.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const organization = await Astro.locals.db.query.organization.findFirst({
	columns: {
		id: true,
		name: true,
		slug: true,
		logo: true,
	},
	extras: {
		projectCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(projects)
				.where(eq(projects.organizationId, organization.id))
				.getSQL()
				.mapWith(Number),
		unarchivedProjectCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(projects)
				.where(
					and(
						eq(projects.organizationId, organization.id),
						ne(projects.state, "archived"),
					),
				)
				.getSQL()
				.mapWith(Number),
		memberCount: (organization) =>
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(member)
				.where(eq(member.organizationId, organization.id))
				.getSQL()
				.mapWith(Number),
	},
	with: {
		invoices: {
			columns: {
				id: true,
			},
			limit: 1,
		},
		data: {
			columns: {
				yearlyBudget: true,
				stripeCustomerId: true,
			},
		},
	},
	where: {
		id,
	},
});

if (!organization) {
	return Astro.redirect("/admin");
}

// The settings form and the client URL form post separate actions that each
// write only their own fields, so a stale tab cannot overwrite the other
// form's fields. After a failed save, only the failed form shows what was
// submitted.
const settingsResult = Astro.getActionResult(
	actions.updateOrganizationSettings,
);
const slugResult = Astro.getActionResult(actions.updateOrganizationSlug);
const submitted = submittedValues(Astro.locals, settingsResult);
---

<AdminOrgShell
	{organization}
	activePage="settings"
	results={[
		[settingsResult, `Identity and billing for ${organization.name} saved.`],
		successMessage(
			slugResult,
			({ slug }) =>
				`Client URL changed to ${Astro.url.origin}/dash/org/${slug}. Send the new address to the client.`,
		),
		successMessage(
			Astro.getActionResult(actions.hardDeleteOrganization),
			clientDeletedMessage,
		),
	]}
	fieldLabels={{
		name: "Name",
		slug: "Slug",
		logo: "Logo URL",
		yearlyBudget: "Yearly budget (EUR)",
		stripeCustomerId: "Stripe customer ID",
		confirmation: "Confirmation",
	}}
>
	<form
		method="POST"
		action={actions.updateOrganizationSettings}
		class="grid gap-6"
	>
		<input type="hidden" name="organizationId" value={organization.id}>
		<section aria-labelledby="identity-heading" class="grid gap-3">
			<h2 id="identity-heading" class="text-label uppercase text-fg-muted">
				Identity
			</h2>
			<p class="max-w-prose text-sm text-fg-muted">
				How this client is named in the admin area and on their dashboard.
			</p>
			<div
				class="grid grid-cols-1 gap-4 border border-dashed border-line p-4 md:grid-cols-2"
			>
				<Field
					label="Name"
					name="name"
					value={submitted?.get("name") ?? organization.name}
					required
					maxlength={120}
					autocomplete="off"
					hint="Up to 120 characters. Shown as the client dashboard title."
					result={settingsResult}
				/>
				<Field
					label="Logo URL"
					name="logo"
					type="url"
					value={submitted?.get("logo") ?? organization.logo ?? ""}
					placeholder="https://"
					hint="Optional. The full address of an image. Leave empty for no logo."
					result={settingsResult}
				/>
			</div>
		</section>
		<section aria-labelledby="billing-heading" class="grid gap-3">
			<h2 id="billing-heading" class="text-label uppercase text-fg-muted">
				Billing
			</h2>
			<p class="max-w-prose text-sm text-fg-muted">
				The budget the client dashboard compares invoices against, and the
				Stripe customer whose invoices belong to this client.
			</p>
			<div
				class="grid grid-cols-1 gap-4 border border-dashed border-line p-4 md:grid-cols-2"
			>
				<Field
					label="Yearly budget (EUR)"
					name="yearlyBudget"
					type="number"
					inputmode="numeric"
					min={1}
					step={1}
					value={submitted?.get("yearlyBudget") ??
						organization.data?.yearlyBudget ??
						""}
					hint="Whole euros per calendar year, January to December. Compared with this year's invoices. Leave empty for no budget."
					result={settingsResult}
				/>
				<div class="grid grid-cols-1 content-start gap-1.5">
					<Field
						label="Stripe customer ID"
						name="stripeCustomerId"
						value={(organization.invoices.length > 0
							? undefined
							: submitted?.get("stripeCustomerId")) ??
							organization.data?.stripeCustomerId ??
							""}
						placeholder="cus_…"
						pattern="cus_[A-Za-z0-9]+"
						title="Starts with cus_ followed by letters and digits"
						autocomplete="off"
						spellcheck="false"
						readonly={organization.invoices.length > 0}
						hint={organization.invoices.length > 0
							? "Locked: this client has attached invoices, and they stay with this Stripe customer."
							: "Optional. Starts with cus_, as shown on the customer page in Stripe. Leave empty to unlink."}
						result={settingsResult}
					/>
					{organization.data?.stripeCustomerId && (
						<Button
							variant="quiet"
							href={`https://dashboard.stripe.com/customers/${organization.data.stripeCustomerId}`}
							target="_blank"
							rel="noreferrer"
							aria-label={`Open in Stripe: customer ${organization.data.stripeCustomerId} (opens in a new tab)`}
							class="max-w-full wrap-break-word"
						>
							Open in Stripe
						</Button>
					)}
				</div>
			</div>
		</section>
		<Button type="submit">Save settings</Button>
	</form>
	<section aria-labelledby="client-url-heading" class="grid gap-3">
		<h2 id="client-url-heading" class="text-label uppercase text-fg-muted">
			Client URL
		</h2>
		<p class="max-w-prose text-sm text-fg-muted">
			The address members of this client use to open their dashboard. It is
			changed on its own, with a confirmation, because existing links and
			bookmarks stop working.
		</p>
		<form
			method="POST"
			action={actions.updateOrganizationSlug}
			class="grid grid-cols-1 gap-4 border border-dashed border-line p-4 md:grid-cols-2"
			data-client-url-form
		>
			<input type="hidden" name="organizationId" value={organization.id}>
			<Field
				id="client-slug"
				label="Slug"
				name="slug"
				value={submittedValues(Astro.locals, slugResult)?.get("slug") ??
					organization.slug}
				data-current-slug={organization.slug}
				required
				pattern="[a-z0-9]+(-[a-z0-9]+)*"
				title="Lowercase letters and digits, separated by single hyphens"
				autocomplete="off"
				spellcheck="false"
				class="wrap-anywhere"
				hint={`Currently ${Astro.url.origin}/dash/org/${organization.slug}. Lowercase letters, digits and single hyphens. Changing it breaks existing links and bookmarks to the dashboard.`}
				result={slugResult}
			/>
			<div class="grid md:col-span-2">
				<ConfirmAction
					id="confirm-client-url"
					trigger="Change client URL"
					title="Change the client URL?"
					confirm="Change client URL"
					cancel="Keep current URL"
				>
					The dashboard moves from
					<span class="wrap-anywhere"
						>{Astro.url.origin}/dash/org/{organization.slug}</span
					>
					to
					<output for="client-slug" class="wrap-anywhere"
						>{Astro.url.origin}/dash/org/{organization.slug}</output
					>. Links and bookmarks to the old address stop working, so send the
					new address to the client.
				</ConfirmAction>
			</div>
		</form>
	</section>
	<section
		aria-labelledby="delete-heading"
		class="grid gap-3 border-t border-dashed border-line pt-6"
	>
		<h2 id="delete-heading" class="text-label uppercase text-fg-muted">
			Delete client
		</h2>
		<p class="max-w-prose text-sm text-fg-muted">
			Deleting a client is permanent and cannot be undone.
		</p>
		{organization.projectCount === 0 ? (
			<form
				method="POST"
				action={actions.hardDeleteOrganization}
				class="grid grid-cols-1 gap-4 border border-dashed border-line-danger p-4 wrap-anywhere"
			>
				<input type="hidden" name="organizationId" value={organization.id}>
				<div class="grid gap-2 text-sm">
					<p>Deleting {organization.name} removes:</p>
					<ul class="grid list-disc gap-1 pl-5">
						<li>the client with its name, client URL and logo</li>
						<li>
							its yearly budget and its link to the Stripe customer; the
							customer and its invoices in Stripe are not touched
						</li>
						<li>
							{`${organization.memberCount} ${organization.memberCount === 1 ? "membership" : "memberships"}`}{" "}
							and any open invitations; the people keep their user accounts but
							lose access to this client
						</li>
					</ul>
				</div>
				<ConfirmAction
					id="confirm-delete-client"
					trigger="Delete client"
					triggerVariant="danger"
					title={`Delete ${organization.name}?`}
					confirm="Delete client"
					cancel="Keep client"
					typeToConfirm={organization.name}
				>
					<span class="wrap-anywhere">{organization.name}</span>, its settings,
					budget, Stripe link and
					{`${organization.memberCount} ${organization.memberCount === 1 ? "membership" : "memberships"}`}{" "}
					are deleted for good.
				</ConfirmAction>
			</form>
		) : (
			<div class="grid grid-cols-1 gap-4 border border-dashed border-line-danger p-4 wrap-anywhere">
				<p class="max-w-prose text-sm">
					Only a client without projects can be deleted. Projects cannot be
					deleted, archived ones included, so {organization.name} stays. To
					offboard the client, archive its projects and remove its members.
				</p>
				<ul class="grid gap-2">
					<li>
						<Button
							variant="quiet"
							href={`/admin/org/${organization.id}/projects`}
							class="max-w-full"
						>
							{`${organization.projectCount} ${organization.projectCount === 1 ? "project" : "projects"}, ${organization.unarchivedProjectCount} not archived`}
						</Button>
					</li>
					<li>
						<Button
							variant="quiet"
							href={`/admin/org/${organization.id}/members`}
							class="max-w-full"
						>
							{`${organization.memberCount} ${organization.memberCount === 1 ? "member" : "members"}`}
						</Button>
					</li>
				</ul>
			</div>
		)}
	</section>
</AdminOrgShell>

<script>
	const form = document.querySelector<HTMLFormElement>(
		"form[data-client-url-form]",
	);
	const slug = form?.elements.namedItem("slug");
	const output = form?.querySelector("output");

	if (form && slug instanceof HTMLInputElement && output) {
		// The field can start with a slug that failed to save, so compare with
		// the client's current slug rather than the field's initial value.
		const sync = () => {
			slug.setCustomValidity(
				slug.value === slug.dataset.currentSlug
					? "Enter a new slug to change the client URL."
					: "",
			);
			output.value = `${window.location.origin}/dash/org/${slug.value}`;
		};
		// ConfirmAction reports this validity before its dialog opens.
		slug.addEventListener("input", sync);
		sync();
	}
</script>
