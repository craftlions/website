---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const organization = await getAdminOrganizationCore(Astro.locals.db, id);

if (!organization) {
	return Astro.redirect("/admin");
}

const actionResult = Astro.getActionResult(actions.createProject);

const projects = await Astro.locals.db.query.projects.findMany({
	columns: {
		publicId: true,
		name: true,
		state: true,
	},
	with: {
		phases: {
			columns: {
				cost: true,
				currency: true,
				state: true,
			},
		},
	},
	where: {
		organizationId: id,
	},
	orderBy: {
		name: "asc",
	},
});

const attentionLabels = {
	submitted: "to send",
	planned: "awaiting approval",
	approved: "ready to start",
	in_progress: "in work",
	delivered: "awaiting acceptance",
} as const;

const summarize = (project: (typeof projects)[number]) => {
	const totals = new Map<string, number>();
	const attention = new Map<keyof typeof attentionLabels, number>();
	for (const phase of project.phases) {
		if (phase.state === "cancelled") continue;
		totals.set(phase.currency, (totals.get(phase.currency) ?? 0) + phase.cost);
		if (phase.state in attentionLabels) {
			const state = phase.state as keyof typeof attentionLabels;
			attention.set(state, (attention.get(state) ?? 0) + 1);
		}
	}
	return {
		total:
			[...totals]
				.map(([currency, total]) =>
					new Intl.NumberFormat("de-DE", {
						style: "currency",
						currency,
					}).format(total),
				)
				.join(" · ") || "—",
		attention: [...attention]
			.map(([state, count]) => `${count} ${attentionLabels[state]}`)
			.join(" · "),
	};
};

const activeProjects = projects.filter(
	(project) => project.state !== "archived",
);
const archivedProjects = projects.filter(
	(project) => project.state === "archived",
);
---

<AdminOrgShell
	{organization}
	activePage="projects"
	showSuccess={Boolean(actionResult && !actionResult.error)}
>
	{actionResult?.error && <p class="border border-dashed border-red-300 p-3 text-sm text-red-700 dark:border-red-700 dark:text-red-300">{actionResult.error.message}</p>}
	<section class="grid gap-4" aria-labelledby="projects-heading">
		<div class="grid grid-cols-[1fr_auto] items-center gap-3">
			<h2
				id="projects-heading"
				class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>Projects</h2
			>
		</div>
		<details class="grid gap-3">
			<summary
				class="inline-grid w-max cursor-pointer list-none border border-dashed border-neutral-300 px-3 py-1 text-sm font-medium text-neutral-900 transition-colors hover:border-neutral-500 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-100 dark:hover:border-neutral-500 dark:hover:bg-neutral-900"
				>New project</summary
			>
			<form
				method="POST"
				action={actions.createProject}
				class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-[minmax(0,1fr)_auto] md:items-end"
			>
				<input type="hidden" name="organizationId" value={organization.id}>
				<label class="grid gap-1 text-sm">
					<span class="font-medium">Project name</span>
					<input
						class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
						name="name"
						required
					>
				</label>
				<Button type="submit">Create project</Button>
			</form>
		</details>
		{activeProjects.length > 0 ? (
			<ul class="grid gap-4 md:grid-cols-2">
				{activeProjects.map((project) => {
					const summary = summarize(project);
					return (
						<li class="grid">
							<a
								href={`/admin/org/${organization.id}/projects/${project.publicId}`}
								class="grid content-start gap-3 border border-dashed border-neutral-300 p-4 transition-colors hover:border-neutral-500 hover:bg-neutral-100 dark:border-neutral-700 dark:hover:border-neutral-500 dark:hover:bg-neutral-900"
							>
								<div class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-3">
									<h3 class="text-lg font-semibold wrap-break-word">{project.name}</h3>
									<Badge type={project.state === "completed" ? "success" : "info"}>{project.state}</Badge>
								</div>
								<dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
									<dt class="text-neutral-500 dark:text-neutral-400">Phases</dt>
									<dd class="tabular-nums">{project.phases.filter((phase) => phase.state !== "cancelled").length}</dd>
									<dt class="text-neutral-500 dark:text-neutral-400">Total</dt>
									<dd class="tabular-nums">{summary.total}</dd>
								</dl>
								<p class="text-sm text-neutral-600 dark:text-neutral-400">{summary.attention || "Nothing needs attention."}</p>
							</a>
						</li>
					);
				})}
			</ul>
		) : (
			<p class="border border-dashed border-neutral-300 p-4 text-sm text-neutral-600 dark:border-neutral-700 dark:text-neutral-400">No projects yet.</p>
		)}
		{archivedProjects.length > 0 && (
			<details class="grid gap-2">
				<summary class="w-max cursor-pointer list-none text-sm text-neutral-500 underline decoration-dashed underline-offset-4 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">Archived ({archivedProjects.length})</summary>
				<ul class="grid gap-1 text-sm">
					{archivedProjects.map((project) => (
						<li>
							<a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}/projects/${project.publicId}`}>{project.name}</a>
						</li>
					))}
				</ul>
			</details>
		)}
	</section>
</AdminOrgShell>
