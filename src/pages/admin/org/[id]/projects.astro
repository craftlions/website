---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import Field from "../../../../components/Field.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import { sumByCurrency } from "../../../../lib/format.ts";
import {
	type BadgeType,
	isInvoiceOverdue,
	type PhaseState,
	phaseStatus,
	projectStatus,
} from "../../../../lib/status.ts";
import { stripeInvoiceFields } from "../../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const actionResult = Astro.getActionResult(actions.createProject);

const [organization, projects] = await Promise.all([
	getAdminOrganizationCore(Astro.locals.db, id),
	Astro.locals.db.query.projects.findMany({
		columns: {
			publicId: true,
			name: true,
			state: true,
		},
		with: {
			phases: {
				columns: {
					cost: true,
					currency: true,
					state: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
						},
						with: {
							stripe: stripeInvoiceFields,
						},
					},
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
]);

if (!organization) {
	return Astro.redirect("/admin");
}

// Projects needing the admin come first (rank 0), then by project state.
const stateRank = { active: 1, draft: 2, completed: 3, archived: 4 } as const;

const rows = projects
	.map((project) => {
		const phases = project.phases.filter(
			(phase) => phase.state !== "cancelled",
		);
		// Issued invoices only: drafts are unsent and void ones never count.
		const invoices = phases.flatMap((phase) =>
			phase.invoices.flatMap((invoice) =>
				invoice.stripe &&
				invoice.stripe.status !== "draft" &&
				invoice.stripe.status !== "void"
					? [{ ...invoice.stripe, amount: invoice.stripe.total }]
					: [],
			),
		);
		const openInvoices = invoices.filter(
			(invoice) => invoice.status === "open",
		);
		const overdueInvoices = openInvoices.filter((invoice) =>
			isInvoiceOverdue(invoice),
		);
		// "To send (1), In work (2)": phase states with this badge, in
		// lifecycle order, labelled from the shared vocabulary.
		const phaseStates = (badge: BadgeType) =>
			(Object.keys(phaseStatus) as PhaseState[])
				.filter((state) => phaseStatus[state].badge === badge)
				.flatMap((state) => {
					const count = phases.filter((phase) => phase.state === state).length;
					return count > 0 ? [`${phaseStatus[state].label} (${count})`] : [];
				})
				.join(", ");
		const needsAdmin = phaseStates("info");
		return {
			...project,
			rank: needsAdmin ? 0 : stateRank[project.state],
			phaseCount: phases.length,
			acceptedCount: phases.filter((phase) => phase.state === "accepted")
				.length,
			needsAdmin,
			waitingOnClient: phaseStates("gray"),
			total:
				phases.length > 0
					? sumByCurrency(
							phases.map((phase) => ({
								amount: phase.cost,
								currency: phase.currency,
							})),
						)
					: null,
			invoiced: invoices.length > 0 ? sumByCurrency(invoices) : null,
			open: openInvoices.length > 0 ? sumByCurrency(openInvoices) : null,
			overdue:
				overdueInvoices.length > 0 ? sumByCurrency(overdueInvoices) : null,
		};
	})
	// Stable sort keeps the name order from the query inside each rank.
	.toSorted((a, b) => a.rank - b.rank);

const groups = [
	{
		archived: false,
		rows: rows.filter((row) => row.state !== "archived"),
	},
	{
		archived: true,
		rows: rows.filter((row) => row.state === "archived"),
	},
];

// The form starts open after a failed create and when there is nothing to
// list yet, so the first project is one step away.
const isCreateOpen =
	Boolean(actionResult?.error) || groups[0]?.rows.length === 0;
---

<AdminOrgShell
	{organization}
	activePage="projects"
	results={[[actionResult, "Project created"]]}
	fieldLabels={{ organizationId: "Client", name: "Project name" }}
>
	{groups.map(({ archived, rows: groupRows }) => {
		// Archived projects collapse into a disclosure; current ones list openly.
		const Disclosure = archived ? "details" : Fragment;
		return archived && groupRows.length === 0 ? null : (
			<section
				class="grid gap-3"
				aria-labelledby={
					archived ? "archived-projects-heading" : "projects-heading"
				}
			>
				{!archived && (
					<>
						<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
							<h2
								id="projects-heading"
								class="text-label uppercase text-fg-muted"
							>
								Projects
							</h2>
							<Button
								aria-expanded={isCreateOpen ? "true" : "false"}
								aria-controls="new-project"
								data-new-project-toggle
							>
								New project
							</Button>
						</div>
						<form
							id="new-project"
							method="POST"
							action={actions.createProject}
							aria-label="New project"
							hidden={!isCreateOpen}
							class="grid gap-3 border border-dashed border-line p-4"
						>
							<input
								type="hidden"
								name="organizationId"
								value={organization.id}
							>
							<Field
								label="Project name"
								name="name"
								required
								maxlength={160}
								autocomplete="off"
								autofocus={Boolean(actionResult?.error)}
								hint="Starts as a draft. Add its phases on the project page, then activate it."
								result={actionResult}
								class="max-w-md"
							/>
							<div class="grid grid-flow-col items-center justify-start gap-3">
								<Button type="submit">Create project</Button>
								<Button variant="quiet" data-new-project-cancel>
									Cancel
								</Button>
							</div>
						</form>
					</>
				)}
				<Disclosure class={archived ? "grid gap-3" : undefined}>
					{archived && (
						<Button as="summary" variant="quiet">
							<h2 id="archived-projects-heading" class="text-label uppercase">
								Archived ({groupRows.length})
							</h2>
						</Button>
					)}
					{groupRows.length > 0 ? (
						<ul class="grid border border-dashed border-line lg:grid-cols-[minmax(10rem,1fr)_auto_auto_auto_auto] lg:gap-x-6">
							{groupRows.map((project) => (
								<li
									class:list={[
										"grid grid-cols-[minmax(0,1fr)_auto] items-start gap-3 border-b border-dashed border-line p-4 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:col-span-5 lg:grid-cols-subgrid lg:gap-x-6",
										archived ? "text-fg-muted" : "text-fg",
									]}
								>
									<h3 class="min-w-0 font-medium wrap-break-word sm:col-span-2 lg:col-span-1">
										<a
											href={`/admin/org/${organization.id}/projects/${project.publicId}`}
											class="underline decoration-dashed underline-offset-4"
										>
											{project.name}
										</a>
									</h3>
									<Badge type={projectStatus[project.state].badge}>
										{projectStatus[project.state].label}
									</Badge>
									<dl class="col-span-2 grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start gap-x-3 gap-y-1 text-sm sm:col-span-1">
										<dt class="label-caps">Phases</dt>
										<dd class="tabular-nums wrap-break-word">
											{project.phaseCount > 0 ? project.phaseCount : "None yet"}
										</dd>
										{project.phaseCount > 0 && (
											<>
												<dt class="label-caps">Accepted</dt>
												<dd class="tabular-nums wrap-break-word">
													{project.acceptedCount} of {project.phaseCount}
												</dd>
											</>
										)}
										{project.needsAdmin && (
											<>
												<dt class="label-caps">Needs you</dt>
												<dd class="wrap-break-word text-fg-info">
													{project.needsAdmin}
												</dd>
											</>
										)}
										{project.waitingOnClient && (
											<>
												<dt class="label-caps">Waiting on client</dt>
												<dd class="wrap-break-word">
													{project.waitingOnClient}
												</dd>
											</>
										)}
									</dl>
									<dl class="col-span-2 grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start gap-x-3 gap-y-1 text-sm sm:col-span-1">
										<dt class="label-caps">Total</dt>
										<dd class="text-right font-medium tabular-nums wrap-break-word">
											{project.total ?? "—"}
										</dd>
										<dt class="label-caps">Invoiced</dt>
										<dd class="text-right tabular-nums wrap-break-word">
											{project.invoiced ?? "—"}
										</dd>
										{project.open && (
											<>
												<dt class="label-caps">Open</dt>
												<dd class="text-right tabular-nums wrap-break-word">
													{project.open}
												</dd>
											</>
										)}
										{project.overdue && (
											<>
												<dt class="label-caps">Overdue</dt>
												<dd class="text-right tabular-nums wrap-break-word text-fg-danger">
													{project.overdue}
												</dd>
											</>
										)}
									</dl>
									<Button
										href={`/admin/org/${organization.id}/projects/${project.publicId}`}
										aria-label={`Open ${project.name}`}
										class="col-span-2 sm:col-span-1"
									>
										Open
									</Button>
								</li>
							))}
						</ul>
					) : (
						<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
							{groups[1]?.rows.length
								? "No current projects. Archived projects are listed below."
								: "No projects yet. Name the first one above to start it as a draft."}
						</p>
					)}
				</Disclosure>
			</section>
		);
	})}
</AdminOrgShell>

<script>
	// "New project" discloses the create form and puts the cursor in its name
	// field; Cancel clears and closes it and returns focus to the toggle.
	const toggle = document.querySelector<HTMLButtonElement>(
		"[data-new-project-toggle]",
	);
	const form = document.querySelector<HTMLFormElement>("#new-project");
	const name = form?.querySelector<HTMLInputElement>('input[name="name"]');

	if (toggle && form && name) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", String(open));
			form.hidden = !open;
		};

		toggle.addEventListener("click", () => {
			const open = toggle.getAttribute("aria-expanded") !== "true";
			setOpen(open);
			if (open) name.focus();
		});

		form
			.querySelector("[data-new-project-cancel]")
			?.addEventListener("click", () => {
				form.reset();
				setOpen(false);
				toggle.focus();
			});
	}
</script>
