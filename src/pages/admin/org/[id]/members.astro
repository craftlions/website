---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import ConfirmAction from "../../../../components/ConfirmAction.astro";
import DisclosureButton from "../../../../components/DisclosureButton.astro";
import Field from "../../../../components/Field.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { successMessage } from "../../../../lib/action-feedback.ts";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import { formatDate } from "../../../../lib/format.ts";
import { memberRole } from "../../../../lib/status.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const addResult = Astro.getActionResult(actions.addOrganizationMember);

const [organization, members] = await Promise.all([
	getAdminOrganizationCore(Astro.locals.db, id),
	Astro.locals.db.query.member.findMany({
		columns: {
			id: true,
			role: true,
			userId: true,
		},
		with: {
			user: {
				columns: {
					id: true,
					email: true,
					name: true,
					lastActiveAt: true,
				},
				with: {
					memberships: { columns: { organizationId: true } },
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			createdAt: "asc",
		},
	}),
]);

if (!organization) {
	return Astro.redirect("/admin");
}

// The form starts open after a failed add and while nobody is a member yet.
const isAddOpen = Boolean(addResult?.error) || members.length === 0;

const otherClients = (count: number) =>
	`${count} other ${count === 1 ? "client" : "clients"}`;
---

<AdminOrgShell
	{organization}
	activePage="members"
	results={[
		successMessage(
			addResult,
			(member) =>
				({
					invited: `${member.email} invited: the new account got an email to set a password.`,
					added: `${member.email} added to ${organization.name}.`,
					unchanged: `${member.email} is already a member of ${organization.name}. Nothing changed.`,
				})[member.outcome],
		),
		[
			Astro.getActionResult(actions.removeOrganizationMember),
			`Member removed from ${organization.name}. Their account still exists.`,
		],
		successMessage(
			Astro.getActionResult(actions.resendWelcomeMail),
			(mail) => `Password reset email sent to ${mail.email}.`,
		),
		[
			Astro.getActionResult(actions.removeNeverLoggedInUser),
			"Account deleted.",
		],
	]}
	fieldLabels={{
		email: "Email",
		name: "Name",
		role: "Role",
		confirmation: "Confirmation",
	}}
>
	<section class="grid gap-3" aria-labelledby="members-heading">
		<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
			<h2 id="members-heading" class="text-label uppercase text-fg-muted">
				Members
			</h2>
			<DisclosureButton controls="add-member" open={isAddOpen}>
				Add member
			</DisclosureButton>
		</div>
		<p class="max-w-prose text-sm text-fg-muted">
			People who can sign in and see the {organization.name} dashboard.
		</p>
		<form
			id="add-member"
			method="POST"
			action={actions.addOrganizationMember}
			aria-label="Add member"
			class="grid grid-cols-[minmax(0,1fr)] gap-4 border border-dashed border-line p-4 md:grid-cols-[repeat(2,minmax(0,1fr))]"
			hidden={!isAddOpen}
		>
			<input type="hidden" name="organizationId" value={organization.id}>
			<Field
				label="Email"
				name="email"
				type="email"
				required
				autocomplete="off"
				result={addResult}
				hint="A new address gets an account and a “Reset your password” email to set a password. An existing account is added without an email; an existing member stays unchanged."
			/>
			<Field
				label="Name"
				name="name"
				required
				maxlength="120"
				autocomplete="off"
				result={addResult}
				hint="Only used when a new account is created."
			/>
			<Field
				label="Role"
				as="select"
				name="role"
				result={addResult}
				hint="Members see projects, phases and invoices and can pay invoices. Owners can also approve, decline and accept phases."
				class="md:col-span-2"
			>
				<option value="member" selected>Member</option>
				<option value="owner">Owner</option>
			</Field>
			<div
				class="grid grid-cols-[auto_auto] items-center justify-start gap-3 md:col-span-2"
			>
				<Button type="submit">Add member</Button>
				<Button variant="quiet" data-disclosure-cancel>Cancel</Button>
			</div>
		</form>
		{members.length > 0 ? (
			<div class="grid grid-cols-[minmax(0,1fr)] border border-dashed border-line md:grid-cols-[minmax(0,1fr)_auto_auto_minmax(0,14rem)] md:gap-x-6">
				<div
					aria-hidden="true"
					class="hidden border-b border-dashed border-line px-4 py-3 label-caps md:col-span-4 md:grid md:grid-cols-subgrid"
				>
					<span>Member</span>
					<span>Role</span>
					<span>Last active</span>
					<span>Actions</span>
				</div>
				<ul class="grid grid-cols-[minmax(0,1fr)] md:col-span-4 md:grid-cols-subgrid">
					{members.map((member) => (
						<li class="grid grid-cols-[minmax(0,1fr)] gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 md:col-span-4 md:grid-cols-subgrid md:items-start">
							<div class="grid gap-1">
								<h3 class="font-medium wrap-break-word">{member.user.name}</h3>
								<p class="text-sm text-fg-muted wrap-break-word">
									{member.user.email}
								</p>
							</div>
							<Badge type={memberRole(member.role).badge}>
								{memberRole(member.role).label}
							</Badge>
							{member.user.lastActiveAt ? (
								<p class="text-sm">
									<span class="text-fg-muted md:sr-only">Last active </span>
									<time datetime={member.user.lastActiveAt.toISOString()}>
										{formatDate(member.user.lastActiveAt)}
									</time>
								</p>
							) : (
								<p class="text-sm text-fg-muted">Never logged in</p>
							)}
							<div class="grid content-start justify-items-start gap-2">
								{member.user.lastActiveAt && (
									<impersonate-user
										class="grid max-w-full justify-items-start gap-1"
										data-user-id={member.userId}
										data-organization-slug={organization.slug}
									>
										<Button
											class="max-w-full wrap-break-word"
											aria-label={`View as ${member.user.name}`}
											aria-describedby={`impersonate-error-${member.id}`}
										>
											View as {member.user.name.split(" ")[0]}
										</Button>
										<p
											id={`impersonate-error-${member.id}`}
											role="alert"
											class="text-sm text-fg-danger"
											hidden
										/>
									</impersonate-user>
								)}
								<form method="POST" action={actions.resendWelcomeMail}>
									<input type="hidden" name="email" value={member.user.email} />
									<Button
										type="submit"
										aria-label={`${member.user.lastActiveAt ? "Send password reset" : "Resend invite"} to ${member.user.name}`}
									>
										{member.user.lastActiveAt
											? "Send password reset"
											: "Resend invite"}
									</Button>
								</form>
								<form method="POST" action={actions.removeOrganizationMember}>
									<input
										type="hidden"
										name="organizationId"
										value={organization.id}
									/>
									<input type="hidden" name="memberId" value={member.id} />
									<ConfirmAction
										id={`remove-member-${member.id}`}
										trigger="Remove from client"
										triggerLabel={`Remove from client: ${member.user.name}`}
										triggerVariant="quiet"
										title={`Remove ${member.user.name} from ${organization.name}?`}
										confirm="Remove from client"
										cancel="Keep member"
									>
										{`${member.user.name} can no longer see the ${organization.name} dashboard. The account stays${member.user.memberships.length > 1 ? ` and keeps access to ${otherClients(member.user.memberships.length - 1)}` : ""}, and you can add it again with the same email.${members.length === 1 ? " Nobody else is a member, so nobody at the client will see the dashboard." : ""}`}
									</ConfirmAction>
								</form>
								{!member.user.lastActiveAt && (
									<form method="POST" action={actions.removeNeverLoggedInUser}>
										<input type="hidden" name="userId" value={member.userId} />
										<ConfirmAction
											id={`delete-user-${member.userId}`}
											trigger="Delete account"
											triggerLabel={`Delete account of ${member.user.name}`}
											triggerVariant="quiet"
											title={`Delete the account of ${member.user.name}?`}
											confirm="Delete account"
											cancel="Keep account"
											typeToConfirm={{ value: member.user.email }}
										>
											{`This deletes the account for ${member.user.email} everywhere: it is removed from ${organization.name}${member.user.memberships.length > 1 ? ` and from ${otherClients(member.user.memberships.length - 1)}` : ""} and can no longer sign in. This cannot be undone; adding the same email later creates a new account.`}
										</ConfirmAction>
									</form>
								)}
							</div>
						</li>
					))}
				</ul>
			</div>
		) : (
			<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
				No members yet. Nobody at {organization.name} can see its dashboard
				until you add one.
			</p>
		)}
	</section>
</AdminOrgShell>

<script>
	import { authClient } from "../../../../lib/auth-client.ts";

	class ImpersonateUser extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const button = this.querySelector("button");
			const message = this.querySelector<HTMLElement>("[role=alert]");
			const { userId, organizationSlug } = this.dataset;

			if (!button || !message || !userId || !organizationSlug) return;

			button.addEventListener("click", async () => {
				button.disabled = true;
				message.hidden = true;
				message.textContent = "";

				try {
					const { error } = await authClient.admin.impersonateUser({
						userId,
					});

					if (error) {
						throw error;
					}

					window.location.replace(`/dash/org/${organizationSlug}`);
				} catch {
					button.disabled = false;
					message.textContent =
						"Could not open the client dashboard as this member. Try again.";
					message.hidden = false;
					button.focus();
				}
			});
		}
	}

	if (!customElements.get("impersonate-user")) {
		customElements.define("impersonate-user", ImpersonateUser);
	}
</script>
