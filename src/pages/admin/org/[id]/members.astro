---
export const prerender = false;

import { actions } from "astro:actions";
import Button from "../../../../components/Button.astro";
import Input from "../../../../components/Input.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const actionResults = [
	Astro.getActionResult(actions.addOrganizationMember),
	Astro.getActionResult(actions.removeOrganizationMember),
	Astro.getActionResult(actions.resendWelcomeMail),
	Astro.getActionResult(actions.removeNeverLoggedInUser),
];
const actionError = actionResults.find((result) => result?.error)?.error;
const actionSucceeded = actionResults.some((result) => result && !result.error);

const [organization, members] = await Promise.all([
	getAdminOrganizationCore(Astro.locals.db, id),
	Astro.locals.db.query.member.findMany({
		columns: {
			id: true,
			role: true,
			userId: true,
		},
		with: {
			user: {
				columns: {
					id: true,
					email: true,
					name: true,
					lastActiveAt: true,
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			createdAt: "asc",
		},
	}),
]);

if (!organization) {
	return Astro.redirect("/admin");
}
---

<AdminOrgShell
	{organization}
	activePage="members"
	showSuccess={actionSucceeded}
>
	{actionError && (
		<p class="border border-dashed border-line-danger p-3 text-sm text-fg-danger">
			{actionError.message}
		</p>
	)}
	<section class="grid gap-6" aria-labelledby="members-heading">
		<div class="grid gap-3">
			<h2 id="members-heading" class="text-label uppercase text-fg-muted"
				>Members</h2
			>
			<form
				method="POST"
				action={actions.addOrganizationMember}
				class="grid gap-3 border border-dashed border-line p-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_max-content_max-content] md:items-end"
			>
				<input type="hidden" name="organizationId" value={organization.id}>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Email</span>
					<Input name="email" type="email" required /></label
				>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Name</span>
					<Input name="name" required /></label
				>
				<label class="grid gap-1 text-sm"
					><span class="font-medium">Role</span
					><Input as="select" name="role">
						<option value="member" selected>Member</option>
						<option value="owner">Owner</option>
					</Input></label
				>
				<Button type="submit">Add user</Button>
			</form>
		</div>
		<div class="grid border border-dashed border-line">
			{members.length > 0 ? (
				members.map((member) => (
					<article class="grid gap-3 border-b border-dashed border-line p-4 last:border-b-0 md:grid-cols-[1fr_auto] md:items-center">
						<div class="grid gap-1">
							<h3 class="font-medium">{member.user.name}</h3>
							<p class="text-sm text-fg-muted wrap-break-word">
								{member.user.email} · {member.role}
							</p>
						</div>
						<div class="grid justify-start gap-2 sm:grid-flow-col">
							{member.user.lastActiveAt && (
								<impersonate-user
									data-user-id={member.userId}
									data-organization-slug={organization.slug}
								>
									<Button type="button">Impersonate</Button>
								</impersonate-user>
							)}
							<form method="POST" action={actions.resendWelcomeMail}>
								<input type="hidden" name="email" value={member.user.email} />
								<Button type="submit">Resend</Button>
							</form>
							<form method="POST" action={actions.removeOrganizationMember}>
								<input
									type="hidden"
									name="organizationId"
									value={organization.id}
								/>
								<input type="hidden" name="memberId" value={member.id} />
								<Button type="submit">Remove member</Button>
							</form>
							{!member.user.lastActiveAt && (
								<form method="POST" action={actions.removeNeverLoggedInUser}>
									<input type="hidden" name="userId" value={member.userId} />
									<Button type="submit">Remove user</Button>
								</form>
							)}
						</div>
					</article>
				))
			) : (
				<p class="p-4 text-sm text-fg-muted">No members.</p>
			)}
		</div>
	</section>
</AdminOrgShell>

<script>
	import { authClient } from "../../../../lib/auth-client.ts";

	class ImpersonateUser extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector("button");
			const userId = this.dataset.userId;
			const organizationSlug = this.dataset.organizationSlug;

			if (
				button &&
				button instanceof HTMLButtonElement &&
				userId &&
				organizationSlug
			) {
				button.addEventListener("click", async () => {
					button.disabled = true;

					try {
						const { error } = await authClient.admin.impersonateUser({
							userId,
						});

						if (error) {
							throw error;
						}

						window.location.replace(`/dash/org/${organizationSlug}`);
					} catch {
						button.disabled = false;
						alert("Unable to impersonate this user. Please try again.");
					}
				});
			}
		}
	}

	if (!customElements.get("impersonate-user")) {
		customElements.define("impersonate-user", ImpersonateUser);
	}
</script>
