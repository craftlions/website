---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../../../components/Badge.astro";
import Button from "../../../../components/Button.astro";
import CostSplit from "../../../../components/CostSplit.astro";
import AdminOrgShell from "../../../../layouts/AdminOrgShell.astro";
import { getAdminOrganizationCore } from "../../../../lib/admin-org.ts";
import {
	deriveWorklist,
	getLatestPhaseStateEventIds,
} from "../../../../lib/admin-worklist.ts";
import { formatMoney } from "../../../../lib/format.ts";
import {
	buildPhaseComponents,
	componentBillingStatus,
} from "../../../../lib/phase-billing";
import { costPartLabel } from "../../../../lib/status.ts";
import { stripeInvoiceFields } from "../../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const actionResult = Astro.getActionResult(actions.transitionPhase);
const actionError = actionResult?.error;
const actionSucceeded = Boolean(actionResult && !actionResult.error);

const [organization, projects, latestStateEventIds] = await Promise.all([
	getAdminOrganizationCore(Astro.locals.db, id),
	Astro.locals.db.query.projects.findMany({
		columns: {
			id: true,
			publicId: true,
			name: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					publicId: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					deliveryAmount: true,
					acceptanceAmount: true,
					currency: true,
					state: true,
					version: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
							component: true,
						},
						with: {
							stripe: stripeInvoiceFields,
						},
					},
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
	getLatestPhaseStateEventIds(Astro.locals.db, id),
]);

if (!organization) {
	return Astro.redirect("/admin");
}

const isUpfrontUnpaid = (
	phase: (typeof projects)[number]["phases"][number],
) => {
	if (phase.upfrontAmount === null || phase.upfrontAmount === 0) return false;
	const status = componentBillingStatus({
		component: "upfront",
		state: phase.state,
		invoice:
			phase.invoices.find((invoice) => invoice.component === "upfront") ?? null,
	});
	return status !== "paid";
};
const worklist = deriveWorklist({
	organizationId: organization.id,
	projects,
	latestStateEventIds,
});
---

<AdminOrgShell
	{organization}
	activePage="worklist"
	showSuccess={actionSucceeded}
>
	{actionError && (
		<p class="border border-dashed border-line-danger p-3 text-sm text-fg-danger">
			{actionError.message}
		</p>
	)}
	<section class="grid gap-3" aria-labelledby="worklist-heading">
		<h2 id="worklist-heading" class="text-label uppercase text-fg-muted"
			>Worklist</h2
		>
		<div
			class="grid border border-dashed border-line md:grid-cols-[auto_1fr_max-content_max-content] md:gap-x-6"
		>
			{worklist.length > 0 ? (
				worklist.map((item) => (
					<article class="grid gap-y-3 border-b border-dashed border-line p-4 last:border-b-0 md:col-span-4 md:grid-cols-subgrid md:items-center">
						<Badge type={item.badge}>{item.label}</Badge>
						<div class="grid gap-1 md:place-items-start">
							<h3 class="font-medium">
								<a
									class="underline decoration-dashed underline-offset-4"
									href={`/admin/org/${organization.id}/projects/${item.project.publicId}`}
								>
									{item.project.name}
								</a>{" "}
								· {item.phase.title}
							</h3>
							{(item.invoice ||
								item.phase.state === "in_progress" ||
								item.phase.state === "delivered") &&
								isUpfrontUnpaid(item.phase) && (
									<Badge type="error">Upfront unpaid</Badge>
								)}
						</div>
						<div class="grid min-w-48 gap-1.5 md:justify-items-end">
							{item.invoice ? (
								<>
									<div class="grid grid-flow-col items-center justify-start gap-2 md:justify-end">
										<p class="text-sm font-medium tabular-nums">
											{formatMoney(
												item.invoice.stripe.total,
												item.phase.currency,
											)}
										</p>
										<Badge type="info">
											{costPartLabel[item.invoice.component]}
										</Badge>
									</div>
									<div class="w-full max-w-56">
										<CostSplit
											items={buildPhaseComponents({
												upfrontAmount: item.phase.upfrontAmount,
												deliveryAmount: item.phase.deliveryAmount,
												acceptanceAmount: item.phase.acceptanceAmount,
												state: item.phase.state,
												invoices: item.phase.invoices,
											})}
											currency={item.phase.currency}
											total={item.phase.cost}
											variant="compact"
											highlight={item.invoice.component}
										/>
									</div>
								</>
							) : (
								<>
									<p class="text-sm font-medium tabular-nums md:text-right">
										{formatMoney(item.phase.cost, item.phase.currency)}
									</p>
									<div class="w-full max-w-56">
										<CostSplit
											items={buildPhaseComponents({
												upfrontAmount: item.phase.upfrontAmount,
												deliveryAmount: item.phase.deliveryAmount,
												acceptanceAmount: item.phase.acceptanceAmount,
												state: item.phase.state,
												invoices: item.phase.invoices,
											})}
											currency={item.phase.currency}
											total={item.phase.cost}
											variant="compact"
										/>
									</div>
								</>
							)}
						</div>
						<div class="grid grid-flow-col items-center gap-3 md:justify-self-end">
							<p class="text-sm tabular-nums text-fg-muted">{item.age}</p>
							{item.phase.state === "submitted" && (
								<form method="POST" action={actions.transitionPhase}>
									<input type="hidden" name="phaseId" value={item.phase.id} />
									<input type="hidden" name="nextState" value="planned" />
									<input
										type="hidden"
										name="expectedVersion"
										value={item.phase.version}
									/>
									<Button type="submit">Send</Button>
								</form>
							)}
							{item.phase.state === "planned" && (
								<form method="POST" action={actions.transitionPhase}>
									<input type="hidden" name="phaseId" value={item.phase.id} />
									<input type="hidden" name="nextState" value="approved" />
									<input
										type="hidden"
										name="expectedVersion"
										value={item.phase.version}
									/>
									<Button type="submit">Approve</Button>
								</form>
							)}
							{(item.phase.state === "submitted" ||
								item.phase.state === "planned") && (
								<form method="POST" action={actions.transitionPhase}>
									<input type="hidden" name="phaseId" value={item.phase.id} />
									<input type="hidden" name="nextState" value="cancelled" />
									<input
										type="hidden"
										name="expectedVersion"
										value={item.phase.version}
									/>
									<Button type="submit">Cancel</Button>
								</form>
							)}
							{item.phase.state === "approved" && (
								<form method="POST" action={actions.transitionPhase}>
									<input type="hidden" name="phaseId" value={item.phase.id} />
									<input type="hidden" name="nextState" value="in_progress" />
									<input
										type="hidden"
										name="expectedVersion"
										value={item.phase.version}
									/>
									<Button type="submit">Start</Button>
								</form>
							)}
							{item.phase.state === "delivered" && (
								<form method="POST" action={actions.transitionPhase}>
									<input type="hidden" name="phaseId" value={item.phase.id} />
									<input type="hidden" name="nextState" value="accepted" />
									<input
										type="hidden"
										name="expectedVersion"
										value={item.phase.version}
									/>
									<Button type="submit">Record acceptance</Button>
								</form>
							)}
						</div>
					</article>
				))
			) : (
				<p class="p-4 text-sm text-fg-muted md:col-span-4">
					Nothing needs action.
				</p>
			)}
		</div>
	</section>
</AdminOrgShell>
