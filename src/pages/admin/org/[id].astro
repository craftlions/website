---
export const prerender = false;

import { actions } from "astro:actions";
import AdminWorklist from "../../../components/AdminWorklist.astro";
import Badge from "../../../components/Badge.astro";
import Button from "../../../components/Button.astro";
import SpendByYear from "../../../components/SpendByYear.astro";
import AdminOrgShell from "../../../layouts/AdminOrgShell.astro";
import {
	phaseTransitionMessage,
	successMessage,
} from "../../../lib/action-feedback.ts";
import {
	deriveWorklist,
	getLatestPhaseStateEventIds,
	getWorklistProjects,
} from "../../../lib/admin-worklist.ts";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import {
	formatMoney,
	formatPercent,
	sumByCurrency,
} from "../../../lib/format.ts";
import {
	invoiceComponents,
	isInvoiceComponentDue,
} from "../../../lib/phase-billing.ts";
import {
	type BadgeType,
	isInvoiceOverdue,
	type PhaseState,
	phaseStatus,
	projectStatus,
} from "../../../lib/status.ts";
import {
	organizationStripeInvoices,
	stripeInvoiceFields,
} from "../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const [organization, projects, latestStateEventIds, openInvoices, spendRows] =
	await Promise.all([
		Astro.locals.db.query.organization.findFirst({
			columns: {
				id: true,
				name: true,
			},
			with: {
				data: {
					columns: {
						yearlyBudget: true,
						stripeCustomerId: true,
					},
				},
				// One row tells whether anyone can see the client dashboard.
				members: {
					columns: {
						id: true,
					},
					limit: 1,
				},
			},
			where: {
				id,
			},
		}),
		// The worklist page's query, so the preview lists the same items.
		getWorklistProjects(Astro.locals.db, id),
		getLatestPhaseStateEventIds(Astro.locals.db, id),
		// Attached and unattached, as in the Invoices tab's summary.
		Astro.locals.db.query.stripeInvoices.findMany({
			columns: {
				status: true,
				currency: true,
				dueAt: true,
			},
			extras: {
				total: stripeInvoiceFields.extras.total,
			},
			where: {
				...organizationStripeInvoices(id),
				status: "open",
			},
		}),
		// The client dashboard's spend history: the one grouped aggregate here,
		// since the relational API cannot group by year.
		getSpendByYear(Astro.locals.db, id),
	]);

if (!organization) {
	return Astro.redirect("/admin");
}

const now = new Date();
const yearlyBudget = organization.data?.yearlyBudget ?? 0;
const { currentYearTotal, usagePercentage } = deriveBudgetConsumption(
	spendRows,
	yearlyBudget,
	now,
);
const overdueInvoices = openInvoices.filter((invoice) =>
	isInvoiceOverdue(invoice, now),
);
const invoicesHref = `/admin/org/${organization.id}/invoices`;
// Active projects, then drafts, which wait for the admin to activate them.
const currentProjects = [
	...projects.filter((project) => project.state === "active"),
	...projects.filter((project) => project.state === "draft"),
].map((project) => {
	const phases = project.phases.filter((phase) => phase.state !== "cancelled");
	// "To send (1), In work (2)": phase states with this badge, in lifecycle
	// order, labelled from the shared vocabulary, as on the Projects tab.
	const phaseStates = (badge: BadgeType) =>
		(Object.keys(phaseStatus) as PhaseState[])
			.filter((state) => phaseStatus[state].badge === badge)
			.flatMap((state) => {
				const count = phases.filter((phase) => phase.state === state).length;
				return count > 0 ? [`${phaseStatus[state].label} (${count})`] : [];
			})
			.join(", ");
	return {
		...project,
		phaseCount: phases.length,
		acceptedCount: phases.filter((phase) => phase.state === "accepted").length,
		needsAdmin: phaseStates("info"),
		waitingOnClient: phaseStates("gray"),
	};
});
// Setup steps still missing, each listed only while it is.
const setupGaps = [
	organization.members.length === 0 && {
		text: `Nobody at ${organization.name} can see their dashboard yet.`,
		action: "Add member",
		href: `/admin/org/${organization.id}/members`,
	},
	!organization.data?.stripeCustomerId && {
		text: "No Stripe customer is linked, so no invoices or spend show up for this client.",
		action: "Link Stripe customer",
		href: `/admin/org/${organization.id}/settings#billing-heading`,
	},
	projects.length === 0 && {
		text: "No projects yet.",
		action: "Create project",
		href: `/admin/org/${organization.id}/projects`,
	},
].filter((gap) => gap !== false);
---

<AdminOrgShell
	{organization}
	activePage="overview"
	results={[
		successMessage(
			Astro.getActionResult(actions.transitionPhase),
			(phase) => phaseTransitionMessage[phase.state],
		),
		[Astro.getActionResult(actions.recordDelivery), "Delivery recorded"],
	]}
	fieldLabels={{ deliveryChoice: "Delivery", deliveryUrl: "Delivery URL" }}
>
	{setupGaps.length > 0 && (
		<section class="grid min-w-0 gap-3" aria-labelledby="setup-heading">
			<h2 id="setup-heading" class="text-label uppercase text-fg-muted">
				Setup
			</h2>
			<ul class="grid border border-dashed border-line">
				{setupGaps.map((gap) => (
					<li class="grid min-w-0 gap-2 border-b border-dashed border-line p-4 last:border-b-0 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:gap-6">
						<p class="text-sm wrap-break-word">{gap.text}</p>
						<Button href={gap.href} variant="quiet">
							{gap.action}
						</Button>
					</li>
				))}
			</ul>
		</section>
	)}
	<section class="grid min-w-0 gap-3" aria-labelledby="worklist-heading">
		<div class="grid gap-1">
			<h2 id="worklist-heading" class="text-label uppercase text-fg-muted">
				Worklist
			</h2>
			<p class="max-w-prose text-sm text-fg-muted">
				Phases that need a step from you or the client, and invoices waiting for
				payment.
			</p>
		</div>
		<AdminWorklist
			items={deriveWorklist({
				organizationId: organization.id,
				projects,
				latestStateEventIds,
				now,
			})}
			limit={5}
			allHref={`/admin/org/${organization.id}/worklist`}
			id="overview-worklist"
		/>
	</section>
	<div
		class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:items-start"
	>
		<div class="grid min-w-0 content-start gap-6">
			<section class="grid content-start gap-4" aria-labelledby="money-heading">
				<div class="grid gap-1">
					<h2 id="money-heading" class="text-label uppercase text-fg-muted">
						Money
					</h2>
					<p class="max-w-prose text-sm text-fg-muted">
						Budget for the current calendar year, and invoices waiting for
						payment or to be sent.
					</p>
				</div>
				<dl class="grid border-t border-dashed border-line">
					<div
						class="grid min-w-0 gap-1 border-b border-dashed border-line p-4"
					>
						<dt class="label-caps">Yearly budget</dt>
						{yearlyBudget > 0 ? (
							<dd class="text-title tabular-nums wrap-break-word">
								{formatMoney(yearlyBudget, "EUR")}
							</dd>
						) : (
							<dd class="grid gap-1 text-sm">
								<span class="text-fg-muted">No yearly budget set.</span>
								<Button
									href={`/admin/org/${organization.id}/settings#billing-heading`}
									variant="quiet"
								>
									Set a budget in settings
								</Button>
							</dd>
						)}
					</div>
					<div
						class="grid min-w-0 gap-1 border-b border-dashed border-line p-4"
					>
						<dt class="label-caps">Invoiced this year</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							{formatMoney(currentYearTotal, "EUR")}
						</dd>
					</div>
					{yearlyBudget > 0 && (
						<div class="grid min-w-0 gap-2 border-b border-dashed border-line p-4">
							<dt class="label-caps">Budget used</dt>
							<dd
								class:list={[
									"text-title tabular-nums",
									usagePercentage > 100 && "text-fg-danger",
								]}
							>
								{formatPercent(usagePercentage)}
							</dd>
							<dd class="grid">
								<progress
									aria-label="Budget used"
									max="100"
									value={Math.min(usagePercentage, 100)}
									class:list={[
										"h-2 w-full appearance-none border border-dashed border-line bg-transparent [&::-webkit-progress-bar]:bg-transparent",
										usagePercentage > 100
											? "[&::-webkit-progress-value]:bg-fill-danger [&::-moz-progress-bar]:bg-fill-danger"
											: "[&::-webkit-progress-value]:bg-ink [&::-moz-progress-bar]:bg-ink",
									]}
								>
									{`${formatPercent(usagePercentage)} used`}
								</progress>
							</dd>
						</div>
					)}
					<div
						class="grid min-w-0 gap-1 border-b border-dashed border-line p-4"
					>
						<dt class="label-caps">Outstanding</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							<a
								href={`${invoicesHref}#invoices`}
								class="underline decoration-dashed underline-offset-4"
							>
								{sumByCurrency(
									openInvoices.map((invoice) => ({
										amount: invoice.total,
										currency: invoice.currency,
									})),
								)}
								<span class="sr-only"> outstanding, see invoices</span>
							</a>
						</dd>
					</div>
					<div
						class="grid min-w-0 gap-1 border-b border-dashed border-line p-4"
					>
						<dt class="label-caps">Overdue</dt>
						<dd
							class:list={[
								"text-title tabular-nums wrap-break-word",
								overdueInvoices.length > 0 && "text-fg-danger",
							]}
						>
							<a
								href={`${invoicesHref}#invoices`}
								class="underline decoration-dashed underline-offset-4"
							>
								{sumByCurrency(
									overdueInvoices.map((invoice) => ({
										amount: invoice.total,
										currency: invoice.currency,
									})),
								)}
								<span class="sr-only"> overdue, see invoices</span>
							</a>
						</dd>
					</div>
					<div
						class="grid min-w-0 gap-1 border-b border-dashed border-line p-4"
					>
						<dt class="label-caps">To invoice</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							<a
								href={`${invoicesHref}#to-invoice`}
								class="underline decoration-dashed underline-offset-4"
							>
								{sumByCurrency(
									projects.flatMap((project) =>
										project.phases.flatMap((phase) =>
											invoiceComponents.flatMap((component) => {
												// A due, priced cost part without an invoice, as
												// on the Invoices tab.
												const amount = phase[`${component}Amount`];
												return amount &&
													isInvoiceComponentDue(component, phase.state) &&
													phase.invoices.every(
														(invoice) => invoice.component !== component,
													)
													? [{ amount, currency: phase.currency }]
													: [];
											}),
										),
									),
								)}
								<span class="sr-only"> to invoice, see due cost parts</span>
							</a>
						</dd>
					</div>
				</dl>
			</section>
			<SpendByYear rows={spendRows} />
		</div>
		<section
			class="grid min-w-0 content-start gap-3"
			aria-labelledby="projects-heading"
		>
			<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
				<h2 id="projects-heading" class="text-label uppercase text-fg-muted">
					Current projects
				</h2>
				{projects.length > 0 && (
					<Button
						href={`/admin/org/${organization.id}/projects`}
						variant="quiet"
					>
						All projects ({projects.length})
					</Button>
				)}
			</div>
			<p class="max-w-prose text-sm text-fg-muted">
				Active projects first, then drafts waiting for you to activate them.
			</p>
			{currentProjects.length > 0 ? (
				<ul class="grid border border-dashed border-line">
					{currentProjects.map((project) => (
						<li class="grid min-w-0 grid-cols-[minmax(0,1fr)_auto] items-start gap-3 border-b border-dashed border-line p-4 last:border-b-0">
							<h3 class="min-w-0 font-medium wrap-break-word">
								<a
									href={`/admin/org/${organization.id}/projects/${project.publicId}`}
									class="underline decoration-dashed underline-offset-4"
								>
									{project.name}
								</a>
							</h3>
							<Badge type={projectStatus[project.state].badge}>
								{projectStatus[project.state].label}
							</Badge>
							<dl class="col-span-2 grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start gap-x-3 gap-y-1 text-sm">
								<dt class="label-caps">Phases</dt>
								<dd class="tabular-nums wrap-break-word">
									{project.phaseCount > 0
										? `${project.acceptedCount} of ${project.phaseCount} accepted`
										: "None yet"}
								</dd>
								{project.needsAdmin && (
									<>
										<dt class="label-caps">Needs you</dt>
										<dd class="wrap-break-word text-fg-info">
											{project.needsAdmin}
										</dd>
									</>
								)}
								{project.waitingOnClient && (
									<>
										<dt class="label-caps">Waiting on client</dt>
										<dd class="wrap-break-word">{project.waitingOnClient}</dd>
									</>
								)}
							</dl>
						</li>
					))}
				</ul>
			) : (
				<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
					{projects.length > 0
						? "No active or draft projects. Completed and archived projects are on the Projects tab."
						: "No projects yet."}
				</p>
			)}
		</section>
	</div>
</AdminOrgShell>
