---
export const prerender = false;

import {
	and,
	count,
	countDistinct,
	eq,
	inArray,
	or,
	type SQLWrapper,
	sql,
	sum,
} from "drizzle-orm";
import AdminOrgShell from "../../../layouts/AdminOrgShell.astro";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import {
	invoices,
	member,
	organizationMetadata,
	organization as organizationTable,
	phases,
	projects,
} from "../../../lib/schema.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const scalar = (query: SQLWrapper) => sql<number>`(${query})`;

const [organization] = await Astro.locals.db
	.select({
		id: organizationTable.id,
		name: organizationTable.name,
		yearlyBudget: organizationMetadata.yearlyBudget,
		openInvoiceTotal: scalar(
			Astro.locals.db
				.select({
					value: sum(invoices.total),
				})
				.from(phases)
				.innerJoin(projects, eq(phases.projectId, projects.id))
				.innerJoin(invoices, eq(invoices.phaseId, phases.id))
				.where(
					and(
						eq(projects.organizationId, organizationTable.id),
						eq(invoices.stripeStatus, "open"),
					),
				),
		),
		activeProjectCount: scalar(
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(projects)
				.where(
					and(
						eq(projects.organizationId, organizationTable.id),
						eq(projects.state, "active"),
					),
				),
		),
		worklistCount: scalar(
			Astro.locals.db
				.select({
					// A phase remains one work item even when several component invoices
					// make the invoice join one-to-many.
					value: countDistinct(phases.id),
				})
				.from(phases)
				.innerJoin(projects, eq(phases.projectId, projects.id))
				.leftJoin(invoices, eq(invoices.phaseId, phases.id))
				.where(
					and(
						eq(projects.organizationId, organizationTable.id),
						// Same membership as the worklist page: lifecycle states plus any
						// outstanding invoice (billing derives from stripeStatus).
						or(
							inArray(phases.state, [
								"submitted",
								"planned",
								"approved",
								"in_progress",
								"delivered",
							]),
							eq(invoices.stripeStatus, "open"),
						),
					),
				),
		),
		openInvoiceCount: scalar(
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(invoices)
				.where(
					and(
						eq(invoices.organizationId, organizationTable.id),
						eq(invoices.stripeStatus, "open"),
					),
				),
		),
		memberCount: scalar(
			Astro.locals.db
				.select({
					value: count(),
				})
				.from(member)
				.where(eq(member.organizationId, organizationTable.id)),
		),
	})
	.from(organizationTable)
	.leftJoin(
		organizationMetadata,
		eq(organizationMetadata.organizationId, organizationTable.id),
	)
	.where(eq(organizationTable.id, id))
	.limit(1);

if (!organization) {
	return Astro.redirect("/admin");
}

// S-004 R4: one full-history module read per organization; deriveBudget
// selects the current-year rows. Any read failure aborts this page — no
// fallback or alternate calculation (R8).
const yearlyBudget = organization.yearlyBudget ?? 0;
const { usagePercentage } = deriveBudgetConsumption(
	await getSpendByYear(Astro.locals.db, id),
	yearlyBudget,
);
// R7: "Budget used" shows a one-decimal uncapped percentage only when there
// is a positive yearly budget; otherwise "No budget" with no percentage.
const hasBudget = yearlyBudget > 0;
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const sections = [
	{
		label: "Worklist",
		detail: `${organization.worklistCount} need action`,
		href: `/admin/org/${organization.id}/worklist`,
	},
	{
		label: "Projects",
		detail: `${organization.activeProjectCount} active`,
		href: `/admin/org/${organization.id}/projects`,
	},
	{
		label: "Invoices",
		detail: `${organization.openInvoiceCount} open`,
		href: `/admin/org/${organization.id}/invoices`,
	},
	{
		label: "Members",
		detail: `${organization.memberCount}`,
		href: `/admin/org/${organization.id}/members`,
	},
	{
		label: "Settings",
		detail: null,
		href: `/admin/org/${organization.id}/settings`,
	},
] as const;
---

<AdminOrgShell {organization} activePage="overview">
	<section class="grid gap-4" aria-labelledby="overview-heading">
		<h2 id="overview-heading" class="sr-only">Overview</h2>
		<dl class="grid gap-3 md:grid-cols-3">
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Budget used</dt
				>
				<dd
					class:list={["text-xl font-semibold tabular-nums", hasBudget && usagePercentage > 100 && "text-red-700 dark:text-red-300"]}
					>{hasBudget ? `${usagePercentage.toFixed(1)}%` : "No budget"}</dd
				>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Open invoices</dt
				>
				<dd class="text-xl font-semibold tabular-nums"
					>{currencyFormatter.format(organization.openInvoiceTotal)}</dd
				>
			</div>
			<div class="grid gap-1">
				<dt
					class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Active projects</dt
				>
				<dd class="text-xl font-semibold tabular-nums"
					>{organization.activeProjectCount}</dd
				>
			</div>
		</dl>
		<div class="grid gap-3 md:grid-cols-2">
			{sections.map((section) => (
				<a class="grid gap-1 border border-dashed border-neutral-300 p-4 transition-colors hover:border-neutral-500 hover:bg-neutral-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-700 dark:border-neutral-700 dark:hover:border-neutral-500 dark:hover:bg-neutral-900 dark:focus-visible:outline-neutral-300" href={section.href}>
					<h3 class="font-semibold">{section.label}</h3>
					{section.detail && <p class="text-sm tabular-nums text-neutral-600 dark:text-neutral-400">{section.detail}</p>}
				</a>
			))}
		</div>
	</section>
</AdminOrgShell>
