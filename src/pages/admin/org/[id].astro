---
export const prerender = false;

import { actions } from "astro:actions";
import AdminWorklist from "../../../components/AdminWorklist.astro";
import Badge from "../../../components/Badge.astro";
import Button from "../../../components/Button.astro";
import Progress from "../../../components/Progress.astro";
import ProjectPhaseSummary from "../../../components/ProjectPhaseSummary.astro";
import SpendByYear from "../../../components/SpendByYear.astro";
import AdminOrgShell from "../../../layouts/AdminOrgShell.astro";
import {
	deliveryRecordedMessage,
	phaseTransitionMessage,
	successMessage,
} from "../../../lib/action-feedback.ts";
import {
	deriveWorklist,
	getLatestPhaseStateEventIds,
	getWorklistProjects,
} from "../../../lib/admin-worklist.ts";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import {
	formatMoney,
	formatPercent,
	sumByCurrency,
} from "../../../lib/format.ts";
import { costPartsToInvoice } from "../../../lib/phase-billing.ts";
import { isInvoiceOverdue, projectStatus } from "../../../lib/status.ts";
import {
	organizationStripeInvoices,
	stripeInvoiceFields,
} from "../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const [organization, projects, latestStateEventIds, openInvoices, spendRows] =
	await Promise.all([
		Astro.locals.db.query.organization.findFirst({
			columns: {
				id: true,
				name: true,
			},
			with: {
				data: {
					columns: {
						yearlyBudget: true,
						stripeCustomerId: true,
					},
				},
				// One row tells whether anyone can see the client dashboard.
				members: {
					columns: {
						id: true,
					},
					limit: 1,
				},
			},
			where: {
				id,
			},
		}),
		// The worklist page's query, so the preview lists the same items.
		getWorklistProjects(Astro.locals.db, id),
		getLatestPhaseStateEventIds(Astro.locals.db, id),
		// Attached and unattached, as in the Invoices tab's summary: attached
		// ones by their cost part's client, unattached ones by the linked Stripe
		// customer.
		Astro.locals.db.query.stripeInvoices.findMany({
			columns: {
				status: true,
				currency: true,
				dueAt: true,
			},
			extras: {
				total: stripeInvoiceFields.extras.total,
			},
			where: {
				status: "open",
				OR: [
					{ link: { organizationId: id } },
					{ NOT: { link: true }, ...organizationStripeInvoices(id) },
				],
			},
		}),
		// The client dashboard's spend history: the one grouped aggregate here,
		// since the relational API cannot group by year.
		getSpendByYear(Astro.locals.db, id),
	]);

if (!organization) {
	return Astro.redirect("/admin");
}

const now = new Date();
const yearlyBudget = organization.data?.yearlyBudget ?? 0;
const { currentYearTotal, usagePercentage } = deriveBudgetConsumption(
	spendRows,
	yearlyBudget,
	now,
);
const overdueInvoices = openInvoices.filter((invoice) =>
	isInvoiceOverdue(invoice, now),
);
const invoicesHref = `/admin/org/${organization.id}/invoices`;
// Active projects, then drafts, which wait for the admin to activate them.
const currentProjects = [
	...projects.filter((project) => project.state === "active"),
	...projects.filter((project) => project.state === "draft"),
];
// Setup steps still missing, each listed only while it is.
const setupGaps = [
	organization.members.length === 0 && {
		text: `Nobody at ${organization.name} can see their dashboard yet.`,
		action: "Add member",
		href: `/admin/org/${organization.id}/members`,
	},
	!organization.data?.stripeCustomerId && {
		text: "No Stripe customer is linked. Until it is, this client's Stripe invoices cannot be attached, spend and budget use stay at zero, and their dashboard lists no invoices.",
		action: "Link Stripe customer",
		href: `/admin/org/${organization.id}/settings#billing-heading`,
	},
	projects.length === 0 && {
		text: "No projects yet.",
		action: "Create project",
		href: `/admin/org/${organization.id}/projects`,
	},
].filter((gap) => gap !== false);
---

<AdminOrgShell
	{organization}
	activePage="overview"
	results={[
		successMessage(
			Astro.getActionResult(actions.transitionPhase),
			(phase) => phaseTransitionMessage[phase.state],
		),
		[Astro.getActionResult(actions.recordDelivery), deliveryRecordedMessage],
	]}
	fieldLabels={{ deliveryChoice: "Delivery", deliveryUrl: "Delivery URL" }}
>
	{setupGaps.length > 0 && (
		<section
			class="stack org-overview"
			data-space="xs"
			aria-labelledby="setup-heading"
		>
			<h2 id="setup-heading" class="label-caps">
				Setup
			</h2>
			<ul class="admin-list">
				{setupGaps.map((gap) => (
					<li class="with-sidebar" data-side="end" data-align="center">
						<p class="text-sm wrap-break-word">{gap.text}</p>
						<Button href={gap.href} variant="quiet">
							{gap.action}
						</Button>
					</li>
				))}
			</ul>
		</section>
	)}
	<section
		class="stack org-overview"
		data-space="xs"
		aria-labelledby="worklist-heading"
	>
		<h2 id="worklist-heading" class="label-caps"> Worklist </h2>
		<p class="measure text-sm text-fg-muted">
			Phases that need a step from you or the client, and unpaid invoices:
			overdue ones always, open ones only when their phase is not listed.
		</p>
		<AdminWorklist
			items={deriveWorklist({
				organizationId: organization.id,
				projects,
				latestStateEventIds,
				now,
			})}
			limit={5}
			allHref={`/admin/org/${organization.id}/worklist`}
			id="overview-worklist"
		/>
	</section>
	<div
		class="with-sidebar org-overview"
		data-align="start"
		style="--sidebar-width: 20rem; --content-min: 60%; --sidebar-space: var(--space-m)"
	>
		<div class="stack" data-space="m">
			<section aria-labelledby="money-heading">
				<h2 id="money-heading" class="label-caps"> Money </h2>
				<p class="measure text-sm text-fg-muted">
					Budget for the current calendar year, and invoices waiting for payment
					or to be sent.
				</p>
				<dl class="org-money">
					<div>
						<dt class="label-caps">Yearly budget</dt>
						{yearlyBudget > 0 ? (
							<dd class="text-title tabular-nums wrap-break-word">
								{formatMoney(yearlyBudget, "EUR")}
							</dd>
						) : (
							<dd class="stack text-sm" data-space="3xs">
								<span class="text-fg-muted">No yearly budget set.</span>
								<Button
									href={`/admin/org/${organization.id}/settings#billing-heading`}
									variant="quiet"
								>
									Set a budget in settings
								</Button>
							</dd>
						)}
					</div>
					<div>
						<dt class="label-caps">Invoiced this year</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							{formatMoney(currentYearTotal, "EUR")}
						</dd>
					</div>
					{yearlyBudget > 0 && (
						<div class="stack" data-space="2xs">
							<dt class="label-caps">Budget used</dt>
							<dd
								class:list={[
									"text-title tabular-nums",
									usagePercentage > 100 && "text-fg-danger",
								]}
							>
								{formatPercent(usagePercentage)}
							</dd>
							<dd class="org-meter">
								<Progress percent={usagePercentage} aria-label="Budget used" />
							</dd>
						</div>
					)}
					<div>
						<dt class="label-caps">Outstanding</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							<a href={`${invoicesHref}#invoices`} class="link">
								{sumByCurrency(
									openInvoices.map((invoice) => ({
										amount: invoice.total,
										currency: invoice.currency,
									})),
								)}
								<span class="sr-only"> outstanding, see invoices</span>
							</a>
						</dd>
					</div>
					<div>
						<dt class="label-caps">Overdue</dt>
						<dd
							class:list={[
								"text-title tabular-nums wrap-break-word",
								overdueInvoices.length > 0 && "text-fg-danger",
							]}
						>
							<a href={`${invoicesHref}#invoices`} class="link">
								{sumByCurrency(
									overdueInvoices.map((invoice) => ({
										amount: invoice.total,
										currency: invoice.currency,
									})),
								)}
								<span class="sr-only"> overdue, see invoices</span>
							</a>
						</dd>
					</div>
					<div>
						<dt class="label-caps">To invoice</dt>
						<dd class="text-title tabular-nums wrap-break-word">
							<a href={`${invoicesHref}#to-invoice`} class="link">
								{sumByCurrency(
									projects.flatMap((project) =>
										project.phases.flatMap((phase) =>
											costPartsToInvoice(phase).map((part) => ({
												amount: part.amount,
												currency: phase.currency,
											})),
										),
									),
								)}
								<span class="sr-only"> to invoice, see due cost parts</span>
							</a>
						</dd>
					</div>
				</dl>
			</section>
			<SpendByYear rows={spendRows} />
		</div>
		<section aria-labelledby="projects-heading">
			<div class="with-sidebar" data-side="end" data-align="center">
				<h2 id="projects-heading" class="label-caps"> Current projects </h2>
				{projects.length > 0 && (
					<Button
						href={`/admin/org/${organization.id}/projects`}
						variant="quiet"
					>
						All projects ({projects.length})
					</Button>
				)}
			</div>
			<p class="measure text-sm text-fg-muted">
				Active projects first, then drafts waiting for you to activate them.
			</p>
			{currentProjects.length > 0 ? (
				<ul class="admin-list org-projects">
					{currentProjects.map((project) => (
						<li>
							<h3 class="wrap-break-word">
								<a
									href={`/admin/org/${organization.id}/projects/${project.publicId}`}
									class="link"
								>
									{project.name}
								</a>
							</h3>
							<Badge type={projectStatus[project.state].badge}>
								{projectStatus[project.state].label}
							</Badge>
							<ProjectPhaseSummary
								phases={project.phases}
								class="org-project-phases"
							/>
						</li>
					))}
				</ul>
			) : (
				<p class="box text-sm text-fg-muted">
					{projects.length > 0
						? "No active or draft projects. Completed and archived projects are on the Projects tab."
						: "No projects yet."}
				</p>
			)}
		</section>
	</div>
</AdminOrgShell>
