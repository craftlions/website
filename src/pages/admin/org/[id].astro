---
export const prerender = false;

import { actions } from "astro:actions";
import { and, count, eq, type SQLWrapper, sql, sum } from "drizzle-orm";
import AdminWorklist from "../../../components/AdminWorklist.astro";
import CostSplit from "../../../components/CostSplit.astro";
import AdminOrgShell from "../../../layouts/AdminOrgShell.astro";
import {
	deriveWorklist,
	getLatestPhaseStateEventIds,
} from "../../../lib/admin-worklist.ts";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import { formatMoney, formatPercent } from "../../../lib/format.ts";
import {
	invoices,
	organizationMetadata,
	organization as organizationTable,
	phases,
	projects,
} from "../../../lib/schema.ts";
import {
	liveInvoices,
	stripeInvoiceFields,
	stripeInvoiceTotal,
} from "../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const scalar = (query: SQLWrapper) => sql<number>`(${query})`;

// S-004 R4: one full-history module read per organization; deriveBudget
// selects the current-year rows. Any read failure aborts this page — no
// fallback or alternate calculation (R8).
const [
	[organization],
	openAttachedInvoices,
	spendRows,
	projectRows,
	latestStateEventIds,
] = await Promise.all([
	Astro.locals.db
		.select({
			id: organizationTable.id,
			name: organizationTable.name,
			yearlyBudget: organizationMetadata.yearlyBudget,
			openInvoiceTotal: scalar(
				Astro.locals.db
					.select({
						value: sum(stripeInvoiceTotal(liveInvoices)),
					})
					.from(phases)
					.innerJoin(projects, eq(phases.projectId, projects.id))
					.innerJoin(invoices, eq(invoices.phaseId, phases.id))
					.innerJoin(liveInvoices, eq(liveInvoices.id, invoices.stripeId))
					.where(
						and(
							eq(projects.organizationId, organizationTable.id),
							eq(liveInvoices.status, "open"),
						),
					),
			),
			activeProjectCount: scalar(
				Astro.locals.db
					.select({
						value: count(),
					})
					.from(projects)
					.where(
						and(
							eq(projects.organizationId, organizationTable.id),
							eq(projects.state, "active"),
						),
					),
			),
		})
		.from(organizationTable)
		.leftJoin(
			organizationMetadata,
			eq(organizationMetadata.organizationId, organizationTable.id),
		)
		.where(eq(organizationTable.id, id))
		.limit(1),
	// Open attached invoices grouped by cost part so the overview shows all
	// three types, matching the openInvoiceTotal scope (attached only).
	Astro.locals.db.query.invoices.findMany({
		columns: { component: true },
		with: {
			stripe: {
				columns: { status: true },
				extras: { total: stripeInvoiceTotal },
			},
		},
		where: {
			organizationId: id,
			stripe: { status: "open" },
		},
	}),
	getSpendByYear(Astro.locals.db, id),
	// The worklist page's query, so the preview lists the same items.
	Astro.locals.db.query.projects.findMany({
		columns: {
			id: true,
			publicId: true,
			name: true,
		},
		with: {
			phases: {
				columns: {
					id: true,
					publicId: true,
					title: true,
					cost: true,
					upfrontAmount: true,
					currency: true,
					state: true,
					version: true,
				},
				with: {
					invoices: {
						columns: {
							id: true,
							component: true,
						},
						with: {
							stripe: stripeInvoiceFields,
						},
					},
				},
				orderBy: {
					id: "asc",
				},
			},
		},
		where: {
			organizationId: id,
		},
		orderBy: {
			name: "asc",
		},
	}),
	getLatestPhaseStateEventIds(Astro.locals.db, id),
]);

if (!organization) {
	return Astro.redirect("/admin");
}
const openByPart = ["upfront", "delivery", "acceptance"]
	.map((component) => ({
		component: component as "upfront" | "delivery" | "acceptance",
		amount: openAttachedInvoices
			.filter((invoice) => invoice.component === component)
			.reduce((total, invoice) => total + (invoice.stripe?.total ?? 0), 0),
	}))
	.filter((part) => part.amount !== 0)
	.map((part) => ({ ...part, status: "not_due" as const }));

const yearlyBudget = organization.yearlyBudget ?? 0;
const { usagePercentage } = deriveBudgetConsumption(spendRows, yearlyBudget);
// R7: "Budget used" shows a one-decimal uncapped percentage only when there
// is a positive yearly budget; otherwise "No budget" with no percentage.
const hasBudget = yearlyBudget > 0;
---

<AdminOrgShell
	{organization}
	activePage="overview"
	results={[
		[Astro.getActionResult(actions.transitionPhase), "Phase status changed"],
		[Astro.getActionResult(actions.recordDelivery), "Delivery recorded"],
	]}
	fieldLabels={{ deliveryChoice: "Delivery", deliveryUrl: "Delivery URL" }}
>
	<section class="grid min-w-0 gap-3" aria-labelledby="worklist-heading">
		<div class="grid gap-1">
			<h2 id="worklist-heading" class="text-label uppercase text-fg-muted">
				Worklist
			</h2>
			<p class="max-w-prose text-sm text-fg-muted">
				Phases that need a step from you or the client, and invoices waiting for
				payment.
			</p>
		</div>
		<AdminWorklist
			items={deriveWorklist({
				organizationId: organization.id,
				projects: projectRows,
				latestStateEventIds,
			})}
			limit={5}
			allHref={`/admin/org/${organization.id}/worklist`}
			id="overview-worklist"
		/>
	</section>
	<section class="grid gap-4" aria-labelledby="overview-heading">
		<h2 id="overview-heading" class="sr-only">Overview</h2>
		<dl class="grid gap-3 md:grid-cols-3">
			<div class="grid gap-1">
				<dt class="label-caps">Budget used</dt>
				<dd
					class:list={[
						"text-title tabular-nums",
						hasBudget && usagePercentage > 100 && "text-fg-danger",
					]}
					>{hasBudget ? formatPercent(usagePercentage) : "No budget"}</dd
				>
			</div>
			<div class="grid content-start gap-1">
				<dt class="label-caps">Open invoices</dt>
				<dd class="text-title tabular-nums"
					>{formatMoney(organization.openInvoiceTotal, "EUR")}</dd
				>
				{openByPart.length > 0 && (
					<dd>
						<CostSplit
							items={openByPart}
							currency="EUR"
							total={organization.openInvoiceTotal}
							variant="compact"
							showStatus={false}
						/>
					</dd>
				)}
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Active projects</dt>
				<dd class="text-title tabular-nums"
					>{organization.activeProjectCount}</dd
				>
			</div>
		</dl>
	</section>
</AdminOrgShell>
