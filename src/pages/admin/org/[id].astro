---
export const prerender = false;

import {
	and,
	count,
	countDistinct,
	eq,
	inArray,
	or,
	type SQLWrapper,
	sql,
	sum,
} from "drizzle-orm";
import CostSplit from "../../../components/CostSplit.astro";
import AdminOrgShell from "../../../layouts/AdminOrgShell.astro";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import {
	invoices,
	member,
	organizationMetadata,
	organization as organizationTable,
	phases,
	projects,
} from "../../../lib/schema.ts";
import { liveInvoices, stripeInvoiceTotal } from "../../../lib/stripe.ts";

const { id } = Astro.params;

if (!id) {
	return Astro.redirect("/admin");
}

const scalar = (query: SQLWrapper) => sql<number>`(${query})`;

// S-004 R4: one full-history module read per organization; deriveBudget
// selects the current-year rows. Any read failure aborts this page — no
// fallback or alternate calculation (R8).
const [[organization], openAttachedInvoices, spendRows] = await Promise.all([
	Astro.locals.db
		.select({
			id: organizationTable.id,
			name: organizationTable.name,
			yearlyBudget: organizationMetadata.yearlyBudget,
			openInvoiceTotal: scalar(
				Astro.locals.db
					.select({
						value: sum(stripeInvoiceTotal(liveInvoices)),
					})
					.from(phases)
					.innerJoin(projects, eq(phases.projectId, projects.id))
					.innerJoin(invoices, eq(invoices.phaseId, phases.id))
					.innerJoin(liveInvoices, eq(liveInvoices.id, invoices.stripeId))
					.where(
						and(
							eq(projects.organizationId, organizationTable.id),
							eq(liveInvoices.status, "open"),
						),
					),
			),
			activeProjectCount: scalar(
				Astro.locals.db
					.select({
						value: count(),
					})
					.from(projects)
					.where(
						and(
							eq(projects.organizationId, organizationTable.id),
							eq(projects.state, "active"),
						),
					),
			),
			worklistCount: scalar(
				Astro.locals.db
					.select({
						// A phase remains one work item even when several component invoices
						// make the invoice join one-to-many.
						value: countDistinct(phases.id),
					})
					.from(phases)
					.innerJoin(projects, eq(phases.projectId, projects.id))
					.leftJoin(invoices, eq(invoices.phaseId, phases.id))
					.leftJoin(liveInvoices, eq(liveInvoices.id, invoices.stripeId))
					.where(
						and(
							eq(projects.organizationId, organizationTable.id),
							// Same membership as the worklist page: lifecycle states plus any
							// outstanding invoice (billing derives from Stripe status).
							or(
								inArray(phases.state, [
									"submitted",
									"planned",
									"approved",
									"in_progress",
									"delivered",
								]),
								eq(liveInvoices.status, "open"),
							),
						),
					),
			),
			openInvoiceCount: scalar(
				Astro.locals.db
					.select({
						value: count(),
					})
					.from(liveInvoices)
					.innerJoin(
						organizationMetadata,
						eq(organizationMetadata.stripeCustomerId, liveInvoices.customer),
					)
					.where(
						and(
							eq(organizationMetadata.organizationId, organizationTable.id),
							eq(liveInvoices.status, "open"),
						),
					),
			),
			memberCount: scalar(
				Astro.locals.db
					.select({
						value: count(),
					})
					.from(member)
					.where(eq(member.organizationId, organizationTable.id)),
			),
		})
		.from(organizationTable)
		.leftJoin(
			organizationMetadata,
			eq(organizationMetadata.organizationId, organizationTable.id),
		)
		.where(eq(organizationTable.id, id))
		.limit(1),
	// Open attached invoices grouped by cost part so the overview shows all
	// three types, matching the openInvoiceTotal scope (attached only).
	Astro.locals.db.query.invoices.findMany({
		columns: { component: true },
		with: {
			stripe: {
				columns: { status: true },
				extras: { total: stripeInvoiceTotal },
			},
		},
		where: {
			organizationId: id,
			stripe: { status: "open" },
		},
	}),
	getSpendByYear(Astro.locals.db, id),
]);

if (!organization) {
	return Astro.redirect("/admin");
}
const openByPart = ["upfront", "delivery", "acceptance"]
	.map((component) => ({
		component: component as "upfront" | "delivery" | "acceptance",
		amount: openAttachedInvoices
			.filter((invoice) => invoice.component === component)
			.reduce((total, invoice) => total + invoice.stripe.total, 0),
	}))
	.filter((part) => part.amount !== 0)
	.map((part) => ({ ...part, status: "not_due" as const }));

const yearlyBudget = organization.yearlyBudget ?? 0;
const { usagePercentage } = deriveBudgetConsumption(spendRows, yearlyBudget);
// R7: "Budget used" shows a one-decimal uncapped percentage only when there
// is a positive yearly budget; otherwise "No budget" with no percentage.
const hasBudget = yearlyBudget > 0;
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const sections = [
	{
		label: "Worklist",
		detail: `${organization.worklistCount} need action`,
		href: `/admin/org/${organization.id}/worklist`,
	},
	{
		label: "Projects",
		detail: `${organization.activeProjectCount} active`,
		href: `/admin/org/${organization.id}/projects`,
	},
	{
		label: "Invoices",
		detail: `${organization.openInvoiceCount} open`,
		href: `/admin/org/${organization.id}/invoices`,
	},
	{
		label: "Members",
		detail: `${organization.memberCount}`,
		href: `/admin/org/${organization.id}/members`,
	},
	{
		label: "Settings",
		detail: null,
		href: `/admin/org/${organization.id}/settings`,
	},
] as const;
---

<AdminOrgShell {organization} activePage="overview">
	<section class="grid gap-4" aria-labelledby="overview-heading">
		<h2 id="overview-heading" class="sr-only">Overview</h2>
		<dl class="grid gap-3 md:grid-cols-3">
			<div class="grid gap-1">
				<dt class="label-caps">Budget used</dt>
				<dd
					class:list={[
						"text-title tabular-nums",
						hasBudget && usagePercentage > 100 && "text-fg-danger",
					]}
					>{hasBudget ? `${usagePercentage.toFixed(1)}%` : "No budget"}</dd
				>
			</div>
			<div class="grid content-start gap-1">
				<dt class="label-caps">Open invoices</dt>
				<dd class="text-title tabular-nums"
					>{currencyFormatter.format(organization.openInvoiceTotal)}</dd
				>
				{openByPart.length > 0 && (
					<dd>
						<CostSplit
							items={openByPart}
							currency="EUR"
							total={organization.openInvoiceTotal}
							variant="compact"
							showStatus={false}
						/>
					</dd>
				)}
			</div>
			<div class="grid gap-1">
				<dt class="label-caps">Active projects</dt>
				<dd class="text-title tabular-nums"
					>{organization.activeProjectCount}</dd
				>
			</div>
		</dl>
		<div class="grid gap-3 md:grid-cols-2">
			{sections.map((section) => (
				<a
					class="grid gap-1 border border-dashed border-line p-4 transition-colors hover:border-line-active hover:bg-panel"
					href={section.href}
				>
					<h3 class="font-semibold">{section.label}</h3>
					{section.detail && (
						<p class="text-sm tabular-nums text-fg-muted">{section.detail}</p>
					)}
				</a>
			))}
		</div>
	</section>
</AdminOrgShell>
