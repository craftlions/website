---
export const prerender = false;

import { actions } from "astro:actions";
import AdminWorklist from "../../components/AdminWorklist.astro";
import Button from "../../components/Button.astro";
import DisclosureButton from "../../components/DisclosureButton.astro";
import Field from "../../components/Field.astro";
import AdminShell from "../../layouts/AdminShell.astro";
import {
	phaseTransitionMessage,
	successMessage,
} from "../../lib/action-feedback.ts";
import {
	compareWorklistItems,
	deriveWorklist,
	getLatestPhaseStateEventIds,
	getWorklistProjects,
} from "../../lib/admin-worklist.ts";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../lib/budget-consumption.ts";
import { formatPercent, sumByCurrency } from "../../lib/format.ts";
import { isInvoiceOverdue } from "../../lib/status.ts";
import { hasStripeRow } from "../../lib/stripe.ts";

const onboardResult = Astro.getActionResult(actions.onboardOrganization);

const now = new Date();
const [organizations, projects, latestStateEventIds] = await Promise.all([
	Astro.locals.db.query.organization.findMany({
		columns: {
			id: true,
			name: true,
		},
		with: {
			data: {
				columns: {
					yearlyBudget: true,
				},
			},
		},
		orderBy: {
			name: "asc",
		},
	}),
	getWorklistProjects(Astro.locals.db),
	getLatestPhaseStateEventIds(Astro.locals.db),
]);
const projectsByOrganization = Map.groupBy(
	projects,
	(project) => project.organizationId,
);

const worklist = organizations
	.flatMap((organization) =>
		deriveWorklist({
			organizationId: organization.id,
			projects: projectsByOrganization.get(organization.id) ?? [],
			latestStateEventIds,
			now,
		}).map((item) => ({ ...item, organization })),
	)
	.toSorted(compareWorklistItems);

// S-004 R1/R5: budget usage is the shared module's current-year percentage
// (D-budget-consumption-definition, uncapped); null without a positive yearly
// budget (R7 "No budget"). Any read failure aborts the render (R8).
const ledger = await Promise.all(
	organizations.map(async (organization) => ({
		id: organization.id,
		name: organization.name,
		activeProjects: (projectsByOrganization.get(organization.id) ?? []).filter(
			(project) => project.state === "active",
		).length,
		totalProjects: projectsByOrganization.get(organization.id)?.length ?? 0,
		yourMove: worklist.filter(
			(item) =>
				item.organization.id === organization.id && item.actor === "admin",
		).length,
		waiting: worklist.filter(
			(item) =>
				item.organization.id === organization.id && item.actor === "client",
		).length,
		openInvoices: (projectsByOrganization.get(organization.id) ?? [])
			.flatMap((project) => project.phases)
			.flatMap((phase) => phase.invoices)
			.filter(hasStripeRow)
			.filter((invoice) => invoice.stripe.status === "open")
			.map((invoice) => ({
				amount: invoice.stripe.total,
				currency: invoice.stripe.currency,
				overdue: isInvoiceOverdue(invoice.stripe, now),
			})),
		budgetUsage:
			(organization.data?.yearlyBudget ?? 0) > 0
				? deriveBudgetConsumption(
						await getSpendByYear(Astro.locals.db, organization.id),
						organization.data?.yearlyBudget ?? 0,
					).usagePercentage
				: null,
	})),
);
const openInvoices = ledger.flatMap((client) => client.openInvoices);

// The form starts open after a failed onboarding and while there is no
// client yet.
const isOnboardOpen = Boolean(onboardResult?.error) || ledger.length === 0;
---

<AdminShell
	title="Client workbench"
	results={[
		successMessage(
			Astro.getActionResult(actions.hardDeleteOrganization),
			(client) => `Client ${client.name} deleted`,
		),
		successMessage(onboardResult, (client) => ({
			text: `${client.name} onboarded.`,
			link: { label: "Open client", href: `/admin/org/${client.id}` },
		})),
		successMessage(
			Astro.getActionResult(actions.transitionPhase),
			(phase) => phaseTransitionMessage[phase.state],
		),
		[Astro.getActionResult(actions.recordDelivery), "Delivery recorded"],
	]}
	fieldLabels={{
		organizationName: "Client name",
		slug: "Slug",
		name: "Contact name",
		email: "Contact email",
		yearlyBudget: "Yearly budget",
		deliveryChoice: "Delivery",
		deliveryUrl: "Delivery URL",
	}}
>
	<header
		slot="header"
		class="grid gap-4 border-b border-dashed border-line pb-6"
	>
		<div class="grid gap-1">
			<p class="text-label uppercase text-fg-muted">Admin</p>
			<h1
				class="border-l border-dashed border-line-strong pl-3 text-display wrap-break-word"
			>
				Client workbench
			</h1>
		</div>
	</header>

	<dl
		class="grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-x-8 gap-y-3 text-sm"
	>
		<div class="grid min-w-0 content-start gap-1">
			<dt class="label-caps">Your move</dt>
			<dd class="text-title tabular-nums">
				{worklist.filter((item) => item.actor === "admin").length}
			</dd>
		</div>
		<div class="grid min-w-0 content-start gap-1">
			<dt class="label-caps">Overdue</dt>
			<dd
				class:list={[
					"text-title tabular-nums wrap-break-word",
					openInvoices.some((invoice) => invoice.overdue)
						? "text-fg-danger"
						: "text-fg",
				]}
			>
				{sumByCurrency(openInvoices.filter((invoice) => invoice.overdue))}
			</dd>
		</div>
		<div class="grid min-w-0 content-start gap-1">
			<dt class="label-caps">Outstanding</dt>
			<dd class="text-title tabular-nums wrap-break-word">
				{sumByCurrency(openInvoices)}
			</dd>
		</div>
	</dl>

	<section class="grid gap-3" aria-labelledby="worklist-heading">
		<div class="grid gap-1">
			<h2 id="worklist-heading" class="text-label uppercase text-fg-muted">
				Worklist
			</h2>
			<p class="max-w-prose text-sm text-fg-muted">
				Phases that need a step from you or a client, and invoices waiting for
				payment, across all clients.
			</p>
		</div>
		<AdminWorklist items={worklist} />
	</section>

	<client-ledger class="grid">
		<section class="grid gap-3" aria-labelledby="ledger-heading">
			<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
				<h2 id="ledger-heading" class="text-label uppercase text-fg-muted">
					Client ledger
				</h2>
				<DisclosureButton controls="onboard-client" open={isOnboardOpen}>
					Onboard client
				</DisclosureButton>
			</div>
			<form
				id="onboard-client"
				method="POST"
				action={actions.onboardOrganization}
				aria-label="Onboard client"
				hidden={!isOnboardOpen}
				class="grid grid-cols-[minmax(0,1fr)] gap-4 border border-dashed border-line p-4 md:grid-cols-[repeat(2,minmax(0,1fr))]"
			>
				<Field
					label="Client name"
					id="organization-name"
					name="organizationName"
					required
					maxlength="120"
					result={onboardResult}
				/>
				<Field
					label="Slug"
					id="organization-slug"
					name="slug"
					required
					autocomplete="off"
					spellcheck="false"
					hint="The client's dashboard address: /dash/org/slug. Filled in from the name; lowercase letters, numbers and dashes."
					result={onboardResult}
				/>
				<Field
					label="Contact name"
					name="name"
					required
					maxlength="120"
					autocomplete="off"
					result={onboardResult}
				/>
				<Field
					label="Contact email"
					name="email"
					type="email"
					required
					autocomplete="off"
					hint="Becomes the first member of the client's dashboard."
					result={onboardResult}
				/>
				<Field
					label="Yearly budget"
					name="yearlyBudget"
					type="number"
					min="1"
					step="1"
					inputmode="numeric"
					hint="Whole euros (EUR) per calendar year. Leave empty for no budget."
					result={onboardResult}
				/>
				<div
					class="grid grid-cols-[auto_auto] items-center justify-start gap-3 md:col-span-2"
				>
					<Button type="submit">Onboard client</Button>
					<Button variant="quiet" data-disclosure-cancel> Cancel </Button>
				</div>
			</form>
			<div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
				<p role="status" class="text-sm text-fg-muted" data-client-count>
					{ledger.length} {ledger.length === 1 ? "client" : "clients"}
				</p>
				{ledger.length > 0 && (
					<Field
						label="Filter by name"
						type="search"
						autocomplete="off"
						spellcheck="false"
						class="sm:w-64"
						data-client-filter
					/>
				)}
			</div>
			<div class="overflow-x-auto border border-dashed border-line">
				<table class="w-full min-w-3xl text-sm">
					<thead>
						<tr class="border-b border-dashed border-line text-fg-muted">
							<th scope="col" class="px-4 py-3 text-left label-caps">
								Client
							</th>
							<th scope="col" class="px-4 py-3 text-right label-caps">
								Your move
							</th>
							<th scope="col" class="px-4 py-3 text-right label-caps">
								Waiting on client
							</th>
							<th scope="col" class="px-4 py-3 text-right label-caps">
								Active projects
							</th>
							<th scope="col" class="px-4 py-3 text-left label-caps">
								Budget used
							</th>
							<th scope="col" class="px-4 py-3 text-right label-caps">
								Outstanding
							</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-dashed divide-line">
						{ledger.length > 0 ? (
							ledger.map((client) => (
								<tr data-client-name={client.name.toLocaleLowerCase("en")}>
									<th
										scope="row"
										class="px-4 py-3 text-left font-medium wrap-break-word"
									>
										<a
											href={`/admin/org/${client.id}`}
											class:list={[
												"underline decoration-dashed underline-offset-4",
												client.yourMove === 0 &&
												client.waiting === 0 &&
												client.openInvoices.length === 0
													? "text-fg-muted"
													: "text-fg",
											]}
										>
											{client.name}
										</a>
									</th>
									<td
										class:list={[
											"px-4 py-3 text-right tabular-nums",
											client.yourMove > 0 ? "text-fg" : "text-fg-muted",
										]}
									>
										{client.yourMove}
									</td>
									<td class="px-4 py-3 text-right tabular-nums text-fg-muted">
										{client.waiting}
									</td>
									<td class="px-4 py-3 text-right tabular-nums text-fg-muted">
										{client.activeProjects} of {client.totalProjects}
									</td>
									<td class="px-4 py-3">
										{client.budgetUsage === null ? (
											<span class="text-fg-muted">No budget</span>
										) : (
											<span class="grid gap-1">
												<progress
													class:list={[
														"h-2 w-24 appearance-none border border-dashed border-line bg-transparent [&::-webkit-progress-bar]:bg-transparent",
														client.budgetUsage > 100
															? "[&::-moz-progress-bar]:bg-fill-danger [&::-webkit-progress-value]:bg-fill-danger"
															: "[&::-moz-progress-bar]:bg-ink [&::-webkit-progress-value]:bg-ink",
													]}
													max="100"
													value={Math.min(client.budgetUsage, 100)}
													aria-label={`Budget used by ${client.name}`}
												/>
												<span
													class:list={[
														"text-xs tabular-nums",
														client.budgetUsage > 100
															? "text-fg-danger"
															: "text-fg-muted",
													]}
												>
													{formatPercent(client.budgetUsage)}
												</span>
											</span>
										)}
									</td>
									<td class="px-4 py-3 text-right">
										<span
											class:list={[
												"block tabular-nums",
												client.openInvoices.length > 0
													? "text-fg"
													: "text-fg-muted",
											]}
										>
											{sumByCurrency(client.openInvoices)}
										</span>
										{client.openInvoices.some((invoice) => invoice.overdue) && (
											<span class="block text-xs tabular-nums text-fg-danger">
												{sumByCurrency(
													client.openInvoices.filter(
														(invoice) => invoice.overdue,
													),
												)}{" "}
												overdue
											</span>
										)}
									</td>
								</tr>
							))
						) : (
							<tr>
								<td colspan="6" class="px-4 py-6 text-center text-fg-muted">
									No clients yet. Onboard the first one above.
								</td>
							</tr>
						)}
						<tr hidden data-client-empty>
							<td colspan="6" class="px-4 py-6 text-center text-fg-muted">
								No client name contains the filter text.
							</td>
						</tr>
					</tbody>
					{ledger.length > 0 && (
						<tfoot>
							<tr class="border-t border-dashed border-line">
								<th scope="row" class="px-4 py-3 text-left label-caps">
									All clients
								</th>
								<td class="px-4 py-3 text-right font-semibold tabular-nums">
									{worklist.filter((item) => item.actor === "admin").length}
								</td>
								<td class="px-4 py-3 text-right font-semibold tabular-nums">
									{worklist.filter((item) => item.actor === "client").length}
								</td>
								<td class="px-4 py-3" colspan="2"></td>
								<td class="px-4 py-3 text-right font-semibold tabular-nums">
									{sumByCurrency(openInvoices)}
								</td>
							</tr>
						</tfoot>
					)}
				</table>
			</div>
		</section>
	</client-ledger>
</AdminShell>

<script>
	// The slug follows the client name until the admin edits it. A form filled
	// in again after a failed submit keeps a slug that was edited by hand.
	const organizationName =
		document.querySelector<HTMLInputElement>("#organization-name");
	const organizationSlug =
		document.querySelector<HTMLInputElement>("#organization-slug");
	const toSlug = (value: string) =>
		value
			.trim()
			.toLowerCase()
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/^-|-$/g, "");
	let slugEdited =
		organizationSlug?.value !== toSlug(organizationName?.value ?? "");

	organizationSlug?.addEventListener("input", () => {
		slugEdited = true;
	});
	organizationName?.addEventListener("input", () => {
		if (!organizationSlug || slugEdited) return;
		organizationSlug.value = toSlug(organizationName.value);
	});
</script>

<script>
	// Filters the ledger rows by client name and announces the match count.
	class ClientLedger extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const input = this.querySelector<HTMLInputElement>(
				"[data-client-filter]",
			);
			const count = this.querySelector<HTMLElement>("[data-client-count]");
			const empty = this.querySelector<HTMLElement>("[data-client-empty]");
			const rows = [
				...this.querySelectorAll<HTMLElement>("[data-client-name]"),
			];

			if (!input || !count || !empty) return;

			input.addEventListener("input", () => {
				const query = input.value.trim().toLocaleLowerCase("en");
				let matches = 0;
				for (const row of rows) {
					row.hidden = !(row.dataset.clientName ?? "").includes(query);
					if (!row.hidden) matches += 1;
				}
				empty.hidden = matches > 0;
				count.textContent = query
					? `${matches} of ${rows.length} ${rows.length === 1 ? "client" : "clients"} match`
					: `${rows.length} ${rows.length === 1 ? "client" : "clients"}`;
			});
		}
	}

	if (!customElements.get("client-ledger")) {
		customElements.define("client-ledger", ClientLedger);
	}
</script>
