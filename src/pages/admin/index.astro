---
export const prerender = false;

import { actions } from "astro:actions";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import Shell from "../../layouts/Shell.astro";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../lib/budget-consumption.ts";
import { getUuidV7Date } from "../../lib/uuid.ts";

const onboardResult = Astro.getActionResult(actions.onboardOrganization);

const organizations = await Astro.locals.db.query.organization.findMany({
	columns: {
		id: true,
		name: true,
		slug: true,
	},
	with: {
		data: {
			columns: {
				yearlyBudget: true,
			},
		},
		projects: {
			columns: {
				id: true,
				name: true,
				state: true,
			},
			with: {
				phases: {
					columns: {
						id: true,
						title: true,
						cost: true,
						currency: true,
						state: true,
						dueAt: true,
					},
					with: {
						invoices: {
							columns: {
								id: true,
								invoiceNumber: true,
								total: true,
								stripeStatus: true,
								stripeDueAt: true,
								fetchedAt: true,
							},
						},
					},
				},
			},
			orderBy: {
				name: "asc",
			},
		},
	},
	orderBy: {
		name: "asc",
	},
});

// S-004 R2/R4: one full-history module read per organization; deriveBudget
// selects the current-year rows. Any read failure aborts this page render —
// no partial ledger or fallback (R8).
const organizationsWithSpend = await Promise.all(
	organizations.map(async (organization) => ({
		organization,
		spendRows: await getSpendByYear(Astro.locals.db, organization.id),
	})),
);

const now = new Date();
const currencyFormatter = new Intl.NumberFormat("de-DE", {
	style: "currency",
	currency: "EUR",
});
const daysSince = (id: string) => {
	const date = getUuidV7Date(id);
	return date
		? Math.max(0, Math.floor((now.getTime() - date.getTime()) / 86400000))
		: 0;
};

const queue = organizations
	.flatMap((organization) =>
		organization.projects.flatMap((project) =>
			project.phases.flatMap((phase) => {
				const link = `/admin/org/${organization.id}`;
				const overdueInvoices = phase.invoices.filter(
					(invoice) =>
						invoice.stripeStatus === "open" &&
						invoice.stripeDueAt &&
						invoice.stripeDueAt < now,
				);

				if (overdueInvoices.length > 0) {
					return overdueInvoices.map((invoice) => ({
						priority: 0,
						kind: "Overdue",
						client: organization.name,
						label: `${project.name} · ${invoice.invoiceNumber}`,
						amount: invoice.total,
						days: Math.floor(
							(now.getTime() -
								(invoice.stripeDueAt?.getTime() ?? now.getTime())) /
								86400000,
						),
						link,
					}));
				}

				if (phase.state === "submitted") {
					return [
						{
							priority: 1,
							kind: "To plan",
							client: organization.name,
							label: `${project.name} · ${phase.title}`,
							amount: phase.cost,
							days: daysSince(phase.id),
							link,
						},
					];
				}

				if (phase.state === "planned") {
					return [
						{
							priority: 2,
							kind: "Awaiting client",
							client: organization.name,
							label: `${project.name} · ${phase.title}`,
							amount: phase.cost,
							days: daysSince(phase.id),
							link,
						},
					];
				}

				// Billing is derived from the invoice's Stripe status alone
				// (D-phase-billing-truth): only an outstanding invoice reads "Unpaid".
				// A delivered phase surfaces as "Awaiting acceptance" regardless of its
				// invoice — acceptance is the next lifecycle step (S-005 R6; recorded
				// by #285).
				if (phase.state === "delivered") {
					return [
						{
							priority: 4,
							kind: "Awaiting acceptance",
							client: organization.name,
							label: `${project.name} · ${phase.title}`,
							amount: phase.cost,
							days: daysSince(phase.id),
							link,
						},
					];
				}

				const openInvoices = phase.invoices.filter(
					(invoice) => invoice.stripeStatus === "open",
				);
				if (openInvoices.length > 0) {
					return openInvoices.map((invoice) => ({
						priority: 3,
						kind: "Unpaid",
						client: organization.name,
						label: `${project.name} · ${invoice.invoiceNumber}`,
						amount: invoice.total,
						days: daysSince(invoice.id),
						link,
					}));
				}

				return [];
			}),
		),
	)
	.toSorted((a, b) => a.priority - b.priority || b.days - a.days);

const ledger = organizationsWithSpend.map(({ organization, spendRows }) => {
	const activeProjects = organization.projects.filter(
		(project) => project.state === "active",
	).length;
	const totalProjects = organization.projects.length;
	const openInvoices = organization.projects
		.flatMap((project) => project.phases)
		.flatMap((phase) => phase.invoices)
		.filter((invoice) => invoice.stripeStatus === "open")
		.reduce((total, invoice) => total + invoice.total, 0);
	const planned = organization.projects
		.flatMap((project) => project.phases)
		.filter((phase) => phase.state === "planned").length;
	const submitted = organization.projects
		.flatMap((project) => project.phases)
		.filter((phase) => phase.state === "submitted").length;
	const overdue = organization.projects
		.flatMap((project) => project.phases)
		.flatMap((phase) => phase.invoices)
		.filter(
			(invoice) =>
				invoice.stripeStatus === "open" &&
				invoice.stripeDueAt &&
				invoice.stripeDueAt < now,
		).length;
	// S-004 R1/R5: budget usage is the shared module's current-year percentage
	// (D-budget-consumption-definition, uncapped); null when there is no
	// positive yearly budget (R7 "No budget").
	const yearlyBudget = organization.data?.yearlyBudget ?? 0;
	const { usagePercentage } = deriveBudgetConsumption(spendRows, yearlyBudget);

	return {
		...organization,
		activeProjects,
		totalProjects,
		openInvoices,
		planned,
		submitted,
		overdue,
		budgetUsage: yearlyBudget > 0 ? usagePercentage : null,
	};
});
const outstandingTotal = ledger.reduce(
	(total, organization) => total + organization.openInvoices,
	0,
);
const overdueCount = queue.filter((item) => item.priority === 0).length;
---

<Shell
	bodyClass="min-h-dvh grid gap-6 bg-neutral-50 p-4 text-pretty text-neutral-950 antialiased dark:bg-neutral-950 dark:text-neutral-50"
>
	<Fragment slot="head"><title>craftlions | Admin</title></Fragment>
	<Fragment slot="body">
		<header class="grid w-full max-w-5xl gap-6 mx-auto">
			<Nav />
		</header>
		<main class="grid w-full max-w-5xl content-start gap-8 mx-auto">
			<section class="grid gap-4">
				<div class="grid gap-1">
					<p
						class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
						>Admin</p
					>
					<h1
						class="border-l border-dashed border-neutral-400 pl-3 text-3xl font-semibold leading-tight dark:border-neutral-600"
						>Client workbench</h1
					>
				</div>
				<dl class="grid grid-flow-col justify-start gap-8 text-sm">
					<div class="grid gap-1">
						<dt
							class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
							>Outstanding</dt
						>
						<dd class="tabular-nums"
							>{currencyFormatter.format(outstandingTotal)}</dd
						>
					</div>
					<div class="grid gap-1">
						<dt
							class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
							>Overdue</dt
						>
						<dd
							class:list={["tabular-nums", overdueCount > 0 && "text-red-700 dark:text-red-300"]}
							>{overdueCount}</dd
						>
					</div>
					<div class="grid gap-1">
						<dt
							class="text-xs font-semibold uppercase text-neutral-500 dark:text-neutral-400"
							>In queue</dt
						>
						<dd class="tabular-nums">{queue.length}</dd>
					</div>
				</dl>
			</section>

			<section class="grid gap-3" aria-labelledby="queue-heading">
				<h2
					id="queue-heading"
					class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Needs action</h2
				>
				<div
					class="grid border border-dashed border-neutral-300 dark:border-neutral-700 sm:grid-cols-[auto_1fr_max-content_max-content] sm:gap-x-6"
				>
					{queue.length > 0 ? queue.map((item) => (
							<article class="grid gap-y-3 border-b border-dashed border-neutral-300 p-4 last:border-b-0 dark:border-neutral-700 sm:col-span-4 sm:grid-cols-subgrid sm:items-center">
								<Badge type={item.priority === 0 ? "error" : item.priority === 1 ? "info" : "gray"}>{item.kind}</Badge>
								<div class="grid gap-1">
									<h3 class="font-medium">{item.client}</h3>
									<p class="text-sm text-neutral-600 dark:text-neutral-400">{item.label}</p>
								</div>
								<p class="text-sm tabular-nums sm:text-right">{currencyFormatter.format(item.amount)}</p>
								<div class="grid grid-flow-col items-center gap-3 sm:justify-self-end">
									<p class="text-sm tabular-nums text-neutral-600 dark:text-neutral-400">{item.days}d</p>
									<Button href={item.link}>Open</Button>
								</div>
							</article>
						)) : (
							<p class="p-4 text-sm text-neutral-600 dark:text-neutral-400 sm:col-span-4">Nothing needs action.</p>
						)}
				</div>
			</section>

			<section class="grid gap-3" aria-labelledby="ledger-heading">
				<h2
					id="ledger-heading"
					class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
					>Client ledger</h2
				>
				<div
					class="overflow-x-auto border border-dashed border-neutral-300 dark:border-neutral-700"
				>
					<table class="w-full min-w-2xl border-collapse text-left text-sm">
						<thead>
							<tr
								class="border-b border-dashed border-neutral-300 text-xs uppercase text-neutral-500 dark:border-neutral-700 dark:text-neutral-400"
							>
								<th class="px-4 py-3" scope="col">Client</th>
								<th class="px-4 py-3" scope="col">Attention</th>
								<th class="px-4 py-3" scope="col">Projects</th>
								<th class="px-4 py-3" scope="col">Budget used</th>
								<th class="px-4 py-3 text-right" scope="col">Open</th>
							</tr>
						</thead>
						<tbody>
							{ledger.length > 0 ? ledger.map((organization) => (
									<tr class:list={["border-b border-dashed border-neutral-300 last:border-b-0 dark:border-neutral-700", organization.openInvoices === 0 && organization.planned === 0 && organization.submitted === 0 && "opacity-60"]}>
										<td class="px-4 py-3 font-medium"><a class="underline decoration-dashed underline-offset-4" href={`/admin/org/${organization.id}`}>{organization.name}</a></td>
										<td class="px-4 py-3">
											<div class="grid grid-flow-col justify-start gap-2">
												{organization.overdue > 0 && <Badge type="error">Overdue</Badge>}
												{organization.submitted > 0 && <Badge type="info">To plan</Badge>}
												{organization.planned > 0 && <Badge type="gray">Awaiting client</Badge>}
												{organization.overdue === 0 && organization.submitted === 0 && organization.planned === 0 && <span class="text-neutral-500 dark:text-neutral-400">Quiet</span>}
											</div>
										</td>
										<td class="px-4 py-3 tabular-nums">{organization.activeProjects}/{organization.totalProjects}</td>
										<td class="px-4 py-3">
											{organization.budgetUsage === null ? (
												<span class="text-neutral-500 dark:text-neutral-400">No budget</span>
											) : (
												<div class="grid gap-1">
													<progress class:list={["h-2 w-24 appearance-none border border-dashed border-neutral-300 bg-transparent [&::-webkit-progress-bar]:bg-transparent [&::-webkit-progress-value]:bg-neutral-900 [&::-moz-progress-bar]:bg-neutral-900 dark:border-neutral-700 dark:[&::-webkit-progress-value]:bg-neutral-100 dark:[&::-moz-progress-bar]:bg-neutral-100", organization.budgetUsage > 100 && "[&::-webkit-progress-value]:bg-red-700 [&::-moz-progress-bar]:bg-red-700 dark:[&::-webkit-progress-value]:bg-red-400 dark:[&::-moz-progress-bar]:bg-red-400"]} max="100" value={Math.min(organization.budgetUsage, 100)} />
													<span class:list={["text-xs tabular-nums", organization.budgetUsage > 100 && "text-red-700 dark:text-red-300"]}>{organization.budgetUsage.toFixed(1)}%</span>
												</div>
											)}
										</td>
										<td class="px-4 py-3 text-right tabular-nums">{currencyFormatter.format(organization.openInvoices)}</td>
									</tr>
								)) : (
									<tr>
										<td class="px-4 py-3 text-neutral-600 dark:text-neutral-400" colspan="5">No clients yet.</td>
									</tr>
								)}
						</tbody>
						{ledger.length > 0 && (
							<tfoot>
								<tr
									class="border-t border-dashed border-neutral-300 font-semibold dark:border-neutral-700"
								>
									<td class="px-4 py-3" colspan="4">Outstanding</td>
									<td class="px-4 py-3 text-right tabular-nums"
										>{currencyFormatter.format(outstandingTotal)}</td
									>
								</tr>
							</tfoot>
						)}
					</table>
				</div>
			</section>

			<section aria-labelledby="onboard-heading">
				<details
					id="onboard"
					class="grid gap-3"
					open={Boolean(onboardResult?.error)}
				>
					<summary
						id="onboard-heading"
						class="w-max cursor-pointer text-sm font-semibold uppercase text-neutral-500 transition-colors hover:text-neutral-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200 dark:focus-visible:outline-neutral-300"
						>Onboard client</summary
					>
					<form
						method="POST"
						action={actions.onboardOrganization}
						class="grid gap-3 border border-dashed border-neutral-300 p-4 dark:border-neutral-700 md:grid-cols-2"
					>
						<label class="grid gap-1 text-sm">
							<span class="font-medium">Contact email</span>
							<input
								class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
								name="email"
								type="email"
								required
							>
						</label>
						<label class="grid gap-1 text-sm">
							<span class="font-medium">Contact name</span>
							<input
								class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
								name="name"
								required
							>
						</label>
						<label class="grid gap-1 text-sm">
							<span class="font-medium">Organization</span>
							<input
								id="organization-name"
								class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
								name="organizationName"
								required
							>
						</label>
						<label class="grid gap-1 text-sm">
							<span class="font-medium">Slug</span>
							<input
								id="organization-slug"
								class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
								name="slug"
								required
							>
						</label>
						<label class="grid gap-1 text-sm md:col-span-2">
							<span class="font-medium">Yearly budget</span>
							<input
								class="border border-dashed border-neutral-300 bg-transparent px-3 py-2 text-sm outline-none transition-colors focus:border-neutral-600 dark:border-neutral-700 dark:focus:border-neutral-300"
								name="yearlyBudget"
								type="number"
								min="1"
							>
						</label>
						{onboardResult?.error && <p class="text-sm text-red-700 dark:text-red-300 md:col-span-2">{onboardResult.error.message}</p>}
						<div class="grid md:col-span-2">
							<Button type="submit">Onboard client</Button>
						</div>
					</form>
				</details>
			</section>
		</main>
		<Footer />
		<script>
			const onboard = document.querySelector<HTMLDetailsElement>("#onboard");
			if (onboard?.open) onboard.scrollIntoView();

			const organizationName =
				document.querySelector<HTMLInputElement>("#organization-name");
			const organizationSlug =
				document.querySelector<HTMLInputElement>("#organization-slug");
			let slugEdited = false;

			organizationSlug?.addEventListener("input", () => {
				slugEdited = true;
			});
			organizationName?.addEventListener("input", () => {
				if (!organizationSlug || slugEdited) return;
				organizationSlug.value = organizationName.value
					.trim()
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, "-")
					.replace(/^-|-$/g, "");
			});
		</script>
	</Fragment>
</Shell>
