---
export const prerender = false;

import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Shell from "../layouts/Shell.astro";
import { parseReturnTo } from "../lib/return-to.ts";

const returnTo = parseReturnTo(Astro.url.searchParams.get("returnTo"));

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect(returnTo);
}
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Login</title> </Fragment>
	<Fragment slot="body">
		<body
			class="min-h-dvh grid grid-rows-[auto_1fr_auto] bg-canvas text-fg antialiased gap-12 p-4 text-pretty"
		>
			<header class="grid gap-6 justify-items-center max-w-3xl mx-auto">
				<Nav variant="marketing" />
			</header>

			<main class="w-full grid content-start min-h-0 max-w-lg mx-auto gap-6">
				<h1 class="border-l border-dashed border-line-strong pl-3 text-display">
					Sign in
				</h1>
				<form
					id="login-form"
					class="grid gap-6"
					data-return-to={returnTo}
					aria-label="Sign in form"
				>
					<fieldset class="grid gap-4 border-none p-0 m-0">
						<div class="grid gap-1.5">
							<label for="email" class="text-label text-fg-muted">
								Email address
							</label>
							<input
								type="email"
								id="email"
								name="email"
								autocomplete="email"
								required
								placeholder="you@example.com"
								class="border border-dashed border-line bg-transparent px-3 py-2 text-sm outline-none transition-colors placeholder:text-fg-muted focus:border-line-active"
							>
						</div>

						<div class="grid gap-1.5">
							<label for="password" class="text-label text-fg-muted">
								Password
							</label>
							<input
								type="password"
								id="password"
								name="password"
								autocomplete="current-password"
								required
								placeholder="••••••••"
								class="border border-dashed border-line bg-transparent px-3 py-2 text-sm outline-none transition-colors placeholder:text-fg-muted focus:border-line-active"
							>
							<a
								href="/forgot-password"
								class="justify-self-end text-sm text-fg-info underline decoration-dashed underline-offset-4"
							>
								Forgot password?
							</a>
						</div>
					</fieldset>

					<Button type="submit" id="login-submit"> Sign in </Button>
				</form>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("login-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"login-submit",
	) as HTMLButtonElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);
		const email = (data.get("email") as string).trim();
		const password = data.get("password") as string;

		if (!email || !password) {
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Signing in…";

		const { error } = await authClient.signIn.email({
			email,
			password,
			rememberMe: true,
			callbackURL:
				(form.dataset.returnTo ?? "/dash") +
				(form.dataset.returnTo?.includes("#") ? "" : location.hash),
		});

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Sign in";
		}
	});
</script>
