---
export const prerender = false;

import Button from "../components/Button.astro";
import Field from "../components/Field.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import PasswordToggle from "../components/PasswordToggle.astro";
import SkipLink from "../components/SkipLink.astro";
import Shell from "../layouts/Shell.astro";
import { parseReturnTo } from "../lib/return-to.ts";

const returnTo = parseReturnTo(Astro.url.searchParams.get("returnTo"));

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect(returnTo);
}
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Login</title> </Fragment>
	<Fragment slot="body">
		<body class="cover public" style="--cover-space: var(--space-xl)">
			<SkipLink />
			<header class="stack center" data-space="m">
				<Nav variant="marketing" />
			</header>

			<main
				id="main"
				tabindex="-1"
				class="stack center"
				data-width="narrow"
				data-space="m"
			>
				<PageHeading> Sign in </PageHeading>
				<form
					id="login-form"
					class="stack"
					data-space="m"
					data-return-to={returnTo}
					aria-label="Sign in form"
				>
					<div class="stack">
						<Field
							label="Email address"
							type="email"
							id="email"
							name="email"
							autocomplete="username"
							spellcheck="false"
							required
							placeholder="you@example.com"
						/>

						<div class="stack" data-space="2xs">
							<Field
								label="Password"
								type="password"
								id="password"
								name="password"
								autocomplete="current-password"
								required
								placeholder="••••••••"
							/>
							<div class="cluster" data-justify="between" data-space="xs">
								<PasswordToggle controls="password" />
								<a href="/forgot-password" class="text-sm text-fg-info link">
									Forgot password?
								</a>
							</div>
						</div>
					</div>

					<Button type="submit" id="login-submit"> Sign in </Button>
				</form>

				<p id="login-message" class="text-sm text-fg-danger" role="alert"></p>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("login-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"login-submit",
	) as HTMLButtonElement;
	const message = document.getElementById(
		"login-message",
	) as HTMLParagraphElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);
		const email = (data.get("email") as string).trim();
		const password = data.get("password") as string;

		if (!email || !password) {
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Signing in…";
		message.textContent = "";

		const { error } = await authClient.signIn.email({
			email,
			password,
			rememberMe: true,
			callbackURL:
				(form.dataset.returnTo ?? "/dash") +
				(form.dataset.returnTo?.includes("#") ? "" : location.hash),
		});

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Sign in";
			// The live region is always rendered, so changing its text announces it.
			message.textContent =
				error.message || "Something went wrong. Please try again.";
			document.getElementById("email")?.focus();
		}
	});
</script>
