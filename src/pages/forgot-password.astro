---
export const prerender = false;

import Button from "../components/Button.astro";
import Field from "../components/Field.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import SkipLink from "../components/SkipLink.astro";
import Shell from "../layouts/Shell.astro";

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect("/");
}
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Forgot Password</title> </Fragment>
	<Fragment slot="body">
		<body class="cover public" style="--cover-space: var(--space-xl)">
			<SkipLink />
			<header class="stack center" data-space="m">
				<Nav variant="marketing" />
			</header>

			<main
				id="main"
				tabindex="-1"
				class="stack center"
				data-width="narrow"
				data-space="m"
			>
				<PageHeading> Reset password </PageHeading>
				<p class="text-fg-muted text-sm">
					Enter your email address and we'll send you a link to reset your
					password.
				</p>
				<div class="request">
					<form
						id="forgot-form"
						class="stack"
						data-space="m"
						method="post"
						aria-label="Forgot password form"
					>
						<Field
							label="Email address"
							type="email"
							id="email"
							name="email"
							autocomplete="email"
							required
							placeholder="you@example.com"
						/>

						<Button type="submit" id="forgot-submit"> Send reset link </Button>
					</form>

					<p
						id="forgot-message"
						class:list={[
							"form-message text-sm",
							Astro.request.method === "POST" && "text-fg-danger",
						]}
						role="status"
						aria-live="polite"
					>
						{/* The script sends the link; a submit without it lands here as a POST. */}
						{Astro.request.method === "POST" &&
							"Sending a reset link needs JavaScript. Turn it on and try again."}
					</p>
				</div>

				<a href="/login" class="auth-link text-sm text-fg-info link">
					Back to sign in
				</a>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("forgot-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"forgot-submit",
	) as HTMLButtonElement;
	const message = document.getElementById(
		"forgot-message",
	) as HTMLParagraphElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);
		const email = (data.get("email") as string).trim();

		if (!email) {
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Sending…";

		const { error } = await authClient
			.requestPasswordReset({
				email,
				redirectTo: `${window.location.origin}/reset-password`,
			})
			.catch(() => ({
				// The request never got an answer, such as when offline.
				error: {
					message:
						"Could not reach the server. Check your connection and try again.",
				},
			}));

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Send reset link";
			message.textContent =
				error.message || "Something went wrong. Please try again.";
			message.className = "form-message text-sm text-fg-danger";
		} else {
			form.reset();
			submitBtn.textContent = "Sent";
			message.textContent =
				"If an account exists for that email, you'll receive a reset link shortly.";
			message.className = "form-message text-sm text-fg-success";
		}
	});
</script>
