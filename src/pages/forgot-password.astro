---
export const prerender = false;

import Button from "../components/Button.astro";
import Field from "../components/Field.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import Shell from "../layouts/Shell.astro";

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect("/");
}
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Forgot Password</title> </Fragment>
	<Fragment slot="body">
		<body
			class="min-h-dvh grid grid-rows-[auto_1fr_auto] gap-12 p-4 text-pretty"
		>
			<header class="grid gap-6 justify-items-center max-w-3xl mx-auto">
				<Nav variant="marketing" />
			</header>

			<main class="w-full grid content-start min-h-0 max-w-lg mx-auto gap-6">
				<PageHeading> Reset password </PageHeading>
				<p class="text-fg-muted text-sm">
					Enter your email address and we'll send you a link to reset your
					password.
				</p>
				<form
					id="forgot-form"
					class="grid gap-6"
					aria-label="Forgot password form"
				>
					<fieldset class="grid gap-4 border-none p-0 m-0">
						<Field
							label="Email address"
							type="email"
							id="email"
							name="email"
							autocomplete="email"
							required
							placeholder="you@example.com"
						/>
					</fieldset>

					<Button type="submit" id="forgot-submit"> Send reset link </Button>
				</form>

				<p
					id="forgot-message"
					class="text-sm hidden"
					role="status"
					aria-live="polite"
				> </p>

				<a href="/login" class="justify-self-start text-sm text-fg-info link">
					Back to sign in
				</a>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("forgot-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"forgot-submit",
	) as HTMLButtonElement;
	const message = document.getElementById(
		"forgot-message",
	) as HTMLParagraphElement;

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);
		const email = (data.get("email") as string).trim();

		if (!email) {
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Sending…";

		const { error } = await authClient.requestPasswordReset({
			email,
			redirectTo: `${window.location.origin}/reset-password`,
		});

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Send reset link";
			message.textContent =
				error.message || "Something went wrong. Please try again.";
			message.className = "text-sm text-fg-danger";
		} else {
			form.reset();
			submitBtn.textContent = "Sent";
			message.textContent =
				"If an account exists for that email, you'll receive a reset link shortly.";
			message.className = "text-sm text-fg-success";
		}
	});
</script>
