---
export const prerender = true;

import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import Shell from "../layouts/Shell.astro";
---

<Shell>
	<Fragment slot="head">
		<title>craftlions | Freelance IT Services & Technical Advisory</title>
		<meta
			name="description"
			content="Freelance software development, technical advisory, and workshops that bring focused expertise into your team's process, communicated plainly."
		>
		<meta
			property="og:title"
			content="craftlions | Freelance IT Services & Technical Advisory"
		>
		<meta
			property="og:description"
			content="Focused IT services and technical expertise for teams that value clarity, maintainability, and long-term software decisions."
		>
		<meta property="og:type" content="website">
		{/* Only facts the imprint and footer already state; no ratings or reviews. */}
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Organization",
						"@id": "https://craftlions.com/#organization",
						name: "craftlions",
						legalName: "craftlions UG (haftungsbeschränkt)",
						url: "https://craftlions.com/",
						email: "alexander@craftlions.com",
						description:
							"Freelance software development, technical advisory, and workshops.",
						address: {
							"@type": "PostalAddress",
							streetAddress: "Amandus-Voigt-Str. 8",
							postalCode: "23617",
							addressLocality: "Stockelsdorf",
							addressCountry: "DE",
						},
						sameAs: [
							"https://github.com/craftlions",
							"https://www.linkedin.com/company/craftlions",
						],
					},
					{
						"@type": "WebSite",
						"@id": "https://craftlions.com/#website",
						name: "craftlions",
						url: "https://craftlions.com/",
						inLanguage: "en",
						publisher: { "@id": "https://craftlions.com/#organization" },
					},
				],
			})}
		/>
	</Fragment>
	<Fragment slot="body">
		<body
			class="min-h-dvh grid grid-rows-[auto_1fr_auto] gap-6 p-4 text-pretty"
		>
			<header class="grid max-w-3xl mx-auto w-full">
				<Nav deferSessionLinks variant="marketing" />
			</header>

			<main
				class="w-full grid content-start min-h-0 max-w-3xl mx-auto gap-12 pb-6"
			>
				<section class="grid gap-6">
					<div class="grid gap-4">
						<PageHeading> Modern IT services drawn with care </PageHeading>
						<p class="pl-3 text-fg-muted">
							craftlions helps teams plan, build, and maintain software with a
							practical engineering mindset. The work is modern, but the process
							stays legible: clear lines, useful decisions, and outcomes that
							can be explained without decoration.
						</p>
						<p class="pl-3 text-fg-muted">
							From product development and technical strategy to workshops and
							hands-on delivery, craftlions brings focused external expertise
							into your existing process. The standard is simple:{" "}
							<strong>
								build carefully, communicate plainly, and leave systems easier
								to trust.
							</strong>
						</p>
					</div>
					<div class="justify-self-start pl-3">
						<Button href="mailto:alexander@craftlions.com">
							Start a project
						</Button>
					</div>
				</section>
				<section class="grid gap-6">
					<h2 class="text-headline">
						Services for steady technical progress
					</h2>
					<article class="grid gap-3 border-l border-dashed border-line pl-3">
						<h3 class="text-title">Software development</h3>
						<p class="text-fg-muted">
							craftlions builds with modern technologies when they serve the
							product, not because they are fashionable. The goal is software
							that is scalable, maintainable, and still understandable after the
							first release.
						</p>
					</article>
					<article class="grid gap-3 border-l border-dashed border-line pl-3">
						<h3 class="text-title">Flexible and asynchronous</h3>
						<p class="text-fg-muted">
							Work can move without filling the calendar. craftlions supports
							async-first collaboration, clear written updates, and real-time
							conversation when it helps unblock decisions.
						</p>
					</article>
					<article class="grid gap-3 border-l border-dashed border-line pl-3">
						<h3 class="text-title"> Technical advisory and strategy </h3>
						<p class="text-fg-muted">
							Strong products need decisions that survive contact with real
							constraints. craftlions helps evaluate options, define
							implementation paths, and reduce risk before complexity becomes
							expensive.
						</p>
					</article>
					<article class="grid gap-3 border-l border-dashed border-line pl-3">
						<h3 class="text-title">Workshops and learning</h3>
						<p class="text-fg-muted">
							Workshops are shaped around the team and the work in front of it:
							architecture choices, implementation patterns, delivery process,
							or practical skills that make better decisions easier.
						</p>
					</article>
					<section>
						<Button href="mailto:alexander@craftlions.com">
							Discuss the work
						</Button>
					</section>
				</section>
				<section class="grid gap-6 border-t border-dashed border-line pt-6">
					<h2 class="text-headline">Why choose craftlions?</h2>
					<p class="text-fg-muted">
						Quality is not a finish-line activity. It starts with choosing the
						right scope, naming tradeoffs clearly, and balancing
						maintainability, performance, and business value from the beginning.
					</p>
					<ul
						class="grid gap-2 pl-5 text-fg-muted list-disc marker:text-fg-muted"
					>
						<li>Experience with modern technology across multiple sectors.</li>
						<li>Reliable delivery with practical technical depth.</li>
						<li
							>Solutions shaped around business goals and operating reality.</li
						>
						<li>Clear integration with your processes, tools, and cadence.</li>
						<li
							>Work accepted only when it can be delivered to a high
							standard.</li
						>
					</ul>
				</section>
				<section class="grid gap-6 border-t border-dashed border-line pt-6">
					<h2 class="text-headline"> Let's build something better together </h2>
					<p class="text-fg-muted">
						craftlions helps businesses build smarter with modern IT services,
						technical advisory, and hands-on product development support.
						Whether you need a reliable technology partner, software
						architecture expertise, or strategic technical guidance, we create
						practical, scalable solutions built for long-term success.
					</p>
					<p class="text-fg-muted">
						The work goes beyond writing code. It strengthens the technical
						foundation, reduces unnecessary complexity, and keeps architecture
						aligned with the business it supports.
					</p>
					<p class="text-fg-muted">
						If you are looking for a technical partner that brings external
						expertise, strategic clarity, creative problem-solving, and a
						commitment to careful delivery, craftlions is ready to help.
					</p>
					<section>
						<Button href="mailto:alexander@craftlions.com">
							Get in touch
						</Button>
					</section>
				</section>
			</main>
			<Footer />
		</body>
	</Fragment>
</Shell>
