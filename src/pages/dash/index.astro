---
export const prerender = false;

import PageHeading from "../../components/PageHeading.astro";
import ClientShell from "../../layouts/ClientShell.astro";

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}

const organizations = await Astro.locals.auth.api.listOrganizations({
	headers: Astro.request.headers,
});

if (organizations.length === 1 && organizations[0]) {
	return Astro.redirect(`/dash/org/${organizations[0].slug}`);
}
---

<ClientShell title="Organizations" wide>
	<PageHeading> Organizations </PageHeading>
	{organizations.length > 0 ? (
		<ul class="client-orgs">
			{organizations
				.toSorted((a, b) => a.name.localeCompare(b.name))
				.map((organization) => (
					<li class="wrap-anywhere">
						<a href={`/dash/org/${organization.slug}`} class="link">
							{organization.name}
						</a>
					</li>
				))}
		</ul>
	) : (
		<p class="box text-sm text-fg-muted">
			Your account does not belong to an organization yet.
		</p>
	)}
</ClientShell>
