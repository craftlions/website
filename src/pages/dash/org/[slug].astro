---
export const prerender = false;

import type { projectSelectType } from "../../../lib/schema.ts";
import { isAPIError } from "better-auth/api";
import Badge from "../../../components/Badge.astro";
import ClientPhaseBanner from "../../../components/ClientPhaseBanner.astro";
import ClientWorklist from "../../../components/ClientWorklist.astro";
import CostSplit from "../../../components/CostSplit.astro";
import ClientOrgShell from "../../../layouts/ClientOrgShell.astro";
import {
	deriveBudgetConsumption,
	getSpendByYear,
} from "../../../lib/budget-consumption.ts";
import { deriveClientWorklist } from "../../../lib/client-worklist.ts";
import { formatMoney, formatPercent } from "../../../lib/format.ts";
import { projectStatus } from "../../../lib/status.ts";
import {
	organizationStripeInvoices,
	stripeInvoiceFields,
} from "../../../lib/stripe.ts";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/dash");
}

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}

if (!session.session.activeOrganizationId) {
	try {
		await Astro.locals.auth.api.setActiveOrganization({
			body: {
				organizationSlug: slug,
			},
			headers: Astro.request.headers,
		});
	} catch (error) {
		if (isAPIError(error) && error.body?.code === "ORGANIZATION_NOT_FOUND") {
			return Astro.redirect("/dash");
		}
	}
}

// One read resolves the slug, checks this user's membership, and loads the
// project tree; it replaces better-auth's multi-query getFullOrganization.
const organization = await Astro.locals.db.query.organization.findFirst({
	columns: {
		id: true,
		name: true,
	},
	with: {
		members: {
			columns: {
				role: true,
			},
			where: {
				userId: session.user.id,
			},
		},
		data: {
			columns: {
				yearlyBudget: true,
			},
		},
		projects: {
			columns: {
				publicId: true,
				name: true,
				state: true,
			},
			with: {
				phases: {
					columns: {
						publicId: true,
						title: true,
						state: true,
						cost: true,
						upfrontAmount: true,
						deliveryAmount: true,
						acceptanceAmount: true,
						currency: true,
						dueAt: true,
						version: true,
					},
				},
			},
			orderBy: {
				name: "asc",
			},
		},
	},
	where: {
		slug,
	},
});
const [currentMember] = organization?.members ?? [];

if (!organization || !currentMember) {
	return Astro.redirect("/dash");
}

const [spendRows, stripeRows] = await Promise.all([
	// S-004 R2/R3: one shared-module read returns the full spend history for
	// this organization; all budget figures derive from it.
	getSpendByYear(Astro.locals.db, organization.id),
	// The worklist lists open invoices only; the Invoices page lists them all.
	Astro.locals.db.query.stripeInvoices.findMany({
		...stripeInvoiceFields,
		with: {
			link: {
				columns: {
					component: true,
				},
				with: {
					phase: {
						columns: {
							publicId: true,
							title: true,
						},
						with: {
							project: {
								columns: {
									publicId: true,
									name: true,
								},
							},
						},
					},
				},
			},
		},
		where: { ...organizationStripeInvoices(organization.id), status: "open" },
		orderBy: {
			invoicedAt: "desc",
		},
	}),
]);

const now = new Date();
const projects = organization.projects.map((project) => {
	const totalsByCurrency = new Map<
		string,
		{ total: number; upfront: number; delivery: number; acceptance: number }
	>();
	for (const phase of project.phases) {
		const entry = totalsByCurrency.get(phase.currency) ?? {
			total: 0,
			upfront: 0,
			delivery: 0,
			acceptance: 0,
		};
		entry.total += phase.cost;
		entry.upfront += phase.upfrontAmount ?? 0;
		entry.delivery += phase.deliveryAmount ?? 0;
		entry.acceptance += phase.acceptanceAmount ?? 0;
		totalsByCurrency.set(phase.currency, entry);
	}
	return {
		publicId: project.publicId,
		name: project.name,
		state: project.state,
		splits: [...totalsByCurrency].map(([currency, entry]) => ({
			currency,
			total: entry.total,
			items: [
				{ component: "upfront" as const, amount: entry.upfront },
				{ component: "delivery" as const, amount: entry.delivery },
				{ component: "acceptance" as const, amount: entry.acceptance },
			]
				.filter((item) => item.amount !== 0)
				.map((item) => ({ ...item, status: "not_due" as const })),
		})),
	};
});
const completedProjectCount = projects.filter(
	(project) => project.state === "completed",
).length;
const yearlyBudget = organization.data?.yearlyBudget ?? 0;
// S-004 R3 + R5: current-year total, remaining budget, and usage percentage
// derive from the module's full-history rows (D-budget-consumption-definition).
const { currentYearTotal, remainingBudget, usagePercentage } =
	deriveBudgetConsumption(spendRows, yearlyBudget);
const budgetPacePercentage = ((now.getMonth() + 1) / 12) * 100;
const budgetPaceGridLineClass = [
	"col-start-2",
	"col-start-3",
	"col-start-4",
	"col-start-5",
	"col-start-6",
	"col-start-7",
	"col-start-8",
	"col-start-9",
	"col-start-10",
	"col-start-11",
	"col-start-12",
	"col-start-13",
][now.getMonth()];

const projectStateToBadgeType = (projectState: projectSelectType["state"]) => {
	switch (projectState) {
		case "completed":
			return "success";
		case "active":
			return "info";
		case "archived":
		case "draft":
			return "gray";
		default:
			return "info";
	}
};

const worklist = deriveClientWorklist({
	slug,
	projects: organization.projects,
	invoices: stripeRows.map(({ link, ...invoice }) => ({
		...invoice,
		component: link?.component ?? null,
		phase: link?.phase ?? null,
	})),
	now,
});
---

<ClientOrgShell
	organization={{ name: organization.name, slug }}
	activePage="overview"
>
	<ClientPhaseBanner />
	<section aria-labelledby="worklist-heading" class="grid gap-3">
		<h2 id="worklist-heading" class="text-label uppercase text-fg-muted">
			Worklist
		</h2>
		<ClientWorklist
			items={worklist}
			canDecide={currentMember.role === "owner" ||
				currentMember.role === "admin"}
		/>
	</section>

	<div
		class="grid content-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start"
	>
		<section
			aria-labelledby="projects-heading"
			class="group grid min-w-0 content-start gap-3"
		>
			<div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3">
				<h2 id="projects-heading" class="text-label uppercase text-fg-muted">
					Projects
				</h2>
				{completedProjectCount > 0 && (
					<label class="grid cursor-pointer grid-flow-col items-center gap-2 text-sm font-medium text-fg-muted select-none">
						<input
							type="checkbox"
							class="size-4 cursor-pointer appearance-none border border-dashed border-line-strong bg-transparent checked:bg-ink checked:bg-[length:0.75rem] checked:bg-center checked:bg-no-repeat checked:bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2016%2016%22%20fill=%22none%22%20stroke=%22white%22%20stroke-width=%222%22%3E%3Cpath%20d=%22M3%208l3.5%203.5L13%205%22/%3E%3C/svg%3E')] dark:checked:bg-[url('data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2016%2016%22%20fill=%22none%22%20stroke=%22black%22%20stroke-width=%222%22%3E%3Cpath%20d=%22M3%208l3.5%203.5L13%205%22/%3E%3C/svg%3E')]"
						/>
						<span>Hide completed</span>
					</label>
				)}
			</div>
			{projects.length > 0 ? (
				<div class="overflow-x-auto border border-dashed border-line">
					<table class="w-full min-w-md text-sm">
						<thead>
							<tr class="border-b border-dashed border-line text-fg-muted">
								<th scope="col" class="px-4 py-3 text-left label-caps">
									Name
								</th>
								<th scope="col" class="px-4 py-3 text-left label-caps">
									Status
								</th>
								<th scope="col" class="px-4 py-3 text-right label-caps">
									Total cost
								</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-dashed divide-line">
							{projects.map((project) => (
								<tr
									class:list={[
										project.state === "completed" &&
											"group-has-[:checked]:hidden",
									]}
								>
									<th
										scope="row"
										class:list={[
											"px-4 py-3 text-left font-medium",
											project.state === "completed" && "text-fg-muted",
										]}
									>
										<a
											href={`/dash/org/${slug}/project/${project.publicId}`}
											class="link hover:text-fg"
										>
											{project.name}
										</a>
									</th>
									<td class="px-4 py-3">
										<Badge type={projectStateToBadgeType(project.state)}>
											{projectStatus[project.state].label}
										</Badge>
									</td>
									<td
										class:list={[
											"px-4 py-3 text-right tabular-nums",
											project.state === "completed"
												? "text-fg-muted"
												: "text-fg",
										]}
									>
										{project.splits.length > 0 ? (
											<div class="grid justify-items-end gap-2">
												{project.splits.map((split) => (
													<div class="grid w-full min-w-48 max-w-64 gap-1">
														<p class="whitespace-nowrap font-medium">
															{formatMoney(split.total, split.currency)}
														</p>
														{split.items.length > 0 && (
															<CostSplit
																items={split.items}
																currency={split.currency}
																total={split.total}
																variant="compact"
																showStatus={false}
															/>
														)}
													</div>
												))}
											</div>
										) : (
											"—"
										)}
									</td>
								</tr>
							))}
							{completedProjectCount === projects.length && (
								<tr class="hidden group-has-[:checked]:table-row">
									<td colspan="3" class="px-4 py-6 text-center text-fg-muted">
										All projects are completed and currently hidden.
									</td>
								</tr>
							)}
						</tbody>
					</table>
				</div>
			) : (
				<p class="border border-dashed border-line p-4 text-sm text-fg-muted">
					No projects yet.
				</p>
			)}
		</section>

		<section
			aria-labelledby="budget-heading"
			class="grid min-w-0 content-start gap-3"
		>
			<h2 id="budget-heading" class="text-label uppercase text-fg-muted">
				Budget
			</h2>
			<dl
				class="grid grid-cols-[minmax(0,1fr)_auto] border border-dashed border-line text-sm"
			>
				<div
					class="col-span-2 grid gap-2 border-b border-dashed border-line p-4"
				>
					<dt class="label-caps">Budget used</dt>
					<dd
						class:list={[
							"text-title tabular-nums",
							yearlyBudget > 0 && usagePercentage > 100
								? "text-fg-danger"
								: "text-fg",
						]}
					>
						{yearlyBudget > 0 ? formatPercent(usagePercentage) : "No budget"}
					</dd>
					{yearlyBudget > 0 && (
						<dd class="grid gap-2">
							<span class="relative grid">
								<progress
									aria-label="Budget used"
									aria-valuetext={formatPercent(usagePercentage)}
									aria-describedby="budget-pace"
									max="100"
									value={Math.min(Number(usagePercentage.toFixed(1)), 100)}
									class:list={[
										"h-2 w-full appearance-none border border-dashed border-line bg-transparent [&::-webkit-progress-bar]:bg-transparent",
										usagePercentage > 100
											? "[&::-webkit-progress-value]:bg-fill-danger [&::-moz-progress-bar]:bg-fill-danger"
											: "[&::-webkit-progress-value]:bg-ink [&::-moz-progress-bar]:bg-ink",
									]}
								>
									{`${formatPercent(usagePercentage)} used`}
								</progress>
								<span
									aria-hidden="true"
									class="pointer-events-none absolute -inset-y-1 left-0 grid w-full grid-cols-12"
								>
									<span
										class:list={[
											"h-full w-0.75 justify-self-start border-x border-canvas bg-ink",
											budgetPaceGridLineClass,
										]}
									/>
								</span>
							</span>
							<span id="budget-pace" class="text-xs text-fg-muted">
								The marker shows calendar pace:{" "}
								{formatPercent(budgetPacePercentage)}.
							</span>
						</dd>
					)}
				</div>
				<div
					class="col-span-2 grid grid-cols-subgrid gap-x-3 px-4 pt-4 last:pb-4"
				>
					<dt class="text-fg-muted">Invoiced this year</dt>
					<dd class="text-right tabular-nums">
						{formatMoney(currentYearTotal, "EUR")}
					</dd>
				</div>
				{yearlyBudget > 0 && (
					<>
						<div class="col-span-2 grid grid-cols-subgrid gap-x-3 px-4 pt-2 last:pb-4">
							<dt class="text-fg-muted">Yearly budget</dt>
							<dd class="text-right tabular-nums">
								{formatMoney(yearlyBudget, "EUR")}
							</dd>
						</div>
						<div class="col-span-2 grid grid-cols-subgrid gap-x-3 px-4 pt-2 last:pb-4">
							<dt class="text-fg-muted">Remaining</dt>
							<dd
								class:list={[
									"text-right tabular-nums",
									remainingBudget < 0 ? "text-fg-danger" : "text-fg",
								]}
							>
								{formatMoney(remainingBudget, "EUR")}
							</dd>
						</div>
					</>
				)}
			</dl>
		</section>
	</div>
</ClientOrgShell>
