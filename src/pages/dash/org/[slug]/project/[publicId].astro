---
export const prerender = false;

import { isAPIError } from "better-auth/api";
import Button from "../../../../../components/Button.astro";
import Footer from "../../../../../components/Footer.astro";
import Nav from "../../../../../components/Nav.astro";
import PhaseOverview from "../../../../../components/PhaseOverview.astro";
import Shell from "../../../../../layouts/Shell.astro";
import { stripeInvoiceFields } from "../../../../../lib/stripe.ts";

const { publicId, slug } = Astro.params;

if (!publicId || !slug) {
	return Astro.redirect("/dash");
}

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}

if (!session.session.activeOrganizationId) {
	try {
		await Astro.locals.auth.api.setActiveOrganization({
			body: {
				organizationSlug: slug,
			},
			headers: Astro.request.headers,
		});
	} catch (error) {
		if (isAPIError(error) && error.body?.code === "ORGANIZATION_NOT_FOUND") {
			return Astro.redirect("/dash");
		}
	}
}

// One read resolves the project within the slug's organization, this user's
// membership, and every phase invoice its payment schedule needs.
const project = await Astro.locals.db.query.projects.findFirst({
	columns: {
		name: true,
	},
	with: {
		organization: {
			columns: {},
			with: {
				members: {
					columns: {
						role: true,
					},
					where: {
						userId: session.user.id,
					},
				},
			},
		},
		phases: {
			columns: {
				publicId: true,
				title: true,
				dueAt: true,
				cost: true,
				upfrontAmount: true,
				deliveryAmount: true,
				acceptanceAmount: true,
				currency: true,
				state: true,
				version: true,
				externalUrl: true,
				deliveryState: true,
				deliveryUrl: true,
			},
			with: {
				invoices: {
					columns: {
						component: true,
					},
					with: {
						stripe: stripeInvoiceFields,
					},
				},
			},
			orderBy: {
				dueAt: "asc",
				id: "asc",
			},
		},
	},
	where: {
		publicId,
		organization: {
			slug,
		},
	},
});

if (!project) {
	return Astro.redirect(`/dash/org/${slug}`);
}

const [currentMember] = project.organization?.members ?? [];

if (!currentMember) {
	return Astro.redirect("/dash");
}

const canApprovePhases =
	currentMember.role === "owner" || currentMember.role === "admin";
---

<Shell
	bodyClass="min-h-dvh grid bg-canvas text-fg antialiased gap-6 p-4 text-pretty"
>
	<Fragment slot="head"> <title>craftlions | {project.name}</title> </Fragment>
	<Fragment slot="body">
		<header class="grid gap-6 max-w-6xl mx-auto w-full">
			<Nav organizationSlug={slug} />
		</header>

		<main
			class="w-full grid content-start min-h-0 pl-3 max-w-6xl mx-auto gap-6"
		>
			<Button href={`/dash/org/${slug}`}>Back to Dashboard</Button>

			<section class="grid gap-4">
				<p class="text-label uppercase text-fg-muted"> Project Overview </p>
				<h1 class="border-l border-dashed border-line-strong pl-3 text-display">
					{project.name}
				</h1>
			</section>

			<section class="grid gap-3" aria-labelledby="phases">
				<h2 id="phases" class="text-label uppercase text-fg-muted">
					Phases &amp; Billing
				</h2>
				<PhaseOverview
					phases={project.phases}
					canApprovePhases={canApprovePhases}
					canAcceptPhases={canApprovePhases}
				/>
			</section>
		</main>
		<Footer />
	</Fragment>
</Shell>
