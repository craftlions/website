---
export const prerender = false;

import { isAPIError } from "better-auth/api";
import Button from "../../../../../components/Button.astro";
import Footer from "../../../../../components/Footer.astro";
import InvoiceTable from "../../../../../components/InvoiceTable.astro";
import Nav from "../../../../../components/Nav.astro";
import PhasesTable from "../../../../../components/PhasesTable.astro";
import Shell from "../../../../../layouts/Shell.astro";
import { buildPhaseComponents } from "../../../../../lib/phase-billing";

const { publicId, slug } = Astro.params;

if (!publicId || !slug) {
	return Astro.redirect("/dash");
}

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect(
		`/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
	);
}

if (!session.session.activeOrganizationId) {
	try {
		await Astro.locals.auth.api.setActiveOrganization({
			body: {
				organizationSlug: slug,
			},
			headers: Astro.request.headers,
		});
	} catch (error) {
		if (isAPIError(error) && error.body?.code === "ORGANIZATION_NOT_FOUND") {
			return Astro.redirect("/dash");
		}
	}
}

// One read resolves the project within the slug's organization, this user's
// membership, and every phase invoice the invoice table needs.
const project = await Astro.locals.db.query.projects.findFirst({
	columns: {
		publicId: true,
		name: true,
	},
	with: {
		organization: {
			columns: {},
			with: {
				members: {
					columns: {
						role: true,
					},
					where: {
						userId: session.user.id,
					},
				},
			},
		},
		phases: {
			columns: {
				id: true,
				publicId: true,
				title: true,
				dueAt: true,
				cost: true,
				upfrontAmount: true,
				deliveryAmount: true,
				acceptanceAmount: true,
				currency: true,
				state: true,
				version: true,
				externalUrl: true,
				deliveryState: true,
				deliveryUrl: true,
			},
			with: {
				invoices: {
					columns: {
						component: true,
						invoiceNumber: true,
						stripePaymentPage: true,
						stripeStatus: true,
						stripePaidAt: true,
						stripeDueAt: true,
						total: true,
						currency: true,
						invoicedAt: true,
					},
				},
			},
			orderBy: {
				dueAt: "asc",
				id: "asc",
			},
		},
	},
	where: {
		publicId,
		organization: {
			slug,
		},
	},
});

if (!project) {
	return Astro.redirect(`/dash/org/${slug}`);
}

const [currentMember] = project.organization?.members ?? [];

if (!currentMember) {
	return Astro.redirect("/dash");
}

const canApprovePhases =
	currentMember.role === "owner" || currentMember.role === "admin";

// S-003 R2: an attached invoice derives its project, phase, and Delivery from
// its one phase — nothing is copied onto the invoice row.
const invoices = project.phases
	.flatMap((phase) =>
		phase.invoices.map((invoice) => ({
			...invoice,
			phase: { ...phase, project },
		})),
	)
	.toSorted((a, b) => b.invoicedAt.getTime() - a.invoicedAt.getTime());

const phasesWithComponents = project.phases.map((phase) => ({
	...phase,
	components: buildPhaseComponents({
		upfrontAmount: phase.upfrontAmount,
		deliveryAmount: phase.deliveryAmount,
		acceptanceAmount: phase.acceptanceAmount,
		state: phase.state,
		invoices: phase.invoices,
	}),
}));
---

<Shell
	bodyClass="min-h-dvh grid bg-neutral-50 dark:bg-neutral-950 dark:text-neutral-50 text-neutral-950 antialiased gap-6 p-4 text-pretty"
>
	<Fragment slot="head"> <title>craftlions | {project.name}</title> </Fragment>
	<Fragment slot="body">
		<header class="grid gap-6 max-w-6xl mx-auto w-full">
			<Nav organizationSlug={slug} />
		</header>

		<main
			class="w-full grid content-start min-h-0 pl-3 max-w-6xl mx-auto gap-6"
		>
			<Button href={`/dash/org/${slug}`}>Back to Dashboard</Button>

			<section class="grid gap-4">
				<p
					class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>
					Project Overview
				</p>
				<h1
					class="border-l border-dashed border-neutral-400 pl-3 text-3xl font-semibold leading-tight dark:border-neutral-600"
				>
					{project.name}
				</h1>
			</section>

			<section>
				<h2
					id="phases"
					class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>
					Phases
				</h2>
				<PhasesTable
					phases={phasesWithComponents}
					canApprovePhases={canApprovePhases}
					canAcceptPhases={canApprovePhases}
				/>
			</section>

			<section>
				<h2
					id="invoices"
					class="text-sm font-semibold uppercase text-neutral-500 dark:text-neutral-400"
				>
					Invoices
				</h2>
				<InvoiceTable {invoices} {slug} />
			</section>
		</main>
		<Footer />
	</Fragment>
</Shell>
