---
export const prerender = false;

import Button from "../components/Button.astro";
import Field from "../components/Field.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import PageHeading from "../components/PageHeading.astro";
import PasswordToggle from "../components/PasswordToggle.astro";
import SkipLink from "../components/SkipLink.astro";
import Shell from "../layouts/Shell.astro";

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect("/");
}

const token = Astro.url.searchParams.get("token");
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Reset Password</title> </Fragment>
	<Fragment slot="body">
		<body class="cover public" style="--cover-space: var(--space-xl)">
			<SkipLink />
			<header class="stack center" data-space="m">
				<Nav variant="marketing" />
			</header>

			<main
				id="main"
				tabindex="-1"
				class="stack center"
				data-width="narrow"
				data-space="m"
			>
				<PageHeading> New password </PageHeading>
				{token ? (
					<p class="text-fg-muted text-sm"> Enter a new password below. </p>
				) : (
					<>
						<p class="text-sm text-fg-danger">
							Invalid or missing reset token.
						</p>
						<a
							href="/forgot-password"
							class="auth-link text-sm text-fg-info link"
						>
							Request a new reset link
						</a>
					</>
				)}
				<form
					id="reset-form"
					class="stack"
					data-space="m"
					method="post"
					aria-label="Reset password form"
					data-token={token}
					hidden={!token}
				>
					<div class="stack">
						<Field
							label="New password"
							type="password"
							id="password"
							name="password"
							autocomplete="new-password"
							required
							minlength={8}
							placeholder="••••••••"
						/>

						<Field
							label="Confirm password"
							type="password"
							id="confirm-password"
							name="confirm-password"
							autocomplete="new-password"
							required
							minlength={8}
							placeholder="••••••••"
						/>

						<PasswordToggle controls="password confirm-password">
							Show passwords
						</PasswordToggle>
					</div>

					<Button type="submit" id="reset-submit"> Reset password </Button>
				</form>

				<p
					id="reset-message"
					class:list={[
						"text-sm",
						Astro.request.method === "POST" && "text-fg-danger",
					]}
					role="status"
					aria-live="polite"
				>
					{/* The script resets it; a submit without it lands here as a POST. */}
					{Astro.request.method === "POST" &&
						"Resetting the password needs JavaScript. Turn it on and try again."}
				</p>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("reset-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"reset-submit",
	) as HTMLButtonElement;
	const message = document.getElementById(
		"reset-message",
	) as HTMLParagraphElement;
	const password = form.elements.namedItem("password") as HTMLInputElement;
	const confirmPassword = form.elements.namedItem(
		"confirm-password",
	) as HTMLInputElement;
	const token = form.dataset.token;

	// A confirmation that differs fails its constraint, so the browser blocks
	// the submit and focuses it, and its field shows the message like any
	// other. Editing the new password re-checks the confirmation, so a fixed
	// mismatch drops the message there as well. An empty confirmation keeps
	// the required message.
	form.addEventListener("input", (event) => {
		confirmPassword.setCustomValidity(
			confirmPassword.value && confirmPassword.value !== password.value
				? "Passwords do not match."
				: "",
		);
		if (event.target === password) {
			confirmPassword.dispatchEvent(new Event("input", { bubbles: true }));
		}
	});

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		if (!password.value || !confirmPassword.value) {
			return;
		}

		if (!token) {
			message.textContent = "Invalid or missing reset token.";
			message.className = "text-sm text-fg-danger";
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Resetting…";

		const { error } = await authClient
			.resetPassword({
				newPassword: password.value,
				token,
			})
			.catch(() => ({
				// The request never got an answer, such as when offline.
				error: {
					message:
						"Could not reach the server. Check your connection and try again.",
				},
			}));

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Reset password";
			message.textContent =
				error.message || "Something went wrong. Please try again.";
			message.className = "text-sm text-fg-danger";
		} else {
			form.hidden = true;
			message.textContent =
				"Your password has been reset. Redirecting to sign in…";
			message.className = "text-sm text-fg-success";
			setTimeout(() => {
				window.location.href = "/login";
			}, 2000);
		}
	});
</script>
