---
export const prerender = false;

import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import Shell from "../layouts/Shell.astro";

const session = await Astro.locals.auth.api.getSession({
	headers: Astro.request.headers,
});

if (session) {
	return Astro.redirect("/");
}

const token = Astro.url.searchParams.get("token");
---

<Shell>
	<Fragment slot="head"> <title>craftlions | Reset Password</title> </Fragment>
	<Fragment slot="body">
		<body
			class="min-h-dvh grid grid-rows-[auto_1fr_auto] bg-canvas text-fg antialiased gap-12 p-4 text-pretty"
		>
			<header class="grid gap-6 justify-items-center max-w-3xl mx-auto">
				<Nav variant="marketing" />
			</header>

			<main class="w-full grid content-start min-h-0 max-w-lg mx-auto gap-6">
				<h1
					class="border-l border-dashed border-line-strong pl-3 text-3xl font-semibold leading-tight"
				>
					New password
				</h1>
				<p class="text-fg-muted text-sm"> Enter a new password below. </p>
				<form
					id="reset-form"
					class="grid gap-6"
					aria-label="Reset password form"
					data-token={token}
				>
					<fieldset class="grid gap-4 border-none p-0 m-0">
						<div class="grid gap-1.5">
							<label for="password" class="text-sm font-semibold text-fg-muted">
								New password
							</label>
							<input
								type="password"
								id="password"
								name="password"
								autocomplete="new-password"
								required
								minlength={8}
								placeholder="••••••••"
								class="border border-dashed border-line bg-transparent px-3 py-2 text-sm outline-none transition-colors placeholder:text-fg-muted focus:border-line-active"
							>
						</div>

						<div class="grid gap-1.5">
							<label
								for="confirm-password"
								class="text-sm font-semibold text-fg-muted"
							>
								Confirm password
							</label>
							<input
								type="password"
								id="confirm-password"
								name="confirm-password"
								autocomplete="new-password"
								required
								minlength={8}
								placeholder="••••••••"
								class="border border-dashed border-line bg-transparent px-3 py-2 text-sm outline-none transition-colors placeholder:text-fg-muted focus:border-line-active"
							>
						</div>
					</fieldset>

					<Button type="submit" id="reset-submit"> Reset password </Button>
				</form>

				<p
					id="reset-message"
					class="text-sm hidden"
					role="status"
					aria-live="polite"
				> </p>
			</main>

			<Footer />
		</body>
	</Fragment>
</Shell>

<script>
	import { authClient } from "../lib/auth-client";

	const form = document.getElementById("reset-form") as HTMLFormElement;
	const submitBtn = document.getElementById(
		"reset-submit",
	) as HTMLButtonElement;
	const message = document.getElementById(
		"reset-message",
	) as HTMLParagraphElement;
	const token = form.dataset.token;

	if (!token) {
		form.style.display = "none";
		message.textContent =
			"Invalid or missing reset token. Please request a new reset link.";
		message.className = "text-sm text-fg-danger";
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();

		const data = new FormData(form);
		const password = data.get("password") as string;
		const confirmPassword = data.get("confirm-password") as string;

		if (!password || !confirmPassword) {
			return;
		}

		if (password !== confirmPassword) {
			message.textContent = "Passwords do not match.";
			message.className = "text-sm text-fg-danger";
			return;
		}

		if (!token) {
			message.textContent = "Invalid or missing reset token.";
			message.className = "text-sm text-fg-danger";
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = "Resetting…";

		const { error } = await authClient.resetPassword({
			newPassword: password,
			token,
		});

		if (error) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Reset password";
			message.textContent =
				error.message || "Something went wrong. Please try again.";
			message.className = "text-sm text-fg-danger";
		} else {
			form.style.display = "none";
			message.textContent =
				"Your password has been reset. Redirecting to sign in…";
			message.className = "text-sm text-fg-success";
			setTimeout(() => {
				window.location.href = "/login";
			}, 2000);
		}
	});
</script>
