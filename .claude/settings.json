{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"deny": [
			"Read(.env)",
			"Read(.env.*)",
			"Read(~/.config/fnox/**)",
			"Bash(fnox get *)",
			"Bash(fnox export *)",
			"Bash(fnox exec *)",
			"Bash(op read *)",
			"Bash(mise * --secrets*)",
			"Bash(mise run dev *)",
			"Bash(mise dev *)",
			"Bash(mise run db:migrate *)",
			"Bash(mise db:migrate *)",
			"Bash(mise run secrets:push *)",
			"Bash(mise secrets:push *)"
		]
	}
}
